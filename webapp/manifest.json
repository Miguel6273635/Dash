{
  "_version": "1.84.0",
  "sap.app": {
    "id": "mantenimiento",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.24.0",
      "toolsId": "b12e882a-3837-4505-bf89-b09af6d5620c"
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "dependencies": {
      "minUI5Version": "1.148.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.viz": {},
        "sap.tnt": {},
        "sap.f": {},
        "sap.ui.layout": {},
        "sap.suite.ui.microchart": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "mantenimiento.i18n.i18n",
          "supportedLocales": [
            ""
          ],
          "fallbackLocale": ""
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        },
        {
          "uri": "css/AnalisisReparacionesPlaneadasEjecutadas.css"
        },
        {
          "uri": "css/AnalisisIntegralReparaciones.css"
        },
        {
          "uri": "css/AnalisisSolicitudesCallCenterAtendidas.css"
        },
        {
          "uri": "css/ConsumoMateriales.css"
        },
        {
          "uri": "css/ConsumoRealVsPlanCategoria.css"
        },
        {
          "uri": "css/CausasZona.css"
        },
        {
          "uri": "css/BalanceOperativoZona.css"
        },
        {
          "uri": "css/DetalleOperativoZonaSur.css"
        },
        {
          "uri": "css/AnalisisFallas.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "viewType": "XML",
        "viewPath": "mantenimiento.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteAnalisisFallas",
          "pattern": ":?query:",
          "target": [
            "TargetAnalisisFallas"
          ]
        },
        {
          "name": "RouteMantenimiento",
          "pattern": "mantenimiento",
          "target": [
            "TargetMantenimiento"
          ]
        },
        {
          "name": "RouteMantenimientoEjecutivo",
          "pattern": "mantenimiento-ejecutivo",
          "target": [
            "TargetMantenimientoEjecutivo"
          ]
        },
        {
          "name": "RouteMantenimientoDetalle",
          "pattern": "mantenimiento-detalle",
          "target": [
            "TargetMantenimientoDetalle"
          ]
        },
        {
          "name": "RouteCausasZona",
          "pattern": "causas-zona",
          "target": [
            "TargetCausasZona"
          ]
        },
        {
          "name": "RouteComportamientoOperativo",
          "pattern": "comportamiento-operativo",
          "target": [
            "TargetComportamientoOperativo"
          ]
        },
        {
          "name": "RouteHorasTrabajadas",
          "pattern": "horas-trabajadas",
          "target": [
            "TargetHorasTrabajadas"
          ]
        },
        {
          "name": "RouteConsumoMateriales",
          "pattern": "consumo-materiales",
          "target": [
            "TargetConsumoMateriales"
          ]
        },
        {
          "name": "RouteConsumoRealVsPlanCategoria",
          "pattern": "consumo-real-vs-plan-categoria",
          "target": [
            "TargetConsumoRealVsPlanCategoria"
          ]
        },
        {
          "name": "RouteDetalleResponsable",
          "pattern": "detalle-responsable/{responsableId}",
          "target": [
            "TargetDetalleResponsable"
          ]
        },
        {
          "name": "RouteAnalisisElevadores",
          "pattern": "analisis-elevadores",
          "target": [
            "TargetAnalisisElevadores"
          ]
        },
        {
          "name": "RouteAnalisisSemanaS22",
          "pattern": "analisis-semana-s22",
          "target": [
            "TargetAnalisisSemanaS22"
          ]
        },
        {
          "name": "RouteAnalisisReparacionesPlaneadasEjecutadas",
          "pattern": "analisis-reparaciones-planeadas-ejecutadas",
          "target": [
            "TargetAnalisisReparacionesPlaneadasEjecutadas"
          ]
        },
        {
          "name": "RouteAnalisisIntegralReparaciones",
          "pattern": "analisis-integral-reparaciones",
          "target": [
            "TargetAnalisisIntegralReparaciones"
          ]
        },
        {
          "name": "RouteAnalisisSolicitudesCallCenterAtendidas",
          "pattern": "analisis-solicitudes-call-center-atendidas",
          "target": [
            "TargetAnalisisSolicitudesCallCenterAtendidas"
          ]
        },
        {
          "name": "RouteBalanceOperativoZona",
          "pattern": "balance-operativo-zona",
          "target": [
            "TargetBalanceOperativoZona"
          ]
        },
        {
          "name": "RouteDetalleOperativoZonaSur",
          "pattern": "detalle-operativo-zona-sur",
          "target": [
            "TargetDetalleOperativoZonaSur"
          ]
        }
      ],
      "targets": {
        "TargetAnalisisFallas": {
          "viewType": "XML",
          "viewId": "AnalisisFallas",
          "viewName": "AnalisisFallas"
        },
        "TargetMantenimiento": {
          "viewType": "XML",
          "viewId": "Mantenimiento",
          "viewName": "Mantenimiento"
        },
        "TargetMantenimientoEjecutivo": {
          "viewType": "XML",
          "viewId": "MantenimientoEjecutivo",
          "viewName": "MantenimientoEjecutivo"
        },
        "TargetMantenimientoDetalle": {
          "viewType": "XML",
          "viewId": "MantenimientoDetalle",
          "viewName": "MantenimientoDetalle"
        },
        "TargetCausasZona": {
          "viewType": "XML",
          "viewId": "CausasZona",
          "viewName": "CausasZona"
        },
        "TargetComportamientoOperativo": {
          "viewType": "XML",
          "viewId": "ComportamientoOperativo",
          "viewName": "ComportamientoOperativo"
        },
        "TargetHorasTrabajadas": {
          "viewType": "XML",
          "viewId": "HorasTrabajadas",
          "viewName": "HorasTrabajadas"
        },
        "TargetConsumoMateriales": {
          "viewType": "XML",
          "viewId": "ConsumoMateriales",
          "viewName": "ConsumoMateriales"
        },
        "TargetConsumoRealVsPlanCategoria": {
          "viewType": "XML",
          "viewId": "ConsumoRealVsPlanCategoria",
          "viewName": "ConsumoRealVsPlanCategoria"
        },
        "TargetDetalleResponsable": {
          "viewType": "XML",
          "viewId": "DetalleResponsable",
          "viewName": "DetalleResponsable"
        },
        "TargetAnalisisElevadores": {
          "viewType": "XML",
          "viewId": "AnalisisElevadores",
          "viewName": "AnalisisElevadores"
        },
        "TargetAnalisisSemanaS22": {
          "viewType": "XML",
          "viewId": "AnalisisSemanaS22",
          "viewName": "AnalisisSemanaS22"
        },
        "TargetAnalisisReparacionesPlaneadasEjecutadas": {
          "viewType": "XML",
          "viewId": "AnalisisReparacionesPlaneadasEjecutadas",
          "viewName": "AnalisisReparacionesPlaneadasEjecutadas"
        },
        "TargetAnalisisIntegralReparaciones": {
          "viewType": "XML",
          "viewId": "AnalisisIntegralReparaciones",
          "viewName": "AnalisisIntegralReparaciones"
        },
        "TargetAnalisisSolicitudesCallCenterAtendidas": {
          "viewType": "XML",
          "viewId": "AnalisisSolicitudesCallCenterAtendidas",
          "viewName": "AnalisisSolicitudesCallCenterAtendidas"
        },
        "TargetBalanceOperativoZona": {
          "viewType": "XML",
          "viewId": "BalanceOperativoZona",
          "viewName": "BalanceOperativoZona"
        },
        "TargetDetalleOperativoZonaSur": {
          "viewType": "XML",
          "viewId": "DetalleOperativoZonaSur",
          "viewName": "DetalleOperativoZonaSur"
        }
      }
    },
    "rootView": {
      "viewName": "mantenimiento.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}