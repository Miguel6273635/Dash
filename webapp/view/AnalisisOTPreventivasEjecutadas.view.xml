<mvc:View
    controllerName="mantenimiento.controller.AnalisisOTPreventivasEjecutadas"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%"
    class="otpEjView">

    <Page
        id="analisisOTPreventivasEjecutadasPage"
        showHeader="false"
        enableScrolling="true"
        class="otpEjPage sapUiSizeCompact">

        <content>

            <VBox
                width="100%"
                height="100%"
                fitContainer="true"
                class="otpEjPageContainer">

                <!-- =====================================================
                     HEADER
                     ===================================================== -->

                <VBox
                    width="100%"
                    class="otpEjHeader">

                    <HBox
                        width="100%"
                        alignItems="Center"
                        wrap="Wrap"
                        class="otpEjTitleRow">

                        <Title
                            text="Análisis de OT Preventivas"
                            level="H1"
                            class="otpEjTitle"/>

                        <Title
                            text="Ejecutadas"
                            level="H1"
                            class="otpEjTitleGreen"/>

                    </HBox>

                    <HBox
                        width="100%"
                        alignItems="Center"
                        wrap="Wrap"
                        class="otpEjBreadcrumb">

                        <Link
                            text="Órdenes"
                            class="otpEjBreadLink"/>

                        <core:Icon
                            src="sap-icon://navigation-right-arrow"
                            class="otpEjBreadIcon"/>

                        <Link
                            text="Composición de órdenes del periodo"
                            class="otpEjBreadLink"/>

                        <core:Icon
                            src="sap-icon://navigation-right-arrow"
                            class="otpEjBreadIcon"/>

                        <Text
                            text="Preventivas"
                            class="otpEjBreadText"/>

                    </HBox>

                </VBox>

                <!-- =====================================================
                     FILTROS
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    class="otpEjFilters">

                    <!-- PERIODO -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Periodo"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/periodo}"
                            change=".onPeriodoChange"
                            items="{otpe>/catalogos/periodos}"
                            class="otpEjFilterControl">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>

                    <!-- FECHA DESDE -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Fecha desde"
                            class="otpEjFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{otpe>/filters/fechaDesde}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            class="otpEjFilterControl"/>

                    </VBox>

                    <!-- FECHA HASTA -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Fecha hasta"
                            class="otpEjFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{otpe>/filters/fechaHasta}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            class="otpEjFilterControl"/>

                    </VBox>

                    <!-- ZONA -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Zona"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/zona}"
                            items="{otpe>/catalogos/zonas}"
                            class="otpEjFilterControl">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>

                    <!-- CLIENTE -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Cliente"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/cliente}"
                            items="{otpe>/catalogos/clientes}"
                            class="otpEjFilterControl">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>

                    <!-- RESPONSABLE -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Responsable"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/responsable}"
                            items="{otpe>/catalogos/responsables}"
                            class="otpEjFilterControl">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>

                    <!-- APLICAR -->

                    <Button
                        text="Aplicar filtros"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press=".onApplyFilters"
                        class="otpEjApplyBtn"/>

                </HBox>

                <!-- =====================================================
                     KPIS
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    class="otpEjKpiGrid">

                    <!-- PLANEADAS -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiBlue">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://appointment-2"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/planeadas}"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="Planeadas"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="Órdenes del periodo"
                                class="otpEjKpiSubLabel"/>

                        </VBox>

                    </HBox>

                    <!-- EJECUTADAS -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiGreen">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://sys-enter-2"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/ejecutadas}"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="Ejecutadas"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="Órdenes completadas"
                                class="otpEjKpiSubLabel"/>

                        </VBox>

                    </HBox>

                    <!-- NO EJECUTADAS -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiRed">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://decline"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/noEjecutadas}"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="No ejecutadas"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="Órdenes pendientes"
                                class="otpEjKpiSubLabel otpEjKpiSubRed"/>

                        </VBox>

                    </HBox>

                    <!-- CUMPLIMIENTO -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiPurple">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://target-group"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/cumplimiento}"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="Cumplimiento"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="Del total planeado"
                                class="otpEjKpiSubLabel"/>

                        </VBox>

                    </HBox>

                </HBox>

                <!-- =====================================================
                     SELECTOR
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="otpEjToolbar">

                    <HBox
                        alignItems="Center"
                        class="otpEjTabs">

                        <Text
                            text="Ver análisis por:"
                            class="otpEjTabsLabel"/>

                        <Button
                            text="{= 'No ejecutadas (' + ${otpe>/kpis/noEjecutadas} + ')' }"
                            type="{= ${otpe>/ui/selectedAnalysis} === 'NO_EJECUTADAS' ? 'Emphasized' : 'Default'}"
                            press=".onSelectNoEjecutadas"
                            class="otpEjTabBtn"/>

                        <Button
                            text="{= 'Ejecutadas (' + ${otpe>/kpis/ejecutadas} + ')' }"
                            type="{= ${otpe>/ui/selectedAnalysis} === 'EJECUTADAS' ? 'Emphasized' : 'Default'}"
                            press=".onSelectEjecutadas"
                            class="otpEjTabBtn"/>

                        <Button
                            text="{= 'Todas (' + ${otpe>/kpis/planeadas} + ')' }"
                            type="{= ${otpe>/ui/selectedAnalysis} === 'TODAS' ? 'Emphasized' : 'Default'}"
                            press=".onSelectTodas"
                            class="otpEjTabBtn"/>

                    </HBox>

                    <HBox
                        alignItems="Center"
                        class="otpEjInfoBox">

                        <core:Icon
                            src="sap-icon://hint"
                            class="otpEjInfoIcon"/>

                        <Text
                            text="{otpe>/infoMessage}"
                            wrapping="false"
                            class="otpEjInfoText"/>

                    </HBox>

                </HBox>

                <!-- =====================================================
                     CARD TABLA
                     ===================================================== -->

                <VBox
                    width="100%"
                    height="100%"
                    fitContainer="true"
                    class="otpEjTableCard">

                    <!-- CABECERA -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="otpEjTableTop">

                        <Title
                            text="Ejecución de OT Preventivas"
                            level="H2"
                            class="otpEjTableTitle"/>

                        <SearchField
                            width="100%"
                            placeholder="Buscar responsable..."
                            liveChange=".onSearchResponsable"
                            search=".onSearchResponsable"
                            class="otpEjSearch"/>

                    </HBox>

                    <!-- TABLA -->

                    <VBox
                        width="100%"
                        height="100%"
                        fitContainer="true"
                        class="otpEjTableViewport">

                        <!-- HEADER -->

                        <HBox
                            width="100%"
                            class="otpEjRespHeader">

                            <Text text=""/>

                            <Text text="Responsable"/>

                            <Text text="OT ejecutadas"/>

                            <Text text="% del total ejecutado"/>

                            <Text text="Clientes atendidos"/>

                            <Text text="Elevadores atendidos"/>

                            <Text text="Tiempo promedio ejecución"/>

                            <Text text=""/>

                        </HBox>

                        <!-- RESPONSABLES PAGINADOS -->

                        <List
                            id="otpeRespList"
                            items="{otpe>/pagedResponsables}"
                            showSeparators="None"
                            noDataText="No se encontraron responsables"
                            class="otpEjRespList">

                            <CustomListItem
                                class="otpEjRespListItem">

                                <customData>

                                    <core:CustomData
                                        key="units"
                                        value="{otpe>_pageUnits}"
                                        writeToDom="true"/>

                                    <core:CustomData
                                        key="expanded"
                                        value="{= ${otpe>expanded} ? 'true' : 'false' }"
                                        writeToDom="true"/>

                                </customData>

                                <VBox
                                    width="100%"
                                    height="100%"
                                    class="otpEjRespBlock">

                                    <!-- RESPONSABLE -->

                                    <HBox
                                        width="100%"
                                        class="otpEjRespRow">

                                        <HBox
                                            alignItems="Center"
                                            justifyContent="Center"
                                            class="otpEjRespLeadCell">

                                            <Button
                                                icon="{= ${otpe>expanded} ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-right'}"
                                                type="Transparent"
                                                press=".onToggleResponsable"
                                                class="otpEjExpandBtn"/>

                                            <core:Icon
                                                src="sap-icon://employee"
                                                class="otpEjRespIcon"/>

                                        </HBox>

                                        <Text
                                            text="{otpe>nombre}"
                                            tooltip="{otpe>nombre}"
                                            class="otpEjRespName"/>

                                        <Text
                                            text="{otpe>ot}"
                                            class="otpEjGreenStrong"/>

                                        <Text
                                            text="{otpe>pct}"
                                            class="otpEjBlueStrong"/>

                                        <Text
                                            text="{otpe>clientes}"
                                            class="otpEjStrong"/>

                                        <Text
                                            text="{otpe>elevadores}"
                                            class="otpEjStrong"/>

                                        <Text
                                            text="{otpe>tiempo}"
                                            class="otpEjGreenStrong"/>

                                        <Button
                                            icon="{= ${otpe>expanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-right'}"
                                            type="Transparent"
                                            press=".onToggleResponsable"
                                            class="otpEjRowArrowBtn"/>

                                    </HBox>

                                    <!-- DETALLE -->

                                    <VBox
                                        width="100%"
                                        visible="{otpe>expanded}"
                                        class="otpEjSubTable">

                                        <HBox
                                            width="100%"
                                            class="otpEjSubHeader">

                                            <Text text="OT"/>
                                            <Text text="Cliente"/>
                                            <Text text="Elevador"/>
                                            <Text text="Fecha ejecución"/>
                                            <Text text="Tiempo ejecución"/>

                                        </HBox>

                                        <VBox
                                            width="100%"
                                            items="{
                                                path: 'otpe>ordenes',
                                                templateShareable: false
                                            }"
                                            class="otpEjSubRows">

                                            <items>

                                                <HBox
                                                    width="100%"
                                                    class="otpEjSubRow">

                                                    <Text
                                                        text="{otpe>ot}"
                                                        class="otpEjOrderText"/>

                                                    <Text
                                                        text="{otpe>cliente}"
                                                        tooltip="{otpe>cliente}"/>

                                                    <Text
                                                        text="{otpe>elevador}"
                                                        tooltip="{otpe>elevador}"/>

                                                    <Text
                                                        text="{otpe>fecha}"/>

                                                    <Text
                                                        text="{otpe>tiempo}"/>

                                                </HBox>

                                            </items>

                                        </VBox>

                                    </VBox>

                                </VBox>

                            </CustomListItem>

                        </List>

                        <!-- TOTAL -->

                        <HBox
                            width="100%"
                            class="otpEjRespRow otpEjTotalRow">

                            <Text text=""/>

                            <Text
                                text="Total"
                                class="otpEjRespName"/>

                            <Text
                                text="{otpe>/totales/ot}"
                                class="otpEjGreenStrong"/>

                            <Text
                                text="{otpe>/totales/pct}"
                                class="otpEjBlueStrong"/>

                            <Text
                                text="{otpe>/totales/clientes}"
                                class="otpEjStrong"/>

                            <Text
                                text="{otpe>/totales/elevadores}"
                                class="otpEjStrong"/>

                            <Text
                                text="{otpe>/totales/tiempo}"
                                class="otpEjGreenStrong"/>

                            <Text text=""/>

                        </HBox>

                    </VBox>

                    <!-- FOOTER -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="otpEjTableFooter">

                        <HBox
                            alignItems="Center"
                            class="otpEjFooterNote">

                            <core:Icon
                                src="sap-icon://hint"
                                class="otpEjFooterIcon"/>

                            <Text
                                text="El tiempo promedio de ejecución corresponde al tiempo desde la fecha de inicio hasta la fecha de cierre de la OT."
                                wrapping="false"
                                class="otpEjFooterText"/>

                        </HBox>

                        <!-- PAGINACIÓN -->

                        <HBox
                            alignItems="Center"
                            visible="{= ${otpe>/pagination/totalPages} > 1 }"
                            class="otpEjPagination">

                            <Button
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                enabled="{= ${otpe>/pagination/page} > 1 }"
                                press=".onPreviousPage"
                                class="otpEjPageButton"/>

                            <Text
                                text="{= 'Página ' + ${otpe>/pagination/page} + ' de ' + ${otpe>/pagination/totalPages} }"
                                class="otpEjPageText"/>

                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                type="Transparent"
                                enabled="{= ${otpe>/pagination/page} &lt; ${otpe>/pagination/totalPages} }"
                                press=".onNextPage"
                                class="otpEjPageButton"/>

                        </HBox>

                    </HBox>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>