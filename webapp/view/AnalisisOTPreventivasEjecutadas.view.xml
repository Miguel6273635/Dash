<mvc:View
    controllerName="mantenimiento.controller.AnalisisOTPreventivasEjecutadas"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%"
    class="otpEjView">

    <Page
        id="analisisOTPreventivasEjecutadasPage"
        showHeader="false"
        enableScrolling="false"
        class="otpEjPage sapUiSizeCompact">

        <content>

            <VBox
                width="100%"
                height="100%"
                fitContainer="true"
                class="otpEjPageContainer">

                <!-- ===================================================== -->
                <!-- ENCABEZADO                                            -->
                <!-- ===================================================== -->

                <VBox
                    width="100%"
                    class="otpEjHeader">

                    <HBox
                        width="100%"
                        alignItems="Center"
                        wrap="Wrap"
                        class="otpEjTitleRow">

                        <Title
                            text="Análisis de OT Preventivas"
                            level="H1"
                            class="otpEjTitle"/>

                        <Title
                            text="Ejecutadas"
                            level="H1"
                            class="otpEjTitleGreen"/>

                    </HBox>

                    <HBox
                        width="100%"
                        alignItems="Center"
                        wrap="Wrap"
                        class="otpEjBreadcrumb">

                        <Link
                            text="Órdenes"
                            class="otpEjBreadLink"/>

                        <core:Icon
                            src="sap-icon://navigation-right-arrow"
                            class="otpEjBreadIcon"/>

                        <Link
                            text="Composición de órdenes del periodo"
                            class="otpEjBreadLink"/>

                        <core:Icon
                            src="sap-icon://navigation-right-arrow"
                            class="otpEjBreadIcon"/>

                        <Text
                            text="Preventivas"
                            class="otpEjBreadText"/>

                    </HBox>

                </VBox>


                <!-- ===================================================== -->
                <!-- FILTROS                                               -->
                <!-- ===================================================== -->

                <HBox
                    width="100%"
                    wrap="NoWrap"
                    alignItems="Stretch"
                    class="otpEjFilters">

                    <!-- PERIODO -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Periodo"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/periodo}"
                            items="{otpe>/catalogos/periodos}"
                            class="otpEjFilterControl otpEjSelect">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>


                    <!-- FECHA DESDE -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Fecha desde"
                            class="otpEjFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{otpe>/filters/fechaDesde}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            class="otpEjFilterControl otpEjDatePicker"/>

                    </VBox>


                    <!-- FECHA HASTA -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Fecha hasta"
                            class="otpEjFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{otpe>/filters/fechaHasta}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            class="otpEjFilterControl otpEjDatePicker"/>

                    </VBox>


                    <!-- ZONA -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Zona"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/zona}"
                            items="{otpe>/catalogos/zonas}"
                            class="otpEjFilterControl otpEjSelect">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>


                    <!-- CLIENTE -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Cliente"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/cliente}"
                            items="{otpe>/catalogos/clientes}"
                            class="otpEjFilterControl otpEjSelect">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>


                    <!-- RESPONSABLE -->

                    <VBox class="otpEjFilterCard">

                        <Label
                            text="Responsable"
                            class="otpEjFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{otpe>/filters/responsable}"
                            items="{otpe>/catalogos/responsables}"
                            class="otpEjFilterControl otpEjSelect">

                            <core:Item
                                key="{otpe>key}"
                                text="{otpe>text}"/>

                        </Select>

                    </VBox>


                    <!-- BOTÓN -->

                    <Button
                        text="Aplicar filtros"
                        icon="sap-icon://filter"
                        type="Emphasized"
                        press=".onApplyFilters"
                        class="otpEjApplyBtn"/>

                </HBox>


                <!-- ===================================================== -->
                <!-- KPI                                                   -->
                <!-- ===================================================== -->

                <HBox
                    width="100%"
                    wrap="NoWrap"
                    alignItems="Stretch"
                    class="otpEjKpiGrid">

                    <!-- PLANEADAS -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiBlue">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://appointment-2"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/planeadas}"
                                wrapping="false"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="Planeadas"
                                wrapping="false"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="Órdenes del periodo"
                                wrapping="false"
                                class="otpEjKpiSubLabel"/>

                        </VBox>

                    </HBox>


                    <!-- EJECUTADAS -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiGreen">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://sys-enter-2"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/ejecutadas}"
                                wrapping="false"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="Ejecutadas"
                                wrapping="false"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="95.4% del total"
                                wrapping="false"
                                class="otpEjKpiSubLabel"/>

                        </VBox>

                    </HBox>


                    <!-- NO EJECUTADAS -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiRed">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://decline"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/noEjecutadas}"
                                wrapping="false"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="No ejecutadas"
                                wrapping="false"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="4.6% del total planeado"
                                wrapping="false"
                                class="otpEjKpiSubLabel otpEjKpiSubRed"/>

                        </VBox>

                    </HBox>


                    <!-- CUMPLIMIENTO -->

                    <HBox
                        alignItems="Center"
                        class="otpEjKpiCard otpEjKpiPurple">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="otpEjKpiIconCircle">

                            <core:Icon
                                src="sap-icon://target-group"
                                class="otpEjKpiIcon"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="otpEjKpiContent">

                            <Text
                                text="{otpe>/kpis/cumplimiento}"
                                wrapping="false"
                                class="otpEjKpiNumber"/>

                            <Text
                                text="Cumplimiento"
                                wrapping="false"
                                class="otpEjKpiLabel"/>

                            <Text
                                text="248 de 260 OT"
                                wrapping="false"
                                class="otpEjKpiSubLabel"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- ===================================================== -->
                <!-- SELECTOR DE ANÁLISIS                                  -->
                <!-- ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    wrap="NoWrap"
                    class="otpEjToolbar">

                    <HBox
                        alignItems="Center"
                        wrap="NoWrap"
                        class="otpEjTabs">

                        <Text
                            text="Ver análisis por:"
                            wrapping="false"
                            class="otpEjTabsLabel"/>

                        <Button
                            text="No ejecutadas (12)"
                            type="Default"
                            press=".onSelectNoEjecutadas"
                            class="otpEjTabBtn"/>

                        <Button
                            text="Ejecutadas (248)"
                            type="Emphasized"
                            press=".onSelectEjecutadas"
                            class="otpEjTabBtn otpEjTabActive"/>

                        <Button
                            text="Todas (260)"
                            type="Default"
                            press=".onSelectTodas"
                            class="otpEjTabBtn"/>

                    </HBox>

                    <HBox
                        alignItems="Center"
                        class="otpEjInfoBox">

                        <core:Icon
                            src="sap-icon://hint"
                            class="otpEjInfoIcon"/>

                        <Text
                            text="{otpe>/infoMessage}"
                            wrapping="false"
                            class="otpEjInfoText"/>

                    </HBox>

                </HBox>


                <!-- ===================================================== -->
                <!-- CARD TABLA                                            -->
                <!-- ===================================================== -->

                <VBox
                    width="100%"
                    height="100%"
                    fitContainer="true"
                    class="otpEjTableCard">

                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>
                    </layoutData>


                    <!-- CABECERA CARD -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="otpEjTableTop">

                        <Title
                            text="Ejecución de OT Preventivas"
                            level="H2"
                            class="otpEjTableTitle"/>

                        <SearchField
                            width="100%"
                            placeholder="Buscar responsable..."
                            liveChange=".onSearchResponsable"
                            class="otpEjSearch"/>

                    </HBox>


                    <!-- CONTENIDO TABLA -->

                    <VBox
                        width="100%"
                        height="100%"
                        fitContainer="true"
                        class="otpEjTableViewport">

                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>


                        <!-- CABECERA -->

                        <HBox
                            width="100%"
                            class="otpEjRespHeader">

                            <Text text=""/>

                            <Text
                                text="Responsable"
                                class="otpEjHeaderText"/>

                            <Text
                                text="OT ejecutadas"
                                class="otpEjHeaderText"/>

                            <Text
                                text="% del total ejecutado"
                                class="otpEjHeaderText"/>

                            <Text
                                text="Clientes atendidos"
                                class="otpEjHeaderText"/>

                            <Text
                                text="Elevadores atendidos"
                                class="otpEjHeaderText"/>

                            <Text
                                text="Tiempo promedio ejecución"
                                class="otpEjHeaderText"/>

                            <Text text=""/>

                        </HBox>


                        <!-- RESPONSABLES -->

                        <VBox
                            width="100%"
                            items="{otpe>/responsables}"
                            class="otpEjRespList">

                            <items>

                                <VBox
                                    width="100%"
                                    visible="{otpe>visible}"
                                    class="otpEjRespBlock">


                                    <!-- FILA RESPONSABLE -->

                                    <HBox
                                        width="100%"
                                        class="otpEjRespRow">

                                        <HBox
                                            alignItems="Center"
                                            justifyContent="Center"
                                            class="otpEjRespLeadCell">

                                            <Button
                                                icon="{= ${otpe>expanded} ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-right'}"
                                                type="Transparent"
                                                press=".onToggleResponsable"
                                                class="otpEjExpandBtn"/>

                                            <core:Icon
                                                src="sap-icon://employee"
                                                class="otpEjRespIcon"/>

                                        </HBox>

                                        <Text
                                            text="{otpe>nombre}"
                                            wrapping="false"
                                            class="otpEjRespName"/>

                                        <Text
                                            text="{otpe>ot}"
                                            wrapping="false"
                                            class="otpEjGreenStrong"/>

                                        <Text
                                            text="{otpe>pct}"
                                            wrapping="false"
                                            class="otpEjBlueStrong"/>

                                        <Text
                                            text="{otpe>clientes}"
                                            wrapping="false"
                                            class="otpEjStrong"/>

                                        <Text
                                            text="{otpe>elevadores}"
                                            wrapping="false"
                                            class="otpEjStrong"/>

                                        <Text
                                            text="{otpe>tiempo}"
                                            wrapping="false"
                                            class="otpEjGreenStrong"/>

                                        <Button
                                            icon="{= ${otpe>expanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-right'}"
                                            type="Transparent"
                                            press=".onToggleResponsable"
                                            class="otpEjRowArrowBtn"/>

                                    </HBox>


                                    <!-- DETALLE EXPANDIDO -->

                                    <VBox
                                        width="100%"
                                        visible="{otpe>expanded}"
                                        class="otpEjSubTable">

                                        <HBox
                                            width="100%"
                                            class="otpEjSubHeader">

                                            <Text text="OT"/>

                                            <Text text="Cliente"/>

                                            <Text text="Elevador"/>

                                            <Text text="Fecha ejecución"/>

                                            <Text text="Tiempo ejecución"/>

                                        </HBox>

                                        <VBox
                                            width="100%"
                                            items="{otpe>ordenes}"
                                            class="otpEjSubRows">

                                            <items>

                                                <HBox
                                                    width="100%"
                                                    class="otpEjSubRow">

                                                    <Text
                                                        text="{otpe>ot}"
                                                        wrapping="false"
                                                        class="otpEjOrderText"/>

                                                    <Text
                                                        text="{otpe>cliente}"
                                                        wrapping="false"/>

                                                    <Text
                                                        text="{otpe>elevador}"
                                                        wrapping="false"/>

                                                    <Text
                                                        text="{otpe>fecha}"
                                                        wrapping="false"/>

                                                    <Text
                                                        text="{otpe>tiempo}"
                                                        wrapping="false"/>

                                                </HBox>

                                            </items>

                                        </VBox>

                                    </VBox>

                                </VBox>

                            </items>

                        </VBox>


                        <!-- TOTAL -->

                        <HBox
                            width="100%"
                            class="otpEjRespRow otpEjTotalRow">

                            <Text text=""/>

                            <Text
                                text="Total"
                                wrapping="false"
                                class="otpEjRespName"/>

                            <Text
                                text="{otpe>/totales/ot}"
                                wrapping="false"
                                class="otpEjGreenStrong"/>

                            <Text
                                text="{otpe>/totales/pct}"
                                wrapping="false"
                                class="otpEjBlueStrong"/>

                            <Text
                                text="{otpe>/totales/clientes}"
                                wrapping="false"
                                class="otpEjStrong"/>

                            <Text
                                text="{otpe>/totales/elevadores}"
                                wrapping="false"
                                class="otpEjStrong"/>

                            <Text
                                text="{otpe>/totales/tiempo}"
                                wrapping="false"
                                class="otpEjGreenStrong"/>

                            <Text text=""/>

                        </HBox>

                    </VBox>


                    <!-- PIE -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        class="otpEjTableFooter">

                        <core:Icon
                            src="sap-icon://hint"
                            class="otpEjFooterIcon"/>

                        <Text
                            text="El tiempo promedio de ejecución corresponde al tiempo desde la fecha de inicio hasta la fecha de cierre de la OT."
                            wrapping="false"
                            class="otpEjFooterText"/>

                    </HBox>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>