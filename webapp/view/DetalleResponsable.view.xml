<mvc:View
    controllerName="mantenimiento.controller.DetalleResponsable"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:l="sap.ui.layout"
    xmlns:mc="sap.suite.ui.microchart"
    xmlns:core="sap.ui.core"
    height="100%">

    <Page
        id="pageDetalle"
        showHeader="false"
        backgroundDesign="Solid"
        class="detalleResponsablePage">

        <content>

            <VBox class="detalleResponsableWrapper">

                <!-- ENCABEZADO + FILTROS -->
                <HBox
                    class="detalleHeader"
                    justifyContent="SpaceBetween"
                    alignItems="Start"
                    wrap="Wrap">

                    <!-- TÍTULO -->
                    <VBox class="detalleHeaderTitle">
                        <Title
                            text="Detalle del responsable"
                            level="H1"
                            class="detalleTitle" />

                        <Text
                            text="Consulta el resumen operativo y contexto del responsable seleccionado."
                            class="detalleSubtitle" />
                    </VBox>

                <!-- FILTROS -->
<HBox
    class="detalleFilters"
    alignItems="Center"
    wrap="NoWrap">

    <!-- Semana -->
    <HBox
        class="detalleFilterCard detalleFilterCardSemana"
        alignItems="Center">

        <VBox
            class="detalleFilterIconBox"
            alignItems="Center"
            justifyContent="Center">
            <core:Icon
                src="sap-icon://appointment-2"
                class="detalleFilterIcon" />
        </VBox>

        <VBox class="detalleFilterTextBox">
            <Text
                text="Semana"
                class="detalleFilterCardLabel" />

            <Select
                width="170px"
                selectedKey="18"
                class="detalleSelectCard">
                <core:Item
                    key="18"
                    text="Semana 18 (29 abr - 5 may 2024)" />
                <core:Item
                    key="17"
                    text="Semana 17" />
            </Select>
        </VBox>
    </HBox>

    <!-- Zona -->
    <HBox
        class="detalleFilterCard detalleFilterCardZona"
        alignItems="Center">

        <VBox
            class="detalleFilterIconBox"
            alignItems="Center"
            justifyContent="Center">
            <core:Icon
                src="sap-icon://map"
                class="detalleFilterIcon" />
        </VBox>

        <VBox class="detalleFilterTextBox">
            <Text
                text="Zona"
                class="detalleFilterCardLabel" />

            <Select
                width="70px"
                selectedKey="norte"
                class="detalleSelectCard">
                <core:Item
                    key="norte"
                    text="Norte" />
                <core:Item
                    key="sur"
                    text="Sur" />
                <core:Item
                    key="todas"
                    text="Todas" />
            </Select>
        </VBox>
    </HBox>

    <!-- Botón aplicar -->
    <Button
        text="Aplicar filtros"
        icon="sap-icon://filter"
        type="Emphasized"
        press=".onApplyFilters"
        class="detalleApplyButton" />

</HBox>
                </HBox>

                <!-- BLOQUE RESPONSABLE -->
                <HBox
                    class="responsableBlock"
                    alignItems="Center">

                    <f:Avatar
                        displaySize="S"
                        src="sap-icon://person-placeholder"
                        class="responsableAvatar" />

                    <VBox class="responsableInfo">
                        <Title
                            text="{detail>/responsable}"
                            level="H3"
                            class="responsableName" />

                        <Text
                            text="Zona: {detail>/zona}  |  Semana: 18 (29 abr - 5 may 2024)  |  Origen activo: Todas"
                            class="responsableMeta" />
                    </VBox>
                </HBox>

                <!-- KPIs -->
                <l:Grid
                    defaultSpan="L3 M6 S12"
                    class="detalleKpiGrid">

                    <!-- KPI 1 -->
                    <f:Card class="detalleKpiCard kpiCardPurple">
                        <f:content>
                            <HBox
                                class="detalleKpiContent"
                                alignItems="Center">

                                <VBox
                                    class="detalleKpiIconBox"
                                    alignItems="Center"
                                    justifyContent="Center">
                                    <core:Icon
                                        src="sap-icon://order-status"
                                        class="detalleKpiIcon" />
                                </VBox>

                                <VBox class="detalleKpiTextBox">
                                    <Text
                                        text="OT desviadas"
                                        class="detalleKpiLabel" />

                                    <Text
                                        text="{detail>/kpi/otDesviadas}"
                                        class="detalleKpiNumber" />

                                    <Text
                                        text="Del total de desviaciones"
                                        class="detalleKpiCaption" />
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                    <!-- KPI 2 -->
                    <f:Card class="detalleKpiCard kpiCardGreen">
                        <f:content>
                            <HBox
                                class="detalleKpiContent"
                                alignItems="Center">

                                <VBox
                                    class="detalleKpiIconBox"
                                    alignItems="Center"
                                    justifyContent="Center">
                                    <core:Icon
                                        src="sap-icon://machine"
                                        class="detalleKpiIcon" />
                                </VBox>

                                <VBox class="detalleKpiTextBox">
                                    <Text
                                        text="Equipos afectados"
                                        class="detalleKpiLabel" />

                                    <Text
                                        text="{detail>/kpi/equiposAfectados}"
                                        class="detalleKpiNumber" />

                                    <Text
                                        text="Equipos únicos"
                                        class="detalleKpiCaption" />
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                    <!-- KPI 3 -->
                    <f:Card class="detalleKpiCard kpiCardOrange">
                        <f:content>
                            <HBox
                                class="detalleKpiContent"
                                alignItems="Center">

                                <VBox
                                    class="detalleKpiIconBox"
                                    alignItems="Center"
                                    justifyContent="Center">
                                    <core:Icon
                                        src="sap-icon://customer-and-contacts"
                                        class="detalleKpiIcon" />
                                </VBox>

                                <VBox class="detalleKpiTextBox">
                                    <Text
                                        text="Clientes afectados"
                                        class="detalleKpiLabel" />

                                    <Text
                                        text="{detail>/kpi/clientesAfectados}"
                                        class="detalleKpiNumber" />

                                    <Text
                                        text="Clientes únicos"
                                        class="detalleKpiCaption" />
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                    <!-- KPI 4 -->
                    <f:Card class="detalleKpiCard kpiCardBlue">
                        <f:content>
                            <HBox
                                class="detalleKpiContent"
                                alignItems="Center">

                                <mc:RadialMicroChart
                                    percentage="{detail>/kpi/cumplimiento}"
                                    size="M"
                                    valueColor="Neutral"
                                    class="detalleRadialChart" />

                                <VBox class="detalleKpiTextBox">
                                    <Text
                                        text="Cumplimiento operativo"
                                        class="detalleKpiLabel" />

                                    <Text
                                        text="{detail>/kpi/cumplimiento}%"
                                        class="detalleKpiNumber" />

                                    <Text
                                        text="Del total de sus OT"
                                        class="detalleKpiCaption" />
                                </VBox>
                            </HBox>
                        </f:content>
                    </f:Card>

                </l:Grid>

                <!-- TABLA PRINCIPAL -->
                <f:Card class="detalleTableCard">
                    <f:content>

                        <VBox class="detalleTableContent">

                            <!-- Título tabla -->
                            <HBox
                                class="detalleTableHeader"
                                alignItems="Center">

                                <VBox
                                    class="detalleTableIconBox"
                                    alignItems="Center"
                                    justifyContent="Center">
                                    <core:Icon
                                        src="sap-icon://task"
                                        class="detalleTableIcon" />
                                </VBox>

                                <Title
                                    text="ÓRDENES DE TRABAJO QUE EXPLICAN LA DESVIACIÓN"
                                    level="H4"
                                    class="detalleTableTitle" />
                            </HBox>

                            <!-- Tabla -->
                            <Table
                                id="tablaOrdenesDesviadas"
                                items="{path: 'detail>/desglose'}"
                                class="detalleOrdersTable"
                                mode="None"
                                growing="false">

                                <columns>
                                    <Column width="12%">
                                        <Text
                                            text="OT"
                                            class="detalleColumnText" />
                                    </Column>

                                    <Column width="12%">
                                        <Text
                                            text="Equipo"
                                            class="detalleColumnText" />
                                    </Column>

                                    <Column width="17%">
                                        <Text
                                            text="Cliente"
                                            class="detalleColumnText" />
                                    </Column>

                                    <Column
                                        width="13%"
                                        hAlign="Center">
                                        <Text
                                            text="Tipo OT"
                                            class="detalleColumnText" />
                                    </Column>

                                    <Column width="20%">
                                        <Text
                                            text="Causa principal"
                                            class="detalleColumnText" />
                                    </Column>

                                    <Column
                                        width="12%"
                                        hAlign="Center">
                                        <HBox
                                            alignItems="Center"
                                            justifyContent="Center">
                                            <Text
                                                text="Días de atraso"
                                                class="detalleColumnText" />

                                            <core:Icon
                                                src="sap-icon://hint"
                                                class="detalleInfoIcon" />
                                        </HBox>
                                    </Column>

                                    <Column
                                        width="14%"
                                        hAlign="Center">
                                        <Text
                                            text="Estado"
                                            class="detalleColumnText" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem class="detalleTableRow">
                                        <cells>

                                            <!-- OT con icono externo -->
                                            <HBox alignItems="Center">
                                                <Link
                                                    text="{detail>ot}"
                                                    press=".onNavToOrder"
                                                    class="detalleOrderLink" />

                                                <core:Icon
                                                    src="sap-icon://action"
                                                    class="detalleOrderActionIcon" />
                                            </HBox>

                                            <Text
                                                text="{detail>equipo}"
                                                class="detalleCellText" />

                                            <Text
                                                text="{detail>cliente}"
                                                class="detalleCellText" />

                                            <!-- Badge Tipo OT -->
                                            <HBox
                                                class="badgeWrapper badgeTipo"
                                                justifyContent="Center"
                                                alignItems="Center">
                                                <customData>
                                                    <core:CustomData
                                                        key="tipo"
                                                        value="{detail>tipoOt}"
                                                        writeToDom="true" />
                                                </customData>

                                                <Text
                                                    text="{detail>tipoOt}"
                                                    wrapping="false"
                                                    class="badgeText" />
                                            </HBox>

                                            <Text
                                                text="{detail>causa}"
                                                class="detalleCellText" />

                                            <Text
                                                text="{detail>retraso}"
                                                class="detalleDelayText" />

                                            <!-- Badge Estado -->
                                            <HBox
                                                class="badgeWrapper badgeEstado"
                                                justifyContent="Center"
                                                alignItems="Center">
                                                <customData>
                                                    <core:CustomData
                                                        key="estado"
                                                        value="{detail>estado}"
                                                        writeToDom="true" />
                                                </customData>

                                                <Text
                                                    text="{detail>estado}"
                                                    wrapping="false"
                                                    class="badgeText" />
                                            </HBox>

                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <!-- Footer tabla -->
                            <HBox
                                class="detalleTableFooter"
                                justifyContent="SpaceBetween"
                                alignItems="Center">

                                <Text
                                    text="Mostrando 1 a 6 de 6 OT desviadas"
                                    class="detalleTableFooterText" />

                                <Select
                                    selectedKey="10"
                                    width="120px"
                                    class="detallePageSizeSelect">
                                    <core:Item
                                        key="10"
                                        text="10 por página" />
                                    <core:Item
                                        key="20"
                                        text="20 por página" />
                                    <core:Item
                                        key="50"
                                        text="50 por página" />
                                </Select>
                            </HBox>

                        </VBox>

                    </f:content>
                </f:Card>

            </VBox>

        </content>
    </Page>
</mvc:View>