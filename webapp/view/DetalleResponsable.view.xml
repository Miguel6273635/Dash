<mvc:View
    controllerName="mantenimiento.controller.DetalleResponsable"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    height="100%"
    displayBlock="true">

    <Page
        id="pageDetalle"
        showHeader="false"
        enableScrolling="false"
        class="detalleResponsablePage">

        <content>

            <VBox
                width="100%"
                height="100%"
                fitContainer="true"
                class="detalleResponsableWrapper sapUiSizeCompact">


                <!-- =====================================================
                     ENCABEZADO
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="End"
                    justifyContent="SpaceBetween"
                    wrap="NoWrap"
                    class="detalleHeader">

                    <!-- TÍTULO -->

                    <VBox
                        class="detalleHeaderTitle">

                        <Button
                            text="Volver a responsables"
                            icon="sap-icon://nav-back"
                            type="Transparent"
                            press=".onNavBack"
                            class="detalleBackButton"/>

                        <Title
                            text="Detalle del responsable"
                            level="H1"
                            class="detalleTitle"/>

                        <Text
                            text="Consulta el resumen operativo y el contexto del responsable seleccionado."
                            wrapping="false"
                            class="detalleSubtitle"/>

                    </VBox>


                    <!-- =================================================
                         FILTROS
                         ================================================= -->

                    <HBox
                        alignItems="Center"
                        wrap="NoWrap"
                        class="detalleFilters">

                        <!-- PERIODO -->

                        <HBox
                            alignItems="Center"
                            class="detalleFilterCard detalleFilterCardPeriodo">

                            <core:Icon
                                src="sap-icon://calendar"
                                class="detalleFilterIcon"/>

                            <VBox
                                width="100%"
                                class="detalleFilterTexts">

                                <Text
                                    text="Periodo"
                                    class="detalleFilterLabel"/>

                                <Select
                                    id="detallePeriodo"
                                    width="100%"
                                    selectedKey="{detail>/filtros/periodKey}"
                                    class="detalleFilterSelect"
                                    items="{detail>/opcionesPeriodo}">

                                    <core:Item
                                        key="{detail>key}"
                                        text="{detail>text}"/>

                                </Select>

                            </VBox>

                        </HBox>


                        <!-- ZONA -->

                        <HBox
                            alignItems="Center"
                            class="detalleFilterCard detalleFilterCardZona">

                            <core:Icon
                                src="sap-icon://map"
                                class="detalleFilterIcon"/>

                            <VBox
                                width="100%"
                                class="detalleFilterTexts">

                                <Text
                                    text="Zona"
                                    class="detalleFilterLabel"/>

                                <Select
                                    id="selectZona"
                                    width="100%"
                                    selectedKey="{detail>/filtros/zonaKey}"
                                    class="detalleFilterSelect"
                                    items="{detail>/opcionesZona}">

                                    <core:Item
                                        key="{detail>key}"
                                        text="{detail>text}"/>

                                </Select>

                            </VBox>

                        </HBox>


                        <!-- BOTÓN -->

                        <VBox
                            justifyContent="Center"
                            class="detalleApplyButtonBox">

                            <Button
                                text="Aplicar filtros"
                                icon="sap-icon://filter"
                                type="Emphasized"
                                width="100%"
                                press=".onApplyFilters"
                                class="detalleApplyButton"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- =====================================================
                     RESPONSABLE
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    class="responsableBlock">

                    <Avatar
                        displaySize="M"
                        icon="sap-icon://person-placeholder"
                        class="responsableAvatar"/>

                    <VBox
                        width="100%"
                        class="responsableInfo">

                        <Title
                            text="{detail>/responsable}"
                            level="H3"
                            class="responsableName"/>

                        <Text
                            text="{= 'Zona: ' + ${detail>/zona} + '  |  Periodo: ' + ${detail>/semana} + '  |  Origen activo: ' + ${detail>/origenActivo}}"
                            wrapping="false"
                            class="responsableMeta"/>

                    </VBox>

                </HBox>


                <!-- =====================================================
                     KPIS
                     MISMA SECUENCIA VISUAL:
                     AZUL / VERDE / ROJO / MORADO
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="detalleKpiRow">


                    <!-- KPI 1 - AZUL -->

                    <HBox
                        alignItems="Center"
                        class="detalleKpiCard detalleKpiBlue">

                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="detalleKpiIconCircle">

                            <core:Icon
                                src="sap-icon://order-status"
                                class="detalleKpiIcon"/>

                        </HBox>

                        <VBox
                            class="detalleKpiTextBox">

                            <Text
                                text="OT desviadas"
                                class="detalleKpiLabel"/>

                            <Text
                                text="{detail>/kpi/otDesviadas}"
                                class="detalleKpiNumber"/>

                            <Text
                                text="Del total de desviaciones"
                                class="detalleKpiCaption"/>

                        </VBox>

                    </HBox>


                    <!-- KPI 2 - VERDE -->

                    <HBox
                        alignItems="Center"
                        class="detalleKpiCard detalleKpiGreen">

                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="detalleKpiIconCircle">

                            <core:Icon
                                src="sap-icon://machine"
                                class="detalleKpiIcon"/>

                        </HBox>

                        <VBox
                            class="detalleKpiTextBox">

                            <Text
                                text="Equipos afectados"
                                class="detalleKpiLabel"/>

                            <Text
                                text="{detail>/kpi/equiposAfectados}"
                                class="detalleKpiNumber"/>

                            <Text
                                text="Equipos únicos"
                                class="detalleKpiCaption"/>

                        </VBox>

                    </HBox>


                    <!-- KPI 3 - ROJO -->

                    <HBox
                        alignItems="Center"
                        class="detalleKpiCard detalleKpiRed">

                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="detalleKpiIconCircle">

                            <core:Icon
                                src="sap-icon://customer-and-contacts"
                                class="detalleKpiIcon"/>

                        </HBox>

                        <VBox
                            class="detalleKpiTextBox">

                            <Text
                                text="Clientes afectados"
                                class="detalleKpiLabel"/>

                            <Text
                                text="{detail>/kpi/clientesAfectados}"
                                class="detalleKpiNumber"/>

                            <Text
                                text="Clientes únicos"
                                class="detalleKpiCaption"/>

                        </VBox>

                    </HBox>


                    <!-- KPI 4 - MORADO -->

                    <HBox
                        alignItems="Center"
                        class="detalleKpiCard detalleKpiPurple">

                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>

                        <HBox
                            id="cumplimientoChart"
                            alignItems="Center"
                            justifyContent="Center"
                            class="detalleComplianceDonut">

                            <Text
                                text="{detail>/kpi/cumplimiento}%"
                                class="detalleComplianceDonutText"/>

                        </HBox>

                        <VBox
                            class="detalleKpiTextBox">

                            <Text
                                text="Cumplimiento operativo"
                                class="detalleKpiLabel"/>

                            <Text
                                text="{detail>/kpi/cumplimiento}%"
                                class="detalleKpiNumber"/>

                            <Text
                                text="{= ${detail>/kpi/otEjecutadas} + ' ejecutadas de ' + ${detail>/kpi/otPlaneadas}}"
                                class="detalleKpiCaption"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- =====================================================
                     TABLA
                     ===================================================== -->

                <VBox
                    id="detalleTableCard"
                    width="100%"
                    height="100%"
                    fitContainer="true"
                    class="detalleTableCard">

                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>
                    </layoutData>


                    <Title
                        text="Órdenes de trabajo que explican la desviación"
                        level="H4"
                        class="detalleTableTitle"/>


                    <!-- ÁREA DISPONIBLE -->

                    <VBox
                        id="detalleTableArea"
                        width="100%"
                        height="100%"
                        fitContainer="true"
                        class="detalleTableWrapper">

                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>

                        <Table
                            id="tablaOrdenesDesviadas"
                            width="100%"
                            inset="false"
                            fixedLayout="true"
                            growing="false"
                            mode="None"
                            showSeparators="Inner"
                            noDataText="No existen órdenes desviadas"
                            items="{
                                path: 'detail>/desgloseVisibles',
                                templateShareable: false
                            }"
                            class="detalleOrdersTable">

                            <columns>

                                <Column width="13%">
                                    <Text
                                        text="OT"
                                        class="detalleColumnText"/>
                                </Column>

                                <Column width="13%">
                                    <Text
                                        text="Equipo"
                                        class="detalleColumnText"/>
                                </Column>

                                <Column width="18%">
                                    <Text
                                        text="Cliente"
                                        class="detalleColumnText"/>
                                </Column>

                                <Column
                                    width="13%"
                                    hAlign="Center">

                                    <Text
                                        text="Tipo OT"
                                        class="detalleColumnText"/>

                                </Column>

                                <Column width="19%">
                                    <Text
                                        text="Causa principal"
                                        class="detalleColumnText"/>
                                </Column>

                                <Column
                                    width="12%"
                                    hAlign="Center">

                                    <Text
                                        text="Días de atraso"
                                        class="detalleColumnText"/>

                                </Column>

                                <Column
                                    width="12%"
                                    hAlign="Center">

                                    <Text
                                        text="Estado"
                                        class="detalleColumnText"/>

                                </Column>

                            </columns>


                            <items>

                                <ColumnListItem
                                    vAlign="Middle"
                                    type="Inactive"
                                    class="detalleTableRow">

                                    <cells>

                                        <Link
                                            text="{detail>ot}"
                                            press=".onNavToOrder"
                                            class="detalleOrderLink"/>

                                        <Text
                                            text="{detail>equipo}"
                                            wrapping="false"
                                            tooltip="{detail>equipo}"
                                            class="detalleCellText"/>

                                        <Text
                                            text="{detail>cliente}"
                                            wrapping="false"
                                            tooltip="{detail>cliente}"
                                            class="detalleCellText"/>

                                        <HBox
                                            width="100%"
                                            justifyContent="Center">

                                            <Text
                                                text="{detail>tipoOt}"
                                                class="detalleTypeBadge"/>

                                        </HBox>

                                        <Text
                                            text="{detail>causa}"
                                            wrapping="false"
                                            tooltip="{detail>causa}"
                                            class="detalleCellText"/>

                                        <Text
                                            text="{detail>retraso}"
                                            width="100%"
                                            textAlign="Center"
                                            class="detalleDelayText"/>

                                        <HBox
                                            width="100%"
                                            justifyContent="Center">

                                            <Text
                                                text="{detail>estado}"
                                                class="detalleStatusBadge">

                                                <customData>

                                                    <core:CustomData
                                                        key="estado"
                                                        value="{detail>estado}"
                                                        writeToDom="true"/>

                                                </customData>

                                            </Text>

                                        </HBox>

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>


                    <!-- =================================================
                         PAGINACIÓN
                         ================================================= -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="detalleTableFooter">

                        <Text
                            text="{detail>/paginacion/texto}"
                            class="detalleTableFooterText"/>

                        <HBox
                            alignItems="Center"
                            visible="{= ${detail>/paginacion/totalPages} > 1 }"
                            class="detallePaginationActions">

                            <Button
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                tooltip="Página anterior"
                                enabled="{detail>/paginacion/hasPrevious}"
                                press=".onPreviousPage"
                                class="detallePageButton"/>

                            <Text
                                text="{= 'Página ' + ${detail>/paginacion/page} + ' de ' + ${detail>/paginacion/totalPages}}"
                                class="detallePageText"/>

                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                type="Transparent"
                                tooltip="Página siguiente"
                                enabled="{detail>/paginacion/hasNext}"
                                press=".onNextPage"
                                class="detallePageButton"/>

                        </HBox>

                    </HBox>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>