<mvc:View
    controllerName="mantenimiento.controller.AnalisisSemanaS22"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    height="100%"
    displayBlock="true">

    <Page
        showHeader="false"
        enableScrolling="true"
        class="analisisS22View analisisGeneralPage">

        <VBox
            width="100%"
            height="100%"
            class="analisisGeneralRoot">

            <!-- =====================================================
                 HEADER
                 ===================================================== -->

            <FlexBox
                width="100%"
                class="analisisGeneralHeader"
                justifyContent="SpaceBetween"
                alignItems="Center"
                wrap="NoWrap">

                <VBox
                    class="analisisGeneralHeaderText">

                    <Title
                        text="Análisis General"
                        level="H1"
                        class="analisisGeneralTitle"/>

                    <Text
                        text="Detalle de OT no ejecutadas que explican la brecha de cumplimiento en la semana seleccionada."
                        wrapping="false"
                        class="analisisGeneralSubtitle"/>

                </VBox>


                <!-- =================================================
                     FILTROS
                     ================================================= -->

                <FlexBox
                    class="analisisGeneralFilters"
                    alignItems="Center"
                    justifyContent="End"
                    wrap="NoWrap">

                    <!-- SEMANA -->

                    <HBox
                        class="analisisFilterCard analisisFilterCardWeek"
                        alignItems="Center">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="analisisFilterIcon"/>

                        <VBox
                            class="analisisFilterContent">

                            <Label
                                text="Semana"
                                class="analisisFilterLabel"/>

                            <Select
                                id="idSemanaSelect"
                                selectedKey="{otModel>/filters/week}"
                                items="{otModel>/weekOptions}"
                                width="100%"
                                class="analisisFilterSelect">

                                <items>

                                    <core:Item
                                        key="{otModel>key}"
                                        text="{otModel>text}"/>

                                </items>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- ZONA -->

                    <HBox
                        class="analisisFilterCard analisisFilterCardZone"
                        alignItems="Center">

                        <core:Icon
                            src="sap-icon://map-2"
                            class="analisisFilterIcon"/>

                        <VBox
                            class="analisisFilterContent">

                            <Label
                                text="Zona"
                                class="analisisFilterLabel"/>

                            <Select
                                id="idZonaSelect"
                                selectedKey="{otModel>/filters/zone}"
                                items="{otModel>/zoneOptions}"
                                width="100%"
                                class="analisisFilterSelect">

                                <items>

                                    <core:Item
                                        key="{otModel>key}"
                                        text="{otModel>text}"/>

                                </items>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- APLICAR -->

                    <VBox
                        class="analisisApplyButtonBox"
                        justifyContent="Center">

                        <Button
                            id="idAplicarFiltrosButton"
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            width="100%"
                            press=".onApplyFilters"
                            class="analisisApplyFilterButton"/>

                    </VBox>

                </FlexBox>

            </FlexBox>


            <!-- =====================================================
                 CONTEXTO DE LA SEMANA
                 ===================================================== -->

            <VBox
                width="100%"
                class="analisisContextSection">

                <Title
                    text="CONTEXTO DE LA SEMANA"
                    level="H4"
                    class="analisisSectionTitle"/>


                <!-- =================================================
                     KPIs PRINCIPALES
                     ================================================= -->

                <FlexBox
                    width="100%"
                    class="analisisMainKpiRow"
                    justifyContent="SpaceBetween"
                    alignItems="Stretch"
                    wrap="NoWrap">


                    <!-- PLANEADAS -->

                    <HBox
                        class="analisisMainKpiCard analisisMainKpiBlue"
                        alignItems="Center">

                        <VBox
                            class="analisisMainKpiIcon analisisMainKpiIconBlue"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://form"
                                class="analisisMainKpiIconSymbol"/>

                        </VBox>

                        <VBox
                            class="analisisMainKpiContent"
                            justifyContent="Center">

                            <Text
                                text="OT planeadas"
                                wrapping="false"
                                class="analisisMainKpiLabel"/>

                            <Text
                                text="{otModel>/summary/plannedOrders}"
                                wrapping="false"
                                class="analisisMainKpiValue analisisValueBlue"/>

                            <Text
                                text="Total de OT"
                                wrapping="false"
                                class="analisisMainKpiDescription"/>

                        </VBox>

                    </HBox>


                    <!-- EJECUTADAS -->

                    <HBox
                        class="analisisMainKpiCard analisisMainKpiGreen"
                        alignItems="Center">

                        <VBox
                            class="analisisMainKpiIcon analisisMainKpiIconGreen"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://accept"
                                class="analisisMainKpiIconSymbol"/>

                        </VBox>

                        <VBox
                            class="analisisMainKpiContent"
                            justifyContent="Center">

                            <Text
                                text="OT ejecutadas"
                                wrapping="false"
                                class="analisisMainKpiLabel"/>

                            <Text
                                text="{otModel>/summary/executedOrders}"
                                wrapping="false"
                                class="analisisMainKpiValue analisisValueGreen"/>

                            <Text
                                text="{otModel>/summary/executedDescription}"
                                wrapping="false"
                                class="analisisMainKpiDescription"/>

                        </VBox>

                    </HBox>


                    <!-- NO EJECUTADAS -->

                    <HBox
                        class="analisisMainKpiCard analisisMainKpiRed"
                        alignItems="Center">

                        <VBox
                            class="analisisMainKpiIcon analisisMainKpiIconRed"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://appointment-2"
                                class="analisisMainKpiIconSymbol"/>

                        </VBox>

                        <VBox
                            class="analisisMainKpiContent"
                            justifyContent="Center">

                            <Text
                                text="OT no ejecutadas"
                                wrapping="false"
                                class="analisisMainKpiLabel"/>

                            <Text
                                text="{otModel>/summary/notExecutedOrders}"
                                wrapping="false"
                                class="analisisMainKpiValue analisisValueRed"/>

                            <Text
                                text="{otModel>/summary/notExecutedDescription}"
                                wrapping="false"
                                class="analisisMainKpiDescription"/>

                        </VBox>

                    </HBox>


                    <!-- CUMPLIMIENTO -->

                    <HBox
                        class="analisisMainKpiCard analisisMainKpiPurple"
                        alignItems="Center">

                        <VBox
                            class="analisisMainKpiIcon analisisMainKpiIconPurple"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://target-group"
                                class="analisisMainKpiIconSymbol"/>

                        </VBox>

                        <VBox
                            class="analisisMainKpiContent"
                            justifyContent="Center">

                            <Text
                                text="Cumplimiento de la semana"
                                wrapping="false"
                                class="analisisMainKpiLabel"/>

                            <Text
                                text="{= ${otModel>/summary/compliance} + '%' }"
                                wrapping="false"
                                class="analisisMainKpiValue analisisValuePurple"/>

                            <Text
                                text="Ejecutadas / planeadas"
                                wrapping="false"
                                class="analisisMainKpiDescription"/>

                        </VBox>

                    </HBox>

                </FlexBox>


                <!-- =================================================
                     KPIs SECUNDARIOS
                     ================================================= -->

                <FlexBox
                    width="100%"
                    class="analisisSecondaryKpiRow"
                    alignItems="Stretch"
                    wrap="NoWrap">


                    <!-- CLIENTES -->

                    <HBox
                        class="analisisSecondaryKpiCard"
                        alignItems="Center">

                        <VBox
                            class="analisisSecondaryIcon analisisSecondaryIconCyan"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://customer"
                                class="analisisSecondaryIconSymbol"/>

                        </VBox>

                        <VBox
                            class="analisisSecondaryText"
                            justifyContent="Center">

                            <Text
                                text="{= ${otModel>/summary/clientsCount} + ' clientes concentran la brecha' }"
                                wrapping="false"
                                class="analisisSecondaryTitle"/>

                            <Text
                                text="OT no ejecutadas de clientes principales"
                                wrapping="false"
                                class="analisisSecondaryDescription"/>

                        </VBox>

                        <VBox
                            class="analisisPercentageCircle analisisPercentageCircleCyan"
                            justifyContent="Center"
                            alignItems="Center">

                            <Text
                                text="{= ${otModel>/summary/clientsImpact} + '%' }"
                                class="analisisPercentageText analisisPercentageCyan"/>

                        </VBox>

                    </HBox>


                    <!-- ELEVADORES -->

                    <HBox
                        class="analisisSecondaryKpiCard"
                        alignItems="Center">

                        <VBox
                            class="analisisSecondaryIcon analisisSecondaryIconBlue"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://product"
                                class="analisisSecondaryIconSymbol"/>

                        </VBox>

                        <VBox
                            class="analisisSecondaryText"
                            justifyContent="Center">

                            <Text
                                text="{= ${otModel>/summary/elevatorsCount} + ' elevadores explican el impacto' }"
                                wrapping="false"
                                class="analisisSecondaryTitle"/>

                            <Text
                                text="OT no ejecutadas por equipo"
                                wrapping="false"
                                class="analisisSecondaryDescription"/>

                        </VBox>

                        <VBox
                            class="analisisPercentageCircle analisisPercentageCircleBlue"
                            justifyContent="Center"
                            alignItems="Center">

                            <Text
                                text="{= ${otModel>/summary/elevatorsImpact} + '%' }"
                                class="analisisPercentageText analisisPercentageBlue"/>

                        </VBox>

                    </HBox>


                    <!-- ZONAS -->

                    <HBox
                        class="analisisSecondaryKpiCard"
                        alignItems="Center">

                        <VBox
                            class="analisisSecondaryIcon analisisSecondaryIconGreen"
                            justifyContent="Center"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://map-2"
                                class="analisisSecondaryIconSymbol"/>

                        </VBox>

                        <VBox
                            class="analisisSecondaryText"
                            justifyContent="Center">

                            <Text
                                text="{= ${otModel>/summary/zonesLabel} + ' concentran la afectación' }"
                                wrapping="false"
                                class="analisisSecondaryTitle"/>

                            <Text
                                text="OT no ejecutadas por zona"
                                wrapping="false"
                                class="analisisSecondaryDescription"/>

                        </VBox>

                        <VBox
                            class="analisisPercentageCircle analisisPercentageCircleGreen"
                            justifyContent="Center"
                            alignItems="Center">

                            <Text
                                text="{= ${otModel>/summary/zonesImpact} + '%' }"
                                class="analisisPercentageText analisisPercentageGreen"/>

                        </VBox>

                    </HBox>

                </FlexBox>

            </VBox>


            <!-- =====================================================
                 TABLA
                 ===================================================== -->

            <VBox
                id="idAnalisisTableCard"
                width="100%"
                height="100%"
                fitContainer="true"
                class="analisisTableCard">

                <layoutData>

                    <FlexItemData
                        growFactor="1"
                        shrinkFactor="1"
                        baseSize="0%"/>

                </layoutData>


                <!-- HEADER TABLA -->

                <FlexBox
                    id="idAnalisisTableHeader"
                    width="100%"
                    class="analisisTableHeader"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    wrap="NoWrap">

                    <VBox>

                        <HBox
                            alignItems="Center">

                            <Title
                                text="{= 'OT NO EJECUTADAS (' + ${otModel>/pagination/totalResults} + ')' }"
                                level="H4"
                                class="analisisTableTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="analisisTableInfoIcon"/>

                        </HBox>

                        <Text
                            text="Ordenadas por contribución a la brecha (mayor a menor)."
                            wrapping="false"
                            class="analisisTableSubtitle"/>

                    </VBox>

                    <SearchField
                        id="idOtSearchField"
                        width="17rem"
                        value="{otModel>/filters/search}"
                        placeholder="Buscar OT, cliente, elevador..."
                        liveChange=".onSearch"
                        search=".onSearch"
                        class="analisisSearchField"/>

                </FlexBox>


                <!-- ÁREA TABLA -->

                <VBox
                    width="100%"
                    class="analisisTableArea">

                    <layoutData>

                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>

                    </layoutData>

                    <Table
                        id="idOtTable"
                        width="100%"
                        items="{path: 'otModel>/results'}"
                        inset="false"
                        fixedLayout="true"
                        showSeparators="Inner"
                        noDataText="No se encontraron órdenes no ejecutadas."
                        class="analisisOtTable">

                        <columns>

                            <Column width="7%">
                                <Text text="Prioridad"/>
                            </Column>

                            <Column width="10%">
                                <Text text="OT"/>
                            </Column>

                            <Column width="16%">
                                <Text text="Cliente"/>
                            </Column>

                            <Column width="8%">
                                <Text text="Zona"/>
                            </Column>

                            <Column width="10%">
                                <Text text="Elevador"/>
                            </Column>

                            <Column width="15%">
                                <Text text="Causa"/>
                            </Column>

                            <Column width="13%">
                                <Text text="Responsable"/>
                            </Column>

                            <Column width="10%">
                                <Text text="Estado"/>
                            </Column>

                            <Column width="11%">
                                <Text text="Contribución"/>
                            </Column>

                        </columns>


                        <items>

                            <ColumnListItem
                                type="Inactive"
                                class="analisisTableRow">

                                <cells>

                                    <HBox
                                        class="analisisPriorityPill"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <Text
                                            text="{otModel>prioridad}"
                                            class="analisisPriorityPillText"/>

                                    </HBox>


                                    <Link
                                        text="{otModel>ot}"
                                        wrapping="false"
                                        class="analisisTableLink"/>


                                    <Text
                                        text="{otModel>cliente}"
                                        wrapping="false"
                                        tooltip="{otModel>cliente}"
                                        class="analisisTablePlainText"/>


                                    <Text
                                        text="{otModel>zona}"
                                        wrapping="false"
                                        tooltip="{otModel>zona}"
                                        class="analisisTablePlainText"/>


                                    <Link
                                        text="{otModel>elevador}"
                                        wrapping="false"
                                        class="analisisTableLink"/>


                                    <Link
                                        text="{otModel>causa}"
                                        wrapping="false"
                                        class="analisisTableCauseLink"/>


                                    <Text
                                        text="{otModel>responsable}"
                                        wrapping="false"
                                        tooltip="{otModel>responsable}"
                                        class="analisisTablePlainText"/>


                                    <Text
                                        text="{otModel>estado}"
                                        wrapping="false"
                                        class="analisisStatusText"/>


                                    <HBox
                                        width="100%"
                                        alignItems="Center"
                                        class="analisisContributionContainer">

                                        <VBox
                                            class="analisisContributionTrack">

                                            <VBox
                                                width="{= ${otModel>contribucion} + '%' }"
                                                class="analisisContributionFill"/>

                                        </VBox>

                                        <Text
                                            text="{= ${otModel>contribucion} + '%' }"
                                            class="analisisContributionValue"/>

                                    </HBox>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                </VBox>


                <!-- FOOTER TABLA -->

                <FlexBox
                    id="idAnalisisTableFooter"
                    width="100%"
                    class="analisisTableFooter"
                    justifyContent="SpaceBetween"
                    alignItems="Center"
                    wrap="NoWrap">

                    <Text
                        text="{otModel>/pagination/summaryText}"
                        class="analisisTableResults"/>


                    <HBox
                        class="analisisPagination"
                        alignItems="Center">

                        <Button
                            icon="sap-icon://navigation-left-arrow"
                            type="Transparent"
                            press=".onPreviousPage"
                            enabled="{otModel>/pagination/canGoPrevious}"
                            class="analisisPagerButton"/>

                        <Text
                            text="{= 'Página ' + ${otModel>/pagination/currentPage} + ' de ' + ${otModel>/pagination/totalPages} }"
                            class="analisisPagerText"/>

                        <Button
                            icon="sap-icon://navigation-right-arrow"
                            type="Transparent"
                            press=".onNextPage"
                            enabled="{otModel>/pagination/canGoNext}"
                            class="analisisPagerButton"/>

                    </HBox>

                </FlexBox>

            </VBox>


            <!-- =====================================================
                 NOTA
                 ===================================================== -->

            <HBox
                width="100%"
                class="analisisInformationBar"
                alignItems="Center">

                <Text
                    text="La prioridad y la contribución usan una regla provisional hasta que la regla funcional sea aprobada."
                    class="analisisInformationText"/>

            </HBox>

        </VBox>

    </Page>

</mvc:View>