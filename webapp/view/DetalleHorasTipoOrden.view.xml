<mvc:View
    controllerName="mantenimiento.controller.DetalleHorasTipoOrden"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="detalleHorasTipoOrdenPage"
        showHeader="false"
        enableScrolling="false"
        class="dhtoPage">

        <content>

            <VBox
                width="100%"
                height="100%"
                class="dhtoContainer sapUiSizeCompact">

                <!-- =================================================
                     HEADER
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="dhtoHeader">

                    <VBox
                        class="dhtoHeaderText">

                        <Title
                            text="Detalle de horas por tipo de orden"
                            level="H1"
                            class="dhtoTitle"/>

                        <Text
                            text="Análisis de horas programadas, horas reales y variaciones por tipo de orden."
                            wrapping="false"
                            class="dhtoSubtitle"/>

                    </VBox>

                    <Button
                        text="Exportar"
                        icon="sap-icon://download"
                        type="Transparent"
                        press=".onExportar"
                        class="dhtoExportBtn"/>

                </HBox>


                <!-- =================================================
                     FILTROS
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    wrap="NoWrap"
                    class="dhtoFilters">

                    <!-- PERIODO -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterPeriod">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Periodo"
                                class="dhtoFilterLabel"/>

                            <Select
                                id="dhtoPeriodoSelect"
                                width="100%"
                                selectedKey="{dhto>/filters/periodo}"
                                items="{dhto>/catalogos/periodos}"
                                change=".onPeriodoChange"
                                class="dhtoFilterControl">

                                <core:Item
                                    key="{dhto>key}"
                                    text="{dhto>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- FECHA DESDE -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterDate">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Fecha desde"
                                class="dhtoFilterLabel"/>

                            <DatePicker
                                id="dhtoFechaDesde"
                                width="100%"
                                value="{dhto>/filters/fechaDesde}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy"
                                change=".onFechaChange"
                                class="dhtoFilterControl"/>

                        </VBox>

                    </HBox>


                    <!-- FECHA HASTA -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterDate">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Fecha hasta"
                                class="dhtoFilterLabel"/>

                            <DatePicker
                                id="dhtoFechaHasta"
                                width="100%"
                                value="{dhto>/filters/fechaHasta}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy"
                                change=".onFechaChange"
                                class="dhtoFilterControl"/>

                        </VBox>

                    </HBox>


                    <!-- ZONA -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterNormal">

                        <core:Icon
                            src="sap-icon://map-2"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Zona"
                                class="dhtoFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dhto>/filters/zona}"
                                items="{dhto>/catalogos/zonas}"
                                class="dhtoFilterControl">

                                <core:Item
                                    key="{dhto>key}"
                                    text="{dhto>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- SUPERVISOR -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterNormal">

                        <core:Icon
                            src="sap-icon://employee"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Supervisor"
                                class="dhtoFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dhto>/filters/supervisor}"
                                items="{dhto>/catalogos/supervisores}"
                                class="dhtoFilterControl">

                                <core:Item
                                    key="{dhto>key}"
                                    text="{dhto>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- TURNO -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterNormal">

                        <core:Icon
                            src="sap-icon://time-entry-request"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Turno"
                                class="dhtoFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dhto>/filters/turno}"
                                items="{dhto>/catalogos/turnos}"
                                class="dhtoFilterControl">

                                <core:Item
                                    key="{dhto>key}"
                                    text="{dhto>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- TIPO ORDEN -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterOrder">

                        <core:Icon
                            src="sap-icon://document-text"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Tipo de orden"
                                class="dhtoFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dhto>/filters/tipoOrden}"
                                items="{dhto>/catalogos/tiposOrden}"
                                class="dhtoFilterControl">

                                <core:Item
                                    key="{dhto>key}"
                                    text="{dhto>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- ESTADO -->

                    <HBox
                        alignItems="Center"
                        class="dhtoFilterItem dhtoFilterEstado">

                        <core:Icon
                            src="sap-icon://status-positive"
                            class="dhtoFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dhtoFilterContent">

                            <Label
                                text="Estado de orden"
                                class="dhtoFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dhto>/filters/estado}"
                                items="{dhto>/catalogos/estados}"
                                class="dhtoFilterControl">

                                <core:Item
                                    key="{dhto>key}"
                                    text="{dhto>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- APLICAR -->

                    <VBox
                        justifyContent="Center"
                        class="dhtoApplyButtonBox">

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            width="100%"
                            press=".onApplyFilters"
                            class="dhtoApplyBtn"/>

                    </VBox>

                </HBox>


                <!-- =================================================
                     KPIS
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="dhtoKpiGrid">

                    <!-- HORAS PROGRAMADAS -->

                    <HBox
                        alignItems="Center"
                        class="dhtoKpiCard dhtoKpiBlue">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dhtoKpiIconCircle dhtoIconBlue">

                            <core:Icon
                                src="sap-icon://time-entry-request"
                                class="dhtoKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dhtoKpiContent">

                            <Text
                                text="Horas programadas"
                                class="dhtoKpiLabel"/>

                            <Text
                                text="{dhto>/kpis/horasProgramadas}"
                                class="dhtoKpiNumber dhtoBlueText"/>

                            <Text
                                text="Carga planificada"
                                class="dhtoKpiHelper"/>

                        </VBox>

                    </HBox>


                    <!-- HORAS REALES -->

                    <HBox
                        alignItems="Center"
                        class="dhtoKpiCard dhtoKpiGreen">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dhtoKpiIconCircle dhtoIconGreen">

                            <core:Icon
                                src="sap-icon://lateness"
                                class="dhtoKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dhtoKpiContent">

                            <Text
                                text="Horas reales"
                                class="dhtoKpiLabel"/>

                            <Text
                                text="{dhto>/kpis/horasReales}"
                                class="dhtoKpiNumber dhtoGreenText"/>

                            <Text
                                text="Horas ejecutadas"
                                class="dhtoKpiHelper"/>

                        </VBox>

                    </HBox>


                    <!-- VARIACIÓN H -->

                    <HBox
                        alignItems="Center"
                        class="dhtoKpiCard dhtoKpiOrange">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dhtoKpiIconCircle dhtoIconOrange">

                            <core:Icon
                                src="sap-icon://sort"
                                class="dhtoKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dhtoKpiContent">

                            <Text
                                text="Variación"
                                class="dhtoKpiLabel"/>

                            <Text
                                text="{dhto>/kpis/variacionHoras}"
                                class="dhtoKpiNumber dhtoOrangeText"/>

                            <Text
                                text="Diferencia real vs plan"
                                class="dhtoKpiHelper"/>

                        </VBox>

                    </HBox>


                    <!-- VARIACIÓN % -->

                    <HBox
                        alignItems="Center"
                        class="dhtoKpiCard dhtoKpiRed">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dhtoKpiIconCircle dhtoIconRed">

                            <Text
                                text="%"
                                class="dhtoPercentIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dhtoKpiContent">

                            <Text
                                text="Variación %"
                                class="dhtoKpiLabel"/>

                            <Text
                                text="{dhto>/kpis/variacionPct}"
                                class="dhtoKpiNumber dhtoRedText"/>

                            <Text
                                text="Variación porcentual"
                                class="dhtoKpiHelper"/>

                        </VBox>

                    </HBox>


                    <!-- OT -->

                    <HBox
                        alignItems="Center"
                        class="dhtoKpiCard dhtoKpiPurple">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dhtoKpiIconCircle dhtoIconPurple">

                            <core:Icon
                                src="sap-icon://task"
                                class="dhtoKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dhtoKpiContent">

                            <Text
                                text="OT relacionadas"
                                class="dhtoKpiLabel"/>

                            <Text
                                text="{dhto>/kpis/otRelacionadas}"
                                class="dhtoKpiNumber dhtoPurpleText"/>

                            <Text
                                text="Órdenes relacionadas"
                                class="dhtoKpiHelper"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- =================================================
                     TABLA PRINCIPAL
                     ================================================= -->

                <VBox
                    width="100%"
                    height="100%"
                    class="dhtoTableCard">

                    <layoutData>

                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>

                    </layoutData>


                    <!-- HEADER -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="dhtoTableTop">

                        <HBox
                            alignItems="Center"
                            class="dhtoTableTitleGroup">

                            <Title
                                text="Órdenes asociadas al tipo de orden seleccionado"
                                level="H3"
                                class="dhtoTableTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="dhtoInfoIcon"/>

                        </HBox>


                        <HBox
                            alignItems="Center"
                            class="dhtoTableActions">

                            <SearchField
                                id="dhtoSearchField"
                                width="15rem"
                                placeholder="Buscar OT, cliente, elevador..."
                                liveChange=".onSearchOrden"
                                search=".onSearchOrden"
                                class="dhtoSearch"/>

                            <Button
                                text="Columnas"
                                icon="sap-icon://table-column"
                                type="Transparent"
                                press=".onColumnas"
                                class="dhtoColumnsBtn"/>

                        </HBox>

                    </HBox>


                    <!-- TABLA CON MARGEN INTERNO -->

                    <VBox
                        width="100%"
                        class="dhtoOrderTableFrame">

                        <layoutData>

                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>

                        </layoutData>


                        <Table
                            width="100%"
                            fixedLayout="true"
                            inset="false"
                            showSeparators="Inner"
                            noDataText="No existen órdenes para los filtros seleccionados"
                            items="{dhto>/ordenesPaginadas}"
                            class="dhtoOrderTable">

                            <columns>

                                <Column width="7%">
                                    <Text text="OT"/>
                                </Column>

                                <Column width="12%">
                                    <Text text="Cliente"/>
                                </Column>

                                <Column width="9%">
                                    <Text text="Elevador / Equipo"/>
                                </Column>

                                <Column width="7%">
                                    <Text text="Zona"/>
                                </Column>

                                <Column width="11%">
                                    <Text text="Responsable"/>
                                </Column>

                                <Column width="8%">
                                    <Text text="Turno"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">
                                    <Text text="Horas plan (h)"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">
                                    <Text text="Horas reales (h)"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">
                                    <Text text="Variación (h)"/>
                                </Column>

                                <Column
                                    width="9%"
                                    hAlign="End">
                                    <Text text="Variación (%)"/>
                                </Column>

                                <Column width="13%">
                                    <Text text="Estado"/>
                                </Column>

                            </columns>


                            <items>

                                <ColumnListItem
                                    vAlign="Middle"
                                    class="dhtoOrderRow">

                                    <cells>

                                        <Text
                                            text="{dhto>ot}"
                                            wrapping="false"
                                            class="dhtoBlueStrong"/>

                                        <Text
                                            text="{dhto>cliente}"
                                            wrapping="false"
                                            tooltip="{dhto>cliente}"
                                            class="dhtoCellText"/>

                                        <Text
                                            text="{dhto>elevador}"
                                            wrapping="false"
                                            tooltip="{dhto>elevador}"
                                            class="dhtoCellText"/>

                                        <Text
                                            text="{dhto>zona}"
                                            wrapping="false"
                                            class="dhtoCellText"/>

                                        <Text
                                            text="{dhto>responsable}"
                                            wrapping="false"
                                            tooltip="{dhto>responsable}"
                                            class="dhtoCellText"/>

                                        <Text
                                            text="{dhto>turno}"
                                            wrapping="false"
                                            class="dhtoCellText"/>

                                        <Text
                                            text="{dhto>horasPlan}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dhtoNumberText"/>

                                        <Text
                                            text="{dhto>horasReales}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dhtoNumberText"/>


                                        <!-- VARIACIÓN H -->

                                        <Text
                                            text="{dhto>variacionH}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dhtoVariationValue">

                                            <customData>

                                                <core:CustomData
                                                    key="colorClass"
                                                    value="{dhto>colorClass}"
                                                    writeToDom="true"/>

                                            </customData>

                                        </Text>


                                        <!-- VARIACIÓN % -->

                                        <Text
                                            text="{dhto>variacionPct}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dhtoVariationValue">

                                            <customData>

                                                <core:CustomData
                                                    key="colorClass"
                                                    value="{dhto>colorClass}"
                                                    writeToDom="true"/>

                                            </customData>

                                        </Text>


                                        <!-- ESTADO -->

                                        <HBox
                                            alignItems="Center"
                                            class="dhtoStatusCell">

                                            <VBox
                                                class="dhtoStatusDot">

                                                <customData>

                                                    <core:CustomData
                                                        key="statusClass"
                                                        value="{dhto>statusDotClass}"
                                                        writeToDom="true"/>

                                                </customData>

                                            </VBox>

                                            <Text
                                                text="{dhto>estado}"
                                                wrapping="false"
                                                tooltip="{dhto>estado}"
                                                class="dhtoStatusText"/>

                                        </HBox>

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>


                    <!-- FOOTER SIN SELECTOR DE FILAS -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="dhtoTableFooter">

                        <Text
                            text="{dhto>/pagination/resultText}"
                            class="dhtoSmallText"/>

                        <HBox
                            alignItems="Center"
                            class="dhtoPagination">

                            <Button
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                enabled="{dhto>/pagination/hasPrevious}"
                                press=".onPreviousPage"
                                class="dhtoPageBtn"/>

                            <Text
                                text="{= 'Página ' + ${dhto>/pagination/currentPage} + ' de ' + ${dhto>/pagination/totalPages} }"
                                class="dhtoPaginationText"/>

                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                type="Transparent"
                                enabled="{dhto>/pagination/hasNext}"
                                press=".onNextPage"
                                class="dhtoPageBtn"/>

                        </HBox>

                    </HBox>

                </VBox>


                <!-- =================================================
                     RESÚMENES
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="dhtoSummaryGrid">

                    <!-- RESUMEN ZONA -->

                    <VBox
                        width="100%"
                        height="100%"
                        class="dhtoSummaryCard dhtoSummaryBlue">

                        <HBox
                            alignItems="Center"
                            class="dhtoSummaryTitleRow">

                            <core:Icon
                                src="sap-icon://map-2"
                                class="dhtoSummaryIcon dhtoBlueText"/>

                            <Title
                                text="Resumen por zona (del tipo seleccionado)"
                                level="H3"
                                class="dhtoSummaryTitle"/>

                        </HBox>


                        <VBox
                            class="dhtoSummaryTableFrame">

                            <HBox
                                class="dhtoSummaryHeader">

                                <Text text="Zona"/>
                                <Text text="OT"/>
                                <Text text="Horas plan (h)"/>
                                <Text text="Horas reales (h)"/>
                                <Text text="Variación (h)"/>
                                <Text text="Variación (%)"/>
                                <Text text="Estado"/>

                            </HBox>


                            <VBox
                                items="{dhto>/resumenZona}"
                                class="dhtoSummaryRows">

                                <HBox
                                    class="dhtoSummaryRow">

                                    <Text text="{dhto>zona}"/>
                                    <Text text="{dhto>ot}"/>
                                    <Text text="{dhto>horasPlan}"/>
                                    <Text text="{dhto>horasReales}"/>

                                    <Text
                                        text="{dhto>variacionH}"
                                        class="dhtoVariationValue">

                                        <customData>

                                            <core:CustomData
                                                key="colorClass"
                                                value="{dhto>colorClass}"
                                                writeToDom="true"/>

                                        </customData>

                                    </Text>

                                    <Text
                                        text="{dhto>variacionPct}"
                                        class="dhtoVariationValue">

                                        <customData>

                                            <core:CustomData
                                                key="colorClass"
                                                value="{dhto>colorClass}"
                                                writeToDom="true"/>

                                        </customData>

                                    </Text>

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="Center"
                                        class="dhtoSummaryStatus">

                                        <VBox
                                            class="dhtoStatusDot">

                                            <customData>

                                                <core:CustomData
                                                    key="statusClass"
                                                    value="{dhto>statusDotClass}"
                                                    writeToDom="true"/>

                                            </customData>

                                        </VBox>

                                        <Text
                                            text="{dhto>estado}"
                                            class="dhtoStatusText"/>

                                    </HBox>

                                </HBox>

                            </VBox>


                            <!-- TOTAL -->

                            <HBox
                                class="dhtoSummaryRow dhtoSummaryTotal">

                                <Text text="Total"/>

                                <Text
                                    text="{dhto>/kpis/otRelacionadas}"/>

                                <Text
                                    text="{dhto>/kpis/horasProgramadas}"/>

                                <Text
                                    text="{dhto>/kpis/horasReales}"/>

                                <Text
                                    text="{dhto>/kpis/variacionHoras}"
                                    class="dhtoRedStrong"/>

                                <Text
                                    text="{dhto>/kpis/variacionPct}"
                                    class="dhtoRedStrong"/>

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="dhtoSummaryStatus">

                                    <VBox
                                        class="dhtoStatusDot">

                                        <customData>

                                            <core:CustomData
                                                key="statusClass"
                                                value="{dhto>/kpis/dot}"
                                                writeToDom="true"/>

                                        </customData>

                                    </VBox>

                                    <Text
                                        text="{dhto>/kpis/text}"
                                        class="dhtoStatusText"/>

                                </HBox>

                            </HBox>

                        </VBox>

                    </VBox>


                    <!-- RESUMEN RESPONSABLE -->

                    <VBox
                        width="100%"
                        height="100%"
                        class="dhtoSummaryCard dhtoSummaryGreen">

                        <HBox
                            alignItems="Center"
                            class="dhtoSummaryTitleRow">

                            <core:Icon
                                src="sap-icon://employee"
                                class="dhtoSummaryIcon dhtoGreenText"/>

                            <Title
                                text="Resumen por responsable (del tipo seleccionado)"
                                level="H3"
                                class="dhtoSummaryTitle"/>

                        </HBox>


                        <VBox
                            class="dhtoSummaryTableFrame">

                            <HBox
                                class="dhtoSummaryHeader">

                                <Text text="Responsable"/>
                                <Text text="OT"/>
                                <Text text="Horas plan (h)"/>
                                <Text text="Horas reales (h)"/>
                                <Text text="Variación (h)"/>
                                <Text text="Variación (%)"/>
                                <Text text="Estado"/>

                            </HBox>


                            <VBox
                                items="{dhto>/resumenResponsable}"
                                class="dhtoSummaryRows">

                                <HBox
                                    class="dhtoSummaryRow">

                                    <Text
                                        text="{dhto>responsable}"
                                        tooltip="{dhto>responsable}"/>

                                    <Text text="{dhto>ot}"/>
                                    <Text text="{dhto>horasPlan}"/>
                                    <Text text="{dhto>horasReales}"/>

                                    <Text
                                        text="{dhto>variacionH}"
                                        class="dhtoVariationValue">

                                        <customData>

                                            <core:CustomData
                                                key="colorClass"
                                                value="{dhto>colorClass}"
                                                writeToDom="true"/>

                                        </customData>

                                    </Text>

                                    <Text
                                        text="{dhto>variacionPct}"
                                        class="dhtoVariationValue">

                                        <customData>

                                            <core:CustomData
                                                key="colorClass"
                                                value="{dhto>colorClass}"
                                                writeToDom="true"/>

                                        </customData>

                                    </Text>

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="Center"
                                        class="dhtoSummaryStatus">

                                        <VBox
                                            class="dhtoStatusDot">

                                            <customData>

                                                <core:CustomData
                                                    key="statusClass"
                                                    value="{dhto>statusDotClass}"
                                                    writeToDom="true"/>

                                            </customData>

                                        </VBox>

                                        <Text
                                            text="{dhto>estado}"
                                            class="dhtoStatusText"/>

                                    </HBox>

                                </HBox>

                            </VBox>


                            <!-- TOTAL -->

                            <HBox
                                class="dhtoSummaryRow dhtoSummaryTotal">

                                <Text text="Total"/>

                                <Text
                                    text="{dhto>/kpis/otRelacionadas}"/>

                                <Text
                                    text="{dhto>/kpis/horasProgramadas}"/>

                                <Text
                                    text="{dhto>/kpis/horasReales}"/>

                                <Text
                                    text="{dhto>/kpis/variacionHoras}"
                                    class="dhtoRedStrong"/>

                                <Text
                                    text="{dhto>/kpis/variacionPct}"
                                    class="dhtoRedStrong"/>

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="dhtoSummaryStatus">

                                    <VBox
                                        class="dhtoStatusDot">

                                        <customData>

                                            <core:CustomData
                                                key="statusClass"
                                                value="{dhto>/kpis/dot}"
                                                writeToDom="true"/>

                                        </customData>

                                    </VBox>

                                    <Text
                                        text="{dhto>/kpis/text}"
                                        class="dhtoStatusText"/>

                                </HBox>

                            </HBox>

                        </VBox>

                    </VBox>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>