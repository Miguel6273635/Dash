<mvc:View
    controllerName="mantenimiento.controller.DetalleCapacidadZona"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="detalleCapacidadZonaPage"
        showHeader="false"
        enableScrolling="false"
        busy="{dcz>/isBusy}"
        busyIndicatorDelay="0"
        class="DetalleCapacidadZona">

        <content>

            <VBox
                width="100%"
                height="100%"
                class="dczRoot sapUiSizeCompact">

                <!-- =================================================
                     VOLVER
                     ================================================= -->

                <HBox
                    class="dczBackRow"
                    alignItems="Center">

                    <Button
                        icon="sap-icon://navigation-left-arrow"
                        text="Volver a Horas trabajadas"
                        type="Transparent"
                        class="dczBackButton"
                        press=".onVolverHoras"/>

                </HBox>


                <!-- =================================================
                     HEADER
                     ================================================= -->

                <VBox
                    class="dczHeader">

                    <HBox
                        alignItems="Center">

                        <Title
                            text="Detalle de capacidad por zona"
                            level="H1"
                            class="dczTitle"/>

                        <core:Icon
                            src="sap-icon://hint"
                            class="dczHeaderInfoIcon"/>

                    </HBox>

                    <Text
                        text="Consulta del detalle de capacidad disponible y la utilización de horas en la zona seleccionada."
                        wrapping="false"
                        class="dczSubtitle"/>

                </VBox>


                <!-- =================================================
                     FILTROS
                     ================================================= -->

                <HBox
                    width="100%"
                    wrap="NoWrap"
                    alignItems="Stretch"
                    class="dczFiltersBar">

                    <!-- AÑO -->

                    <VBox
                        class="dczFilterBox dczFilterYear">

                        <Label
                            text="Año"
                            class="dczFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dcz>/filters/periodo}"
                            change=".onPeriodoChange"
                            items="{dcz>/catalogos/periodos}"
                            class="dczFilterControl">

                            <core:Item
                                key="{dcz>key}"
                                text="{dcz>text}"/>

                        </Select>

                    </VBox>


                    <!-- FECHA DESDE -->

                    <VBox
                        class="dczFilterBox dczFilterDate">

                        <Label
                            text="Fecha desde"
                            class="dczFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{dcz>/filters/fechaDesde}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            change=".onFechaChange"
                            class="dczFilterControl"/>

                    </VBox>


                    <!-- FECHA HASTA -->

                    <VBox
                        class="dczFilterBox dczFilterDate">

                        <Label
                            text="Fecha hasta"
                            class="dczFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{dcz>/filters/fechaHasta}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            change=".onFechaChange"
                            class="dczFilterControl"/>

                    </VBox>


                    <!-- ZONA -->

                    <VBox
                        class="dczFilterBox dczFilterNormal">

                        <Label
                            text="Zona"
                            class="dczFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dcz>/filters/zona}"
                            items="{dcz>/catalogos/zonas}"
                            class="dczFilterControl">

                            <core:Item
                                key="{dcz>key}"
                                text="{dcz>text}"/>

                        </Select>

                    </VBox>


                    <!-- SUPERVISOR -->

                    <VBox
                        class="dczFilterBox dczFilterNormal">

                        <Label
                            text="Supervisor"
                            class="dczFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dcz>/filters/supervisor}"
                            items="{dcz>/catalogos/supervisores}"
                            class="dczFilterControl">

                            <core:Item
                                key="{dcz>key}"
                                text="{dcz>text}"/>

                        </Select>

                    </VBox>


                    <!-- TURNO -->

                    <VBox
                        class="dczFilterBox dczFilterNormal">

                        <Label
                            text="Turno"
                            class="dczFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dcz>/filters/turno}"
                            items="{dcz>/catalogos/turnos}"
                            class="dczFilterControl">

                            <core:Item
                                key="{dcz>key}"
                                text="{dcz>text}"/>

                        </Select>

                    </VBox>


                    <!-- TIPO ORDEN -->

                    <VBox
                        class="dczFilterBox dczFilterOrder">

                        <Label
                            text="Tipo de orden"
                            class="dczFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dcz>/filters/tipoOrden}"
                            items="{dcz>/catalogos/tiposOrden}"
                            class="dczFilterControl">

                            <core:Item
                                key="{dcz>key}"
                                text="{dcz>text}"/>

                        </Select>

                    </VBox>


                    <!-- ESTADO -->

                    <VBox
                        class="dczFilterBox dczFilterState">

                        <Label
                            text="Estado de orden"
                            class="dczFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dcz>/filters/estado}"
                            items="{dcz>/catalogos/estados}"
                            class="dczFilterControl">

                            <core:Item
                                key="{dcz>key}"
                                text="{dcz>text}"/>

                        </Select>

                    </VBox>


                    <!-- APLICAR -->

                    <VBox
                        class="dczApplyButtonBox"
                        justifyContent="Center">

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            iconFirst="true"
                            type="Emphasized"
                            width="100%"
                            class="dczApplyButton"
                            press=".onAplicarFiltros"/>

                    </VBox>

                </HBox>


                <!-- =================================================
                     KPIS
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="dczKpiRow">

                    <!-- ZONA -->

                    <HBox
                        alignItems="Center"
                        class="dczKpiCard dczKpiBlue">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dczKpiIcon dczKpiIconBlue">

                            <core:Icon
                                src="sap-icon://map"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="dczKpiContent">

                            <Text
                                text="Zona seleccionada"
                                wrapping="false"
                                class="dczKpiLabel"/>

                            <Text
                                text="{dcz>/kpis/zona}"
                                wrapping="false"
                                class="dczKpiNumber"/>

                        </VBox>

                    </HBox>


                    <!-- CAPACIDAD -->

                    <HBox
                        alignItems="Center"
                        class="dczKpiCard dczKpiPurple">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dczKpiIcon dczKpiIconPurple">

                            <core:Icon
                                src="sap-icon://database"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="dczKpiContent">

                            <Text
                                text="Capacidad disponible"
                                wrapping="false"
                                class="dczKpiLabel"/>

                            <Text
                                text="{dcz>/kpis/capacidadDisponible}"
                                wrapping="false"
                                class="dczKpiNumber"/>

                        </VBox>

                    </HBox>


                    <!-- PROGRAMADAS -->

                    <HBox
                        alignItems="Center"
                        class="dczKpiCard dczKpiTeal">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dczKpiIcon dczKpiIconTeal">

                            <core:Icon
                                src="sap-icon://calendar"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="dczKpiContent">

                            <Text
                                text="Horas programadas"
                                wrapping="false"
                                class="dczKpiLabel"/>

                            <Text
                                text="{dcz>/kpis/horasProgramadas}"
                                wrapping="false"
                                class="dczKpiNumber"/>

                        </VBox>

                    </HBox>


                    <!-- REALES -->

                    <HBox
                        alignItems="Center"
                        class="dczKpiCard dczKpiGreen">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dczKpiIcon dczKpiIconGreen">

                            <core:Icon
                                src="sap-icon://history"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="dczKpiContent">

                            <Text
                                text="Horas reales"
                                wrapping="false"
                                class="dczKpiLabel"/>

                            <Text
                                text="{dcz>/kpis/horasReales}"
                                wrapping="false"
                                class="dczKpiNumber"/>

                        </VBox>

                    </HBox>


                    <!-- UTILIZACIÓN -->

                    <HBox
                        alignItems="Center"
                        class="dczKpiCard dczKpiOrange">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dczKpiIcon dczKpiIconOrange">

                            <core:Icon
                                src="sap-icon://trend-up"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="dczKpiContent">

                            <Text
                                text="Utilización"
                                wrapping="false"
                                class="dczKpiLabel"/>

                            <Text
                                text="{dcz>/kpis/utilizacion}"
                                wrapping="false"
                                class="dczKpiNumber"/>

                            <HBox
                                class="dczUtilTrack">

                                <HBox
                                    width="{dcz>/kpis/utilizacionWidth}"
                                    class="dczUtilFill"/>

                            </HBox>

                        </VBox>

                    </HBox>


                    <!-- ESTADO -->

                    <HBox
                        alignItems="Center"
                        class="dczKpiCard dczKpiRed">

                        <HBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dczKpiIcon dczKpiIconRed">

                            <core:Icon
                                src="sap-icon://record"/>

                        </HBox>

                        <VBox
                            justifyContent="Center"
                            class="dczKpiContent">

                            <Text
                                text="Estado"
                                wrapping="false"
                                class="dczKpiLabel"/>

                            <Text
                                text="{dcz>/kpis/estado}"
                                wrapping="false"
                                class="dczKpiNumber"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- =================================================
                     TABLA PRINCIPAL
                     ================================================= -->

                <VBox
                    width="100%"
                    height="100%"
                    class="dczCard dczMainTableCard">

                    <layoutData>

                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>

                    </layoutData>


                    <!-- HEADER -->

                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="dczCardHeader">

                        <HBox
                            alignItems="Center"
                            class="dczCardTitleGroup">

                            <Title
                                text="Órdenes asociadas a la zona seleccionada"
                                level="H3"
                                class="dczCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="dczInfoIcon"/>

                        </HBox>


                        <HBox
                            alignItems="Center"
                            class="dczTableActions">

                            <SearchField
                                id="dczSearchField"
                                placeholder="Buscar OT, cliente, elevador, responsable..."
                                width="19rem"
                                liveChange=".onBuscarOrden"
                                search=".onBuscarOrden"
                                class="dczSearchField"/>

                            <Button
                                text="Columnas"
                                icon="sap-icon://table-view"
                                type="Transparent"
                                class="dczColumnsButton"/>

                        </HBox>

                    </HBox>


                    <!-- MARCO DE TABLA -->

                    <VBox
                        width="100%"
                        class="dczOrdersTableFrame">

                        <layoutData>

                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>

                        </layoutData>

                        <Table
                            id="tblOrdenesZona"
                            width="100%"
                            fixedLayout="true"
                            inset="false"
                            showSeparators="Inner"
                            items="{dcz>/ordenesPaginadas}"
                            noDataText="No se encontraron órdenes para los filtros seleccionados"
                            class="dczOrdersTable">

                            <columns>

                                <Column width="7%">
                                    <Text text="OT"/>
                                </Column>

                                <Column width="11%">
                                    <Text text="Cliente"/>
                                </Column>

                                <Column width="10%">
                                    <Text text="Elevador / Equipo"/>
                                </Column>

                                <Column width="13%">
                                    <Text text="Tipo de orden"/>
                                </Column>

                                <Column width="11%">
                                    <Text text="Responsable"/>
                                </Column>

                                <Column width="8%">
                                    <Text text="Turno"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">
                                    <Text text="Horas plan (h)"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">
                                    <Text text="Horas reales (h)"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">
                                    <Text text="Variación (h)"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">
                                    <Text text="Variación (%)"/>
                                </Column>

                                <Column width="8%">
                                    <Text text="Estado"/>
                                </Column>

                            </columns>


                            <items>

                                <ColumnListItem
                                    vAlign="Middle"
                                    class="dczOrderRow">

                                    <cells>

                                        <Text
                                            text="{dcz>ot}"
                                            wrapping="false"
                                            class="dczBlueStrong"/>

                                        <Text
                                            text="{dcz>cliente}"
                                            tooltip="{dcz>cliente}"
                                            wrapping="false"
                                            class="dczTableText"/>

                                        <Text
                                            text="{dcz>elevador}"
                                            tooltip="{dcz>elevador}"
                                            wrapping="false"
                                            class="dczTableText"/>

                                        <Text
                                            text="{dcz>tipoOrden}"
                                            tooltip="{dcz>tipoOrden}"
                                            wrapping="false"
                                            class="dczTableText"/>

                                        <Text
                                            text="{dcz>responsable}"
                                            tooltip="{dcz>responsable}"
                                            wrapping="false"
                                            class="dczTableText"/>

                                        <Text
                                            text="{dcz>turno}"
                                            wrapping="false"
                                            class="dczTableText"/>

                                        <Text
                                            text="{dcz>horasPlan}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dczTableTextCenter"/>

                                        <Text
                                            text="{dcz>horasReales}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dczTableTextCenter"/>

                                        <Text
                                            text="{dcz>variacionH}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="{dcz>colorClass}"/>

                                        <Text
                                            text="{dcz>variacionPct}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="{dcz>colorClass}"/>

                                        <HBox
                                            alignItems="Center"
                                            class="dczStatusCell">

                                            <VBox
                                                class="{dcz>statusDotClass}"/>

                                            <Text
                                                text="{dcz>estado}"
                                                wrapping="false"
                                                tooltip="{dcz>estado}"
                                                class="dczStatusText"/>

                                        </HBox>

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>


                    <!-- PAGINACIÓN -->

                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="dczTableFooter">

                        <Text
                            text="{dcz>/pagination/resultText}"
                            class="dczFooterText"/>

                        <HBox
                            alignItems="Center"
                            class="dczPager">

                            <Button
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                enabled="{dcz>/pagination/hasPrevious}"
                                press=".onPaginaAnterior"
                                class="dczPagerButton"/>

                            <Text
                                text="{= 'Página ' + ${dcz>/pagination/currentPage} + ' de ' + ${dcz>/pagination/totalPages} }"
                                class="dczPaginationText"/>

                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                type="Transparent"
                                enabled="{dcz>/pagination/hasNext}"
                                press=".onPaginaSiguiente"
                                class="dczPagerButton"/>

                        </HBox>

                    </HBox>

                </VBox>


                <!-- =================================================
                     RESÚMENES
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="dczBottomGrid">

                    <!-- RESUMEN TURNO -->

                    <VBox
                        width="100%"
                        height="100%"
                        class="dczCard dczSummaryCard dczSummaryBlue">

                        <HBox
                            alignItems="Center"
                            class="dczSummaryTitleRow">

                            <HBox
                                alignItems="Center"
                                justifyContent="Center"
                                class="dczSummaryIcon dczSummaryIconBlue">

                                <core:Icon
                                    src="sap-icon://calendar"/>

                            </HBox>

                            <Title
                                text="Resumen por turno de la zona seleccionada"
                                level="H3"
                                class="dczCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="dczInfoIcon"/>

                        </HBox>


                        <VBox
                            width="100%"
                            class="dczSummaryTableFrame">

                            <Table
                                width="100%"
                                fixedLayout="true"
                                inset="false"
                                showSeparators="Inner"
                                items="{dcz>/resumenTurno}"
                                noDataText="No data"
                                class="dczSummaryTable dczSummaryTurnoTable">

                                <columns>

                                    <Column width="20%">
                                        <Text text="Turno"/>
                                    </Column>

                                    <Column
                                        width="8%"
                                        hAlign="Center">
                                        <Text text="OT"/>
                                    </Column>

                                    <Column
                                        width="14%"
                                        hAlign="Center">
                                        <Text text="Horas plan (h)"/>
                                    </Column>

                                    <Column
                                        width="14%"
                                        hAlign="Center">
                                        <Text text="Horas reales (h)"/>
                                    </Column>

                                    <Column
                                        width="13%"
                                        hAlign="Center">
                                        <Text text="Variación (h)"/>
                                    </Column>

                                    <Column
                                        width="13%"
                                        hAlign="Center">
                                        <Text text="Variación (%)"/>
                                    </Column>

                                    <Column
                                        width="18%">
                                        <Text text="Estado"/>
                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem>

                                        <cells>

                                            <HBox
                                                alignItems="Center"
                                                class="dczSummaryNameCell">

                                                <VBox
                                                    class="{dcz>dotClass}"/>

                                                <Text
                                                    text="{dcz>turno}"
                                                    wrapping="false"
                                                    tooltip="{dcz>turno}"
                                                    class="dczTableText"/>

                                            </HBox>

                                            <Text
                                                text="{dcz>ot}"
                                                class="dczTableTextCenter"/>

                                            <Text
                                                text="{dcz>horasPlan}"
                                                class="dczTableTextCenter"/>

                                            <Text
                                                text="{dcz>horasReales}"
                                                class="dczTableTextCenter"/>

                                            <Text
                                                text="{dcz>variacionH}"
                                                class="{dcz>colorClass}"/>

                                            <Text
                                                text="{dcz>variacionPct}"
                                                class="{dcz>colorClass}"/>

                                            <HBox
                                                alignItems="Center"
                                                class="dczStatusCell">

                                                <VBox
                                                    class="{dcz>statusDotClass}"/>

                                                <Text
                                                    text="{dcz>estado}"
                                                    wrapping="false"
                                                    class="dczStatusText"/>

                                            </HBox>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                    </VBox>


                    <!-- RESUMEN TIPO ORDEN -->

                    <VBox
                        width="100%"
                        height="100%"
                        class="dczCard dczSummaryCard dczSummaryGreen">

                        <HBox
                            alignItems="Center"
                            class="dczSummaryTitleRow">

                            <HBox
                                alignItems="Center"
                                justifyContent="Center"
                                class="dczSummaryIcon dczSummaryIconGreen">

                                <core:Icon
                                    src="sap-icon://task"/>

                            </HBox>

                            <Title
                                text="Resumen por tipo de orden de la zona seleccionada"
                                level="H3"
                                class="dczCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="dczInfoIcon"/>

                        </HBox>


                        <VBox
                            width="100%"
                            class="dczSummaryTableFrame">

                            <Table
                                width="100%"
                                fixedLayout="true"
                                inset="false"
                                showSeparators="Inner"
                                items="{dcz>/resumenTipoOrden}"
                                noDataText="No data"
                                class="dczSummaryTable dczSummaryTipoTable">

                                <columns>

                                    <Column width="28%">
                                        <Text text="Tipo de orden"/>
                                    </Column>

                                    <Column
                                        width="8%"
                                        hAlign="Center">
                                        <Text text="OT"/>
                                    </Column>

                                    <Column
                                        width="14%"
                                        hAlign="Center">
                                        <Text text="Horas plan (h)"/>
                                    </Column>

                                    <Column
                                        width="14%"
                                        hAlign="Center">
                                        <Text text="Horas reales (h)"/>
                                    </Column>

                                    <Column
                                        width="12%"
                                        hAlign="Center">
                                        <Text text="Variación (h)"/>
                                    </Column>

                                    <Column
                                        width="12%"
                                        hAlign="Center">
                                        <Text text="Variación (%)"/>
                                    </Column>

                                    <Column width="12%">
                                        <Text text="Estado"/>
                                    </Column>

                                </columns>


                                <items>

                                    <ColumnListItem>

                                        <cells>

                                            <HBox
                                                alignItems="Center"
                                                class="dczSummaryNameCell">

                                                <VBox
                                                    class="{dcz>dotClass}"/>

                                                <Text
                                                    text="{dcz>tipoOrden}"
                                                    tooltip="{dcz>tipoOrden}"
                                                    wrapping="false"
                                                    class="dczTableText"/>

                                            </HBox>

                                            <Text
                                                text="{dcz>ot}"
                                                class="dczTableTextCenter"/>

                                            <Text
                                                text="{dcz>horasPlan}"
                                                class="dczTableTextCenter"/>

                                            <Text
                                                text="{dcz>horasReales}"
                                                class="dczTableTextCenter"/>

                                            <Text
                                                text="{dcz>variacionH}"
                                                class="{dcz>colorClass}"/>

                                            <Text
                                                text="{dcz>variacionPct}"
                                                class="{dcz>colorClass}"/>

                                            <HBox
                                                alignItems="Center"
                                                class="dczStatusCell">

                                                <VBox
                                                    class="{dcz>statusDotClass}"/>

                                                <Text
                                                    text="{dcz>estado}"
                                                    wrapping="false"
                                                    class="dczStatusText"/>

                                            </HBox>

                                        </cells>

                                    </ColumnListItem>

                                </items>

                            </Table>

                        </VBox>

                    </VBox>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>