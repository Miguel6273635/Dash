<mvc:View
    controllerName="mantenimiento.controller.DetalleCapacidadZona"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page showHeader="false" class="DetalleCapacidadZona">
        <content>
            <ScrollContainer height="100%" width="100%" vertical="true" horizontal="false">
                <VBox class="dczPage">

                    <!-- VOLVER -->
                    <HBox class="dczBackRow" alignItems="Center">
                        <Button
                            icon="sap-icon://navigation-left-arrow"
                            text="Volver a Horas trabajadas"
                            type="Transparent"
                            class="dczBackButton"
                            press=".onVolverHoras" />
                    </HBox>

                    <!-- HEADER -->
                    <VBox class="dczHeader">
                        <HBox alignItems="Center">
                            <Title
                                text="Detalle de capacidad por zona"
                                level="H1"
                                class="dczTitle" />
                            <Button
                                icon="sap-icon://hint"
                                type="Transparent"
                                class="dczInfoButton" />
                        </HBox>

                        <Text
                            text="Consulta del detalle de capacidad disponible y la utilización de horas en la zona seleccionada."
                            class="dczSubtitle" />
                    </VBox>

                    <!-- FILTROS -->
                    <HBox class="dczFiltersBar" wrap="NoWrap">

                        <VBox class="dczFilterBox">
                            <Label text="Periodo" class="dczFilterLabel" />
                            <Select selectedKey="{dcz>/filters/periodo}">
                                <core:Item key="Mayo 2024" text="Mayo 2024" />
                                <core:Item key="Junio 2024" text="Junio 2024" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label text="Fecha desde" class="dczFilterLabel" />
                            <DatePicker
                                value="{dcz>/filters/fechaDesde}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy" />
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label text="Fecha hasta" class="dczFilterLabel" />
                            <DatePicker
                                value="{dcz>/filters/fechaHasta}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy" />
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label text="Zona" class="dczFilterLabel" />
                            <Select selectedKey="{dcz>/filters/zona}">
                                <core:Item key="Norte" text="Norte" />
                                <core:Item key="Centro" text="Centro" />
                                <core:Item key="Sur" text="Sur" />
                                <core:Item key="Este" text="Este" />
                                <core:Item key="Oeste" text="Oeste" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label text="Supervisor" class="dczFilterLabel" />
                            <Select selectedKey="{dcz>/filters/supervisor}">
                                <core:Item key="Todos" text="Todos" />
                                <core:Item key="Juan Pérez" text="Juan Pérez" />
                                <core:Item key="María López" text="María López" />
                                <core:Item key="Carlos Ruiz" text="Carlos Ruiz" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label text="Turno" class="dczFilterLabel" />
                            <Select selectedKey="{dcz>/filters/turno}">
                                <core:Item key="Todos" text="Todos" />
                                <core:Item key="Diurno" text="Diurno" />
                                <core:Item key="Nocturno" text="Nocturno" />
                                <core:Item key="Fin de semana" text="Fin de semana" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label text="Tipo de orden" class="dczFilterLabel" />
                            <Select selectedKey="{dcz>/filters/tipoOrden}">
                                <core:Item key="Todos" text="Todos" />
                                <core:Item key="Reparación / correctivo" text="Reparación / correctivo" />
                                <core:Item key="Mantenimiento planeado" text="Mantenimiento planeado" />
                                <core:Item key="Call Center" text="Call Center" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label text="Estado de orden" class="dczFilterLabel" />
                            <Select selectedKey="{dcz>/filters/estado}">
                                <core:Item key="Todos" text="Todos" />
                                <core:Item key="Sobrecargado" text="Sobrecargado" />
                                <core:Item key="Cerca de plan" text="Cerca de plan" />
                                <core:Item key="Dentro de plan" text="Dentro de plan" />
                            </Select>
                        </VBox>

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            class="dczApplyButton"
                            press=".onAplicarFiltros" />

                    </HBox>

                    <!-- KPIS -->
                    <HBox class="dczKpiRow">

                        <HBox class="dczKpiCard dczKpiBlue" alignItems="Center">
                            <HBox class="dczKpiIcon dczKpiIconBlue" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://map-2" />
                            </HBox>
                            <VBox>
                                <Text text="Zona seleccionada" class="dczKpiLabel" />
                                <Text text="{dcz>/kpis/zona}" class="dczKpiNumber dczBlueText" />
                            </VBox>
                        </HBox>

                        <HBox class="dczKpiCard dczKpiBlue" alignItems="Center">
                            <HBox class="dczKpiIcon dczKpiIconBlue" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://database" />
                            </HBox>
                            <VBox>
                                <Text text="Capacidad disponible" class="dczKpiLabel" />
                                <Text text="{dcz>/kpis/capacidadDisponible}" class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>

                        <HBox class="dczKpiCard dczKpiTeal" alignItems="Center">
                            <HBox class="dczKpiIcon dczKpiIconTeal" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://calendar" />
                            </HBox>
                            <VBox>
                                <Text text="Horas programadas" class="dczKpiLabel" />
                                <Text text="{dcz>/kpis/horasProgramadas}" class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>

                        <HBox class="dczKpiCard dczKpiGreen" alignItems="Center">
                            <HBox class="dczKpiIcon dczKpiIconGreen" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://lateness" />
                            </HBox>
                            <VBox>
                                <Text text="Horas reales" class="dczKpiLabel" />
                                <Text text="{dcz>/kpis/horasReales}" class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>

                        <HBox class="dczKpiCard dczKpiOrange" alignItems="Center">
                            <HBox class="dczKpiIcon dczKpiIconOrange" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://trend-up" />
                            </HBox>
                            <VBox>
                                <Text text="Utilización" class="dczKpiLabel" />
                                <Text text="{dcz>/kpis/utilizacion}" class="dczKpiNumber dczOrangeText" />
                                <VBox class="dczUtilTrack">
                                    <VBox class="dczUtilFill" width="92%" />
                                </VBox>
                            </VBox>
                        </HBox>

                        <HBox class="dczKpiCard dczKpiRed" alignItems="Center">
                            <HBox class="dczKpiIcon dczKpiIconRed" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://record" />
                            </HBox>
                            <VBox>
                                <Text text="Estado" class="dczKpiLabel" />
                                <Text text="{dcz>/kpis/estado}" class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>

                    </HBox>

                    <!-- TABLA PRINCIPAL -->
                    <VBox class="dczCard dczMainTableCard">

                        <HBox class="dczCardHeader" justifyContent="SpaceBetween" alignItems="Center">
                            <HBox alignItems="Center">
                                <Title
                                    text="Órdenes asociadas a la zona seleccionada"
                                    level="H3"
                                    class="dczCardTitle" />
                                <Button icon="sap-icon://hint" type="Transparent" class="dczSmallButton" />
                            </HBox>

                            <HBox alignItems="Center" class="dczTableActions">
                                <SearchField
                                    placeholder="Buscar OT, cliente, elevador, responsable..."
                                    width="310px"
                                    liveChange=".onBuscarOrden" />

                                <Button
                                    text="Columnas"
                                    icon="sap-icon://table-view"
                                    type="Transparent"
                                    class="dczColumnsButton" />
                            </HBox>
                        </HBox>

                        <Table
                            id="tblOrdenesZona"
                            items="{dcz>/ordenes}"
                            class="dczOrdersTable"
                            fixedLayout="true">

                            <columns>
                                <Column width="95px">
                                    <Text text="OT" />
                                </Column>
                                <Column>
                                    <Text text="Cliente" />
                                </Column>
                                <Column>
                                    <Text text="Elevador / Equipo" />
                                </Column>
                                <Column>
                                    <Text text="Tipo de orden" />
                                </Column>
                                <Column>
                                    <Text text="Responsable" />
                                </Column>
                                <Column>
                                    <Text text="Turno" />
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Horas plan (h)" />
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Horas reales (h)" />
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Variación (h)" />
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Variación (%)" />
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="ESTADO" />
                                </Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{dcz>ot}" class="dczBlueStrong" />
                                        <Text text="{dcz>cliente}" class="dczTableText" />
                                        <Text text="{dcz>elevador}" class="dczTableText" />
                                        <Text text="{dcz>tipoOrden}" class="dczTableText" />
                                        <Text text="{dcz>responsable}" class="dczTableText" />
                                        <Text text="{dcz>turno}" class="dczTableText" />
                                        <Text text="{dcz>horasPlan}" class="dczTableTextCenter" />
                                        <Text text="{dcz>horasReales}" class="dczTableTextCenter" />
                                        <Text text="{dcz>variacionH}" class="{dcz>colorClass}" />
                                        <Text text="{dcz>variacionPct}" class="{dcz>colorClass}" />

                                        <HBox alignItems="Center" justifyContent="Center" class="dczStatusCell">
                                            <VBox class="{dcz>statusDotClass}" />
                                            <Text text="{dcz>estado}" class="dczStatusText" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                        <HBox class="dczTableFooter" justifyContent="SpaceBetween" alignItems="Center">
                            <Text text="Mostrando 1 a 10 de 78 resultados" />

                            <HBox alignItems="Center" class="dczPager">
                                <Select selectedKey="10" width="116px">
                                    <core:Item key="10" text="10 por página" />
                                    <core:Item key="20" text="20 por página" />
                                </Select>

                                <Button icon="sap-icon://navigation-left-arrow" type="Transparent" class="dczPagerButton" />
                                <Button text="1" type="Emphasized" class="dczPagerActive" />
                                <Button text="2" type="Transparent" class="dczPagerButton" />
                                <Button text="3" type="Transparent" class="dczPagerButton" />
                                <Text text="..." class="dczPagerDots" />
                                <Button text="8" type="Transparent" class="dczPagerButton" />
                                <Button icon="sap-icon://navigation-right-arrow" type="Transparent" class="dczPagerButton" />
                            </HBox>
                        </HBox>

                    </VBox>

                    <!-- RESÚMENES -->
                    <HBox class="dczBottomGrid">

                        <!-- RESUMEN POR TURNO -->
                        <VBox class="dczCard dczSummaryCard dczSummaryBlue">
                            <HBox class="dczSummaryTitleRow" alignItems="Center">
                                <HBox class="dczSummaryIcon dczSummaryIconBlue" alignItems="Center" justifyContent="Center">
                                    <core:Icon src="sap-icon://calendar" />
                                </HBox>
                                <Title
                                    text="Resumen por turno de la zona seleccionada"
                                    level="H3"
                                    class="dczCardTitle" />
                                <Button icon="sap-icon://hint" type="Transparent" class="dczSmallButton" />
                            </HBox>

                            <Table
                                items="{dcz>/resumenTurno}"
                                class="dczSummaryTable"
                                fixedLayout="true">

                                <columns>
                                    <Column>
                                        <Text text="Turno" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="OT" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Horas plan (h)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Horas reales (h)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Variación (h)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Variación (%)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Estado" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <HBox alignItems="Center">
                                                <VBox class="{dcz>dotClass}" />
                                                <Text text="{dcz>turno}" class="dczTableText" />
                                            </HBox>
                                            <Text text="{dcz>ot}" class="dczTableTextCenter" />
                                            <Text text="{dcz>horasPlan}" class="dczTableTextCenter" />
                                            <Text text="{dcz>horasReales}" class="dczTableTextCenter" />
                                            <Text text="{dcz>variacionH}" class="{dcz>colorClass}" />
                                            <Text text="{dcz>variacionPct}" class="{dcz>colorClass}" />
                                            <HBox alignItems="Center" justifyContent="Center" class="dczStatusCell">
                                                <VBox class="{dcz>statusDotClass}" />
                                                <Text text="{dcz>estado}" class="dczStatusText" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <HBox class="dczSummaryTotalRow">
                                <Text text="Total" />
                                <Text text="78" />
                                <Text text="1,450" />
                                <Text text="1,620" />
                                <Text text="+170" class="dczRedStrong" />
                                <Text text="101.3%" class="dczRedStrong" />
                                <HBox alignItems="Center" justifyContent="Center">
                                    <VBox class="dczDotRed" />
                                    <Text text="Sobrecargado" class="dczStatusText" />
                                </HBox>
                            </HBox>
                        </VBox>

                        <!-- RESUMEN POR TIPO ORDEN -->
                        <VBox class="dczCard dczSummaryCard dczSummaryGreen">
                            <HBox class="dczSummaryTitleRow" alignItems="Center">
                                <HBox class="dczSummaryIcon dczSummaryIconGreen" alignItems="Center" justifyContent="Center">
                                    <core:Icon src="sap-icon://task" />
                                </HBox>
                                <Title
                                    text="Resumen por tipo de orden de la zona seleccionada"
                                    level="H3"
                                    class="dczCardTitle" />
                                <Button icon="sap-icon://hint" type="Transparent" class="dczSmallButton" />
                            </HBox>

                            <Table
                                items="{dcz>/resumenTipoOrden}"
                                class="dczSummaryTable"
                                fixedLayout="true">

                                <columns>
                                    <Column>
                                        <Text text="Tipo de orden" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="OT" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Horas plan (h)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Horas reales (h)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Variación (h)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Variación (%)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Utilización (%)" />
                                    </Column>
                                    <Column hAlign="Center">
                                        <Text text="Estado" />
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <HBox alignItems="Center">
                                                <VBox class="{dcz>dotClass}" />
                                                <Text text="{dcz>tipoOrden}" class="dczTableText" />
                                            </HBox>
                                            <Text text="{dcz>ot}" class="dczTableTextCenter" />
                                            <Text text="{dcz>horasPlan}" class="dczTableTextCenter" />
                                            <Text text="{dcz>horasReales}" class="dczTableTextCenter" />
                                            <Text text="{dcz>variacionH}" class="{dcz>colorClass}" />
                                            <Text text="{dcz>variacionPct}" class="{dcz>colorClass}" />
                                            <Text text="{dcz>utilizacion}" class="{dcz>utilClass}" />
                                            <HBox alignItems="Center" justifyContent="Center" class="dczStatusCell">
                                                <VBox class="{dcz>statusDotClass}" />
                                                <Text text="{dcz>estado}" class="dczStatusText" />
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <HBox class="dczSummaryTotalRow dczSummaryTotalTipo">
                                <Text text="Total" />
                                <Text text="78" />
                                <Text text="1,450" />
                                <Text text="1,620" />
                                <Text text="+170" class="dczRedStrong" />
                                <Text text="101.3%" class="dczRedStrong" />
                                <HBox alignItems="Center" justifyContent="Center">
                                    <VBox class="dczDotRed" />
                                </HBox>
                                <HBox alignItems="Center" justifyContent="Center">
                                    <VBox class="dczDotRed" />
                                    <Text text="Sobrecargado" class="dczStatusText" />
                                </HBox>
                            </HBox>
                        </VBox>

                    </HBox>

                </VBox>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>