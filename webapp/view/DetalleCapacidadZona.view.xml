<mvc:View
    controllerName="mantenimiento.controller.DetalleCapacidadZona"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        showHeader="false"
        busy="{dcz>/isBusy}"
        busyIndicatorDelay="0"
        class="DetalleCapacidadZona">

        <content>
            <ScrollContainer
                height="100%"
                width="100%"
                vertical="true"
                horizontal="false">

                <VBox class="dczPage">

                    <!-- VOLVER -->
                    <HBox
                        class="dczBackRow"
                        alignItems="Center">

                        <Button
                            icon="sap-icon://navigation-left-arrow"
                            text="Volver a Horas trabajadas"
                            type="Transparent"
                            class="dczBackButton"
                            press=".onVolverHoras" />
                    </HBox>

                    <!-- HEADER -->
                    <VBox class="dczHeader">
                        <HBox alignItems="Center">
                            <Title
                                text="Detalle de capacidad por zona"
                                level="H1"
                                class="dczTitle" />

                            <Button
                                icon="sap-icon://hint"
                                type="Transparent"
                                class="dczInfoButton" />
                        </HBox>

                        <Text
                            text="Consulta del detalle de capacidad disponible y la utilización de horas en la zona seleccionada."
                            class="dczSubtitle" />
                    </VBox>

                    <!-- FILTROS -->
                    <HBox
                        class="dczFiltersBar"
                        wrap="NoWrap"
                        alignItems="Stretch">

                        <VBox class="dczFilterBox">
                            <Label
                                text="Año"
                                class="dczFilterLabel" />

                            <Select
                                width="100%"
                                selectedKey="{dcz>/filters/periodo}"
                                change=".onPeriodoChange"
                                items="{dcz>/catalogos/periodos}">

                                <core:Item
                                    key="{dcz>key}"
                                    text="{dcz>text}" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label
                                text="Fecha desde"
                                class="dczFilterLabel"/>

                            <DatePicker
                                width="100%"
                                value="{dcz>/filters/fechaDesde}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy"
                                change=".onFechaChange" />
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label
                                text="Fecha hasta"
                                class="dczFilterLabel"/>

                            <DatePicker
                                width="100%"
                                value="{dcz>/filters/fechaHasta}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy"
                                change=".onFechaChange" />
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label
                                text="Zona"
                                class="dczFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dcz>/filters/zona}"
                                items="{dcz>/catalogos/zonas}">

                                <core:Item
                                    key="{dcz>key}"
                                    text="{dcz>text}" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label
                                text="Supervisor"
                                class="dczFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dcz>/filters/supervisor}"
                                items="{dcz>/catalogos/supervisores}">

                                <core:Item
                                    key="{dcz>key}"
                                    text="{dcz>text}" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label
                                text="Turno"
                                class="dczFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dcz>/filters/turno}"
                                items="{dcz>/catalogos/turnos}">

                                <core:Item
                                    key="{dcz>key}"
                                    text="{dcz>text}" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label
                                text="Tipo de orden"
                                class="dczFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dcz>/filters/tipoOrden}"
                                items="{dcz>/catalogos/tiposOrden}">

                                <core:Item
                                    key="{dcz>key}"
                                    text="{dcz>text}" />
                            </Select>
                        </VBox>

                        <VBox class="dczFilterBox">
                            <Label
                                text="Estado de orden"
                                class="dczFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{dcz>/filters/estado}"
                                items="{dcz>/catalogos/estados}">

                                <core:Item
                                    key="{dcz>key}"
                                    text="{dcz>text}" />
                            </Select>
                        </VBox>

                        <VBox
                            class="dczApplyButtonBox"
                            justifyContent="Center"
                            alignItems="Center">

                            <Button
                                text="Aplicar filtros"
                                icon="sap-icon://filter"
                                iconFirst="true"
                                type="Emphasized"
                                class="dczApplyButton"
                                press=".onAplicarFiltros"/>
                        </VBox>
                    </HBox>

                    <!-- KPIS -->
                    <HBox class="dczKpiRow">

                        <HBox
                            class="dczKpiCard dczKpiBlue"
                            alignItems="Center">

                            <HBox
                                class="dczKpiIcon dczKpiIconBlue"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://map" />
                            </HBox>

                            <VBox>
                                <Text
                                    text="Zona seleccionada"
                                    class="dczKpiLabel" />

                                <Text
                                    text="{dcz>/kpis/zona}"
                                    class="dczKpiNumber dczBlueText" />
                            </VBox>
                        </HBox>

                        <HBox
                            class="dczKpiCard dczKpiBlue"
                            alignItems="Center">

                            <HBox
                                class="dczKpiIcon dczKpiIconBlue"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://database" />
                            </HBox>

                            <VBox>
                                <Text
                                    text="Capacidad disponible"
                                    class="dczKpiLabel" />

                                <Text
                                    text="{dcz>/kpis/capacidadDisponible}"
                                    class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>

                        <HBox
                            class="dczKpiCard dczKpiTeal"
                            alignItems="Center">

                            <HBox
                                class="dczKpiIcon dczKpiIconTeal"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://calendar" />
                            </HBox>

                            <VBox>
                                <Text
                                    text="Horas programadas"
                                    class="dczKpiLabel" />

                                <Text
                                    text="{dcz>/kpis/horasProgramadas}"
                                    class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>

                        <HBox
                            class="dczKpiCard dczKpiGreen"
                            alignItems="Center">

                            <HBox
                                class="dczKpiIcon dczKpiIconGreen"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://history" />
                            </HBox>

                            <VBox>
                                <Text
                                    text="Horas reales"
                                    class="dczKpiLabel" />

                                <Text
                                    text="{dcz>/kpis/horasReales}"
                                    class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>

                        <HBox
                            class="dczKpiCard dczKpiOrange"
                            alignItems="Center">

                            <HBox
                                class="dczKpiIcon dczKpiIconOrange"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://trend-up" />
                            </HBox>

                            <VBox>
                                <Text
                                    text="Utilización"
                                    class="dczKpiLabel" />

                                <Text
                                    text="{dcz>/kpis/utilizacion}"
                                    class="dczKpiNumber dczOrangeText" />

                                <VBox class="dczUtilTrack">
                                    <VBox
                                        class="dczUtilFill"
                                        width="{dcz>/kpis/utilizacionWidth}" />
                                </VBox>
                            </VBox>
                        </HBox>

                        <HBox
                            class="dczKpiCard dczKpiRed"
                            alignItems="Center">

                            <HBox
                                class="dczKpiIcon dczKpiIconRed"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://record" />
                            </HBox>

                            <VBox>
                                <Text
                                    text="Estado"
                                    class="dczKpiLabel" />

                                <Text
                                    text="{dcz>/kpis/estado}"
                                    class="dczKpiNumber dczDarkText" />
                            </VBox>
                        </HBox>
                    </HBox>

                    <!-- TABLA PRINCIPAL -->
                    <VBox class="dczCard dczMainTableCard">

                        <HBox
                            class="dczCardHeader"
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <HBox alignItems="Center">
                                <Title
                                    text="Órdenes asociadas a la zona seleccionada"
                                    level="H3"
                                    class="dczCardTitle" />

                                <Button
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    class="dczSmallButton" />
                            </HBox>

                            <HBox
                                alignItems="Center"
                                class="dczTableActions">

                                <SearchField
                                    placeholder="Buscar OT, cliente, elevador, responsable..."
                                    width="310px"
                                    liveChange=".onBuscarOrden" />

                                <Button
                                    text="Columnas"
                                    icon="sap-icon://table-view"
                                    type="Transparent"
                                    class="dczColumnsButton" />
                            </HBox>
                        </HBox>

                        <Table
                            id="tblOrdenesZona"
                            items="{dcz>/ordenes}"
                            noDataText="No se encontraron órdenes para los filtros seleccionados"
                            class="dczOrdersTable"
                            fixedLayout="true">

                            <columns>
                                <Column width="88px"><Text text="OT"/></Column>
                                <Column width="145px"><Text text="Cliente"/></Column>
                                <Column width="125px"><Text text="Elevador / Equipo"/></Column>
                                <Column width="165px"><Text text="Tipo de orden"/></Column>
                                <Column width="130px"><Text text="Responsable"/></Column>
                                <Column width="100px"><Text text="Turno"/></Column>
                                <Column width="92px" hAlign="Center"><Text text="Horas plan (h)"/></Column>
                                <Column width="98px" hAlign="Center"><Text text="Horas reales (h)"/></Column>
                                <Column width="86px" hAlign="Center"><Text text="Variación (h)"/></Column>
                                <Column width="92px" hAlign="Center"><Text text="Variación (%)"/></Column>
                                <Column width="130px" hAlign="Center"><Text text="Estado"/></Column>
                            </columns>

                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{dcz>ot}" class="dczBlueStrong" />
                                        <Text text="{dcz>cliente}" class="dczTableText" />
                                        <Text text="{dcz>elevador}" class="dczTableText" />
                                        <Text text="{dcz>tipoOrden}" class="dczTableText" />
                                        <Text text="{dcz>responsable}" class="dczTableText" />
                                        <Text text="{dcz>turno}" class="dczTableText" />
                                        <Text text="{dcz>horasPlan}" class="dczTableTextCenter" />
                                        <Text text="{dcz>horasReales}" class="dczTableTextCenter" />
                                        <Text text="{dcz>variacionH}" class="{dcz>colorClass}" />
                                        <Text text="{dcz>variacionPct}" class="{dcz>colorClass}" />

                                        <HBox
                                            alignItems="Center"
                                            justifyContent="Center"
                                            class="dczStatusCell">

                                            <VBox class="{dcz>statusDotClass}" />
                                            <Text text="{dcz>estado}" class="dczStatusText" />
                                        </HBox>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>

                        <HBox
                            class="dczTableFooter"
                            justifyContent="SpaceBetween"
                            alignItems="Center">

                            <Text text="{dcz>/footerText}" />

                            <HBox
                                alignItems="Center"
                                class="dczPager">

                                <Select
                                    selectedKey="10"
                                    width="116px">

                                    <core:Item key="10" text="10 por página" />
                                    <core:Item key="20" text="20 por página" />
                                </Select>

                                <Button
                                    icon="sap-icon://navigation-left-arrow"
                                    type="Transparent"
                                    class="dczPagerButton" />

                                <Button
                                    text="1"
                                    type="Emphasized"
                                    class="dczPagerActive" />

                                <Button
                                    icon="sap-icon://navigation-right-arrow"
                                    type="Transparent"
                                    class="dczPagerButton" />
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- RESÚMENES -->
                    <HBox class="dczBottomGrid">

                        <VBox
                            class="dczCard dczSummaryCard dczSummaryBlue">

                            <HBox
                                class="dczSummaryTitleRow"
                                alignItems="Center">

                                <HBox
                                    class="dczSummaryIcon dczSummaryIconBlue"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <core:Icon src="sap-icon://calendar" />
                                </HBox>

                                <Title
                                    text="Resumen por turno de la zona seleccionada"
                                    level="H3"
                                    class="dczCardTitle" />

                                <Button
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    class="dczSmallButton" />
                            </HBox>

                            <Table
                                items="{dcz>/resumenTurno}"
                                class="dczSummaryTable dczSummaryTurnoTable"
                                fixedLayout="true">

                                <columns>
                                    <Column width="20%"><Text text="Turno"/></Column>
                                    <Column width="8%" hAlign="Center"><Text text="OT"/></Column>
                                    <Column width="14%" hAlign="Center"><Text text="Horas plan (h)"/></Column>
                                    <Column width="14%" hAlign="Center"><Text text="Horas reales (h)"/></Column>
                                    <Column width="13%" hAlign="Center"><Text text="Variación (h)"/></Column>
                                    <Column width="13%" hAlign="Center"><Text text="Variación (%)"/></Column>
                                    <Column width="18%" hAlign="Center"><Text text="Estado"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <HBox
                                                alignItems="Center"
                                                class="dczSummaryNameCell">

                                                <VBox class="{dcz>dotClass}"/>
                                                <Text text="{dcz>turno}" class="dczTableText"/>
                                            </HBox>

                                            <Text text="{dcz>ot}" class="dczTableTextCenter"/>
                                            <Text text="{dcz>horasPlan}" class="dczTableTextCenter"/>
                                            <Text text="{dcz>horasReales}" class="dczTableTextCenter"/>
                                            <Text text="{dcz>variacionH}" class="{dcz>colorClass}"/>
                                            <Text text="{dcz>variacionPct}" class="{dcz>colorClass}"/>

                                            <HBox
                                                alignItems="Center"
                                                justifyContent="Center"
                                                class="dczStatusCell">

                                                <VBox class="{dcz>statusDotClass}"/>
                                                <Text text="{dcz>estado}" class="dczStatusText"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>

                        <VBox
                            class="dczCard dczSummaryCard dczSummaryGreen">

                            <HBox
                                class="dczSummaryTitleRow"
                                alignItems="Center">

                                <HBox
                                    class="dczSummaryIcon dczSummaryIconGreen"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <core:Icon src="sap-icon://task" />
                                </HBox>

                                <Title
                                    text="Resumen por tipo de orden de la zona seleccionada"
                                    level="H3"
                                    class="dczCardTitle" />

                                <Button
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    class="dczSmallButton" />
                            </HBox>

                            <Table
                                items="{dcz>/resumenTipoOrden}"
                                class="dczSummaryTable dczSummaryTipoTable"
                                fixedLayout="true">

                                <columns>
                                    <Column width="28%"><Text text="Tipo de orden"/></Column>
                                    <Column width="8%" hAlign="Center"><Text text="OT"/></Column>
                                    <Column width="14%" hAlign="Center"><Text text="Horas plan (h)"/></Column>
                                    <Column width="14%" hAlign="Center"><Text text="Horas reales (h)"/></Column>
                                    <Column width="12%" hAlign="Center"><Text text="Variación (h)"/></Column>
                                    <Column width="12%" hAlign="Center"><Text text="Variación (%)"/></Column>
                                    <Column width="12%" hAlign="Center"><Text text="Estado"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <HBox
                                                alignItems="Center"
                                                class="dczSummaryNameCell">

                                                <VBox class="{dcz>dotClass}"/>
                                                <Text text="{dcz>tipoOrden}" class="dczTableText"/>
                                            </HBox>

                                            <Text text="{dcz>ot}" class="dczTableTextCenter"/>
                                            <Text text="{dcz>horasPlan}" class="dczTableTextCenter"/>
                                            <Text text="{dcz>horasReales}" class="dczTableTextCenter"/>
                                            <Text text="{dcz>variacionH}" class="{dcz>colorClass}"/>
                                            <Text text="{dcz>variacionPct}" class="{dcz>colorClass}"/>

                                            <HBox
                                                alignItems="Center"
                                                justifyContent="Center"
                                                class="dczStatusCell">

                                                <VBox class="{dcz>statusDotClass}"/>
                                                <Text text="{dcz>estado}" class="dczStatusText"/>
                                            </HBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>