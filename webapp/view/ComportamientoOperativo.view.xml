<mvc:View controllerName="mantenimiento.controller.ComportamientoOperativo" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:core="sap.ui.core" height="100%">
    <Page id="pageComportamiento" showHeader="false" class="coPageBackground">
        <content><VBox class="coPage">
            <HBox class="coHeader" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                <VBox class="coHeaderText"><Title text="Comportamiento operativo por responsables" level="H1" class="coTitle"/><Text text="Análisis del comportamiento de los responsables según las causas que explican sus desviaciones." class="coSubtitle"/></VBox>
                <HBox class="coFilters" alignItems="Center" wrap="Wrap">
                    <HBox class="coFilterCard coPeriodCard" alignItems="Center"><core:Icon src="sap-icon://calendar" class="coFilterIcon"/><VBox class="coFilterTexts"><Text text="Periodo" class="coFilterLabel"/><Select id="coPeriod" selectedKey="{data>/filtros/periodo}" change=".onPeriodoChange" class="coFilterSelect" items="{data>/opcionesPeriodo}"><items><core:Item key="{data>key}" text="{data>text}"/></items></Select></VBox></HBox>
                    <HBox class="coFilterCard coZoneCard" alignItems="Center"><core:Icon src="sap-icon://map" class="coFilterIcon"/><VBox class="coFilterTexts"><Text text="Zona" class="coFilterLabel"/><Select id="coZone" selectedKey="{data>/filtros/zona}" class="coFilterSelect" items="{data>/opcionesZona}"><items><core:Item key="{data>key}" text="{data>text}"/></items></Select></VBox></HBox>
                    <Button text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" press=".onApplyFilters" class="coApplyButton"/>
                </HBox>
            </HBox>
            <VBox class="coMainCard">
                <HBox class="coCardToolbar" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                    <HBox class="coTabs" alignItems="Center" wrap="Wrap">
                        <Button id="coTabTodas" text="Todas" icon="sap-icon://table-view" type="Emphasized" press=".onOriginTabPress" class="coTabButton coTabButtonActive"><customData><core:CustomData key="origin" value="TODAS" writeToDom="false"/></customData></Button>
                        <Button id="coTabInternas" text="Internas (operación)" icon="sap-icon://wrench" type="Transparent" press=".onOriginTabPress" class="coTabButton"><customData><core:CustomData key="origin" value="INTERNAL" writeToDom="false"/></customData></Button>
                        <Button id="coTabExternas" text="Externas (cliente/proveedor)" icon="sap-icon://shipping-status" type="Transparent" press=".onOriginTabPress" class="coTabButton"><customData><core:CustomData key="origin" value="EXTERNAL" writeToDom="false"/></customData></Button>
                        <Button id="coTabJustificadas" text="Justificadas" icon="sap-icon://employee-approvals" type="Transparent" press=".onOriginTabPress" class="coTabButton"><customData><core:CustomData key="origin" value="JUSTIFIED" writeToDom="false"/></customData></Button>
                    </HBox>
                    <HBox class="coOriginBox" alignItems="Center"><Text text="Origen activo:" class="coOriginLabel"/><Select id="coOrigin" selectedKey="{data>/filtros/origen}" change=".onOriginSelectChange" width="130px" class="coOriginSelect" items="{data>/opcionesOrigen}"><items><core:Item key="{data>key}" text="{data>text}"/></items></Select></HBox>
                </HBox>
                <VBox class="coTableWrapper"><Table id="idResponsablesTable" items="{data>/responsables}" class="coTable" fixedLayout="true" mode="None">
                    <columns>
                        <Column width="5%" hAlign="Center"><Text text="#" class="coTableHeaderText"/></Column><Column width="17%"><Text text="Responsable" class="coTableHeaderText"/></Column><Column width="9%" hAlign="Center"><Text text="OT desviadas" class="coTableHeaderText"/></Column><Column width="9%" hAlign="Center"><Text text="% del total" class="coTableHeaderText"/></Column><Column width="24%"><Text text="Principal causa" class="coTableHeaderText"/></Column><Column width="10%" hAlign="Center"><Text text="Tipo de OT" class="coTableHeaderText"/></Column><Column width="15%" hAlign="Center"><Text text="Cumplimiento" class="coTableHeaderText"/></Column><Column width="11%" hAlign="Center"><Text text="Riesgo" class="coTableHeaderText"/></Column>
                    </columns>
                    <items><ColumnListItem class="coTableRow" vAlign="Middle" type="Inactive"><cells>
                        <Text text="{data>id}" textAlign="Center" class="coRankText"/>
                        <HBox alignItems="Center" class="coResponsibleCell"><Avatar displaySize="XS" backgroundColor="{path: 'data>responsableId', formatter: '.getAvatarColor'}" initials="{data>initials}" class="coAvatar"/><Link text="{data>responsable}" press=".onResponsablePress" class="coResponsibleLink"/></HBox>
                        <Text text="{data>otDesviadas}" textAlign="Center" class="coOtDeviationText"/><Text text="{data>porcentajeTotal}" textAlign="Center" class="coPercentText"/>
                        <HBox class="coCauseCard" alignItems="Center"><HBox class="coCauseIconBox" alignItems="Center" justifyContent="Center"><core:Icon src="{data>causaIcon}" class="coCauseIcon"/></HBox><VBox class="coCauseTexts"><Text text="{data>causaPrincipal}" class="coCauseTitle" wrapping="false"/><Text text="{data>causaDetalle}" class="coCauseDetail" wrapping="true"/></VBox></HBox>
                        <HBox justifyContent="Center"><Text text="{data>tipoOt}" class="coTipoOtBadge"/></HBox>
                        <VBox class="coComplianceCell" alignItems="Center"><Text text="{data>cumplimiento}" class="coComplianceValue"/><ProgressIndicator percentValue="{data>cumplimientoValue}" displayValue="" state="{data>riesgoState}" class="coComplianceProgress"/></VBox>
                        <HBox justifyContent="Center"><ObjectStatus text="{data>riesgo}" state="{data>riesgoState}" class="coRiskBadge"/></HBox>
                    </cells></ColumnListItem></items>
                </Table></VBox>
                <HBox class="coPagination" justifyContent="SpaceBetween" alignItems="Center"><Text text="{= 'Responsables con desviaciones: ' + ${data>/resumen/totalResponsables}}" class="coPaginationText"/><Text text="{data>/filtros/fechaDesde} - {data>/filtros/fechaHasta}" class="coPaginationText"/></HBox>
            </VBox>
        </VBox></content>
    </Page>
</mvc:View>
