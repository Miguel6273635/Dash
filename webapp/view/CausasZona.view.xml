<mvc:View
    controllerName="mantenimiento.controller.CausasZona"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">

    <Page id="pageCausasZona" showHeader="false" class="CausasZonaView">
        <content>
            <!-- CORRECCIÓN: Un único contenedor principal con ambas clases -->
            <VBox id="pageContainer" class="czContainer">
            <!-- ========================================== -->
         <!-- 1. ENCABEZADO Y FILTROS (INTEGRADOS)       -->

<HBox class="czHeader" justifyContent="SpaceBetween" alignItems="End" wrap="Wrap">
    
    <!-- LADO IZQUIERDO: Título -->
    <VBox>
        <Link text="&lt; Volver a cumplimiento general de órdenes" press=".onNavBack" class="czBackLink"/>
        <Title text="Causas por zona" class="czTitle"/>
        <Text text="Detalle de las causas de incumplimiento del plan por zona y semana." class="czSubtitle"/>
    </VBox>

    <!-- LADO DERECHO: Filtros (Ahora dentro del mismo HBox) -->
    <HBox alignItems="End" wrap="Wrap">
        <VBox class="czFilterItem sapUiSmallMarginEnd">
            <Label text="Semana"/>
            <DatePicker value="Semana 18 (29 abr - 5 may 2024)" displayFormat="dd/MM/yyyy" />
        </VBox>
        <VBox class="czFilterItem sapUiSmallMarginEnd">
            <Label text="Zona"/>
            <Select selectedKey="norte">
                <items><core:Item key="norte" text="Norte" /></items>
            </Select>
        </VBox>
        <VBox class="czFilterItem">
            <Button text="Aplicar Filtros" icon="sap-icon://filter" type="Emphasized" class="czFilterButton"/>
        </VBox>
    </HBox>

</HBox>

<!-- ========================================== -->
<!-- 2. TARJETAS KPI (DISEÑO DEGRADADO)         -->
<!-- ========================================== -->
<HBox class="czKpiRow" wrap="Wrap">

    <!-- KPI 1: OT PLANEADAS -->
    <VBox class="czKpiCard czKpiBlue">
        <HBox alignItems="Center">
            <VBox class="czKpiIconBox czBlueSoft">
                <core:Icon src="sap-icon://checklist-item-2" class="czKpiIcon"/>
            </VBox>
            <VBox>
                <Text text="OT PLANEADAS" class="czKpiLabel"/>
                <Title text="84" class="czKpiNumber czBlueText"/>
                <Text text="100% del plan" class="czKpiSub"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- KPI 2: OT EJECUTADAS -->
    <VBox class="czKpiCard czKpiGreen">
        <HBox alignItems="Center">
            <VBox class="czKpiIconBox czGreenSoft">
                <core:Icon src="sap-icon://accept" class="czKpiIcon"/>
            </VBox>
            <VBox>
                <Text text="OT EJECUTADAS" class="czKpiLabel"/>
                <Title text="62" class="czKpiNumber czGreenText"/>
                <Text text="74% del plan" class="czKpiSub"/>
            </VBox>
        </HBox>
    </VBox>

    <!-- KPI 3: OT NO EJECUTADAS -->
    <VBox class="czKpiCard czKpiRed">
        <HBox alignItems="Center">
            <VBox class="czKpiIconBox czRedSoft">
                <core:Icon src="sap-icon://message-error" class="czKpiIcon"/>
            </VBox>
            <VBox>
                <Text text="OT NO EJECUTADAS" class="czKpiLabel"/>
                <Title text="22" class="czKpiNumber czRedText"/>
                <Text text="26% del plan" class="czKpiSub"/>
            </VBox>
        </HBox>
    </VBox>

<!-- ========================================== -->
<!-- KPI 4: CUMPLIMIENTO (ESTILO MORADO)        -->
<!-- ========================================== -->
<VBox class="czKpiCard czKpiPurple">
    <HBox alignItems="Center">
        <VBox class="czKpiIconBox czPurpleSoft">
            <!-- CAMBIO DE ÍCONO -->
        	<core:Icon src="sap-icon://line-charts" class="czKpiIcon"/>
        </VBox>
        <VBox>
            <Text text="CUMPLIMIENTO" class="czKpiLabel"/>
            <!-- CAMBIO DE CLASE DE COLOR -->
            <Title text="74%" class="czKpiNumber czPurpleText"/>
            <Text text="-22 OT vs plan" class="czKpiSub"/>
        </VBox>
    </HBox>
</VBox>

</HBox>
<!-- ======================================================== -->
<!-- 3. LAYOUT PRINCIPAL (TABLA 75% / RESUMEN 25%)            -->
<!-- ======================================================== -->
<l:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="1" class="sapUiSmallMarginTop">
    <l:content>

        <!-- COLUMNA IZQUIERDA: TABLA (Ocupa 9 de 12 espacios = 75%) -->
        <VBox>
            <layoutData><l:GridData span="XL9 L9 M12 S12" /></layoutData>
            
            <VBox class="czTableCard">
                <!-- Encabezado de la Tarjeta -->
                <HBox class="czTableTop" justifyContent="SpaceBetween" alignItems="Center">
                    <Title text="DETALLE DE INCUMPLIMIENTO POR ZONA NORTE (22)" class="czSectionTitle"/>
                    <core:Icon src="sap-icon://information" color="#94a3b8"/>
                </HBox>

                <!-- Barra de Filtros Interna -->
                <OverflowToolbar class="czTableToolbar">
                    <SegmentedButton selectedKey="todas">
                        <items>
                            <SegmentedButtonItem text="Todas" key="todas"/>
                            <SegmentedButtonItem text="Preventivas" key="preventivas"/>
                            <SegmentedButtonItem text="Correctivas" key="correctivas"/>
                            <SegmentedButtonItem text="Call Center" key="callcenter"/>
                        </items>
                    </SegmentedButton>
                    <ToolbarSpacer/>
                    <Text text="Filtro activo: Todas" class="czFilterActiveText"/>
                </OverflowToolbar>

                                          <!-- Tabla Inteligente: Evita cortes de texto y usa Popin -->
                                <Table id="idIncumplimientoTable" items="{/IncumplimientosData}" class="czInnerTable" alternateRowColors="true">
                                    <columns>
                                        <Column width="4.5rem"><Text text="OT" wrapping="true"/></Column>
                                        <!-- DemandPopin: Si no cabe, se pone debajo elegante -->
                                        <Column width="5rem" demandPopin="true" minScreenWidth="Tablet"><Text text="EQUIPO" wrapping="true"/></Column>
                                        <Column width="6.5rem"><Text text="TIPO OT" wrapping="true"/></Column>
                                        <Column width="8rem"><Text text="CLIENTE" wrapping="true"/></Column>
                                        <Column><Text text="CAUSA INCUMPLIMIENTO" wrapping="true"/></Column>
                                        <!-- DemandPopin para el responsable -->
                                        <Column width="7rem" demandPopin="true" minScreenWidth="Desktop"><Text text="RESPONSABLE" wrapping="true"/></Column>
                                        <Column width="4.5rem" hAlign="End"><Text text="DÍAS ▾" wrapping="true"/></Column>
                                        <Column width="7rem"><Text text="ESTADO" wrapping="true"/></Column>
                                    </columns>
                                    <items>
                                        <ColumnListItem vAlign="Middle">
                                            <cells>
                                                <Link text="{OT}" class="czLinkText" wrapping="true"/>
                                                <Text text="{Equipo}" class="czRowText" wrapping="true"/>
                                                <ObjectStatus class="statusTag {= 'tag' + ${StatusTipo} }" text="{TipoOT}"/>
                                                <Text text="{Cliente}" class="czRowText" wrapping="true"/>
                                                <ObjectStatus class="statusTag {= 'tag' + ${StatusCausa} }" text="{CausaIncumplimiento}"/>
                                                <Text text="{Responsable}" class="czRowText" wrapping="true"/>
                                                <Text text="{DiasAtraso}" class="czRowText czRedNumber" wrapping="true"/>
                                                <ObjectStatus class="statusTag tagError" text="{Estado}"/>
                                            </cells>
                                        </ColumnListItem>
                                    </items>
                                </Table>

                <!-- Paginación Footer -->
                <OverflowToolbar class="czTableFooter">
                    <Text text="Mostrando 1 a 3 de 22 órdenes" class="sapUiSmallMarginBegin czFooterText"/>
                    <ToolbarSpacer />
                    <Button type="Transparent" icon="sap-icon://slim-arrow-left" />
                    <Button text="1" type="Emphasized"/>
                    <Button text="2" type="Transparent"/>
                    <Button type="Transparent" icon="sap-icon://slim-arrow-right" />
                    <ToolbarSpacer />
                    <Select width="120px" selectedKey="10" class="sapUiSmallMarginEnd">
                        <items><core:Item key="10" text="10 por página" /></items>
                    </Select>
                </OverflowToolbar>
            </VBox>
        </VBox>

        <!-- COLUMNA DERECHA: RESUMEN (Ocupa 3 de 12 espacios = 25%) -->
        <VBox>
            <layoutData><l:GridData span="XL3 L3 M12 S12" /></layoutData>
            <!-- El contenido del resumen irá aquí en el siguiente paso -->
        </VBox>

    </l:content>
</l:Grid>


            </VBox>
        </content>
    </Page>
</mvc:View>
