<mvc:View
    controllerName="mantenimiento.controller.CausasZona"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls"
    xmlns:viz.feeds="sap.viz.ui5.controls.common.feeds"
    xmlns:viz.data="sap.viz.ui5.data"

    xmlns:mc="sap.suite.ui.microchart">

    <Page id="pageCausasZona" showHeader="false" class="CausasZonaView">
        <content>
            <VBox id="pageContainer" class="czContainer">
                
                <!-- 1. ENCABEZADO Y FILTROS -->
                <HBox class="czHeader" justifyContent="SpaceBetween" alignItems="End" wrap="Wrap" width="100%">
                    <VBox class="sapUiSmallMarginBottom">
                        <Link text="&lt; Volver a cumplimiento general de órdenes" press=".onNavBack" class="czBackLink"/>
                        <Title text="Causas por zona" class="czTitle"/>
                        <Text text="Detalle de las causas de incumplimiento del plan por zona y semana." class="czSubtitle"/>
                    </VBox>
                    <HBox alignItems="End" class="czFilterPanel sapUiSmallMarginBottom" wrap="Wrap">
                        <VBox class="czFilterItem"><Label text="Semana" class="czFilterLabel"/><DatePicker value="Semana 18 (29 abr - 5 may 2024)" displayFormat="dd/MM/yyyy" class="czFilterInput"/></VBox>
                        <VBox class="czFilterItem"><Label text="Zona" class="czFilterLabel"/><Select selectedKey="norte" class="czFilterInput"><items><core:Item key="norte" text="Norte" /></items></Select></VBox>
                        <VBox class="czFilterItem"><Button text="Aplicar Filtros" icon="sap-icon://filter" class="czFilterButton"/></VBox>
                    </HBox>
                </HBox>

                <!-- 2. TARJETAS KPI -->
                <HBox class="czKpiRow" wrap="Wrap">
                    <VBox class="czKpiCard czKpiBlue"><HBox alignItems="Center"><VBox class="czKpiIconBox czBlueSoft"><core:Icon src="sap-icon://inspection" class="czKpiIcon"/></VBox><VBox><Text text="OT PLANEADAS" class="czKpiLabel"/><Title text="84" class="czKpiNumber czBlueText"/><Text text="100% del plan" class="czKpiSub"/></VBox></HBox></VBox>
                    <VBox class="czKpiCard czKpiGreen"><HBox alignItems="Center"><VBox class="czKpiIconBox czGreenSoft"><core:Icon src="sap-icon://accept" class="czKpiIcon"/></VBox><VBox><Text text="OT EJECUTADAS" class="czKpiLabel"/><Title text="62" class="czKpiNumber czGreenText"/><Text text="74% del plan" class="czKpiSub"/></VBox></HBox></VBox>
                    <VBox class="czKpiCard czKpiRed"><HBox alignItems="Center"><VBox class="czKpiIconBox czRedSoft"><core:Icon src="sap-icon://message-error" class="czKpiIcon"/></VBox><VBox><Text text="OT NO EJECUTADAS" class="czKpiLabel"/><Title text="22" class="czKpiNumber czRedText"/><Text text="26% del plan" class="czKpiSub"/></VBox></HBox></VBox>
                    <VBox class="czKpiCard czKpiPurple"><HBox alignItems="Center"><VBox class="czKpiIconBox czPurpleSoft"><core:Icon src="sap-icon://line-charts" class="czKpiIcon"/></VBox><VBox><Text text="CUMPLIMIENTO" class="czKpiLabel"/><Title text="74%" class="czKpiNumber czPurpleText"/><Text text="-22 OT vs plan" class="czKpiSub"/></VBox></HBox></VBox>
                </HBox>

                <!-- 3. LAYOUT PRINCIPAL (TABLA 75% / DERECHA 25%)-->
                <l:Grid defaultSpan="XL12 L12 M12 S12" hSpacing="1" class="sapUiSmallMarginTop">
                    <l:content>
                        
                        <!-- COLUMNA IZQUIERDA: TABLA (75%) -->
                        <VBox>
                            <layoutData><l:GridData span="XL9 L9 M12 S12" /></layoutData>
                            
                            <VBox class="dashCard sapUiContentPadding">
                                <HBox alignItems="Center" class="sapUiSmallMarginBottom">
                                    <Title text="DETALLE DE INCUMPLIMIENTO POR ZONA NORTE (22)" class="czSectionTitle"/>
                                    <core:Icon src="sap-icon://information" class="sapUiTinyMarginBegin" color="#94a3b8"/>
                                </HBox>
                                
                                <OverflowToolbar class="czTableToolbar">
                                    <SegmentedButton selectedKey="todas">
                                        <items>
                                            <SegmentedButtonItem text="Todas" key="todas"/>
                                            <SegmentedButtonItem text="Preventivas" key="preventivas"/>
                                            <SegmentedButtonItem text="Correctivas" key="correctivas"/>
                                            <SegmentedButtonItem text="Call Center" key="callcenter"/>
                                        </items>
                                    </SegmentedButton>
                                    <ToolbarSpacer/>
                                    <Text text="Filtro activo: Todas" class="czFilterActiveText"/>
                                </OverflowToolbar>

                                <ScrollContainer width="100%" horizontal="true" vertical="false" class="czTableScroll">
                                    <Table id="idIncumplimientoTable" items="{/IncumplimientosData}" alternateRowColors="true" class="czInnerTable">
                                        <columns>
                                            <Column width="6.5rem"><Text text="OT"/></Column>
                                            <Column width="5.5rem"><Text text="EQUIPO"/></Column>
                                            <Column width="7.5rem"><Text text="TIPO OT"/></Column>
                                            <Column width="10rem"><Text text="CLIENTE"/></Column>
                                            <Column width="15rem"><Text text="CAUSA INCUMPLIMIENTO"/></Column>
                                            <Column width="10rem"><Text text="RESPONSABLE"/></Column>
                                            <Column width="6rem" hAlign="End"><Text text="DÍAS ▾"/></Column>
                                            <Column width="8.5rem"><Text text="ESTADO"/></Column>
                                        </columns>
                                        
                                        <items>
                                            <ColumnListItem vAlign="Middle">
                                                <cells>
                                                    <Link text="{OT}" class="czLinkText" wrapping="true"/>
                                                    <Text text="{Equipo}" class="czRowText" wrapping="true"/>
                                                    
                                                    <!-- === 1. PÍLDORA CORREGIDA: TIPO OT === -->
                                                    <ObjectStatus class="statusTag" text="{TipoOT}" state="{= ${TipoOT} === 'Preventivo' ? 'Information' : 'Warning' }"/>
                                                    
                                                    <Text text="{Cliente}" class="czRowText" wrapping="true"/>
                                                    
                                                    <!-- === 2. PÍLDORA CORREGIDA: CAUSA INCUMPLIMIENTO === -->
                                                    <ObjectStatus class="statusTag" text="{CausaIncumplimiento}" state="{= ${StatusCausa} === 'Error' ? 'Error' : (${StatusCausa} === 'Warning' ? 'Warning' : 'None') }"/>
                                                    
                                                    <HBox alignItems="Center">
                                                        <core:Icon src="sap-icon://employee" color="#94a3b8" class="sapUiTinyMarginEnd"/>
                                                        <Text text="{Responsable}" class="czRowText" wrapping="true"/>
                                                    </HBox>
                                                    
                                                    <Text text="{DiasAtraso}" class="czRowText czRedNumber" />
                                                    
                                                    <!-- === 3. PÍLDORA CORREGIDA: ESTADO === -->
                                                    <ObjectStatus class="statusTag" text="{Estado}" state="Error"/>
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </ScrollContainer>
                                
                                <OverflowToolbar class="czTableFooter">
                                    <Text text="Mostrando 1 a 6 de 22 órdenes" class="czFooterText"/>
                                    <ToolbarSpacer />
                                    <Button type="Transparent" icon="sap-icon://slim-arrow-left" />
                                    <Button text="1" type="Emphasized"/>
                                    <Button text="2" type="Transparent"/>
                                    <Button type="Transparent" icon="sap-icon://slim-arrow-right" />
                                    <ToolbarSpacer />
                                    <Select width="120px" selectedKey="10">
                                        <items><core:Item key="10" text="10 por página" /></items>
                                    </Select>
                                </OverflowToolbar>
                            </VBox>
                        </VBox>
<!-- COLUMNA DERECHA: GRÁFICOS (25%) -->
<VBox>
    <layoutData><l:GridData span="XL3 L3 M12 S12" /></layoutData>
    
    <VBox class="dashCard sapUiContentPadding">
        <HBox alignItems="Center" class="sapUiMediumMarginBottom">
            <Title text="RESUMEN" class="czSectionTitle"/>
            <core:Icon src="sap-icon://pie-chart" class="sapUiTinyMarginBegin" color="#94a3b8"/>
        </HBox>

        <!-- GRÁFICO 1: BARRAS HORIZONTALES (VizFrame) -->
        <VBox class="sapUiLargeMarginBottom">
            <Text text="OT NO EJECUTADAS POR CAUSA" class="czChartTitle sapUiSmallMarginBottom" wrapping="true"/>
            
            <viz:VizFrame id="barChartCausas" uiConfig="{applicationSet:'fiori'}" height="220px" width="100%" vizType="bar">
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{/ResumenCausas}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Causa" value="{Causa}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="OTs" value="{Cantidad}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem uid="valueAxis" type="Measure" values="OTs" />
                    <viz.feeds:FeedItem uid="categoryAxis" type="Dimension" values="Causa" />
                </viz:feeds>
            </viz:VizFrame>
        </VBox>

        <Toolbar width="100%" class="sapUiSmallMarginBottom" design="Transparent"/>

        <!-- GRÁFICO 2: DONA (VizFrame) -->
        <VBox>
            <Text text="OT NO EJECUTADAS POR TIPO" class="czChartTitle sapUiSmallMarginBottom" wrapping="true"/>
            
            <viz:VizFrame id="donutChartTipos" uiConfig="{applicationSet:'fiori'}" height="240px" width="100%" vizType="donut">
                <viz:dataset>
                    <viz.data:FlattenedDataset data="{/ResumenTipos}">
                        <viz.data:dimensions>
                            <viz.data:DimensionDefinition name="Tipo" value="{Tipo}" />
                        </viz.data:dimensions>
                        <viz.data:measures>
                            <viz.data:MeasureDefinition name="OTs" value="{Cantidad}" />
                        </viz.data:measures>
                    </viz.data:FlattenedDataset>
                </viz:dataset>
                <viz:feeds>
                    <viz.feeds:FeedItem uid="size" type="Measure" values="OTs" />
                    <viz.feeds:FeedItem uid="color" type="Dimension" values="Tipo" />
                </viz:feeds>
            </viz:VizFrame>
        </VBox>
        
    </VBox>
</VBox>


                    </l:content>
                </l:Grid>
            </VBox>
        </content>
    </Page>
</mvc:View>
