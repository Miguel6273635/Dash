<mvc:View
    controllerName="mantenimiento.controller.VistaSupervisor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        id="vistaSupervisorPage"
        showHeader="false"
        enableScrolling="false"
        busy="{supervisor>/busy}"
        busyIndicatorDelay="0"
        class="vistaSupervisorPage">

        <content>

            <VBox class="vsDashboard">

                <VBox class="vsHeaderBlock">

                    <Title
                        text="Vista Supervisor"
                        level="H1"
                        class="vsPageTitle" />

                    <Text
                        text="Resumen ejecutivo de recursos asignados"
                        class="vsPageSubtitle" />

                </VBox>

                <!-- FILTROS -->

                <HBox
                    class="vsFilterRow"
                    alignItems="End">

                    <VBox
                        class="vsFilterCard vsFilterPeriod">

                        <Label
                            text="Periodo"
                            class="vsFilterLabel" />

                        <Select
                            width="100%"
                            selectedKey="{supervisor>/filters/period}"
                            change=".onPeriodChange"
                            items="{supervisor>/catalogs/periods}"
                            class="vsFilterControl">

                            <core:Item
                                key="{supervisor>key}"
                                text="{supervisor>text}" />

                        </Select>

                    </VBox>

                    <VBox class="vsFilterCard">

                        <Label
                            text="Fecha desde"
                            class="vsFilterLabel" />

                        <DatePicker
                            width="100%"
                            value="{supervisor>/filters/dateFrom}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onDateChange"
                            class="vsFilterControl" />

                    </VBox>

                    <VBox class="vsFilterCard">

                        <Label
                            text="Fecha hasta"
                            class="vsFilterLabel" />

                        <DatePicker
                            width="100%"
                            value="{supervisor>/filters/dateTo}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onDateChange"
                            class="vsFilterControl" />

                    </VBox>

                    <VBox
                        class="vsFilterCard vsFilterWide">

                        <Label
                            text="Supervisor"
                            class="vsFilterLabel" />

                        <Select
                            width="100%"
                            selectedKey="{supervisor>/filters/supervisor}"
                            change=".onFilterChange"
                            items="{supervisor>/catalogs/supervisors}"
                            class="vsFilterControl">

                            <core:Item
                                key="{supervisor>key}"
                                text="{supervisor>text}" />

                        </Select>

                    </VBox>

                    <VBox
                        class="vsFilterCard vsFilterShift">

                        <Label
                            text="Turno"
                            class="vsFilterLabel" />

                        <Select
                            width="100%"
                            selectedKey="{supervisor>/filters/shift}"
                            change=".onFilterChange"
                            items="{supervisor>/catalogs/shifts}"
                            class="vsFilterControl">

                            <core:Item
                                key="{supervisor>key}"
                                text="{supervisor>text}" />

                        </Select>

                    </VBox>

                    <VBox
                        class="vsApplyButtonBox"
                        justifyContent="Center">

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            press=".onApplyFilters"
                            class="vsApplyButton" />

                    </VBox>

                </HBox>

                <!-- KPIs -->

                <HBox class="vsKpiRow">

                    <VBox
                        class="vsKpiCard vsKpiBlue vsKpiAssigned">

                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://group"
                                    class="vsKpiIcon" />

                            </HBox>

                            <VBox class="vsKpiTextBlock">

                                <Text
                                    text="Recursos asignados"
                                    class="vsKpiLabel" />

                                <Text
                                    text="{supervisor>/kpis/assigned}"
                                    class="vsKpiValue" />

                                <Text
                                    text="Total asignados"
                                    class="vsKpiHelper" />

                            </VBox>

                            <VBox class="vsAssignedBreakdown">

                                <HBox
                                    class="vsBreakdownRow"
                                    alignItems="Center">

                                    <core:Icon
                                        src="sap-icon://employee"
                                        class="vsBreakdownIcon" />

                                    <Text
                                        text="{supervisor>/kpis/mechanics}"
                                        class="vsBreakdownValue" />

                                    <Text
                                        text="mecánicos"
                                        class="vsBreakdownLabel" />

                                </HBox>

                                <HBox
                                    class="vsBreakdownRow"
                                    alignItems="Center">

                                    <core:Icon
                                        src="sap-icon://employee"
                                        class="vsBreakdownIcon" />

                                    <Text
                                        text="{supervisor>/kpis/helpers}"
                                        class="vsBreakdownValue" />

                                    <Text
                                        text="ayudantes"
                                        class="vsBreakdownLabel" />

                                </HBox>

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- CAPACIDAD -->

                    <VBox
                        class="vsKpiCard vsKpiGreen">

                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://history"
                                    class="vsKpiIcon" />

                            </HBox>

                            <VBox class="vsKpiTextBlock">

                                <Text
                                    text="Capacidad disponible"
                                    class="vsKpiLabel" />

                                <Text
                                    text="{supervisor>/kpis/availableCapacity}"
                                    class="vsKpiValue" />

                                <Text
                                    text="Total disponible"
                                    class="vsKpiHelper" />

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- CARGA -->

                    <VBox
                        busy="{supervisor>/operationalBusy}"
                        busyIndicatorDelay="0"
                        class="vsKpiCard vsKpiOrange">

                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://task"
                                    class="vsKpiIcon" />

                            </HBox>

                            <VBox class="vsKpiTextBlock">

                                <Text
                                    text="Carga programada"
                                    class="vsKpiLabel" />

                                <Text
                                    text="{supervisor>/kpis/scheduledLoad}"
                                    class="vsKpiValue" />

                                <Text
                                    text="Total programada"
                                    class="vsKpiHelper" />

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- SOBRE CAPACIDAD -->

                    <VBox
                        class="vsKpiCard vsKpiPurple">

                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://message-warning"
                                    class="vsKpiIcon" />

                            </HBox>

                            <VBox class="vsKpiTextBlock">

                                <Text
                                    text="Recursos sobre capacidad"
                                    class="vsKpiLabel" />

                                <Text
                                    text="{supervisor>/kpis/overCapacity}"
                                    class="vsKpiValue" />

                                <Text
                                    text="Total recursos"
                                    class="vsKpiHelper" />

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- CUMPLIMIENTO -->

                    <VBox
                        class="vsKpiCard vsKpiRed">

                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://target-group"
                                    class="vsKpiIcon" />

                            </HBox>

                            <VBox class="vsKpiTextBlock">

                                <Text
                                    text="Cumplimiento operativo"
                                    class="vsKpiLabel" />

                                <HBox
                                    alignItems="Center"
                                    class="vsComplianceLine">

                                    <Text
                                        text="{supervisor>/kpis/compliance}"
                                        class="vsKpiValue" />

                                    <Text
                                        text="{supervisor>/kpis/complianceTarget}"
                                        class="vsKpiMeta" />

                                </HBox>

                                <Text
                                    text="{supervisor>/kpis/complianceGap}"
                                    class="vsKpiAlert" />

                            </VBox>

                        </HBox>

                    </VBox>

                </HBox>

                <!-- CONTENIDO -->

                <HBox
                    width="100%"
                    fitContainer="true"
                    class="vsMainRow"
                    alignItems="Stretch">

                    <!-- UTILIZACIÓN -->

                    <VBox class="vsLeftColumn">

                        <layoutData>

                            <FlexItemData
                                growFactor="42"
                                shrinkFactor="1"
                                baseSize="0%" />

                        </layoutData>

                        <VBox
                            busy="{supervisor>/operationalBusy}"
                            busyIndicatorDelay="0"
                            class="vsCard vsUtilizationCard">

                            <Title
                                text="Utilización de recursos"
                                level="H3"
                                class="vsSectionTitle" />

                            <Text
                                text="Resumen de desempeño por nivel de utilización"
                                class="vsSectionSubtitle" />

                            <HBox class="vsUtilizationGrid">

                                <!-- CRÍTICO -->

                                <VBox
                                    class="vsUtilColumn vsUtilCritical">

                                    <VBox class="vsUtilHeader">

                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://trend-up"
                                                    class="vsUtilIcon" />

                                            </HBox>

                                            <Text
                                                text="Crítico"
                                                class="vsUtilTitle" />

                                            <Text
                                                text="{supervisor>/utilizationMeta/criticalCount}"
                                                class="vsUtilBadge" />

                                        </HBox>

                                        <Text
                                            text="{supervisor>/utilizationMeta/criticalRange}"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />

                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/critical}">

                                        <items>

                                            <VBox class="vsResourceTile">

                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilizationText}"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />

                                                </HBox>

                                            </VBox>

                                        </items>

                                    </VBox>

                                </VBox>

                                <!-- ALTO -->

                                <VBox
                                    class="vsUtilColumn vsUtilHigh">

                                    <VBox class="vsUtilHeader">

                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://bar-chart"
                                                    class="vsUtilIcon" />

                                            </HBox>

                                            <Text
                                                text="Alto"
                                                class="vsUtilTitle" />

                                            <Text
                                                text="{supervisor>/utilizationMeta/highCount}"
                                                class="vsUtilBadge" />

                                        </HBox>

                                        <Text
                                            text="{supervisor>/utilizationMeta/highRange}"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />

                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/high}">

                                        <items>

                                            <VBox class="vsResourceTile">

                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilizationText}"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />

                                                </HBox>

                                            </VBox>

                                        </items>

                                    </VBox>

                                </VBox>

                                <!-- NORMAL -->

                                <VBox
                                    class="vsUtilColumn vsUtilNormal">

                                    <VBox class="vsUtilHeader">

                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://favorite"
                                                    class="vsUtilIcon" />

                                            </HBox>

                                            <Text
                                                text="Normal"
                                                class="vsUtilTitle" />

                                            <Text
                                                text="{supervisor>/utilizationMeta/normalCount}"
                                                class="vsUtilBadge" />

                                        </HBox>

                                        <Text
                                            text="{supervisor>/utilizationMeta/normalRange}"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />

                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/normal}">

                                        <items>

                                            <VBox class="vsResourceTile">

                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilizationText}"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />

                                                </HBox>

                                            </VBox>

                                        </items>

                                    </VBox>

                                </VBox>

                                <!-- BAJO -->

                                <VBox
                                    class="vsUtilColumn vsUtilLow">

                                    <VBox class="vsUtilHeader">

                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://accept"
                                                    class="vsUtilIcon" />

                                            </HBox>

                                            <Text
                                                text="Bajo"
                                                class="vsUtilTitle" />

                                            <Text
                                                text="{supervisor>/utilizationMeta/lowCount}"
                                                class="vsUtilBadge" />

                                        </HBox>

                                        <Text
                                            text="{supervisor>/utilizationMeta/lowRange}"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />

                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/low}">

                                        <items>

                                            <VBox class="vsResourceTile">

                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilizationText}"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />

                                                </HBox>

                                            </VBox>

                                        </items>

                                    </VBox>

                                </VBox>

                            </HBox>

                        </VBox>

                    </VBox>

                    <!-- DERECHA -->

                    <VBox class="vsRightColumn">

                        <layoutData>

                            <FlexItemData
                                growFactor="58"
                                shrinkFactor="1"
                                baseSize="0%" />

                        </layoutData>

                        <!-- SERVICIOS -->

                        <VBox
                            busy="{supervisor>/operationalBusy}"
                            busyIndicatorDelay="0"
                            class="vsCard vsPressureCard">

                            <Title
                                text="Presión por tipo de servicio"
                                level="H3"
                                class="vsSectionTitle" />

                            <HBox
                                class="vsPressureContent"
                                alignItems="Center"
                                justifyContent="Center">

                                <HBox
                                    id="serviceDonut"
                                    class="vsDonut"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <VBox
                                        class="vsDonutCenter"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <Text
                                            text="Carga"
                                            class="vsDonutText" />

                                        <Text
                                            text="por servicio"
                                            class="vsDonutText" />

                                    </VBox>

                                </HBox>

                                <VBox class="vsServiceList">

                                    <HBox
                                        class="vsServiceRow"
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                        <Text
                                            text="{supervisor>/serviceTypes/0/label}"
                                            class="vsServiceName" />

                                        <VBox alignItems="End">

                                            <Text
                                                text="{supervisor>/serviceTypes/0/percentage}"
                                                class="vsServicePercent" />

                                            <Text
                                                text="{supervisor>/serviceTypes/0/hours}"
                                                class="vsServiceHours" />

                                        </VBox>

                                    </HBox>

                                    <HBox
                                        class="vsServiceRow"
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                        <Text
                                            text="{supervisor>/serviceTypes/1/label}"
                                            class="vsServiceName" />

                                        <VBox alignItems="End">

                                            <Text
                                                text="{supervisor>/serviceTypes/1/percentage}"
                                                class="vsServicePercent" />

                                            <Text
                                                text="{supervisor>/serviceTypes/1/hours}"
                                                class="vsServiceHours" />

                                        </VBox>

                                    </HBox>

                                    <HBox
                                        class="vsServiceRow"
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                        <Text
                                            text="{supervisor>/serviceTypes/2/label}"
                                            class="vsServiceName" />

                                        <VBox alignItems="End">

                                            <Text
                                                text="{supervisor>/serviceTypes/2/percentage}"
                                                class="vsServicePercent" />

                                            <Text
                                                text="{supervisor>/serviceTypes/2/hours}"
                                                class="vsServiceHours" />

                                        </VBox>

                                    </HBox>

                                </VBox>

                            </HBox>

                            <HBox
                                class="vsPressureFooter"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://target-group"
                                    class="vsPressureFooterIcon" />

                                <Text
                                    text="Total carga programada:"
                                    class="vsPressureFooterLabel" />

                                <Text
                                    text="{supervisor>/serviceTotalHours}"
                                    class="vsPressureFooterValue" />

                            </HBox>

                        </VBox>

                        <!-- MATERIALES -->

                        <VBox
                            busy="{supervisor>/materialsBusy}"
                            busyIndicatorDelay="0"
                            class="vsCard vsMaterialsCard">

                            <Title
                                text="Materiales con mayor consumo"
                                level="H3"
                                class="vsSectionTitle" />

                            <HBox class="vsMaterialsGrid">

                                <VBox
                                    class="vsMaterialTile vsMaterialOrange"
                                    alignItems="Center">

                                    <Text
                                        text="{supervisor>/materials/0/name}"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="{supervisor>/materials/0/quantity}"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="{supervisor>/materials/0/unit}"
                                            class="vsMaterialUnit" />

                                    </HBox>

                                    <HBox class="vsMaterialLine" />

                                </VBox>

                                <VBox
                                    class="vsMaterialTile vsMaterialBlue"
                                    alignItems="Center">

                                    <Text
                                        text="{supervisor>/materials/1/name}"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="{supervisor>/materials/1/quantity}"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="{supervisor>/materials/1/unit}"
                                            class="vsMaterialUnit" />

                                    </HBox>

                                    <HBox class="vsMaterialLine" />

                                </VBox>

                                <VBox
                                    class="vsMaterialTile vsMaterialPurple"
                                    alignItems="Center">

                                    <Text
                                        text="{supervisor>/materials/2/name}"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="{supervisor>/materials/2/quantity}"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="{supervisor>/materials/2/unit}"
                                            class="vsMaterialUnit" />

                                    </HBox>

                                    <HBox class="vsMaterialLine" />

                                </VBox>

                                <VBox
                                    class="vsMaterialTile vsMaterialGreen"
                                    alignItems="Center">

                                    <Text
                                        text="{supervisor>/materials/3/name}"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="{supervisor>/materials/3/quantity}"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="{supervisor>/materials/3/unit}"
                                            class="vsMaterialUnit" />

                                    </HBox>

                                    <HBox class="vsMaterialLine" />

                                </VBox>

                            </HBox>

                        </VBox>

                    </VBox>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>