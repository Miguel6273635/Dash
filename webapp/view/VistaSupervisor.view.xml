<mvc:View
    controllerName="mantenimiento.controller.VistaSupervisor"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">

    <Page
        id="vistaSupervisorPage"
        showHeader="false"
        enableScrolling="false"
        class="vistaSupervisorPage">

        <content>
            <VBox class="vsDashboard">

                <!-- ===================================================== -->
                <!-- ENCABEZADO                                            -->
                <!-- ===================================================== -->

                <VBox class="vsHeaderBlock">
                    <Title
                        text="Vista Supervisor"
                        level="H1"
                        class="vsPageTitle" />

                    <Text
                        text="Resumen ejecutivo de recursos asignados"
                        class="vsPageSubtitle" />
                </VBox>

                <!-- ===================================================== -->
                <!-- FILTROS                                               -->
                <!-- ===================================================== -->

                <HBox
                    class="vsFilterRow"
                    alignItems="End">

                    <VBox class="vsFilterCard vsFilterPeriod">
                        <Label
                            text="Periodo"
                            class="vsFilterLabel" />

                        <Select
                            id="periodSelect"
                            width="100%"
                            selectedKey="{supervisor>/filters/period}"
                            change=".onFilterChange"
                            class="vsFilterControl">

                            <core:Item key="05-2025" text="Mayo 2025" />
                            <core:Item key="04-2025" text="Abril 2025" />
                            <core:Item key="03-2025" text="Marzo 2025" />
                        </Select>
                    </VBox>

                    <VBox class="vsFilterCard">
                        <Label
                            text="Fecha desde"
                            class="vsFilterLabel" />

                        <DatePicker
                            id="dateFrom"
                            width="100%"
                            value="{supervisor>/filters/dateFrom}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onFilterChange"
                            class="vsFilterControl" />
                    </VBox>

                    <VBox class="vsFilterCard">
                        <Label
                            text="Fecha hasta"
                            class="vsFilterLabel" />

                        <DatePicker
                            id="dateTo"
                            width="100%"
                            value="{supervisor>/filters/dateTo}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onFilterChange"
                            class="vsFilterControl" />
                    </VBox>

                    <VBox class="vsFilterCard vsFilterWide">
                        <Label
                            text="Supervisor"
                            class="vsFilterLabel" />

                        <Select
                            id="supervisorSelect"
                            width="100%"
                            selectedKey="{supervisor>/filters/supervisor}"
                            change=".onFilterChange"
                            class="vsFilterControl">

                            <core:Item
                                key="SERGIO_RAMIREZ"
                                text="SERGIO RAMIREZ" />

                            <core:Item
                                key="RICARDO_MARTINEZ"
                                text="RICARDO MARTÍNEZ" />

                            <core:Item
                                key="ANA_RODRIGUEZ"
                                text="ANA RODRÍGUEZ" />
                        </Select>
                    </VBox>

                    <VBox class="vsFilterCard vsFilterShift">
                        <Label
                            text="Turno"
                            class="vsFilterLabel" />

                        <Select
                            id="shiftSelect"
                            width="100%"
                            selectedKey="{supervisor>/filters/shift}"
                            change=".onFilterChange"
                            class="vsFilterControl">

                            <core:Item key="ALL" text="Todos" />
                            <core:Item key="MORNING" text="Matutino" />
                            <core:Item key="EVENING" text="Vespertino" />
                            <core:Item key="NIGHT" text="Nocturno" />
                        </Select>
                    </VBox>

                    <VBox
                        class="vsApplyButtonBox"
                        justifyContent="Center">

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            press=".onApplyFilters"
                            class="vsApplyButton" />
                    </VBox>
                </HBox>

                <!-- ===================================================== -->
                <!-- KPIS                                                  -->
                <!-- ===================================================== -->

                <HBox class="vsKpiRow">

                    <!-- RECURSOS ASIGNADOS -->

                    <VBox class="vsKpiCard vsKpiBlue vsKpiAssigned">
                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://group"
                                    class="vsKpiIcon" />
                            </HBox>

                            <VBox class="vsKpiTextBlock">
                                <Text
                                    text="Recursos asignados"
                                    class="vsKpiLabel" />

                                <Text
                                    text="{supervisor>/kpis/assigned}"
                                    class="vsKpiValue" />

                                <Text
                                    text="Total asignados"
                                    class="vsKpiHelper" />
                            </VBox>

                            <VBox class="vsAssignedBreakdown">
                                <HBox
                                    class="vsBreakdownRow"
                                    alignItems="Center">

                                    <core:Icon
                                        src="sap-icon://employee"
                                        class="vsBreakdownIcon" />

                                    <Text
                                        text="{supervisor>/kpis/mechanics}"
                                        class="vsBreakdownValue" />

                                    <Text
                                        text="mecánicos"
                                        class="vsBreakdownLabel" />
                                </HBox>

                                <HBox
                                    class="vsBreakdownRow"
                                    alignItems="Center">

                                    <core:Icon
                                        src="sap-icon://employee"
                                        class="vsBreakdownIcon" />

                                    <Text
                                        text="{supervisor>/kpis/helpers}"
                                        class="vsBreakdownValue" />

                                    <Text
                                        text="ayudantes"
                                        class="vsBreakdownLabel" />
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- CAPACIDAD DISPONIBLE -->

                    <VBox class="vsKpiCard vsKpiGreen">
                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://history"
                                    class="vsKpiIcon" />
                            </HBox>

                            <VBox class="vsKpiTextBlock">
                                <Text
                                    text="Capacidad disponible"
                                    class="vsKpiLabel" />

                                <HBox
                                    alignItems="End"
                                    class="vsKpiValueLine">

                                    <Text
                                        text="{supervisor>/kpis/availableCapacity}"
                                        class="vsKpiValue" />

                                    <Text
                                        text="h"
                                        class="vsKpiUnit" />
                                </HBox>

                                <Text
                                    text="Total disponible"
                                    class="vsKpiHelper" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- CARGA PROGRAMADA -->

                    <VBox class="vsKpiCard vsKpiOrange">
                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://task"
                                    class="vsKpiIcon" />
                            </HBox>

                            <VBox class="vsKpiTextBlock">
                                <Text
                                    text="Carga programada"
                                    class="vsKpiLabel" />

                                <HBox
                                    alignItems="End"
                                    class="vsKpiValueLine">

                                    <Text
                                        text="{supervisor>/kpis/scheduledLoad}"
                                        class="vsKpiValue" />

                                    <Text
                                        text="h"
                                        class="vsKpiUnit" />
                                </HBox>

                                <Text
                                    text="Total programada"
                                    class="vsKpiHelper" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- RECURSOS SOBRE CAPACIDAD -->

                    <VBox class="vsKpiCard vsKpiPurple">
                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://message-warning"
                                    class="vsKpiIcon" />
                            </HBox>

                            <VBox class="vsKpiTextBlock">
                                <Text
                                    text="Recursos sobre capacidad"
                                    class="vsKpiLabel" />

                                <Text
                                    text="{supervisor>/kpis/overCapacity}"
                                    class="vsKpiValue" />

                                <Text
                                    text="Total recursos"
                                    class="vsKpiHelper" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- CUMPLIMIENTO OPERATIVO -->

                    <VBox class="vsKpiCard vsKpiRed">
                        <HBox
                            class="vsKpiContent"
                            alignItems="Center">

                            <HBox
                                class="vsKpiIconCircle"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://target-group"
                                    class="vsKpiIcon" />
                            </HBox>

                            <VBox class="vsKpiTextBlock">
                                <Text
                                    text="Cumplimiento operativo"
                                    class="vsKpiLabel" />

                                <HBox
                                    alignItems="Center"
                                    class="vsComplianceLine">

                                    <Text
                                        text="{supervisor>/kpis/compliance}%"
                                        class="vsKpiValue" />

                                    <Text
                                        text="Meta: {supervisor>/kpis/complianceTarget}%"
                                        class="vsKpiMeta" />
                                </HBox>

                                <Text
                                    text="{supervisor>/kpis/complianceGap} puntos por debajo de la meta"
                                    class="vsKpiAlert" />
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- ===================================================== -->
                <!-- CONTENIDO PRINCIPAL                                   -->
                <!-- ===================================================== -->

                <HBox
                    width="100%"
                    fitContainer="true"
                    class="vsMainRow"
                    alignItems="Stretch"
                    justifyContent="Start">

                    <!-- ================================================= -->
                    <!-- UTILIZACIÓN DE RECURSOS                           -->
                    <!-- ================================================= -->

                    <VBox class="vsLeftColumn">
                        <layoutData>
                            <FlexItemData
                                growFactor="42"
                                shrinkFactor="1"
                                baseSize="0%" />
                        </layoutData>

                        <VBox class="vsCard vsUtilizationCard">

                            <Title
                                text="Utilización de recursos"
                                level="H3"
                                class="vsSectionTitle" />

                            <Text
                                text="Resumen de desempeño por nivel de utilización"
                                class="vsSectionSubtitle" />

                            <HBox class="vsUtilizationGrid">

                                <!-- CRÍTICO -->

                                <VBox class="vsUtilColumn vsUtilCritical">

                                    <VBox class="vsUtilHeader">
                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://trend-up"
                                                    class="vsUtilIcon" />
                                            </HBox>

                                            <HBox alignItems="Center">
                                                <Text
                                                    text="Crítico"
                                                    class="vsUtilTitle" />

                                                <Text
                                                    text="2"
                                                    class="vsUtilBadge" />
                                            </HBox>
                                        </HBox>

                                        <Text
                                            text=">120%"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />
                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/critical}">

                                        <items>
                                            <VBox class="vsResourceTile">
                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilization}%"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />
                                                </HBox>
                                            </VBox>
                                        </items>
                                    </VBox>
                                </VBox>

                                <!-- ALTO -->

                                <VBox class="vsUtilColumn vsUtilHigh">

                                    <VBox class="vsUtilHeader">
                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://bar-chart"
                                                    class="vsUtilIcon" />
                                            </HBox>

                                            <HBox alignItems="Center">
                                                <Text
                                                    text="Alto"
                                                    class="vsUtilTitle" />

                                                <Text
                                                    text="3"
                                                    class="vsUtilBadge" />
                                            </HBox>
                                        </HBox>

                                        <Text
                                            text="101% - 120%"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />
                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/high}">

                                        <items>
                                            <VBox class="vsResourceTile">
                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilization}%"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />
                                                </HBox>
                                            </VBox>
                                        </items>
                                    </VBox>
                                </VBox>

                                <!-- NORMAL -->

                                <VBox class="vsUtilColumn vsUtilNormal">

                                    <VBox class="vsUtilHeader">
                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://favorite"
                                                    class="vsUtilIcon" />
                                            </HBox>

                                            <HBox alignItems="Center">
                                                <Text
                                                    text="Normal"
                                                    class="vsUtilTitle" />

                                                <Text
                                                    text="4"
                                                    class="vsUtilBadge" />
                                            </HBox>
                                        </HBox>

                                        <Text
                                            text="71% - 100%"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />
                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/normal}">

                                        <items>
                                            <VBox class="vsResourceTile">
                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilization}%"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />
                                                </HBox>
                                            </VBox>
                                        </items>
                                    </VBox>
                                </VBox>

                                <!-- BAJO -->

                                <VBox class="vsUtilColumn vsUtilLow">

                                    <VBox class="vsUtilHeader">
                                        <HBox
                                            class="vsUtilHeaderTop"
                                            alignItems="Center">

                                            <HBox
                                                class="vsUtilIconCircle"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://accept"
                                                    class="vsUtilIcon" />
                                            </HBox>

                                            <HBox alignItems="Center">
                                                <Text
                                                    text="Bajo"
                                                    class="vsUtilTitle" />

                                                <Text
                                                    text="5"
                                                    class="vsUtilBadge" />
                                            </HBox>
                                        </HBox>

                                        <Text
                                            text="0% - 70%"
                                            class="vsUtilRange" />

                                        <HBox class="vsUtilRule" />
                                    </VBox>

                                    <VBox
                                        class="vsResourceList"
                                        items="{supervisor>/utilization/low}">

                                        <items>
                                            <VBox class="vsResourceTile">
                                                <Text
                                                    text="{supervisor>name}"
                                                    class="vsResourceName" />

                                                <Text
                                                    text="{supervisor>utilization}%"
                                                    class="vsResourcePercent" />

                                                <HBox
                                                    class="vsResourceLine"
                                                    alignItems="Center">

                                                    <core:Icon
                                                        src="sap-icon://employee"
                                                        class="vsResourceIcon" />

                                                    <Text
                                                        text="{supervisor>resourceText}"
                                                        class="vsResourceText" />
                                                </HBox>
                                            </VBox>
                                        </items>
                                    </VBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <!-- ================================================= -->
                    <!-- COLUMNA DERECHA                                   -->
                    <!-- ================================================= -->

                    <VBox class="vsRightColumn">
                        <layoutData>
                            <FlexItemData
                                growFactor="58"
                                shrinkFactor="1"
                                baseSize="0%" />
                        </layoutData>

                        <!-- PRESIÓN POR TIPO DE SERVICIO -->

                        <VBox class="vsCard vsPressureCard">

                            <Title
                                text="Presión por tipo de servicio"
                                level="H3"
                                class="vsSectionTitle" />

                            <HBox
                                class="vsPressureContent"
                                alignItems="Center"
                                justifyContent="Center">

                                <HBox
                                    class="vsDonut"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <VBox
                                        class="vsDonutCenter"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <Text
                                            text="Carga"
                                            class="vsDonutText" />

                                        <Text
                                            text="por servicio"
                                            class="vsDonutText" />
                                    </VBox>
                                </HBox>

                                <VBox class="vsServiceList">

                                    <HBox
                                        class="vsServiceRow"
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                        <HBox
                                            class="vsServiceIdentity"
                                            alignItems="Center">

                                            <HBox
                                                class="vsServiceIconCircle vsServiceBlue"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://document-text"
                                                    class="vsServiceIcon" />
                                            </HBox>

                                            <Text
                                                text="Planeado"
                                                class="vsServiceName" />
                                        </HBox>

                                        <VBox alignItems="End">
                                            <Text
                                                text="45%"
                                                class="vsServicePercent" />

                                            <Text
                                                text="321 h"
                                                class="vsServiceHours" />
                                        </VBox>
                                    </HBox>

                                    <HBox
                                        class="vsServiceRow"
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                        <HBox
                                            class="vsServiceIdentity"
                                            alignItems="Center">

                                            <HBox
                                                class="vsServiceIconCircle vsServiceRed"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://wrench"
                                                    class="vsServiceIcon" />
                                            </HBox>

                                            <Text
                                                text="Correctivo"
                                                class="vsServiceName" />
                                        </HBox>

                                        <VBox alignItems="End">
                                            <Text
                                                text="35%"
                                                class="vsServicePercent" />

                                            <Text
                                                text="250 h"
                                                class="vsServiceHours" />
                                        </VBox>
                                    </HBox>

                                    <HBox
                                        class="vsServiceRow"
                                        alignItems="Center"
                                        justifyContent="SpaceBetween">

                                        <HBox
                                            class="vsServiceIdentity"
                                            alignItems="Center">

                                            <HBox
                                                class="vsServiceIconCircle vsServicePurple"
                                                alignItems="Center"
                                                justifyContent="Center">

                                                <core:Icon
                                                    src="sap-icon://headset"
                                                    class="vsServiceIcon" />
                                            </HBox>

                                            <Text
                                                text="Call Center"
                                                class="vsServiceName" />
                                        </HBox>

                                        <VBox alignItems="End">
                                            <Text
                                                text="20%"
                                                class="vsServicePercent" />

                                            <Text
                                                text="142 h"
                                                class="vsServiceHours" />
                                        </VBox>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <HBox
                                class="vsPressureFooter"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://target-group"
                                    class="vsPressureFooterIcon" />

                                <Text
                                    text="Total carga programada:"
                                    class="vsPressureFooterLabel" />

                                <Text
                                    text="713 h"
                                    class="vsPressureFooterValue" />
                            </HBox>
                        </VBox>

                        <!-- MATERIALES CON MAYOR CONSUMO -->

                        <VBox class="vsCard vsMaterialsCard">

                            <Title
                                text="Materiales con mayor consumo"
                                level="H3"
                                class="vsSectionTitle" />

                            <HBox class="vsMaterialsGrid">

                                <!-- ACEITE -->

                                <VBox
                                    class="vsMaterialTile vsMaterialOrange"
                                    alignItems="Center">

                                    <HBox
                                        class="vsMaterialIconCircle vsMaterialDropCircle"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <core:Icon
                                            src="sap-icon://nutrition-activity"
                                            class="vsMaterialIcon vsMaterialDropIcon" />
                                    </HBox>

                                    <Text
                                        text="Aceite"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="38"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="pzas"
                                            class="vsMaterialUnit" />
                                    </HBox>

                                    <HBox class="vsMaterialLine" />
                                </VBox>

                                <!-- REFACCIONES -->

                                <VBox
                                    class="vsMaterialTile vsMaterialBlue"
                                    alignItems="Center">

                                    <HBox
                                        class="vsMaterialIconCircle"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <core:Icon
                                            src="sap-icon://action-settings"
                                            class="vsMaterialIcon" />
                                    </HBox>

                                    <Text
                                        text="Refacciones"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="24"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="pzas"
                                            class="vsMaterialUnit" />
                                    </HBox>

                                    <HBox class="vsMaterialLine" />
                                </VBox>

                                <!-- LUBRICANTES -->

                                <VBox
                                    class="vsMaterialTile vsMaterialPurple"
                                    alignItems="Center">

                                    <HBox
                                        class="vsMaterialIconCircle vsMaterialDropCircle"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <core:Icon
                                            src="sap-icon://nutrition-activity"
                                            class="vsMaterialIcon vsMaterialDropIcon" />
                                    </HBox>

                                    <Text
                                        text="Lubricantes"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="19"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="pzas"
                                            class="vsMaterialUnit" />
                                    </HBox>

                                    <HBox class="vsMaterialLine" />
                                </VBox>

                                <!-- HERRAMIENTAS -->

                                <VBox
                                    class="vsMaterialTile vsMaterialGreen"
                                    alignItems="Center">

                                    <HBox
                                        class="vsMaterialIconCircle"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <core:Icon
                                            src="sap-icon://wrench"
                                            class="vsMaterialIcon" />
                                    </HBox>

                                    <Text
                                        text="Herramientas"
                                        class="vsMaterialName" />

                                    <HBox
                                        class="vsMaterialValueRow"
                                        alignItems="End">

                                        <Text
                                            text="12"
                                            class="vsMaterialValue" />

                                        <Text
                                            text="pzas"
                                            class="vsMaterialUnit" />
                                    </HBox>

                                    <HBox class="vsMaterialLine" />
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>