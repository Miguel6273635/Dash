<mvc:View
    controllerName="mantenimiento.controller.HorasTrabajadas"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="pageHorasTrabajadas"
        showHeader="false"
        enableScrolling="false"
        class="HorasTrabajadas">

        <content>

            <ScrollContainer
                id="scHorasTrabajadas"
                height="100%"
                width="100%"
                vertical="true"
                horizontal="false"
                focusable="true"
                class="htwScroll">

                <VBox
                    id="vbHorasPage"
                    width="100%"
                    height="100%"
                    class="htwPageContainer sapUiSizeCompact">

                    <!-- HEADER -->

                    <HBox
                        id="hbHorasHeader"
                        width="100%"
                        class="htwHeader"
                        alignItems="Center">

                        <VBox
                            id="vbHorasHeaderText"
                            class="htwHeaderText">

                            <Title
                                id="ttlHoras"
                                text="Horas trabajadas"
                                level="H1"
                                class="htwMainTitle"/>

                            <Text
                                id="txtHorasSub"
                                text="Análisis de capacidad, carga y utilización de horas"
                                wrapping="false"
                                class="htwSubtitle"/>

                        </VBox>

                    </HBox>


                    <!-- FILTROS -->

                    <HBox
                        id="hbHorasFilters"
                        width="100%"
                        class="htwFiltersBar"
                        alignItems="Center"
                        wrap="NoWrap">

                        <!-- PERIODO -->

                        <HBox
                            id="fbPeriodo"
                            class="htwFilterBox htwFilterPeriodo"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://calendar"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Periodo"
                                    class="htwFilterLabel"/>

                                <Select
                                    width="100%"
                                    selectedKey="{horasModel>/filtros/periodo}"
                                    class="htwFilterSelect"/>

                            </VBox>

                        </HBox>


                        <!-- FECHA DESDE -->

                        <HBox
                            id="fbFechaDesde"
                            class="htwFilterBox htwFilterFecha"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://calendar"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Fecha desde"
                                    class="htwFilterLabel"/>

                                <DatePicker
                                    width="100%"
                                    value="{horasModel>/filtros/fechaDesde}"
                                    displayFormat="dd/MM/yyyy"
                                    valueFormat="dd/MM/yyyy"
                                    class="htwFilterDate"/>

                            </VBox>

                        </HBox>


                        <!-- FECHA HASTA -->

                        <HBox
                            id="fbFechaHasta"
                            class="htwFilterBox htwFilterFecha"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://calendar"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Fecha hasta"
                                    class="htwFilterLabel"/>

                                <DatePicker
                                    width="100%"
                                    value="{horasModel>/filtros/fechaHasta}"
                                    displayFormat="dd/MM/yyyy"
                                    valueFormat="dd/MM/yyyy"
                                    class="htwFilterDate"/>

                            </VBox>

                        </HBox>


                        <!-- ZONA -->

                        <HBox
                            id="fbZona"
                            class="htwFilterBox htwFilterSmall"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://map-2"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Zona"
                                    class="htwFilterLabel"/>

                                <Select
                                    width="100%"
                                    selectedKey="{horasModel>/filtros/zona}"
                                    class="htwFilterSelect"/>

                            </VBox>

                        </HBox>


                        <!-- SUPERVISOR -->

                        <HBox
                            id="fbSupervisor"
                            class="htwFilterBox htwFilterMedium"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://employee"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Supervisor"
                                    class="htwFilterLabel"/>

                                <Select
                                    width="100%"
                                    selectedKey="{horasModel>/filtros/supervisor}"
                                    class="htwFilterSelect"/>

                            </VBox>

                        </HBox>


                        <!-- TIPO DE ORDEN -->

                        <HBox
                            id="fbTipoOrden"
                            class="htwFilterBox htwFilterMedium"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://document-text"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Tipo de orden"
                                    class="htwFilterLabel"/>

                                <Select
                                    width="100%"
                                    selectedKey="{horasModel>/filtros/tipoOrden}"
                                    class="htwFilterSelect"/>

                            </VBox>

                        </HBox>


                        <!-- TURNO -->

                        <HBox
                            id="fbTurno"
                            class="htwFilterBox htwFilterSmall"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://time-entry-request"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Turno"
                                    class="htwFilterLabel"/>

                                <Select
                                    width="100%"
                                    selectedKey="{horasModel>/filtros/turno}"
                                    class="htwFilterSelect"/>

                            </VBox>

                        </HBox>


                        <!-- MECÁNICO -->

                        <HBox
                            id="fbMecanico"
                            class="htwFilterBox htwFilterMedium"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://employee"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Mecánico"
                                    class="htwFilterLabel"/>

                                <Select
                                    width="100%"
                                    selectedKey="{horasModel>/filtros/mecanico}"
                                    class="htwFilterSelect"/>

                            </VBox>

                        </HBox>


                        <!-- ESTADO -->

                        <HBox
                            id="fbEstado"
                            class="htwFilterBox htwFilterEstado"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://status-positive"
                                class="htwFilterIcon"/>

                            <VBox
                                width="100%"
                                class="htwFilterContent">

                                <Label
                                    text="Estado de orden"
                                    class="htwFilterLabel"/>

                                <Select
                                    width="100%"
                                    selectedKey="{horasModel>/filtros/estadoOrden}"
                                    class="htwFilterSelect"/>

                            </VBox>

                        </HBox>


                        <!-- APLICAR -->

                        <VBox
                            class="htwApplyButtonBox"
                            justifyContent="Center">

                            <Button
                                id="btnAplicarFiltros"
                                text="Aplicar filtros"
                                icon="sap-icon://filter"
                                type="Emphasized"
                                width="100%"
                                class="htwApplyButton"
                                press=".onAplicarFiltros"/>

                        </VBox>

                    </HBox>


                    <!-- KPIS -->

                    <HBox
                        id="hbKpis"
                        width="100%"
                        class="htwKpiWrapper"
                        alignItems="Stretch"
                        justifyContent="SpaceBetween"
                        wrap="NoWrap">

                        <!-- CAPACIDAD COMPROMETIDA -->

                        <HBox
                            id="cardCapacidadComprometida"
                            class="htwBigKpi htwPurpleKpi"
                            alignItems="Center">

                            <VBox
                                class="htwKpiIcon htwKpiIconPurple"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://group"/>

                            </VBox>

                            <VBox
                                class="htwKpiContent"
                                justifyContent="Center">

                                <Text
                                    text="Capacidad comprometida"
                                    wrapping="false"
                                    class="htwKpiLabel"/>

                                <Text
                                    text="{horasModel>/kpis/capacidadComprometida}"
                                    wrapping="false"
                                    class="htwKpiNumber htwPurpleText"/>

                                <Text
                                    text="Relación: horas programadas / capacidad disponible"
                                    wrapping="false"
                                    class="htwKpiDescription"/>

                            </VBox>

                        </HBox>


                        <!-- MARGEN DE CAPACIDAD -->

                        <HBox
                            id="cardMargenCapacidad"
                            class="htwBigKpi htwGreenKpi"
                            alignItems="Center">

                            <VBox
                                class="htwKpiIcon htwKpiIconGreen"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon src="sap-icon://line-chart"/>

                            </VBox>

                            <VBox
                                class="htwKpiContent"
                                justifyContent="Center">

                                <Text
                                    text="Margen de capacidad"
                                    wrapping="false"
                                    class="htwKpiLabel"/>

                                <Text
                                    text="{horasModel>/kpis/margenCapacidad}"
                                    wrapping="false"
                                    class="htwKpiNumber htwGreenText"/>

                                <Text
                                    text="Horas disponibles para absorber carga adicional"
                                    wrapping="false"
                                    class="htwKpiDescription"/>

                            </VBox>

                        </HBox>

                    </HBox>


                    <!-- DASHBOARD -->

                    <VBox
                        id="vbDashboardGrid"
                        width="100%"
                        class="htwDashboardGrid">

                        <!-- FILA 1 -->

                        <HBox
                            id="rowCards1"
                            width="100%"
                            class="htwCardsRow"
                            wrap="NoWrap">

                            <!-- CARD 1: CAPACIDAD VS CARGA -->

                            <VBox
                                id="cardCapacidadCarga"
                                width="100%"
                                height="100%"
                                class="htwCard htwCapacidadCargaCard htwDonutCleanCard">

                                <HBox
                                    class="htwCardHeader htwDonutCleanHeader"
                                    alignItems="Center"
                                    justifyContent="Start">

                                    <Title
                                        text="Capacidad vs carga programada"
                                        level="H3"
                                        class="htwCardTitle"/>

                                    <core:Icon
                                        id="icInfoCapacidadCarga"
                                        src="sap-icon://hint"
                                        class="htwCardInfoIcon"/>

                                </HBox>

                                <HBox
                                    class="htwDonutCleanArea"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <VBox
                                        class="htwDonutCleanSvgWrapper"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <core:HTML
                                            sanitizeContent="false"
                                            content='&lt;svg class="htwDonutCleanSvg" viewBox="0 0 180 180" xmlns="http://www.w3.org/2000/svg"&gt;&lt;circle cx="90" cy="90" r="58" fill="none" stroke="#edf1f5" stroke-width="22"/&gt;&lt;circle cx="90" cy="90" r="31" fill="#ffffff"/&gt;&lt;text x="90" y="82" text-anchor="middle" class="htwDonutCleanCenterLabel"&gt;Capacidad&lt;/text&gt;&lt;text x="90" y="105" text-anchor="middle" class="htwDonutCleanCenterValue"&gt;Sin datos&lt;/text&gt;&lt;/svg&gt;'/>

                                    </VBox>

                                    <VBox
                                        class="htwDonutCleanLegend"
                                        justifyContent="Center">

                                        <HBox
                                            class="htwDonutCleanLegendItem"
                                            alignItems="Center">

                                            <VBox
                                                class="htwDonutCleanDot htwDonutCleanDotOrange"/>

                                            <VBox>

                                                <Text
                                                    text="Capacidad disponible"
                                                    class="htwDonutCleanLegendTitle"/>

                                                <Text
                                                    text="Sin datos"
                                                    class="htwDonutCleanLegendSub"/>

                                            </VBox>

                                        </HBox>

                                        <HBox
                                            class="htwDonutCleanLegendItem"
                                            alignItems="Center">

                                            <VBox
                                                class="htwDonutCleanDot htwDonutCleanDotGreen"/>

                                            <VBox>

                                                <Text
                                                    text="Horas programadas"
                                                    class="htwDonutCleanLegendTitle"/>

                                                <Text
                                                    text="Sin datos"
                                                    class="htwDonutCleanLegendSub"/>

                                            </VBox>

                                        </HBox>

                                        <HBox
                                            class="htwDonutCleanLegendItem"
                                            alignItems="Center">

                                            <VBox
                                                class="htwDonutCleanDot htwDonutCleanDotBlue"/>

                                            <VBox>

                                                <Text
                                                    text="Horas reales"
                                                    class="htwDonutCleanLegendTitle"/>

                                                <Text
                                                    text="Sin datos"
                                                    class="htwDonutCleanLegendSub"/>

                                            </VBox>

                                        </HBox>

                                    </VBox>

                                </HBox>

                            </VBox>


                            <!-- CARD 2: UTILIZACIÓN POR TURNO -->

                            <VBox
                                id="cardUtilizacionTurno"
                                width="100%"
                                height="100%"
                                class="htwCard htwUtilizacionCard">

                                <HBox
                                    class="htwCardHeader"
                                    alignItems="Center"
                                    justifyContent="Start">

                                    <Title
                                        text="Utilización por turno"
                                        level="H3"
                                        class="htwCardTitle"/>

                                    <core:Icon
                                        id="icInfoUtilizacionTurno"
                                        src="sap-icon://hint"
                                        class="htwCardInfoIcon"/>

                                </HBox>

                                <Text
                                    text="Resumen de utilización por turno"
                                    wrapping="false"
                                    class="htwCardSubtitle"/>

                                <VBox
                                    class="htwTurnoManualList"/>

                                <HBox
                                    class="htwPromedioBox"
                                    justifyContent="SpaceBetween"
                                    alignItems="Center">

                                    <HBox alignItems="Center">

                                        <VBox
                                            class="htwPromedioIcon"
                                            alignItems="Center"
                                            justifyContent="Center">

                                            <core:Icon
                                                src="sap-icon://business-objects-experience"/>

                                        </VBox>

                                        <Text
                                            text="Promedio de utilización"
                                            class="htwPromedioLabel"/>

                                    </HBox>

                                    <Text
                                        text="Sin datos"
                                        class="htwPromedioValue"/>

                                </HBox>

                            </VBox>


                            <!-- CARD 3: TIPO DE ORDEN -->

                            <VBox
                                id="cardHorasTipoOrden"
                                width="100%"
                                height="100%"
                                class="htwCard htwTipoOrdenCard">

                                <HBox
                                    class="htwCardHeader"
                                    alignItems="Center"
                                    justifyContent="Start">

                                    <Title
                                        text="Horas por tipo de orden (plan vs real)"
                                        level="H3"
                                        class="htwCardTitle"/>

                                    <core:Icon
                                        id="icInfoHorasTipoOrden"
                                        src="sap-icon://hint"
                                        class="htwCardInfoIcon"/>

                                </HBox>

                                <HBox
                                    class="htwTipoOrdenLegendRow"
                                    alignItems="Center"
                                    wrap="NoWrap">

                                    <HBox
                                        class="htwTipoOrdenLegendItem"
                                        alignItems="Center">

                                        <VBox
                                            class="htwTipoLegendLine htwTipoLegendBlue"/>

                                        <Text
                                            text="Horas programadas"
                                            class="htwTipoLegendText"/>

                                    </HBox>

                                    <HBox
                                        class="htwTipoOrdenLegendItem"
                                        alignItems="Center">

                                        <VBox
                                            class="htwTipoLegendLine htwTipoLegendPurple"/>

                                        <Text
                                            text="Horas reales"
                                            class="htwTipoLegendText"/>

                                    </HBox>

                                    <HBox
                                        class="htwTipoOrdenLegendItem"
                                        alignItems="Center">

                                        <VBox
                                            class="htwTipoLegendDashed"/>

                                        <Text
                                            text="Variación (%)"
                                            class="htwTipoLegendText"/>

                                    </HBox>

                                </HBox>

                                <VBox
                                    class="htwTipoOrdenChartBox">

                                    <core:HTML
                                        id="htmlTipoOrdenChart"
                                        sanitizeContent="false"
                                        content='&lt;svg class="htwTipoSvg" viewBox="0 0 560 235" xmlns="http://www.w3.org/2000/svg"&gt;&lt;text x="280" y="120" text-anchor="middle" class="htwSvgNoData"&gt;Sin datos&lt;/text&gt;&lt;/svg&gt;'/>

                                </VBox>

                                <Link
                                    text="Ver detalles por tipo de orden"
                                    class="htwCardLink"
                                    press=".onVerDetalleTipoOrden"/>

                            </VBox>

                        </HBox>


                        <!-- FILA 2 -->

                        <HBox
                            id="rowCards2"
                            width="100%"
                            class="htwCardsRow htwCardsRowLast"
                            wrap="NoWrap">

                            <!-- CARD 4: CAPACIDAD POR ZONA -->

                            <VBox
                                id="cardCapacidadZona"
                                width="100%"
                                height="100%"
                                class="htwCard htwZonaCard htwZonaV2Card">

                                <HBox
                                    class="htwCardHeader htwZonaV2Header"
                                    justifyContent="SpaceBetween"
                                    alignItems="Center">

                                    <HBox
                                        alignItems="Center"
                                        class="htwZonaV2TitleRow">

                                        <Title
                                            text="Capacidad por zona"
                                            level="H3"
                                            class="htwCardTitle"/>

                                        <core:Icon
                                            src="sap-icon://hint"
                                            class="htwCardInfoIcon"/>

                                    </HBox>

                                    <Button
                                        icon="sap-icon://overflow"
                                        type="Transparent"
                                        class="htwZonaV2MenuButton"/>

                                </HBox>

                                <HBox
                                    class="htwZonaV2Analysis"
                                    alignItems="Start">

                                    <core:Icon
                                        src="sap-icon://alert"
                                        class="htwZonaV2AlertIcon"/>

                                    <VBox
                                        class="htwZonaV2AnalysisTextBox">

                                        <Text
                                            text="Análisis"
                                            class="htwZonaV2AnalysisTitle"/>

                                        <Text
                                            text="Muestra de utilización en porcentaje por debajo del rango normal de utilización."
                                            class="htwZonaV2AnalysisText"/>

                                        <Link
                                            text="Ver detalle"
                                            class="htwZonaV2AnalysisLink"
                                            press=".onVerDetalleZona"/>

                                    </VBox>

                                </HBox>

                                <VBox
                                    class="htwZonaV2ChartBox">

                                    <core:HTML
                                        id="htmlCapacidadZonaChart"
                                        sanitizeContent="false"
                                        content='&lt;svg class="htwZonaV2Svg" viewBox="0 0 500 112" xmlns="http://www.w3.org/2000/svg"&gt;&lt;text x="250" y="58" text-anchor="middle" class="htwSvgNoData"&gt;Sin datos&lt;/text&gt;&lt;/svg&gt;'/>

                                </VBox>

                                <HBox
                                    class="htwZonaLegendV3"
                                    alignItems="Center"
                                    justifyContent="Center"
                                    wrap="NoWrap">

                                    <HBox
                                        class="htwZonaLegendV3Item"
                                        alignItems="Center">

                                        <VBox
                                            class="htwZonaLegendV3Oval htwZonaLegendV3Gray"/>

                                        <Text
                                            text="Normal"
                                            class="htwZonaLegendV3Text"/>

                                    </HBox>

                                    <HBox
                                        class="htwZonaLegendV3Item"
                                        alignItems="Center">

                                        <VBox
                                            class="htwZonaLegendV3Oval htwZonaLegendV3Orange"/>

                                        <Text
                                            text="Cerca de saturación"
                                            class="htwZonaLegendV3Text"/>

                                    </HBox>

                                    <HBox
                                        class="htwZonaLegendV3Item"
                                        alignItems="Center">

                                        <VBox
                                            class="htwZonaLegendV3Oval htwZonaLegendV3Red"/>

                                        <Text
                                            text="Sobrecargado"
                                            class="htwZonaLegendV3Text"/>

                                    </HBox>

                                </HBox>

                                <HBox
                                    class="htwZonaV2BottomLinkWrap">

                                    <Link
                                        text="Ver detalle por zona →"
                                        press=".onDetalleZona"
                                        class="htwCardLink"/>

                                </HBox>

                            </VBox>


                            <!-- CARD 5: CAUSAS -->

                            <VBox
                                id="cardCausas"
                                width="100%"
                                height="100%"
                                class="htwCard htwCausasCard">

                                <HBox
                                    class="htwCardHeader"
                                    justifyContent="Start"
                                    alignItems="Center">

                                    <Title
                                        text="Causas de desviación de horas"
                                        level="H3"
                                        class="htwCardTitle"/>

                                    <core:Icon
                                        id="icInfoCausasHoras"
                                        src="sap-icon://hint"
                                        class="htwCardInfoIcon"/>

                                </HBox>

                                <HBox
                                    class="htwCauseHeader">

                                    <Text
                                        text="Causa"
                                        class="htwCauseNameCol"/>

                                    <Text
                                        text=""
                                        class="htwCauseBarCol"/>

                                    <Text
                                        text="Horas extra"
                                        class="htwCauseHoursCol"/>

                                    <Text
                                        text="% del total"
                                        class="htwCausePercentCol"/>

                                </HBox>

                                <List
                                    showSeparators="None"
                                    noDataText="No data"
                                    class="htwCauseList"
                                    items="{horasModel>/graficas/causasDesviacion}">

                                    <CustomListItem>

                                        <HBox
                                            class="htwCauseRow"
                                            alignItems="Center">

                                            <Text
                                                text="{horasModel>causa}"
                                                wrapping="false"
                                                class="htwCauseNameCol htwCauseName"/>

                                            <HBox
                                                class="htwCauseManualTrack">

                                                <HBox
                                                    class="htwCauseManualFill"
                                                    width="{= ${horasModel>porcentaje} + '%' }"/>

                                            </HBox>

                                            <Text
                                                text="{horasModel>horasTexto}"
                                                class="htwCauseHoursCol"/>

                                            <Text
                                                text="{horasModel>porcentajeTexto}"
                                                class="htwCausePercentCol"/>

                                        </HBox>

                                    </CustomListItem>

                                </List>

                                <HBox
                                    class="htwTotalExtraBox"
                                    justifyContent="SpaceBetween"
                                    alignItems="Center">

                                    <HBox
                                        alignItems="Center">

                                        <core:Icon
                                            src="sap-icon://sum"
                                            class="htwPurpleIcon htwSumIcon"/>

                                        <Text
                                            text="Total horas extra"
                                            class="htwTotalExtraText"/>

                                    </HBox>

                                    <Text
                                        text="{horasModel>/kpis/totalHorasExtra}"
                                        class="htwTotalExtraValue"/>

                                </HBox>

                                <Link
                                    text="Ver detalle por causa"
                                    class="htwCardLink"
                                    press=".onVerDetalleCausa"/>

                            </VBox>


                            <!-- CARD 6: PROYECCIÓN -->

                            <VBox
                                id="cardProyeccion"
                                width="100%"
                                height="100%"
                                class="htwCard htwProyeccionCard htwProjectionCard">

                                <HBox
                                    class="htwCardHeader"
                                    alignItems="Center"
                                    justifyContent="Start">

                                    <Title
                                        text="Proyección de cierre de horas"
                                        level="H3"
                                        class="htwCardTitle"/>

                                    <core:Icon
                                        id="icInfoProyeccionHoras"
                                        src="sap-icon://hint"
                                        class="htwCardInfoIcon"/>

                                </HBox>

                                <HBox
                                    class="htwProjectionTop"
                                    alignItems="Stretch"
                                    justifyContent="Start">

                                    <VBox
                                        class="htwProjectionMetricBox"
                                        justifyContent="Center">

                                        <Text
                                            text="Utilización proyectada al cierre"
                                            class="htwProjectionMiniLabel"/>

                                        <Text
                                            text="Sin datos"
                                            class="htwProjectionBigValue"/>

                                        <Text
                                            text="de utilización proyectada"
                                            class="htwProjectionMiniDesc"/>

                                    </VBox>

                                    <VBox
                                        class="htwProjectionChartBox">

                                        <core:HTML
                                            id="htmlProyeccionChart"
                                            sanitizeContent="false"
                                            content='&lt;svg class="htwProjectionSvg" viewBox="0 0 620 210" xmlns="http://www.w3.org/2000/svg"&gt;&lt;text x="310" y="108" text-anchor="middle" class="htwProjDateText"&gt;Sin capacidad validada para calcular la proyección&lt;/text&gt;&lt;/svg&gt;'/>

                                    </VBox>

                                </HBox>

                                <HBox
                                    class="htwProjectionAlerts"
                                    wrap="NoWrap">

                                    <!-- ESTADO -->

                                    <VBox
                                        class="htwAlertBox htwAlertBoxRed">

                                        <HBox
                                            class="htwAlertContent"
                                            alignItems="Center">

                                            <core:Icon
