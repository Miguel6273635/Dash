                                            <VBox
                                                class="htwAlertTextWrap">

                                                <Text
                                                    text="Riesgo"
                                                    class="htwAlertLabel"/>

                                                <Text
                                                    text="Sin datos"
                                                    class="htwAlertMain htwAlertMainGreen"/>

                                                <Text
                                                    text="Sin capacidad validada"
                                                    class="htwAlertSub"/>

                                            </VBox>

                                        </HBox>

                                    </VBox>

                                </HBox>

                                <Text
                                    text="Proyección pendiente de datos validados"
                                    class="htwProjectionFooter"/>

                            </VBox>

                        </HBox>

                    </VBox>

                </VBox>

            </ScrollContainer>

        </content>

