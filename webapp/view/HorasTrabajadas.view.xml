                                                    class="htwAlertLabel"/>

                                                <Text
                                                    text="Sin datos"
                                                    class="htwAlertMain htwAlertMainRed"/>

                                                <Text
                                                    text="Sin capacidad validada"
                                                    class="htwAlertSub"/>

                                            </VBox>

                                        </HBox>

                                    </VBox>


                                    <!-- BRECHA -->

                                    <VBox
                                        class="htwAlertBox htwAlertBoxOrange">

                                        <HBox
                                            class="htwAlertContent"
                                            alignItems="Center">

                                            <core:Icon
                                                src="sap-icon://alert"
                                                class="htwAlertIcon htwAlertIconOrange"/>

                                            <VBox
                                                class="htwAlertTextWrap">

                                                <Text
                                                    text="Brecha proyectada"
                                                    class="htwAlertLabel"/>

                                                <Text
                                                    text="Sin datos"
                                                    class="htwAlertMain htwAlertMainOrange"/>

                                                <Text
                                                    text="Capacidad menos horas proyectadas"
                                                    class="htwAlertSub"/>

                                            </VBox>

                                        </HBox>

                                    </VBox>


                                    <!-- RIESGO -->

                                    <VBox
                                        class="htwAlertBox htwAlertBoxGreen">

                                        <HBox
                                            class="htwAlertContent"
                                            alignItems="Center">

                                            <core:Icon
