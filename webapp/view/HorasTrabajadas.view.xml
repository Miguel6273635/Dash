<mvc:View controllerName="mantenimiento.controller.HorasTrabajadas" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="pageHorasTrabajadas" showHeader="false" class="HorasTrabajadas">
        <content>
            <ScrollContainer id="scHorasTrabajadas" height="100%" width="100%" vertical="false" horizontal="false" class="htwScroll">
                <VBox id="vbHorasPage" class="htwPageContainer sapUiSizeCompact">
                    <!-- HEADER PRINCIPAL -->
                    <HBox id="hbHorasHeader" class="htwHeader" alignItems="Center">
                        <VBox id="vbHorasIcon" class="htwHeaderIcon" alignItems="Center" justifyContent="Center">
                            <core:Icon id="icHorasHeader" src="sap-icon://history"/>
                        </VBox>
                        <VBox id="vbHorasHeaderText">
                            <Title id="ttlHoras" text="Horas trabajadas" level="H1" class="htwMainTitle"/>
                            <Text id="txtHorasSub" text="Análisis de capacidad, carga y utilización de horas" class="htwSubtitle"/>
                        </VBox>
                    </HBox>
                    <!-- FILTROS -->
                    <HBox id="hbHorasFilters" class="htwFiltersBar" alignItems="End" wrap="NoWrap">
                        <VBox id="fbPeriodo" class="htwFilterBox htwFilterPeriodo">
                            <Label text="Periodo" class="htwFilterLabel"/>
                            <Select selectedKey="{horasModel>/filtros/periodo}">
                                <core:Item key="mayo2024" text="Mayo 2024 (Mensual)"/>
                                <core:Item key="junio2024" text="Junio 2024 (Mensual)"/>
                            </Select>
                        </VBox>
                        <VBox id="fbFechaDesde" class="htwFilterBox htwFilterFecha">
                            <Label text="Fecha desde" class="htwFilterLabel"/>
                            <DatePicker value="{horasModel>/filtros/fechaDesde}" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy"/>
                        </VBox>
                        <VBox id="fbFechaHasta" class="htwFilterBox htwFilterFecha">
                            <Label text="Fecha hasta" class="htwFilterLabel"/>
                            <DatePicker value="{horasModel>/filtros/fechaHasta}" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy"/>
                        </VBox>
                        <VBox id="fbZona" class="htwFilterBox htwFilterSmall">
                            <Label text="Zona" class="htwFilterLabel"/>
                            <Select selectedKey="{horasModel>/filtros/zona}">
                                <core:Item key="todas" text="Todas"/>
                                <core:Item key="norte" text="Norte"/>
                                <core:Item key="centro" text="Centro"/>
                                <core:Item key="sur" text="Sur"/>
                            </Select>
                        </VBox>
                        <VBox id="fbSupervisor" class="htwFilterBox htwFilterSmall">
                            <Label text="Supervisor" class="htwFilterLabel"/>
                            <Select selectedKey="{horasModel>/filtros/supervisor}">
                                <core:Item key="todos" text="Todos"/>
                                <core:Item key="sup1" text="Juan Pérez"/>
                                <core:Item key="sup2" text="María López"/>
                            </Select>
                        </VBox>
                        <VBox id="fbTipoOrden" class="htwFilterBox htwFilterSmall">
                            <Label text="Tipo de orden" class="htwFilterLabel"/>
                            <Select selectedKey="{horasModel>/filtros/tipoOrden}">
                                <core:Item key="todos" text="Todos"/>
                                <core:Item key="implementacion" text="Implementación"/>
                                <core:Item key="reparacion" text="Reparación"/>
                                <core:Item key="callcenter" text="Call Center"/>
                            </Select>
                        </VBox>
                        <VBox id="fbTurno" class="htwFilterBox htwFilterSmall">
                            <Label text="Turno" class="htwFilterLabel"/>
                            <Select selectedKey="{horasModel>/filtros/turno}">
                                <core:Item key="todos" text="Todos"/>
                                <core:Item key="diurno" text="Diurno"/>
                                <core:Item key="nocturno" text="Nocturno"/>
                                <core:Item key="finsemana" text="Fin de semana"/>
                            </Select>
                        </VBox>
                        <VBox id="fbMecanico" class="htwFilterBox htwFilterSmall">
                            <Label text="Mecánico" class="htwFilterLabel"/>
                            <Select selectedKey="{horasModel>/filtros/mecanico}">
                                <core:Item key="todos" text="Todos"/>
                                <core:Item key="mec1" text="Juan Pérez"/>
                                <core:Item key="mec2" text="Carlos Ruiz"/>
                            </Select>
                        </VBox>
                        <VBox id="fbEstado" class="htwFilterBox htwFilterEstado">
                            <Label text="Estado de orden" class="htwFilterLabel"/>
                            <Select selectedKey="{horasModel>/filtros/estadoOrden}">
                                <core:Item key="todos" text="Todos"/>
                                <core:Item key="abierta" text="Abierta"/>
                                <core:Item key="cerrada" text="Cerrada"/>
                            </Select>
                        </VBox>
                        <Button id="btnAplicarFiltros" text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" class="htwApplyButton" press=".onAplicarFiltros"/>
                    </HBox>
                    <!-- KPIS SUPERIORES -->
                    <HBox id="hbKpis" class="htwKpiWrapper" alignItems="Center" justifyContent="SpaceBetween" wrap="NoWrap">
                        <VBox id="cardCapacidadComprometida" class="htwBigKpi htwPurpleKpi">
                            <HBox class="htwBigKpiInner" alignItems="Center">
                                <VBox class="htwKpiIcon htwKpiIconPurple" alignItems="Center" justifyContent="Center">
                                    <core:Icon src="sap-icon://group"/>
                                </VBox>
                                <VBox class="htwKpiContent">
                                    <Text text="Capacidad comprometida" class="htwKpiLabel"/>
                                    <Text text="{horasModel>/kpis/capacidadComprometida}" class="htwKpiNumber htwPurpleText"/>
                                    <Text text="Relación: horas programadas / capacidad disponible" class="htwKpiDescription"/>
                                    <HBox class="htwKpiProgressTrack">
                                        <HBox class="htwKpiProgressFill htwKpiProgressPurpleFill" width="{= ${horasModel>/kpis/capacidadComprometidaValor} + '%' }"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                        <VBox id="cardMargenCapacidad" class="htwBigKpi htwGreenKpi">
                            <HBox class="htwBigKpiInner" alignItems="Center">
                                <VBox class="htwKpiIcon htwKpiIconGreen" alignItems="Center" justifyContent="Center">
                                    <core:Icon src="sap-icon://line-chart"/>
                                </VBox>
                                <VBox class="htwKpiContent">
                                    <Text text="Margen de capacidad" class="htwKpiLabel"/>
                                    <Text text="{horasModel>/kpis/margenCapacidad}" class="htwKpiNumber htwGreenText"/>
                                    <Text text="Horas disponibles para absorber carga adicional" class="htwKpiDescription"/>
                                    <HBox class="htwKpiProgressTrack">
                                        <HBox class="htwKpiProgressFill htwKpiProgressGreenFill" width="{= ${horasModel>/kpis/margenCapacidadValor} + '%' }"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>
                    <!-- DASHBOARD -->
                    <VBox id="vbDashboardGrid" class="htwDashboardGrid">
                        <!-- FILA 1 -->
                        <HBox id="rowCards1" class="htwCardsRow" wrap="NoWrap">
                            <!-- CARD 1: CAPACIDAD VS CARGA -->
                            <!-- CARD 1: CAPACIDAD VS CARGA -->
                            <VBox id="cardCapacidadCarga" class="htwCard htwCapacidadCargaCard htwDonutCleanCard">
                                <HBox class="htwCardHeader htwDonutCleanHeader" justifyContent="Start" alignItems="Center">
                                    <Title text="Capacidad vs carga programada" level="H3" class="htwCardTitle"/>
                                    <core:Icon id="icInfoCapacidadCarga" src="sap-icon://hint" class="htwDonutCleanTitleIcon"/>
                                </HBox>
                                <HBox class="htwDonutCleanArea" alignItems="Center" justifyContent="Center">
                                    <VBox class="htwDonutCleanSvgWrapper" alignItems="Center" justifyContent="Center">
                                        <core:HTML sanitizeContent="false" content='&lt;svg class="htwDonutCleanSvg" viewBox="0 0 180 180"&gt;
                    &lt;g transform="rotate(-90 90 90)"&gt;
                        &lt;circle cx="90" cy="90" r="58" fill="none" stroke="#ff9800" stroke-width="34" pathLength="100" stroke-dasharray="31.7 68.3" stroke-dashoffset="0"/&gt;
                        &lt;circle cx="90" cy="90" r="58" fill="none" stroke="#15b65c" stroke-width="34" pathLength="100" stroke-dasharray="34.3 65.7" stroke-dashoffset="-31.7"/&gt;
                        &lt;circle cx="90" cy="90" r="58" fill="none" stroke="#2196f3" stroke-width="34" pathLength="100" stroke-dasharray="31 69" stroke-dashoffset="-66"/&gt;
                    &lt;/g&gt;
                    &lt;circle cx="90" cy="90" r="37" fill="#ffffff"/&gt;
                    &lt;text x="90" y="80" text-anchor="middle" class="htwDonutCleanCenterLabel"&gt;Total&lt;/text&gt;
                    &lt;text x="90" y="102" text-anchor="middle" class="htwDonutCleanCenterValue"&gt;6,400 h&lt;/text&gt;
                 &lt;text x="36" y="90" text-anchor="middle" class="htwDonutCleanPct"&gt;31.0%&lt;/text&gt;
&lt;text x="145" y="90" text-anchor="middle" class="htwDonutCleanPct"&gt;31.7%&lt;/text&gt;
&lt;text x="90" y="145" text-anchor="middle" class="htwDonutCleanPct"&gt;34.3%&lt;/text&gt;
                &lt;/svg&gt;'/>
                                    </VBox>
                                    <VBox class="htwDonutCleanLegend" justifyContent="Center">
                                        <HBox class="htwDonutCleanLegendItem" alignItems="Center">
                                            <VBox class="htwDonutCleanDot htwDonutCleanDotOrange"/>
                                            <VBox>
                                                <Text text="Capacidad disponible" class="htwDonutCleanLegendTitle"/>
                                                <Text text="6,400 h (34.3%)" class="htwDonutCleanLegendSub"/>
                                            </VBox>
                                        </HBox>
                                        <HBox class="htwDonutCleanLegendItem" alignItems="Center">
                                            <VBox class="htwDonutCleanDot htwDonutCleanDotGreen"/>
                                            <VBox>
                                                <Text text="Horas programadas" class="htwDonutCleanLegendTitle"/>
                                                <Text text="5,900 h (31.7%)" class="htwDonutCleanLegendSub"/>
                                            </VBox>
                                        </HBox>
                                        <HBox class="htwDonutCleanLegendItem" alignItems="Center">
                                            <VBox class="htwDonutCleanDot htwDonutCleanDotBlue"/>
                                            <VBox>
                                                <Text text="Horas reales" class="htwDonutCleanLegendTitle"/>
                                                <Text text="5,842 h (31.0%)" class="htwDonutCleanLegendSub"/>
                                            </VBox>
                                        </HBox>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <!-- CARD 2: UTILIZACIÓN POR TURNO -->
                            <VBox id="cardUtilizacionTurno" class="htwCard htwUtilizacionCard">
                                <HBox class="htwCardHeader htwTurnoHeader" alignItems="Center" justifyContent="Start">
                                    <HBox class="htwTurnoTitleInlineRow" alignItems="Center">
                                        <Title text="Utilización por turno" level="H3" class="htwCardTitle htwTurnoCardTitle" />
                                        <core:Icon id="icInfoUtilizacionTurno" src="sap-icon://hint" class="htwTurnoInfoIcon" />
                                        <Text text="Resumen de utilización por turno" class="htwTurnoInlineSubtitle" />
                                    </HBox>
                                </HBox>
                                <VBox class="htwTurnoManualList">
                                    <!-- DIURNO -->
                                    <HBox class="htwTurnoManualRow" alignItems="Center">
                                        <VBox class="htwTurnoIconBox htwTurnoIconSuccess" alignItems="Center" justifyContent="Center">
                                            <core:Icon src="sap-icon://light-mode"/>
                                        </VBox>
                                        <VBox class="htwTurnoManualContent">
                                            <Text text="Diurno" class="htwTurnoManualName"/>
                                            <HBox class="htwTurnoManualBarLine" alignItems="Center">
                                                <HBox class="htwTurnoManualTrack">
                                                    <HBox class="htwTurnoManualFill htwTurnoFillSuccess" width="84.9%"/>
                                                </HBox>
                                                <Text text="84.9%" class="htwTurnoManualValue htwTurnoValueSuccess"/>
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                    <!-- NOCTURNO -->
                                    <HBox class="htwTurnoManualRow" alignItems="Center">
                                        <VBox class="htwTurnoIconBox htwTurnoIconWarning" alignItems="Center" justifyContent="Center">
                                            <core:Icon src="sap-icon://lateness"/>
                                        </VBox>
                                        <VBox class="htwTurnoManualContent">
                                            <Text text="Nocturno" class="htwTurnoManualName"/>
                                            <HBox class="htwTurnoManualBarLine" alignItems="Center">
                                                <HBox class="htwTurnoManualTrack">
                                                    <HBox class="htwTurnoManualFill htwTurnoFillWarning" width="95.1%"/>
                                                </HBox>
                                                <Text text="95.1%" class="htwTurnoManualValue htwTurnoValueWarning"/>
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                    <!-- FIN DE SEMANA -->
                                    <HBox class="htwTurnoManualRow" alignItems="Center">
                                        <VBox class="htwTurnoIconBox htwTurnoIconError" alignItems="Center" justifyContent="Center">
                                            <core:Icon src="sap-icon://appointment-2"/>
                                        </VBox>
                                        <VBox class="htwTurnoManualContent">
                                            <Text text="Fin de semana" class="htwTurnoManualName"/>
                                            <HBox class="htwTurnoManualBarLine" alignItems="Center">
                                                <HBox class="htwTurnoManualTrack">
                                                    <HBox class="htwTurnoManualFill htwTurnoFillError" width="100%"/>
                                                </HBox>
                                                <Text text="117.4%" class="htwTurnoManualValue htwTurnoValueError"/>
                                            </HBox>
                                        </VBox>
                                    </HBox>
                                </VBox>
                                <HBox class="htwPromedioBox" justifyContent="SpaceBetween" alignItems="Center">
                                    <HBox alignItems="Center">
                                        <VBox class="htwPromedioIcon" alignItems="Center" justifyContent="Center">
                                            <core:Icon src="sap-icon://business-objects-experience"/>
                                        </VBox>
                                        <Text text="Promedio de utilización" class="htwPromedioLabel"/>
                                    </HBox>
                                    <Text text="99.1%" class="htwPromedioValue"/>
                                </HBox>
                            </VBox>
                            <!-- CARD 3: HORAS POR TIPO DE ORDEN -->
                            <VBox id="cardHorasTipoOrden" class="htwCard htwTipoOrdenCard">
                                <HBox class="htwTipoOrdenHeader" alignItems="Center" justifyContent="Start">
                                    <Title text="Horas por tipo de orden (plan vs real)" level="H3" class="htwCardTitle htwTipoOrdenTitle"/>
                                    <core:Icon id="icInfoHorasTipoOrden" src="sap-icon://hint" class="htwTipoOrdenInfoIcon"/>
                                </HBox>
                                <HBox class="htwTipoOrdenLegendRow" alignItems="Center" wrap="NoWrap">
                                    <HBox class="htwTipoOrdenLegendItem" alignItems="Center">
                                        <VBox class="htwTipoLegendLine htwTipoLegendBlue"/>
                                        <Text text="Horas programadas" class="htwTipoLegendText"/>
                                    </HBox>
                                    <HBox class="htwTipoOrdenLegendItem" alignItems="Center">
                                        <VBox class="htwTipoLegendLine htwTipoLegendPurple"/>
                                        <Text text="Horas reales" class="htwTipoLegendText"/>
                                    </HBox>
                                    <HBox class="htwTipoOrdenLegendItem" alignItems="Center">
                                        <VBox class="htwTipoLegendDashed"/>
                                        <Text text="Variación (%)" class="htwTipoLegendText"/>
                                    </HBox>
                                </HBox>
                                <VBox class="htwTipoOrdenChartBox">
                                    <core:HTML id="htmlTipoOrdenChart" sanitizeContent="false" content='&lt;svg class="htwTipoSvg" viewBox="0 0 560 235" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg"&gt;
        &lt;!-- Texto Horas hombre como la referencia --&gt;
        &lt;text x="62" y="28" class="htwTipoYAxisTitle"&gt;Horas hombre&lt;/text&gt;
        &lt;!-- Grid --&gt;
        &lt;line x1="62" y1="45" x2="525" y2="45" class="htwTipoGridLine"/&gt;
        &lt;line x1="62" y1="78" x2="525" y2="78" class="htwTipoGridLine"/&gt;
        &lt;line x1="62" y1="112" x2="525" y2="112" class="htwTipoGridLine"/&gt;
        &lt;line x1="62" y1="146" x2="525" y2="146" class="htwTipoGridLine"/&gt;
        &lt;line x1="62" y1="178" x2="525" y2="178" class="htwTipoAxisLine"/&gt;
        &lt;!-- Eje Y --&gt;
        &lt;text x="22" y="49" class="htwTipoAxisText"&gt;4K&lt;/text&gt;
        &lt;text x="22" y="82" class="htwTipoAxisText"&gt;3K&lt;/text&gt;
        &lt;text x="22" y="116" class="htwTipoAxisText"&gt;2K&lt;/text&gt;
        &lt;text x="22" y="150" class="htwTipoAxisText"&gt;1K&lt;/text&gt;
        &lt;text x="30" y="182" class="htwTipoAxisText"&gt;0&lt;/text&gt;
        &lt;!-- Línea azul: Horas programadas --&gt;
        &lt;polyline fill="none" stroke="#2563eb" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="110,80 210,88 285,125 320,122 440,160 500,152"/&gt;
        &lt;!-- Línea morada: Horas reales --&gt;
        &lt;polyline fill="none" stroke="#7c3aed" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" points="110,95 210,105 285,140 320,140 440,172 500,165"/&gt;
        &lt;!-- Puntos azules --&gt;
        &lt;circle cx="110" cy="80" r="4.4" fill="#2563eb" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="210" cy="88" r="4.4" fill="#2563eb" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="285" cy="125" r="4.4" fill="#2563eb" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="320" cy="122" r="4.4" fill="#2563eb" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="440" cy="160" r="4.4" fill="#2563eb" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="500" cy="152" r="4.4" fill="#2563eb" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;!-- Puntos morados --&gt;
        &lt;circle cx="110" cy="95" r="4.4" fill="#7c3aed" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="210" cy="105" r="4.4" fill="#7c3aed" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="285" cy="140" r="4.4" fill="#7c3aed" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="320" cy="140" r="4.4" fill="#7c3aed" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="440" cy="172" r="4.4" fill="#7c3aed" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;circle cx="500" cy="165" r="4.4" fill="#7c3aed" stroke="#ffffff" stroke-width="2"/&gt;
        &lt;!-- Valores azules --&gt;
        &lt;text x="92" y="66" class="htwTipoBlueText"&gt;3,100 h&lt;/text&gt;
        &lt;text x="190" y="76" class="htwTipoBlueText"&gt;2,950 h&lt;/text&gt;
        &lt;text x="345" y="125" class="htwTipoBlueText"&gt;1,700 h&lt;/text&gt;
        &lt;text x="505" y="152" class="htwTipoBlueText"&gt;692 h&lt;/text&gt;
        &lt;!-- Valores morados --&gt;
        &lt;text x="94" y="113" class="htwTipoPurpleText"&gt;2,950 h&lt;/text&gt;
        &lt;text x="300" y="158" class="htwTipoPurpleText"&gt;1,900 h&lt;/text&gt;
        &lt;text x="505" y="174" class="htwTipoPurpleText"&gt;620 h&lt;/text&gt;
        &lt;!-- Badges más pequeños --&gt;
        &lt;rect x="220" y="126" rx="9" ry="9" width="48" height="18" class="htwTipoBadgeGreen"/&gt;
        &lt;text x="232" y="139" class="htwTipoGreenText"&gt;-4.8%&lt;/text&gt;
        &lt;rect x="328" y="102" rx="9" ry="9" width="54" height="18" class="htwTipoBadgeRed"/&gt;
        &lt;text x="341" y="115" class="htwTipoRedText"&gt;+11.8%&lt;/text&gt;
        &lt;rect x="462" y="118" rx="9" ry="9" width="56" height="18" class="htwTipoBadgeGreen"/&gt;
        &lt;text x="475" y="131" class="htwTipoGreenText"&gt;+11.3%&lt;/text&gt;
        &lt;!-- Etiquetas eje X --&gt;
        &lt;text x="110" y="202" text-anchor="middle" class="htwTipoXAxisText"&gt;Implementación&lt;/text&gt;
        &lt;text x="110" y="216" text-anchor="middle" class="htwTipoXAxisText"&gt;planeada&lt;/text&gt;
        &lt;text x="285" y="202" text-anchor="middle" class="htwTipoXAxisText"&gt;Reparación&lt;/text&gt;
        &lt;text x="285" y="216" text-anchor="middle" class="htwTipoXAxisText"&gt;(correctiva)&lt;/text&gt;
        &lt;text x="472" y="210" text-anchor="middle" class="htwTipoXAxisText"&gt;Call Center&lt;/text&gt;
    &lt;/svg&gt;'/>
                                </VBox>
                                <Link text="Ver detalles por tipo de orden" class="htwCardLink htwTipoOrdenLink" press=".onVerDetalleTipoOrden"/>
                            </VBox>
                        </HBox>
                        <!-- FILA 2 -->
                        <HBox id="rowCards2" class="htwCardsRow" wrap="NoWrap">
                            <!-- CARD 4: CAPACIDAD POR ZONA -->
                            <VBox id="cardCapacidadZona" class="htwCard htwZonaCard htwZonaV2Card">
                                <!-- Header -->
                                <HBox class="htwZonaV2Header" justifyContent="SpaceBetween" alignItems="Center">
                                    <HBox alignItems="Center" class="htwZonaV2TitleRow">
                                        <Title text="Capacidad por zona" level="H3" class="htwCardTitle htwZonaV2Title"/>
                                        <core:Icon src="sap-icon://hint" class="htwZonaV2InfoIcon"/>
                                    </HBox>
                                    <Button icon="sap-icon://overflow" type="Transparent" class="htwZonaV2MenuButton"/>
                                </HBox>
                                <!-- Caja de análisis arriba, ya no encima de la gráfica -->
                                <HBox class="htwZonaV2Analysis" alignItems="Start">
                                    <core:Icon src="sap-icon://alert" class="htwZonaV2AlertIcon"/>
                                    <VBox class="htwZonaV2AnalysisTextBox">
                                        <Text text="Análisis" class="htwZonaV2AnalysisTitle"/>
                                        <Text text="Muestra de utilización en porcentaje por debajo del rango normal de utilización." class="htwZonaV2AnalysisText"/>
                                        <Link text="Ver detalle" class="htwZonaV2AnalysisLink" press=".onVerDetalleZona"/>
                                    </VBox>
                                </HBox>
                                <!-- Gráfica -->
                                <VBox class="htwZonaV2ChartBox">
                                    <core:HTML id="htmlCapacidadZonaChart" sanitizeContent="false" content='&lt;svg class="htwZonaV2Svg" viewBox="0 0 500 112" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"&gt;
    &lt;!-- Grid --&gt;
    &lt;line x1="38" y1="10" x2="488" y2="10" class="htwZonaV2Grid"/&gt;
    &lt;line x1="38" y1="34" x2="488" y2="34" class="htwZonaV2Grid"/&gt;
    &lt;line x1="38" y1="58" x2="488" y2="58" class="htwZonaV2Grid"/&gt;
    &lt;line x1="38" y1="84" x2="488" y2="84" class="htwZonaV2Base"/&gt;
    &lt;!-- Eje Y --&gt;
    &lt;text x="5" y="13" class="htwZonaV2AxisText"&gt;150%&lt;/text&gt;
