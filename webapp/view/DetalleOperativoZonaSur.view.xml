<mvc:View
    controllerName="mantenimiento.controller.DetalleOperativoZonaSur"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:html="http://www.w3.org/1999/xhtml">

    <Page
        showHeader="false"
        busy="{doz>/busy}"
        busyIndicatorDelay="0"
        class="DetalleOperativoZonaSur">

        <content>
            <ScrollContainer
                height="100%"
                width="100%"
                vertical="true"
                horizontal="false">

                <VBox class="dozPage">

                    <!-- HEADER -->
                    <VBox class="dozHeader">
                        <Title
                            text="Detalle operativo de zona"
                            level="H1"
                            class="dozTitle"/>

                        <Text
                            text="Información consolidada de carga, horas y recursos de la zona seleccionada."
                            class="dozSubtitle"/>
                    </VBox>

                    <!-- FILTROS -->
                    <HBox
                        class="dozFiltersBar"
                        wrap="NoWrap"
                        alignItems="End">

                        <VBox class="dozFilterBox">
                            <Label
                                text="Periodo"
                                class="dozFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{doz>/filtros/periodo}"
                                change=".onPeriodoChange"
                                items="{doz>/catalogos/periodos}">

                                <core:Item
                                    key="{doz>key}"
                                    text="{doz>text}"/>
                            </Select>
                        </VBox>

                        <VBox class="dozFilterBox">
                            <Label
                                text="Fecha desde"
                                class="dozFilterLabel"/>

                            <DatePicker
                                width="100%"
                                value="{doz>/filtros/fechaDesde}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy"
                                change=".onFechaChange"/>
                        </VBox>

                        <VBox class="dozFilterBox">
                            <Label
                                text="Fecha hasta"
                                class="dozFilterLabel"/>

                            <DatePicker
                                width="100%"
                                value="{doz>/filtros/fechaHasta}"
                                displayFormat="dd/MM/yyyy"
                                valueFormat="dd/MM/yyyy"
                                change=".onFechaChange"/>
                        </VBox>

                        <VBox class="dozFilterBox">
                            <Label
                                text="Zona"
                                class="dozFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{doz>/filtros/zona}"
                                items="{doz>/catalogos/zonas}">

                                <core:Item
                                    key="{doz>key}"
                                    text="{doz>text}"/>
                            </Select>
                        </VBox>

                        <VBox class="dozFilterBox">
                            <Label
                                text="Supervisor"
                                class="dozFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{doz>/filtros/supervisor}"
                                items="{doz>/catalogos/supervisores}">

                                <core:Item
                                    key="{doz>key}"
                                    text="{doz>text}"/>
                            </Select>
                        </VBox>

                        <VBox class="dozFilterBox">
                            <Label
                                text="Tipo de orden"
                                class="dozFilterLabel"/>

                            <Select
                                width="100%"
                                selectedKey="{doz>/filtros/tipoOrden}"
                                items="{doz>/catalogos/tiposOrden}">

                                <core:Item
                                    key="{doz>key}"
                                    text="{doz>text}"/>
                            </Select>
                        </VBox>

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            class="dozApplyButton"
                            press=".onAplicarFiltros"/>
                    </HBox>

                    <!-- KPI -->
                    <HBox
                        class="dozKpiRow"
                        wrap="NoWrap">

                        <HBox
                            class="dozKpiCard dozKpiDanger"
                            alignItems="Center">

                            <HBox
                                class="dozKpiIcon dozIconDanger"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://target-group"/>
                            </HBox>

                            <VBox class="dozKpiTextBox">
                                <Text
                                    text="Índice de presión de la zona"
                                    class="dozKpiLabel"/>

                                <HBox
                                    alignItems="Center"
                                    class="dozKpiMainLine">

                                    <Text
                                        text="{doz>/kpis/indicePresion/texto}"
                                        class="dozKpiNumber dozTextDanger"/>

                                    <ObjectStatus
                                        text="{doz>/kpis/indicePresion/estado}"
                                        class="dozKpiBadge"/>
                                </HBox>

                                <Text
                                    text="{doz>/kpis/indicePresion/nivel}"
                                    class="dozKpiSmall"/>
                            </VBox>
                        </HBox>

                        <HBox
                            class="dozKpiCard dozKpiBlue"
                            alignItems="Center">

                            <HBox
                                class="dozKpiIcon dozIconBlue"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://checklist"/>
                            </HBox>

                            <VBox class="dozKpiTextBox">
                                <Text
                                    text="Órdenes abiertas"
                                    class="dozKpiLabel"/>

                                <Text
                                    text="{doz>/kpis/ordenesAbiertas/valor}"
                                    class="dozKpiNumber dozTextBlue"/>

                                <Text
                                    text="{doz>/kpis/ordenesAbiertas/porcentaje}"
                                    class="dozKpiSmall"/>
                            </VBox>
                        </HBox>

                        <HBox
                            class="dozKpiCard dozKpiRed"
                            alignItems="Center">

                            <HBox
                                class="dozKpiIcon dozIconRed"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://lateness"/>
                            </HBox>

                            <VBox class="dozKpiTextBox">
                                <Text
                                    text="Órdenes vencidas"
                                    class="dozKpiLabel"/>

                                <Text
                                    text="{doz>/kpis/ordenesVencidas/valor}"
                                    class="dozKpiNumber dozTextRed"/>

                                <Text
                                    text="{doz>/kpis/ordenesVencidas/porcentaje}"
                                    class="dozKpiSmall"/>
                            </VBox>
                        </HBox>

                        <HBox
                            busy="{doz>/operationalBusy}"
                            busyIndicatorDelay="0"
                            class="dozKpiCard dozKpiPurple"
                            alignItems="Center">

                            <HBox
                                class="dozKpiIcon dozIconPurple"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://time-entry-request"/>
                            </HBox>

                            <VBox class="dozKpiTextBox">
                                <Text
                                    text="Horas programadas"
                                    class="dozKpiLabel"/>

                                <Text
                                    text="{doz>/kpis/horasProgramadas/texto}"
                                    class="dozKpiNumber dozTextPurple"/>
                            </VBox>
                        </HBox>

                        <HBox
                            busy="{doz>/confirmationBusy}"
                            busyIndicatorDelay="0"
                            class="dozKpiCard dozKpiGreen"
                            alignItems="Center">

                            <HBox
                                class="dozKpiIcon dozIconGreen"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://clock"/>
                            </HBox>

                            <VBox class="dozKpiTextBox">
                                <Text
                                    text="Horas reales"
                                    class="dozKpiLabel"/>

                                <Text
                                    text="{doz>/kpis/horasReales/texto}"
                                    class="dozKpiNumber dozTextGreen"/>

                                <Text
                                    text="{doz>/kpis/horasReales/variacion}"
                                    class="dozKpiSmall dozTextRed"/>
                            </VBox>
                        </HBox>

                        <HBox
                            class="dozKpiCard dozKpiResource"
                            alignItems="Center">

                            <HBox
                                class="dozKpiIcon dozIconResource"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://group"/>
                            </HBox>

                            <VBox class="dozKpiTextBox">
                                <Text
                                    text="Recursos disponibles (Mecánicos / Ayudantes)"
                                    class="dozKpiLabel"/>

                                <Text
                                    text="{doz>/kpis/recursosDisponibles/texto}"
                                    class="dozKpiNumber dozTextGreen"/>

                                <Text
                                    text="{doz>/kpis/recursosDisponibles/utilizacion}"
                                    class="dozKpiSmall"/>
                            </VBox>
                        </HBox>
                    </HBox>

                    <!-- FILA SUPERIOR -->
                    <HBox
                        class="dozTopGrid"
                        wrap="NoWrap">

                        <!-- RESUMEN ESTADOS -->
                        <VBox class="dozCard dozStatusCard">

                            <HBox
                                class="dozCardHeader"
                                justifyContent="SpaceBetween"
                                alignItems="Center">

                                <HBox alignItems="Center">
                                    <Title
                                        text="Resumen de carga operativa por estado"
                                        level="H3"
                                        class="dozCardTitle"/>

                                    <Button
                                        icon="sap-icon://hint"
                                        type="Transparent"
                                        class="dozInfoBtn"/>
                                </HBox>

                                <HBox
                                    class="dozTotalPill"
                                    alignItems="Center"
                                    justifyContent="Center">

                                    <Text text="Total"/>

                                    <Text
                                        text="{doz>/totalOrdenesAbiertas}"
                                        class="dozTotalValue"/>
                                </HBox>
                            </HBox>

                            <Text
                                text="Distribución de órdenes de la zona por estado."
                                class="dozCardSubtitle"/>

                            <VBox
                                class="dozStatusList"
                                items="{doz>/resumenEstados}">

                                <items>
                                    <HBox
                                        class="dozStatusRow"
                                        alignItems="Center">

                                        <HBox
                                            class="dozStatusIconBox"
                                            alignItems="Center"
                                            justifyContent="Center">

                                            <customData>
                                                <core:CustomData
                                                    key="color"
                                                    value="{doz>color}"
                                                    writeToDom="true"/>
                                            </customData>

                                            <core:Icon
                                                src="{doz>icon}"/>
                                        </HBox>

                                        <Text
                                            text="{doz>estado}"
                                            class="dozStatusName"/>

                                        <ProgressIndicator
                                            percentValue="{doz>porcentajeNumero}"
                                            displayValue=""
                                            width="100%"
                                            class="dozStatusProgress">

                                            <customData>
                                                <core:CustomData
                                                    key="color"
                                                    value="{doz>color}"
                                                    writeToDom="true"/>
                                            </customData>
                                        </ProgressIndicator>

                                        <Text
                                            text="{doz>cantidad}"
                                            class="dozStatusQty"/>

                                        <Text
                                            text="{doz>porcentajeTexto}"
                                            class="dozStatusPct"/>
                                    </HBox>
                                </items>
                            </VBox>

                            <HBox
                                class="dozCardLink"
                                justifyContent="End"
                                alignItems="Center">

                                <Link
                                    text="Ver detalle de órdenes"
                                    press=".onVerDetalleOrdenes"/>

                                <core:Icon
                                    src="sap-icon://arrow-right"/>
                            </HBox>
                        </VBox>

                        <!-- EVOLUCIÓN HORAS -->
                        <VBox
                            busy="{doz>/confirmationBusy}"
                            busyIndicatorDelay="0"
                            class="dozCard dozHoursCardFixed">

                            <HBox
                                class="dozHoursFixedHeader"
                                alignItems="Center">

                                <Title
                                    text="Evolución de horas (programadas vs reales)"
                                    level="H3"
                                    class="dozHoursFixedTitle"/>

                                <Button
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    class="dozHoursFixedInfo"/>
                            </HBox>

                            <Text
                                text="Comparativa acumulada de horas en el periodo."
                                class="dozHoursFixedSubtitle"/>

                            <HBox
                                class="dozHoursFixedMiniRow"
                                wrap="NoWrap">

                                <HBox
                                    class="dozHoursFixedMini dozHoursFixedPurple"
                                    alignItems="Center">

                                    <core:Icon
                                        src="sap-icon://calendar"/>

                                    <VBox>
                                        <Text
                                            text="Total programadas"
                                            class="dozHoursFixedMiniLabel"/>

                                        <Text
                                            text="{doz>/horasResumen/programadas}"
                                            class="dozHoursFixedMiniValue"/>
                                    </VBox>
                                </HBox>

                                <HBox
                                    class="dozHoursFixedMini dozHoursFixedGreen"
                                    alignItems="Center">

                                    <core:Icon
                                        src="sap-icon://clock"/>

                                    <VBox>
                                        <Text
                                            text="Total reales"
                                            class="dozHoursFixedMiniLabel"/>

                                        <Text
                                            text="{doz>/horasResumen/reales}"
                                            class="dozHoursFixedMiniValue"/>
                                    </VBox>
                                </HBox>

                                <HBox
                                    class="dozHoursFixedMini dozHoursFixedRed"
                                    alignItems="Center">

                                    <core:Icon
                                        src="sap-icon://trend-up"/>

                                    <VBox>
                                        <Text
                                            text="Variación"
                                            class="dozHoursFixedMiniLabel"/>

                                        <Text
                                            text="{doz>/horasResumen/variacion}"
                                            class="dozHoursFixedMiniValue"/>
                                    </VBox>
                                </HBox>
                            </HBox>

                            <VBox class="dozHoursFixedChartBox">

                                <HBox
                                    class="dozHoursFixedLegend"
                                    justifyContent="End"
                                    alignItems="Center">

                                    <HBox alignItems="Center">
                                        <VBox class="dozHoursFixedLegendPurple"/>
                                        <Text text="Programadas"/>
                                    </HBox>

                                    <HBox alignItems="Center">
                                        <VBox class="dozHoursFixedLegendGreen"/>
                                        <Text text="Reales"/>
                                    </HBox>
                                </HBox>

                                <html:svg
                                    class="dozHoursFixedSvg"
                                    width="100%"
                                    height="100%"
                                    viewBox="0 0 560 205"
                                    preserveAspectRatio="none">

                                    <html:line x1="45" y1="30" x2="530" y2="30" class="dozHoursFixedGrid"/>
                                    <html:line x1="45" y1="65" x2="530" y2="65" class="dozHoursFixedGrid"/>
                                    <html:line x1="45" y1="100" x2="530" y2="100" class="dozHoursFixedGrid"/>
                                    <html:line x1="45" y1="135" x2="530" y2="135" class="dozHoursFixedGrid"/>
                                    <html:line x1="45" y1="170" x2="530" y2="170" class="dozHoursFixedGrid"/>

                                    <html:line x1="45" y1="30" x2="45" y2="170" class="dozHoursFixedAxis"/>
                                    <html:line x1="45" y1="170" x2="530" y2="170" class="dozHoursFixedAxis"/>

                                    <html:polyline
                                        points=""
                                        class="dozHoursFixedLinePurple"/>

                                    <html:polyline
                                        points=""
                                        class="dozHoursFixedLineGreen"/>

                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotPurple"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotPurple"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotPurple"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotPurple"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotPurple"/>

                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotGreen"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotGreen"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotGreen"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotGreen"/>
                                    <html:circle cx="-20" cy="-20" r="4" class="dozHoursFixedDotGreen"/>

                                    <html:text x="4" y="35" class="dozHoursFixedLabel">Máx.</html:text>
                                    <html:text x="14" y="105" class="dozHoursFixedLabel">50%</html:text>
                                    <html:text x="26" y="175" class="dozHoursFixedLabel">0</html:text>

                                    <html:text x="70" y="195" class="dozHoursFixedLabel dozHoursWeekLabel" text-anchor="middle"></html:text>
                                    <html:text x="180" y="195" class="dozHoursFixedLabel dozHoursWeekLabel" text-anchor="middle"></html:text>
                                    <html:text x="290" y="195" class="dozHoursFixedLabel dozHoursWeekLabel" text-anchor="middle"></html:text>
                                    <html:text x="400" y="195" class="dozHoursFixedLabel dozHoursWeekLabel" text-anchor="middle"></html:text>
                                    <html:text x="510" y="195" class="dozHoursFixedLabel dozHoursWeekLabel" text-anchor="middle"></html:text>
                                </html:svg>
                            </VBox>

                            <HBox
                                class="dozHoursFixedLink"
                                justifyContent="End"
                                alignItems="Center">

                                <Link
                                    text="Ver detalle de horas"
                                    press=".onVerDetalleHoras"/>

                                <core:Icon
                                    src="sap-icon://arrow-right"/>
                            </HBox>
                        </VBox>

                        <!-- RECURSOS -->
                        <VBox
                            busy="{doz>/operationalBusy}"
                            busyIndicatorDelay="0"
                            class="dozCard dozResourcesCard">

                            <HBox
                                class="dozCardHeader"
                                alignItems="Center">

                                <Title
                                    text="Recursos y utilización"
                                    level="H3"
                                    class="dozCardTitle"/>

                                <Button
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    class="dozInfoBtn"/>
                            </HBox>

                            <Text
                                text="Capacidad, utilización y disponibilidad de recursos."
                                class="dozCardSubtitle"/>

                            <VBox
                                class="dozGaugeWrap"
                                alignItems="Center">

                                <html:div class="dozGauge">
                                    <html:div class="dozGaugeNeedle"></html:div>

                                    <html:div class="dozGaugeCenter">
                                        <html:div class="dozGaugeValue">Sin datos</html:div>
                                        <html:div class="dozGaugeText">Utilización</html:div>
                                    </html:div>

                                    <html:span class="dozGaugeLabel dozGaugeLabel0">0%</html:span>
                                    <html:span class="dozGaugeLabel dozGaugeLabel50">50%</html:span>
                                    <html:span class="dozGaugeLabel dozGaugeLabel80">80%</html:span>
                                    <html:span class="dozGaugeLabel dozGaugeLabel100">100%</html:span>
                                </html:div>
                            </VBox>

                            <HBox
                                class="dozResourceBoxes"
                                wrap="NoWrap">

                                <VBox class="dozResourceBox">
                                    <HBox alignItems="Center">
                                        <HBox
                                            class="dozResourceIcon dozIconBlue"
                                            alignItems="Center"
                                            justifyContent="Center">

                                            <core:Icon
                                                src="sap-icon://technical-object"/>
                                        </HBox>

                                        <Text
                                            text="Asignados"
                                            class="dozResourceTitle"/>
                                    </HBox>

                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Mecánicos"/>
                                        <Text text="{doz>/recursos/asignados/mecanicos}"/>
                                    </HBox>

                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Ayudantes"/>
                                        <Text text="{doz>/recursos/asignados/ayudantes}"/>
                                    </HBox>
                                </VBox>

                                <VBox class="dozResourceBox">
                                    <HBox alignItems="Center">
                                        <HBox
                                            class="dozResourceIcon dozIconGreen"
                                            alignItems="Center"
                                            justifyContent="Center">

                                            <core:Icon
                                                src="sap-icon://sys-enter-2"/>
                                        </HBox>

                                        <Text
                                            text="Disponibles"
                                            class="dozResourceTitle"/>
                                    </HBox>

                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Mecánicos"/>
                                        <Text text="{doz>/recursos/disponibles/mecanicos}"/>
                                    </HBox>

                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Ayudantes"/>
                                        <Text text="{doz>/recursos/disponibles/ayudantes}"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <HBox
                                class="dozCardLink"
                                justifyContent="End"
                                alignItems="Center">

                                <Link
                                    text="Ver detalle de recursos"
                                    press=".onVerDetalleRecursos"/>

                                <core:Icon
                                    src="sap-icon://arrow-right"/>
                            </HBox>
                        </VBox>
                    </HBox>

                    <!-- FILA INFERIOR -->
                    <HBox
                        class="dozBottomGrid"
                        wrap="NoWrap">

                        <!-- CAUSAS -->
                        <VBox class="dozCard dozCausesCard">

                            <HBox
                                class="dozCardHeader"
                                alignItems="Center">

                                <Title
                                    text="Principales causas de presión"
                                    level="H3"
                                    class="dozCardTitle"/>

                                <Button
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    class="dozInfoBtn"/>
                            </HBox>

                            <Text
                                text="Factores que más impactan el índice de presión de la zona."
                                class="dozCardSubtitle"/>

                            <HBox class="dozCauseHeader">
                                <Text text=""/>
                                <Text text="IMPACTO"/>
                            </HBox>

                            <VBox
                                class="dozCauseList"
                                items="{doz>/causasPresion}">

                                <items>
                                    <HBox
                                        class="dozCauseRow"
                                        alignItems="Center">

                                        <HBox
                                            class="dozCauseIconBox"
                                            alignItems="Center"
                                            justifyContent="Center">

                                            <customData>
                                                <core:CustomData
                                                    key="color"
                                                    value="{doz>color}"
                                                    writeToDom="true"/>
                                            </customData>

                                            <core:Icon
                                                src="{doz>icon}"/>
                                        </HBox>

                                        <Text
                                            text="{doz>causa}"
                                            class="dozCauseName"/>

                                        <ProgressIndicator
                                            percentValue="{doz>impacto}"
                                            displayValue=""
                                            width="100%"
                                            class="dozCauseProgress">

                                            <customData>
                                                <core:CustomData
                                                    key="color"
                                                    value="{doz>color}"
                                                    writeToDom="true"/>
                                            </customData>
                                        </ProgressIndicator>

                                        <Text
                                            text="{doz>impactoTexto}"
                                            class="dozCauseImpact"/>

                                        <Link
                                            text="Ver detalle"
                                            press=".onVerDetalleCausa"/>

                                        <core:Icon
                                            src="sap-icon://navigation-right-arrow"
                                            class="dozMiniArrow"/>
                                    </HBox>
                                </items>
                            </VBox>
                        </VBox>

                        <!-- CLIENTES / EQUIPOS -->
                        <VBox class="dozCard dozClientsCard">

                            <HBox
                                class="dozCardHeader"
                                alignItems="Center"
                                justifyContent="Center">

                                <Title
                                    text="Clientes / Elevadores con mayor carga"
                                    level="H3"
                                    class="dozCardTitle"/>

                                <Button
                                    icon="sap-icon://hint"
                                    type="Transparent"
                                    class="dozInfoBtn"/>
                            </HBox>

                            <Text
                                text="Top 5 de clientes o elevadores con más órdenes abiertas y vencidas."
                                class="dozCardSubtitle"/>

                            <Table
                                id="tblClientesCarga"
                                items="{doz>/clientesCarga}"
                                class="dozSmallTable"
                                fixedLayout="true">

                                <columns>
                                    <Column width="42%">
                                        <Text text="Cliente / Sitio"/>
                                    </Column>

                                    <Column hAlign="Center">
                                        <Text text="Elevador"/>
                                    </Column>

                                    <Column hAlign="Center">
                                        <Text text="Órdenes abiertas"/>
                                    </Column>

                                    <Column hAlign="Center">
                                        <Text text="Vencidas"/>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <HBox alignItems="Center">
                                                <core:Icon
                                                    src="sap-icon://building"
                                                    class="dozTableIcon"/>

                                                <Text
                                                    text="{doz>cliente}"
                                                    class="dozTableStrong"/>
                                            </HBox>

                                            <Text
                                                text="{doz>elevador}"
                                                class="dozTableText"/>

                                            <Text
                                                text="{doz>abiertas}"
                                                class="dozTableStrongCenter"/>

                                            <ObjectStatus
                                                text="{doz>vencidas}"
                                                class="dozNumberBadge"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>

                            <HBox
                                class="dozCardLink"
                                justifyContent="End"
                                alignItems="Center">

                                <Link
                                    text="Ver detalle por cliente / elevador"
                                    press=".onVerDetalleCliente"/>

                                <core:Icon
                                    src="sap-icon://arrow-right"/>
                            </HBox>
                        </VBox>

                        <!-- PRÓXIMAS A VENCER -->
                        <VBox class="dozCard dozOrdersCard">

                            <HBox
                                class="dozCardHeader"
                                alignItems="Center"
                                justifyContent="SpaceBetween">

                                <HBox alignItems="Center">
                                    <Title
                                        text="Órdenes próximas a vencer"
                                        level="H3"
                                        class="dozCardTitle"/>

                                    <Button
                                        icon="sap-icon://hint"
                                        type="Transparent"
                                        class="dozInfoBtn"/>
                                </HBox>

                                <HBox
                                    class="dozCardLinkTop"
                                    alignItems="Center">

                                    <Link
                                        text="Ver todas próximas a vencer"
                                        press=".onVerTodasProximas"/>

                                    <core:Icon
                                        src="sap-icon://arrow-right"/>
                                </HBox>
                            </HBox>

                            <Text
                                text="Órdenes que vencerán en los próximos 7 días."
                                class="dozCardSubtitle"/>

                            <Table
                                id="tblOrdenesVencer"
                                items="{doz>/ordenesVencer}"
                                class="dozOrdersTable"
                                fixedLayout="true">

                                <columns>
                                    <Column width="18%">
                                        <Text text="OT"/>
                                    </Column>

                                    <Column width="22%">
                                        <Text text="TIPO DE ORDEN"/>
                                    </Column>

                                    <Column hAlign="Center">
                                        <Text text="ELEVADOR"/>
                                    </Column>

                                    <Column hAlign="Center">
                                        <Text text="COMPROMISO"/>
                                    </Column>

                                    <Column
                                        hAlign="Center"
                                        width="9%">

                                        <Text text="DÍAS"/>
                                    </Column>

                                    <Column hAlign="Center">
                                        <Text text="PRIORIDAD"/>
                                    </Column>
                                </columns>

                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <HBox alignItems="Center">
                                                <core:Icon
                                                    src="sap-icon://building"
                                                    class="dozTableIcon"/>

                                                <Text
                                                    text="{doz>ot}"
                                                    class="dozTableStrong"/>
                                            </HBox>

                                            <ObjectStatus
                                                text="{doz>tipo}"
                                                class="dozTypeBadge">

                                                <customData>
                                                    <core:CustomData
                                                        key="tipo"
                                                        value="{doz>tipoKey}"
                                                        writeToDom="true"/>
                                                </customData>
                                            </ObjectStatus>

                                            <Text
                                                text="{doz>elevador}"
                                                class="dozTableText"/>

                                            <Text
                                                text="{doz>compromiso}"
                                                class="dozTableText"/>

                                            <ObjectStatus
                                                text="{doz>dias}"
                                                class="dozDayBadge"/>

                                            <ObjectStatus
                                                text="{doz>prioridad}"
                                                class="dozPriorityBadge">

                                                <customData>
                                                    <core:CustomData
                                                        key="priority"
                                                        value="{doz>prioridadKey}"
                                                        writeToDom="true"/>
                                                </customData>
                                            </ObjectStatus>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollContainer>
        </content>
    </Page>
</mvc:View>
