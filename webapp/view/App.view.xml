<mvc:View
  controllerName="mantenimiento.controller.App"
  displayBlock="true"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt">

  <tnt:ToolPage id="toolPage">

    <!-- HEADER -->
    <tnt:header>
      <tnt:ToolHeader>
        <Button
          icon="sap-icon://menu2"
          type="Transparent"
          press=".onToggleSideNav" />

        <Title
          text="Mantenimiento"
          level="H4"
          class="sapUiTinyMarginBegin" />

        <ToolbarSpacer />

        <Button
          icon="sap-icon://refresh"
          type="Transparent"
          tooltip="Actualizar"
          press=".onRefresh" />
      </tnt:ToolHeader>
    </tnt:header>

    <!-- MENÚ LATERAL -->
    <tnt:sideContent>
      <tnt:SideNavigation
        id="sideNavigation"
        class="customSideNav"
        itemSelect=".onMenuSelect">

        <tnt:NavigationList>

          <tnt:NavigationListItem
            text="MANTENIMIENTO"
            enabled="false"
            class="sideSectionTitle" />

          <tnt:NavigationListItem
            text="Dashboard Ejecutivo"
            icon="sap-icon://home"
            key="RouteMantenimiento" />

          <!-- ÓRDENES CON SUBMENÚ -->
          <tnt:NavigationListItem
            text="Órdenes"
            icon="sap-icon://business-objects-experience">

            <tnt:items>
              <tnt:NavigationListItem
                text="Preventivas no ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisOTPreventivasNoEjecutadas" />

              <tnt:NavigationListItem
                text="Preventivas ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisOTPreventivasEjecutadas" />

              <tnt:NavigationListItem
                text="Reparaciones no ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisReparacionesPlaneadasNoEjecutadas" />
            </tnt:items>

          </tnt:NavigationListItem>

          <!-- MENÚS SEPARADOS -->
          <tnt:NavigationListItem
            text="Cumplimiento de Órdenes"
            icon="sap-icon://chart-axis"
            key="RouteDetalleCumplimientoOrdenes" />

          <tnt:NavigationListItem
            text="Causas por zona"
            icon="sap-icon://map-2"
            key="RouteCausasZona" />

          <tnt:NavigationListItem
            text="Comportamiento operativo por responsables"
            icon="sap-icon://group"
            key="RouteComportamientoOperativo" />

          <!-- PLAN POR ZONA Y PERIODO -->
          <tnt:NavigationListItem
            text="Plan por zona y periodo"
            icon="sap-icon://map-2">

            <tnt:items>
              <tnt:NavigationListItem
                text="Balance operativo por zona"
                icon="sap-icon://sys-enter-2"
                key="RouteBalanceOperativoZona" />

              <tnt:NavigationListItem
                text="Detalle operativo zona"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleOperativoZonaSur" />
            </tnt:items>

          </tnt:NavigationListItem>

          <tnt:NavigationListItem
            text="Horas trabajadas"
            icon="sap-icon://time-entry-request"
            key="RouteHorasTrabajadas" />

          <!-- MECÁNICOS CON SUBMENÚ -->
          <tnt:NavigationListItem
            text="Mecánicos"
            icon="sap-icon://employee">

            <tnt:items>
              <tnt:NavigationListItem
                text="Mecánicos"
                icon="sap-icon://sys-enter-2"
                key="RouteMecanicos" />

              <tnt:NavigationListItem
                text="Detalle de mecánicos"
                icon="sap-icon://detail-view"
                key="RouteDetalleMecanicos" />
            </tnt:items>

          </tnt:NavigationListItem>

          <!-- MATERIALES -->
          <tnt:NavigationListItem
            text="Materiales"
            icon="sap-icon://inventory">

            <tnt:items>
              <tnt:NavigationListItem
                text="Consumo de materiales"
                icon="sap-icon://sys-enter-2"
                key="RouteConsumoMateriales" />

              <tnt:NavigationListItem
                text="Consumo real vs plan categoria"
                icon="sap-icon://sys-enter-2"
                key="RouteConsumoRealVsPlanCategoria" />
            </tnt:items>

          </tnt:NavigationListItem>

          <!-- ANÁLISIS DE CAUSAS -->
          <tnt:NavigationListItem
            text="Análisis de causas"
            icon="sap-icon://cause">

            <tnt:items>
              <tnt:NavigationListItem
                text="Análisis de Elevadores con Desviación"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisElevadores" />

              <tnt:NavigationListItem
                text="Análisis de fallas y servicios afectados"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisFallas" />
            </tnt:items>

          </tnt:NavigationListItem>

          <!-- REPARACIÓN -->
          <tnt:NavigationListItem
            text="Reparación"
            icon="sap-icon://cause">

            <tnt:items>
              <tnt:NavigationListItem
                text="Análisis de reparaciones ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisReparacionesPlaneadasEjecutadas" />

              <tnt:NavigationListItem
                text="Análisis integral de reparaciones"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisIntegralReparaciones" />
            </tnt:items>

          </tnt:NavigationListItem>

          <!-- CALL CENTER -->
          <tnt:NavigationListItem
            text="Call Center"
            icon="sap-icon://call">

            <tnt:items>
              <tnt:NavigationListItem
                text="Análisis de solicitudes atendidas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisSolicitudesCallCenterAtendidas" />
              
            <tnt:NavigationListItem
              text="Análisis de solicitudes no atendidas"
              icon="sap-icon://decline"
              key="RouteCallCenterNoAtendidas" />

            </tnt:items>

          </tnt:NavigationListItem>

          <!-- TENDENCIA -->
          <tnt:NavigationListItem
            text="Tendencia de ejecución: Planeado vs Real"
            icon="sap-icon://chart-axis"
            key="RouteTendenciasEjecucion" />

          <tnt:NavigationListItem
            text="Análisis Semana S22"
            icon="sap-icon://sys-enter-2"
            key="RouteAnalisisSemanaS22" />

          <tnt:NavigationListItem
            text="Reportes"
            icon="sap-icon://table-chart"
            key="RouteReportes" />

          <tnt:NavigationListItem
            text="OTROS MÓDULOS"
            enabled="false"
            class="sideSectionTitle sideSecondTitle" />

          <tnt:NavigationListItem
            text="Inventarios"
            icon="sap-icon://product"
            key="RouteInventarios" />

          <tnt:NavigationListItem
            text="Compras"
            icon="sap-icon://cart"
            key="RouteCompras" />

          <tnt:NavigationListItem
            text="Contratos"
            icon="sap-icon://document"
            key="RouteContratos" />

          <tnt:NavigationListItem
            text="Finanzas"
            icon="sap-icon://money-bills"
            key="RouteFinanzas" />

          <tnt:NavigationListItem
            text="Recursos Humanos"
            icon="sap-icon://group"
            key="RouteRecursosHumanos" />

        </tnt:NavigationList>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <!-- CONTENIDO PRINCIPAL -->
    <tnt:mainContents>
      <App id="app" />
    </tnt:mainContents>

  </tnt:ToolPage>
</mvc:View>