<mvc:View
  controllerName="mantenimiento.controller.App"
  displayBlock="true"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:tnt="sap.tnt">


  <tnt:ToolPage
    id="toolPage"
    sideExpanded="false"
    class="appToolPage">

    <!-- HEADER -->
    <tnt:header>
      <tnt:ToolHeader>

        <Button
          id="sideNavToggleButton"
          icon="sap-icon://menu2"
          type="Transparent"
          tooltip="Abrir o cerrar menú"
          press=".onToggleSideNav" />

        <Title
          text="Mantenimiento"
          level="H4"
          class="sapUiTinyMarginBegin" />

        <ToolbarSpacer />

        <Button
          id="refreshButton"
          icon="sap-icon://refresh"
          type="Transparent"
          tooltip="Actualizar"
          press=".onRefresh" />

      </tnt:ToolHeader>
    </tnt:header>

    <!-- MENÚ LATERAL -->
    <tnt:sideContent>
      <tnt:SideNavigation
        id="sideNavigation"
        class="customSideNav appSideNavigation"
        itemSelect=".onMenuSelect">

        <tnt:NavigationList>

          <tnt:NavigationListItem
            text="MANTENIMIENTO"
            enabled="false"
            class="sideSectionTitle" />

          <!-- PANTALLA PRINCIPAL -->
          <tnt:NavigationListItem
            text="Pantalla principal"
            icon="sap-icon://home"
            key="RouteMantenimiento" />

          <!-- ÓRDENES -->
          <tnt:NavigationListItem
            text="Órdenes"
            icon="sap-icon://business-objects-experience"
            expanded="false">

            <tnt:items>

              <tnt:NavigationListItem
                text="Preventivas no ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisOTPreventivasNoEjecutadas" />

              <tnt:NavigationListItem
                text="Preventivas ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisOTPreventivasEjecutadas" />

              <tnt:NavigationListItem
                text="Reparaciones no ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisReparacionesPlaneadasNoEjecutadas" />

              <tnt:NavigationListItem
                text="Reparaciones ejecutadas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisReparacionesPlaneadasEjecutadas" />

              <tnt:NavigationListItem
                text="Análisis de reparaciones"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisIntegralReparaciones" />

              <tnt:NavigationListItem
                text="Call Center no atendidas"
                icon="sap-icon://sys-enter-2"
                key="RouteCallCenterNoAtendidas" />

              <tnt:NavigationListItem
                text="Call Center atendidas"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisSolicitudesCallCenterAtendidas" />

            </tnt:items>
          </tnt:NavigationListItem>

          <!-- CUMPLIMIENTO DE ÓRDENES -->
          <tnt:NavigationListItem
            text="Cumplimiento de órdenes"
            icon="sap-icon://chart-axis"
            key="RouteDetalleCumplimientoOrdenes"
            expanded="false">

            <tnt:items>

              <tnt:NavigationListItem
                text="Elevadores con desviación"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisElevadores" />

              <tnt:NavigationListItem
                text="Causas por zona"
                icon="sap-icon://sys-enter-2"
                key="RouteCausasZona" />

              <tnt:NavigationListItem
                text="Fallas y servicios afectados"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisFallas" />

              <tnt:NavigationListItem
                text="Responsables"
                icon="sap-icon://sys-enter-2"
                key="RouteComportamientoOperativo" />

              <tnt:NavigationListItem
                text="Detalle del responsable"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleResponsable" />

              <tnt:NavigationListItem
                text="Tendencia planeado vs real"
                icon="sap-icon://sys-enter-2"
                key="RouteTendenciasEjecucion" />

              <tnt:NavigationListItem
                text="Análisis de semana"
                icon="sap-icon://sys-enter-2"
                key="RouteAnalisisSemanaS22" />

            </tnt:items>
          </tnt:NavigationListItem>

          <!-- HORAS TRABAJADAS -->
          <tnt:NavigationListItem
            text="Horas trabajadas"
            icon="sap-icon://time-entry-request"
            key="RouteHorasTrabajadas"
            expanded="false">

            <tnt:items>

              <tnt:NavigationListItem
                text="Capacidad vs carga"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleCapacidadCarga" />

              <tnt:NavigationListItem
                text="Utilización por turno"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleUtilizacionTurno" />

              <tnt:NavigationListItem
                text="Horas por tipo de orden"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleHorasTipoOrden" />

              <tnt:NavigationListItem
                text="Capacidad por zona"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleCapacidadZona" />

              <tnt:NavigationListItem
                text="Desviación de horas"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleDesviacionHoras" />

            </tnt:items>
          </tnt:NavigationListItem>

          <!-- MECÁNICOS -->
          <tnt:NavigationListItem
            text="Mecánicos"
            icon="sap-icon://employee"
            key="RouteMecanicos"
            expanded="false">

            <tnt:items>

              <tnt:NavigationListItem
                text="Detalle de mecánicos"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleMecanicos" />

              <tnt:NavigationListItem
                text="Vista dirección"
                icon="sap-icon://sys-enter-2"
                key="RouteVistaDireccion" />

              <tnt:NavigationListItem
                text="Vista jefatura"
                icon="sap-icon://sys-enter-2"
                key="RouteVistaJefatura" />

              <tnt:NavigationListItem
                text="Vista supervisor"
                icon="sap-icon://sys-enter-2"
                key="RouteVistaSupervisor" />

              <tnt:NavigationListItem
                text="Detalle operativo de jefaturas"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleOperativoJefaturas" />

              <tnt:NavigationListItem
                text="Detalle operativo de supervisores"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleOperativoSupervisores" />

              <tnt:NavigationListItem
                text="Detalle operativo de recursos"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleOperativoRecursos" />

              <tnt:NavigationListItem
                text="Detalle de Gerencia"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleGerencia" />

              <tnt:NavigationListItem
                text="Detalle de Jefatura"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleCargaCapacidadJefatura" />

              <tnt:NavigationListItem
                text="Detalle de Supervisor"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleCargaSupervisor" />

            </tnt:items>
          </tnt:NavigationListItem>

          <!-- MATERIALES -->
          <tnt:NavigationListItem
            text="Materiales"
            icon="sap-icon://inventory"
            key="RouteConsumoMateriales"
            expanded="false">

            <tnt:items>

              <tnt:NavigationListItem
                text="Consumo real vs plan"
                icon="sap-icon://sys-enter-2"
                key="RouteConsumoRealVsPlanCategoria" />

            </tnt:items>
          </tnt:NavigationListItem>

          <!-- BALANCE OPERATIVO -->
          <tnt:NavigationListItem
            text="Balance operativo"
            icon="sap-icon://map-2"
            key="RouteBalanceOperativoZona"
            expanded="false">

            <tnt:items>

              <tnt:NavigationListItem
                text="Detalle por zona"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleOperativoZonaSur" />

            </tnt:items>
          </tnt:NavigationListItem>

          <!-- EQUIPOS BLOQUEADOS -->
          <tnt:NavigationListItem
            text="Equipos bloqueados"
            icon="sap-icon://locked"
            key="RouteEquiposBloqueados"
            expanded="false">

            <tnt:items>

              <tnt:NavigationListItem
                text="Listado de equipos bloqueados"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleEquiposBloqueados" />

              <tnt:NavigationListItem
                text="Órdenes afectadas"
                icon="sap-icon://sys-enter-2"
                key="RouteListadoOrdenesAfectadas" />

              <tnt:NavigationListItem
                text="Pendientes de desbloqueo"
                icon="sap-icon://sys-enter-2"
                key="RoutePendientesDesbloqueo" />

              <tnt:NavigationListItem
                text="Detalle del equipo bloqueado"
                icon="sap-icon://sys-enter-2"
                key="RouteFichaEquipoBloqueado" />

              <tnt:NavigationListItem
                text="Detalle de orden afectada"
                icon="sap-icon://sys-enter-2"
                key="RouteDetalleOrdenAfectada" />

                <tnt:NavigationListItem
                text="Historial de Seguimiento"
                icon="sap-icon://sys-enter-2"
                key="RouteHistorialSeguimiento" />

            </tnt:items>
          </tnt:NavigationListItem>

          <!-- OTROS MÓDULOS -->
          <tnt:NavigationListItem
            text="OTROS MÓDULOS"
            enabled="false"
            class="sideSectionTitle sideSecondTitle" />

          <tnt:NavigationListItem
            text="Inventarios"
            icon="sap-icon://product" />

          <tnt:NavigationListItem
            text="Compras"
            icon="sap-icon://cart" />

          <tnt:NavigationListItem
            text="Contratos"
            icon="sap-icon://document" />

          <tnt:NavigationListItem
            text="Finanzas"
            icon="sap-icon://money-bills" />

          <tnt:NavigationListItem
            text="Recursos Humanos"
            icon="sap-icon://group" />

        </tnt:NavigationList>

        <tnt:fixedItem>
          <tnt:NavigationList>
            <tnt:NavigationListItem
              text="Actualizar información"
              icon="sap-icon://refresh"
              key="cacheRefresh" />
          </tnt:NavigationList>
        </tnt:fixedItem>
      </tnt:SideNavigation>
    </tnt:sideContent>

    <!-- CONTENIDO PRINCIPAL -->
    <tnt:mainContents>
      <App id="app" />
    </tnt:mainContents>

  </tnt:ToolPage>
</mvc:View>