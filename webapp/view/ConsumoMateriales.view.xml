                                            <core:CustomData key="zona" value="{materialesModel>zonaKey}" writeToDom="true"/>
                                        </customData>
                                    </Text>
                                    <Text text="{materialesModel>total}" class="cmHeatTotal"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <HBox class="cmHeatLegend" justifyContent="Center" wrap="Wrap">
                        <HBox alignItems="Center">
