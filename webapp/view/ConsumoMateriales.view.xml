                        </HBox>
                        <HBox alignItems="Center">
                            <VBox class="cmLegendDot cmLightGreenBg"/>
                            <Text text="20% - 39%"/>
                        </HBox>
                        <HBox alignItems="Center">
                            <VBox class="cmLegendDot cmTealBg"/>
                            <Text text="&lt; 20% del máximo"/>
                        </HBox>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
