<mvc:View
    controllerName="mantenimiento.controller.DetalleUtilizacionTurno"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="detalleUtilizacionTurnoPage"
        showHeader="false"
        enableScrolling="false"
        class="dutPage">

        <content>

            <VBox
                width="100%"
                height="100%"
                class="dutMainContainer sapUiSizeCompact">

                <!-- HEADER -->

                <VBox class="dutHeaderBlock">

                    <Title
                        text="Detalle de utilización por turno"
                        level="H1"
                        class="dutMainTitle"/>

                    <Text
                        text="Análisis de la capacidad disponible y la utilización de horas por turno."
                        wrapping="false"
                        class="dutSubtitle"/>

                </VBox>


                <!-- FILTROS -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    wrap="NoWrap"
                    class="dutFiltersContainer">

                    <!-- PERIODO -->

                    <HBox
                        alignItems="Center"
                        class="dutFilterCard dutFilterPeriodo">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="dutFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dutFilterContent">

                            <Label
                                text="Periodo"
                                class="dutFilterLabel"/>

                            <Select
                                id="periodoSelect"
                                width="100%"
                                selectedKey="{detalleTurno>/filtros/periodo}"
                                items="{detalleTurno>/catalogos/periodos}"
                                class="dutBorderlessSelect">

                                <core:Item
                                    key="{detalleTurno>key}"
                                    text="{detalleTurno>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- FECHA DESDE -->

                    <HBox
                        alignItems="Center"
                        class="dutFilterCard dutFilterFecha">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="dutFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dutFilterContent">

                            <Label
                                text="Fecha desde"
                                class="dutFilterLabel"/>

                            <DatePicker
                                id="fechaDesdeDatePicker"
                                width="100%"
                                value="{detalleTurno>/filtros/fechaDesde}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="dd/MM/yyyy"
                                class="dutBorderlessDatePicker"/>

                        </VBox>

                    </HBox>


                    <!-- FECHA HASTA -->

                    <HBox
                        alignItems="Center"
                        class="dutFilterCard dutFilterFecha">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="dutFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dutFilterContent">

                            <Label
                                text="Fecha hasta"
                                class="dutFilterLabel"/>

                            <DatePicker
                                id="fechaHastaDatePicker"
                                width="100%"
                                value="{detalleTurno>/filtros/fechaHasta}"
                                valueFormat="yyyy-MM-dd"
                                displayFormat="dd/MM/yyyy"
                                class="dutBorderlessDatePicker"/>

                        </VBox>

                    </HBox>


                    <!-- ZONA -->

                    <HBox
                        alignItems="Center"
                        class="dutFilterCard dutFilterZona">

                        <core:Icon
                            src="sap-icon://map-2"
                            class="dutFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dutFilterContent">

                            <Label
                                text="Zona"
                                class="dutFilterLabel"/>

                            <Select
                                id="zonaSelect"
                                width="100%"
                                selectedKey="{detalleTurno>/filtros/zona}"
                                items="{detalleTurno>/catalogos/zonas}"
                                class="dutBorderlessSelect">

                                <core:Item
                                    key="{detalleTurno>key}"
                                    text="{detalleTurno>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- SUPERVISOR -->

                    <HBox
                        alignItems="Center"
                        class="dutFilterCard dutFilterSupervisor">

                        <core:Icon
                            src="sap-icon://employee"
                            class="dutFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dutFilterContent">

                            <Label
                                text="Supervisor"
                                class="dutFilterLabel"/>

                            <Select
                                id="supervisorSelect"
                                width="100%"
                                selectedKey="{detalleTurno>/filtros/supervisor}"
                                items="{detalleTurno>/catalogos/supervisores}"
                                class="dutBorderlessSelect">

                                <core:Item
                                    key="{detalleTurno>key}"
                                    text="{detalleTurno>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- MECÁNICO -->

                    <HBox
                        alignItems="Center"
                        class="dutFilterCard dutFilterMecanico">

                        <core:Icon
                            src="sap-icon://group"
                            class="dutFilterIcon"/>

                        <VBox
                            width="100%"
                            class="dutFilterContent">

                            <Label
                                text="Mecánico / Cuadrilla"
                                class="dutFilterLabel"/>

                            <Select
                                id="mecanicoSelect"
                                width="100%"
                                selectedKey="{detalleTurno>/filtros/mecanico}"
                                items="{detalleTurno>/catalogos/mecanicos}"
                                class="dutBorderlessSelect">

                                <core:Item
                                    key="{detalleTurno>key}"
                                    text="{detalleTurno>text}"/>

                            </Select>

                        </VBox>

                    </HBox>


                    <!-- APLICAR -->

                    <VBox
                        justifyContent="Center"
                        class="dutApplyButtonBox">

                        <Button
                            id="aplicarFiltrosButton"
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            width="100%"
                            press=".onAplicarFiltros"
                            class="dutApplyButton"/>

                    </VBox>

                </HBox>


                <!-- KPIS -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="dutKpiContainer">

                    <!-- UTILIZACIÓN GENERAL -->

                    <HBox
                        alignItems="Center"
                        class="dutKpiCard dutKpiPurple">

                        <VBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="dutKpiIconCircle dutKpiIconPurple">

                            <core:Icon
                                src="sap-icon://history"
                                class="dutKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dutKpiTextBlock">

                            <Text
                                text="Utilización general"
                                wrapping="false"
                                class="dutKpiLabel"/>

                            <Text
                                text="{detalleTurno>/kpis/utilizacionGeneral/valor}"
                                wrapping="false"
                                class="dutKpiValueText dutPurpleValue"/>

                            <Text
                                text="{detalleTurno>/kpis/utilizacionGeneral/detalle}"
                                wrapping="false"
                                class="dutKpiDetail"/>

                        </VBox>

                    </HBox>


                    <!-- TURNO SATURADO -->

                    <HBox
                        alignItems="Center"
                        class="dutKpiCard dutKpiRed">

                        <VBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="dutKpiIconCircle dutKpiIconRed">

                            <core:Icon
                                src="sap-icon://performance"
                                class="dutKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dutKpiTextBlock">

                            <Text
                                text="Turno más saturado"
                                wrapping="false"
                                class="dutKpiLabel"/>

                            <Text
                                text="{detalleTurno>/kpis/turnoSaturado/valor}"
                                tooltip="{detalleTurno>/kpis/turnoSaturado/valor}"
                                wrapping="false"
                                class="dutKpiValueText dutRedValue"/>

                            <Text
                                text="{detalleTurno>/kpis/turnoSaturado/detalle}"
                                wrapping="false"
                                class="dutKpiDetail"/>

                        </VBox>

                    </HBox>


                    <!-- SOBRE CAPACIDAD -->

                    <HBox
                        alignItems="Center"
                        class="dutKpiCard dutKpiOrange">

                        <VBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="dutKpiIconCircle dutKpiIconOrange">

                            <core:Icon
                                src="sap-icon://group"
                                class="dutKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dutKpiTextBlock">

                            <Text
                                text="Turnos sobre capacidad"
                                wrapping="false"
                                class="dutKpiLabel"/>

                            <Text
                                text="{detalleTurno>/kpis/sobreCapacidad/valor}"
                                wrapping="false"
                                class="dutKpiValueText dutOrangeValue"/>

                            <Text
                                text="{detalleTurno>/kpis/sobreCapacidad/detalle}"
                                wrapping="false"
                                class="dutKpiDetail"/>

                        </VBox>

                    </HBox>


                    <!-- CERCA SATURACIÓN -->

                    <HBox
                        alignItems="Center"
                        class="dutKpiCard dutKpiYellow">

                        <VBox
                            justifyContent="Center"
                            alignItems="Center"
                            class="dutKpiIconCircle dutKpiIconYellow">

                            <core:Icon
                                src="sap-icon://warning2"
                                class="dutKpiIcon"/>

                        </VBox>

                        <VBox
                            justifyContent="Center"
                            class="dutKpiTextBlock">

                            <Text
                                text="Turnos cerca de saturación"
                                wrapping="false"
                                class="dutKpiLabel"/>

                            <Text
                                text="{detalleTurno>/kpis/cercaSaturacion/valor}"
                                wrapping="false"
                                class="dutKpiValueText dutYellowValue"/>

                            <Text
                                text="{detalleTurno>/kpis/cercaSaturacion/detalle}"
                                wrapping="false"
                                class="dutKpiDetail"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- RESUMEN POR TURNO -->

                <VBox
                    width="100%"
                    class="dutSummaryCard">

                    <HBox
                        alignItems="Center"
                        class="dutSummaryHeader">

                        <Title
                            text="Resumen por turno"
                            level="H3"
                            class="dutSummaryTitle"/>

                        <core:Icon
                            src="sap-icon://hint"
                            class="dutCardInfoIcon"/>

                    </HBox>


                    <VBox
                        width="100%"
                        class="dutSummaryTableFrame">

                        <Table
                            id="resumenTurnosTable"
                            width="100%"
                            fixedLayout="true"
                            inset="false"
                            showSeparators="Inner"
                            noDataText="Sin datos"
                            items="{detalleTurno>/resumenTurnos}"
                            itemPress=".onSeleccionarTurno"
                            class="dutSummaryTable">

                            <columns>

                                <Column
                                    width="14%"
                                    hAlign="Begin">

                                    <Text
                                        text="Turno"
                                        class="dutSummaryColumnHeader"/>

                                </Column>

                                <Column
                                    width="14%"
                                    hAlign="End">

                                    <Text
                                        text="Capacidad disponible (h)"
                                        class="dutSummaryColumnHeader"/>

                                </Column>

                                <Column
                                    width="14%"
                                    hAlign="End">

                                    <Text
                                        text="Horas programadas (h)"
                                        class="dutSummaryColumnHeader"/>

                                </Column>

                                <Column
                                    width="12%"
                                    hAlign="End">

                                    <Text
                                        text="Horas reales (h)"
                                        class="dutSummaryColumnHeader"/>

                                </Column>

                                <Column
                                    width="21%"
                                    hAlign="Center">

                                    <Text
                                        text="Utilización (real / capacidad)"
                                        class="dutSummaryColumnHeader"/>

                                </Column>

                                <Column
                                    width="10%"
                                    hAlign="End">

                                    <Text
                                        text="Margen (h)"
                                        class="dutSummaryColumnHeader"/>

                                </Column>

                                <Column
                                    width="15%"
                                    hAlign="Begin">

                                    <Text
                                        text="Estado"
                                        class="dutSummaryColumnHeader"/>

                                </Column>

                            </columns>


                            <items>

                                <ColumnListItem
                                    type="{= ${detalleTurno>esTotal} ? 'Inactive' : 'Active' }"
                                    vAlign="Middle"
                                    class="{= ${detalleTurno>esTotal} ? 'dutSummaryTotalRow' : 'dutSummaryDataRow' }">

                                    <cells>

                                        <Text
                                            text="{detalleTurno>turno}"
                                            tooltip="{detalleTurno>turno}"
                                            wrapping="false"
                                            class="dutSummaryTurnoText"/>

                                        <Text
                                            text="{detalleTurno>capacidad}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dutSummaryNumberText"/>

                                        <Text
                                            text="{detalleTurno>horasProgramadas}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dutSummaryNumberText"/>

                                        <Text
                                            text="{detalleTurno>horasReales}"
                                            textAlign="End"
                                            width="100%"
                                            wrapping="false"
                                            class="dutSummaryNumberText"/>


                                        <!-- UTILIZACIÓN -->

                                        <HBox
                                            justifyContent="Center"
                                            alignItems="Center"
                                            width="100%"
                                            class="dutSummaryUtilizationCell">

                                            <ObjectStatus
                                                text="{detalleTurno>utilizacion}"
                                                state="{= ${detalleTurno>estadoKey} === 'error' ? 'Error' : ${detalleTurno>estadoKey} === 'warning' ? 'Warning' : ${detalleTurno>estadoKey} === 'normal' ? 'Success' : 'None' }"
                                                class="dutSummaryUtilizationValue"/>

                                            <HBox
                                                alignItems="Center"
                                                class="dutSummaryChartTrack">

                                                <HBox
                                                    width="{detalleTurno>anchoBarra}"
                                                    visible="{= ${detalleTurno>estadoKey} === 'normal' }"
                                                    class="dutSummaryChartFill dutSummaryChartFillNormal"/>

                                                <HBox
                                                    width="{detalleTurno>anchoBarra}"
                                                    visible="{= ${detalleTurno>estadoKey} === 'warning' }"
                                                    class="dutSummaryChartFill dutSummaryChartFillWarning"/>

                                                <HBox
                                                    width="{detalleTurno>anchoBarra}"
                                                    visible="{= ${detalleTurno>estadoKey} === 'error' }"
                                                    class="dutSummaryChartFill dutSummaryChartFillError"/>

                                            </HBox>

                                        </HBox>


                                        <!-- MARGEN -->

                                        <VBox
                                            justifyContent="Center"
                                            alignItems="End"
                                            width="100%"
                                            class="dutSummaryMarginContainer">

                                            <Text
                                                text="{detalleTurno>margen}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>margenState} === 'Success' }"
                                                class="dutSummaryMarginText dutSummaryMarginSuccess"/>

                                            <Text
                                                text="{detalleTurno>margen}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>margenState} === 'Warning' }"
                                                class="dutSummaryMarginText dutSummaryMarginWarning"/>

                                            <Text
                                                text="{detalleTurno>margen}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>margenState} === 'Error' }"
                                                class="dutSummaryMarginText dutSummaryMarginError"/>

                                        </VBox>


                                        <!-- ESTADO -->

                                        <VBox
                                            justifyContent="Center"
                                            alignItems="Start"
                                            width="100%"
                                            class="dutSummaryStatusCell">

                                            <HBox
                                                alignItems="Center"
                                                visible="{= !${detalleTurno>esTotal} &amp;&amp; ${detalleTurno>estadoKey} === 'normal' }"
                                                class="dutSummaryStatusPill dutSummaryStatusPillNormal">

                                                <core:Icon
                                                    src="sap-icon://circle-task-2"
                                                    class="dutSummaryStatusDot dutSummaryStatusDotNormal"/>

                                                <Text
                                                    text="{detalleTurno>estado}"
                                                    class="dutSummaryStatusText dutSummaryStatusTextNormal"/>

                                            </HBox>

                                            <HBox
                                                alignItems="Center"
                                                visible="{= !${detalleTurno>esTotal} &amp;&amp; ${detalleTurno>estadoKey} === 'warning' }"
                                                class="dutSummaryStatusPill dutSummaryStatusPillWarning">

                                                <core:Icon
                                                    src="sap-icon://circle-task-2"
                                                    class="dutSummaryStatusDot dutSummaryStatusDotWarning"/>

                                                <Text
                                                    text="{detalleTurno>estado}"
                                                    class="dutSummaryStatusText dutSummaryStatusTextWarning"/>

                                            </HBox>

                                            <HBox
                                                alignItems="Center"
                                                visible="{= !${detalleTurno>esTotal} &amp;&amp; ${detalleTurno>estadoKey} === 'error' }"
                                                class="dutSummaryStatusPill dutSummaryStatusPillError">

                                                <core:Icon
                                                    src="sap-icon://circle-task-2"
                                                    class="dutSummaryStatusDot dutSummaryStatusDotError"/>

                                                <Text
                                                    text="{detalleTurno>estado}"
                                                    class="dutSummaryStatusText dutSummaryStatusTextError"/>

                                            </HBox>

                                            <Text
                                                text="-"
                                                visible="{detalleTurno>esTotal}"
                                                class="dutSummaryTotalStatus"/>

                                        </VBox>

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>

                </VBox>


                <!-- ÓRDENES ASOCIADAS -->

                <VBox
                    width="100%"
                    height="100%"
                    class="dutSectionCard dutOrdersSection">

                    <layoutData>

                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>

                    </layoutData>


                    <!-- HEADER -->

                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="dutOrdersHeader">

                        <HBox
                            alignItems="Center"
                            class="dutOrdersTitleGroup">

                            <Title
                                text="Órdenes asociadas al turno seleccionado"
                                level="H3"
                                class="dutSectionTitle"/>

                            <HBox
                                alignItems="Center"
                                visible="{= !!${detalleTurno>/turnoSeleccionado} }"
                                class="dutSelectedShiftTag">

                                <Text
                                    text="Turno: {detalleTurno>/turnoSeleccionado}"
                                    class="dutSelectedShiftText"/>

                                <Button
                                    icon="sap-icon://decline"
                                    type="Transparent"
                                    tooltip="Limpiar selección"
                                    press=".onLimpiarTurno"
                                    class="dutTagCloseButton"/>

                            </HBox>

                        </HBox>


                        <HBox
                            alignItems="Center"
                            class="dutTableActions">

                            <SearchField
                                id="ordenSearchField"
                                width="15rem"
                                placeholder="Buscar OT, cliente, elevador..."
                                liveChange=".onBuscarOrden"
                                search=".onBuscarOrden"
                                class="dutSearchField"/>

                            <Button
                                text="Columnas"
                                icon="sap-icon://table-column"
                                type="Transparent"
                                press=".onColumnas"
                                class="dutSecondaryActionButton"/>

                            <Button
                                icon="sap-icon://action-settings"
                                type="Transparent"
                                tooltip="Configuración"
                                press=".onConfiguracion"
                                class="dutIconActionButton"/>

                        </HBox>

                    </HBox>


                    <!-- TABLA -->

                    <VBox
                        width="100%"
                        class="dutOrdersTableWrapper">

                        <layoutData>

                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>

                        </layoutData>

                        <Table
                            id="ordenesTable"
                            width="100%"
                            fixedLayout="true"
                            inset="false"
                            showSeparators="Inner"
                            noDataText="No existen órdenes para los filtros seleccionados"
                            items="{detalleTurno>/ordenesPaginadas}"
                            class="dutTable dutOrdersTable">

                            <columns>

                                <Column width="7%">
                                    <Text
                                        text="OT"
                                        class="dutColumnHeader"/>
                                </Column>

                                <Column width="10%">
                                    <Text
                                        text="Cliente"
                                        class="dutColumnHeader"/>
                                </Column>

                                <Column width="8%">
                                    <Text
                                        text="Elevador"
                                        class="dutColumnHeader"/>
                                </Column>

                                <Column width="7%">
                                    <Text
                                        text="Zona"
                                        class="dutColumnHeader"/>
                                </Column>

                                <Column width="12%">
                                    <Text
                                        text="Tipo de OT"
                                        class="dutColumnHeader"/>
                                </Column>

                                <Column width="11%">
                                    <Text
                                        text="Responsable"
                                        class="dutColumnHeader"/>
                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">

                                    <Text
                                        text="Horas plan."
                                        class="dutColumnHeader dutColumnHeaderRight"/>

                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">

                                    <Text
                                        text="Horas real."
                                        class="dutColumnHeader dutColumnHeaderRight"/>

                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">

                                    <Text
                                        text="Variación (h)"
                                        class="dutColumnHeader dutColumnHeaderRight"/>

                                </Column>

                                <Column
                                    width="8%"
                                    hAlign="End">

                                    <Text
                                        text="Variación (%)"
                                        class="dutColumnHeader dutColumnHeaderRight"/>

                                </Column>

                                <Column width="13%">
                                    <Text
                                        text="Estado"
                                        class="dutColumnHeader"/>
                                </Column>

                            </columns>


                            <items>

                                <ColumnListItem
                                    vAlign="Middle"
                                    class="dutOrderRow">

                                    <cells>

                                        <Link
                                            text="{detalleTurno>ot}"
                                            press=".onVerOrden"
                                            class="dutOrderLink"/>

                                        <Text
                                            text="{detalleTurno>cliente}"
                                            wrapping="false"
                                            tooltip="{detalleTurno>cliente}"
                                            class="dutCellText"/>

                                        <Text
                                            text="{detalleTurno>elevador}"
                                            wrapping="false"
                                            tooltip="{detalleTurno>elevador}"
                                            class="dutCellText"/>

                                        <Text
                                            text="{detalleTurno>zona}"
                                            wrapping="false"
                                            class="dutCellText"/>

                                        <Text
                                            text="{detalleTurno>tipoOt}"
                                            wrapping="false"
                                            tooltip="{detalleTurno>tipoOt}"
                                            class="dutCellText"/>

                                        <Text
                                            text="{detalleTurno>responsable}"
                                            wrapping="false"
                                            tooltip="{detalleTurno>responsable}"
                                            class="dutCellText"/>

                                        <Text
                                            text="{detalleTurno>horasPlan}"
                                            textAlign="End"
                                            width="100%"
                                            class="dutCenteredCell"/>

                                        <Text
                                            text="{detalleTurno>horasReal}"
                                            textAlign="End"
                                            width="100%"
                                            class="dutCenteredCell"/>


                                        <!-- VARIACIÓN HORAS -->

                                        <VBox
                                            justifyContent="Center"
                                            alignItems="End"
                                            width="100%"
                                            class="dutVariationCell">

                                            <Text
                                                text="{detalleTurno>variacionHoras}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>variacionState} === 'Error' }"
                                                class="dutVariationText dutVariationError"/>

                                            <Text
                                                text="{detalleTurno>variacionHoras}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>variacionState} === 'Success' }"
                                                class="dutVariationText dutVariationSuccess"/>

                                            <Text
                                                text="{detalleTurno>variacionHoras}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>variacionState} === 'Warning' }"
                                                class="dutVariationText dutVariationWarning"/>

                                        </VBox>


                                        <!-- VARIACIÓN PORCENTAJE -->

                                        <VBox
                                            justifyContent="Center"
                                            alignItems="End"
                                            width="100%"
                                            class="dutVariationCell">

                                            <Text
                                                text="{detalleTurno>variacionPorcentaje}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>variacionState} === 'Error' }"
                                                class="dutVariationText dutVariationError"/>

                                            <Text
                                                text="{detalleTurno>variacionPorcentaje}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>variacionState} === 'Success' }"
                                                class="dutVariationText dutVariationSuccess"/>

                                            <Text
                                                text="{detalleTurno>variacionPorcentaje}"
                                                textAlign="End"
                                                width="100%"
                                                visible="{= ${detalleTurno>variacionState} === 'Warning' }"
                                                class="dutVariationText dutVariationWarning"/>

                                        </VBox>


                                        <!-- ESTADO -->

                                        <HBox
                                            alignItems="Center"
                                            class="dutOrderStatus">

                                            <core:Icon
                                                src="sap-icon://circle-task-2"
                                                color="{detalleTurno>statusColor}"
                                                class="dutStatusDot"/>

                                            <Text
                                                text="{detalleTurno>estado}"
                                                wrapping="false"
                                                tooltip="{detalleTurno>estado}"
                                                class="dutStatusText"/>

                                        </HBox>

                                    </cells>

                                </ColumnListItem>

                            </items>

                        </Table>

                    </VBox>


                    <!-- FOOTER SIN SELECTOR DE CANTIDAD -->

                    <HBox
                        width="100%"
                        justifyContent="SpaceBetween"
                        alignItems="Center"
                        class="dutTableFooter">

                        <Text
                            text="{detalleTurno>/pagination/resultText}"
                            class="dutResultCount"/>

                        <HBox
                            alignItems="Center"
                            class="dutPaginationContainer">

                            <Button
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                enabled="{detalleTurno>/pagination/hasPrevious}"
                                press=".onPaginaAnterior"
                                class="dutPaginationArrow"/>

                            <Text
                                text="{= 'Página ' + ${detalleTurno>/pagination/currentPage} + ' de ' + ${detalleTurno>/pagination/totalPages} }"
                                class="dutPaginationText"/>

                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                type="Transparent"
                                enabled="{detalleTurno>/pagination/hasNext}"
                                press=".onPaginaSiguiente"
                                class="dutPaginationArrow"/>

                        </HBox>

                    </HBox>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>