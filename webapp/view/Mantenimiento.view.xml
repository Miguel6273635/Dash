<mvc:View controllerName="mantenimiento.controller.Mantenimiento" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="pageMantenimientoDashboard" showHeader="false" enableScrolling="false" class="MantenimientoDashboard">
        <content>
            <VBox id="dashboardPage" class="mdPageContainer sapUiSizeCompact">
                <!-- Encabezado -->
                <VBox class="mdHeader" justifyContent="Center">
                    <Title text="Dashboard Ejecutivo de Mantenimiento" level="H1" class="mdMainTitle" />
                </VBox>
                <!-- Filtros -->
                <HBox class="mdFiltersBar" renderType="Bare" wrap="NoWrap" alignItems="Stretch">
                    <VBox class="mdFilterBox mdFilterPeriod">
                        <Label text="Periodo" class="mdFilterLabel" />
                        <Select id="slPeriodo" selectedKey="{dash>/filtros/periodo}" change=".onFilterChange" width="100%">
                            <items>
                                <core:Item key="ABRIL_2024" text="Abril 2024 (Mensual)" />
                                <core:Item key="MAYO_2024" text="Mayo 2024 (Mensual)" />
                                <core:Item key="JUNIO_2024" text="Junio 2024 (Mensual)" />
                            </items>
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Fecha desde" class="mdFilterLabel" />
                        <DatePicker id="dpInicio" value="{dash>/filtros/fechaInicio}" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" change=".onFilterChange" width="100%" />
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Fecha hasta" class="mdFilterLabel" />
                        <DatePicker id="dpFin" value="{dash>/filtros/fechaFin}" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" change=".onFilterChange" width="100%" />
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Zona" class="mdFilterLabel" />
                        <Select id="slZona" selectedKey="{dash>/filtros/zona}" change=".onFilterChange" width="100%">
                            <items>
                                <core:Item key="TODAS" text="Todas" />
                                <core:Item key="NORTE" text="Norte" />
                                <core:Item key="CENTRO" text="Centro" />
                                <core:Item key="SUR" text="Sur" />
                                <core:Item key="ESTE" text="Este" />
                                <core:Item key="OESTE" text="Oeste" />
                            </items>
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Supervisor" class="mdFilterLabel" />
                        <Select id="slSupervisor" selectedKey="{dash>/filtros/supervisor}" change=".onFilterChange" width="100%">
                            <items>
                                <core:Item key="TODOS" text="Todos" />
                                <core:Item key="SUP_01" text="Supervisor 1" />
                                <core:Item key="SUP_02" text="Supervisor 2" />
                            </items>
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Tipo de orden" class="mdFilterLabel" />
                        <Select id="slTipoOrden" selectedKey="{dash>/filtros/tipoOrden}" change=".onFilterChange" width="100%">
                            <items>
                                <core:Item key="TODOS" text="Todos" />
                                <core:Item key="PREVENTIVO" text="Preventivo" />
                                <core:Item key="CORRECTIVO" text="Correctivo" />
                                <core:Item key="CALL_CENTER" text="Call Center" />
                            </items>
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Turno" class="mdFilterLabel" />
                        <Select id="slTurno" selectedKey="{dash>/filtros/turno}" change=".onFilterChange" width="100%">
                            <items>
                                <core:Item key="TODOS" text="Todos" />
                                <core:Item key="DIURNO" text="Diurno" />
                                <core:Item key="NOCTURNO" text="Nocturno" />
                                <core:Item key="FIN_SEMANA" text="Fin de semana" />
                            </items>
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Mecánico" class="mdFilterLabel" />
                        <Select id="slMecanico" selectedKey="{dash>/filtros/mecanico}" change=".onFilterChange" width="100%">
                            <items>
                                <core:Item key="TODOS" text="Todos" />
                                <core:Item key="MEC_01" text="Carlos Ruiz" />
                                <core:Item key="MEC_02" text="Ana López" />
                                <core:Item key="MEC_03" text="Miguel Torres" />
                            </items>
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox mdFilterStatus">
                        <Label text="Estado de orden" class="mdFilterLabel" />
                        <Select id="slEstadoOrden" selectedKey="{dash>/filtros/estadoOrden}" change=".onFilterChange" width="100%">
                            <items>
                                <core:Item key="TODOS" text="Todos" />
                                <core:Item key="ABIERTA" text="Abierta" />
                                <core:Item key="EN_PROCESO" text="En proceso" />
                                <core:Item key="COMPLETADA" text="Completada" />
                                <core:Item key="DETENIDA" text="Detenida" />
                            </items>
                        </Select>
                    </VBox>
                    <VBox class="mdApplyWrap" justifyContent="Center" alignItems="Stretch">
                        <Button text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" press=".onAplicarFiltros" class="mdApplyButton" />
                    </VBox>
                </HBox>
                <!-- Indicadores superiores -->
                <HBox class="mdGridRow mdTopRow" renderType="Bare" wrap="NoWrap">
                    <VBox class="mdCard mdComplianceCard">
                        <HBox class="mdComplianceTitleRow" alignItems="Center" justifyContent="Center">
                            <Text text="Cumplimiento general del plan" textDirection="LTR" textAlign="Center" wrapping="false" class="mdComplianceTitle" />
                        </HBox>
                        <VBox class="mdSemiGauge" alignItems="Center" renderType="Bare">
                            <VBox class="mdGaugeVisual" renderType="Bare">
                                <core:HTML sanitizeContent="false" content='&lt;svg viewBox=&quot;0 0 220 100&quot; preserveAspectRatio=&quot;xMidYMid meet&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;&lt;defs&gt;&lt;linearGradient id=&quot;mdComplianceBlue&quot; x1=&quot;0%&quot; y1=&quot;0%&quot; x2=&quot;100%&quot; y2=&quot;0%&quot;&gt;&lt;stop offset=&quot;0%&quot; stop-color=&quot;#0867e8&quot;/&gt;&lt;stop offset=&quot;52%&quot; stop-color=&quot;#1685ff&quot;/&gt;&lt;stop offset=&quot;100%&quot; stop-color=&quot;#0875f5&quot;/&gt;&lt;/linearGradient&gt;&lt;/defs&gt;&lt;path d=&quot;M28 86 A82 64 0 0 1 192 86&quot; pathLength=&quot;100&quot; class=&quot;mdGaugeTrack&quot;/&gt;&lt;path d=&quot;M28 86 A82 64 0 0 1 192 86&quot; pathLength=&quot;100&quot; stroke-dasharray=&quot;94.8 100&quot; stroke=&quot;url(#mdComplianceBlue)&quot; class=&quot;mdGaugeProgress&quot;/&gt;&lt;/svg&gt;' />
                                <VBox class="mdGaugeOverlay" alignItems="Center">
                                    <Text text="{dash>/summary/compliance}" class="mdMetricValue mdBlueText" />
                                    <Text text="{= ${dash>/summary/executed} + ' órdenes'}" class="mdGaugeOrdersInside" />
                                </VBox>
                            </VBox>
                            <HBox class="mdGaugeLabels" justifyContent="SpaceBetween">
                                <Text text="0%" />
                                <Text text="100%" />
                            </HBox>
                        </VBox>
                        <HBox class="mdTargetBand mdTargetBlue" alignItems="Center" justifyContent="Center">
                            <Text text="Meta ≥ 95%" />
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdDeviationCard">
                        <HBox class="mdDeviationTitleRow" alignItems="Center" justifyContent="Center">
                            <Text text="Desviación general del periodo" textAlign="Center" wrapping="false" class="mdDeviationTitle" />
                        </HBox>
                        <Text text="{dash>/summary/deviation}" class="mdMetricValue mdRedText" />
                        <Text text="Fuera de tolerancia" class="mdMetricCaption" />
                        <VBox class="mdDeviationGauge">
                            <HBox class="mdDeviationBar" renderType="Bare">
                                <VBox class="mdDevGood" />
                                <VBox class="mdDevWarn" />
                                <VBox class="mdDevBad" />
                                <VBox class="mdDevMarker" />
                            </HBox>
                            <HBox class="mdScaleLabels" justifyContent="SpaceBetween">
                                <Text text="0%" />
                                <Text text="6%" />
                                <Text text="15%" />
                            </HBox>
                        </VBox>
                        <HBox class="mdTargetBand mdTargetRed" alignItems="Center" justifyContent="Center">
                            <Text text="Meta ≤ 5%" />
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdCausesCard">
                        <Title text="Causas de no ejecución" level="H3" class="mdCardTitle" />
                        <List items="{dash>/causes}" showSeparators="None" class="mdCauseList">
                            <CustomListItem>
                                <HBox class="mdCauseRow" alignItems="Center" renderType="Bare">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>tone}" writeToDom="true" />
                                    </customData>
                                    <HBox class="mdCauseName" alignItems="Center">
                                        <VBox class="mdCauseDot" />
                                        <Text text="{dash>label}" />
                                    </HBox>
                                    <HBox class="mdCauseTrack" alignItems="Center">
                                        <HBox class="mdCauseFill" width="{dash>width}" />
                                    </HBox>
                                    <Text text="{dash>value}" class="mdCauseValue" />
                                </HBox>
                            </CustomListItem>
                        </List>
                        <HBox class="mdInfoBand" alignItems="Center">
                            <core:Icon src="sap-icon://message-information" />
                            <Text text="22 órdenes no ejecutadas representan el 5.2% del plan." />
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdDetailCard">
                        <Button text="Ver detalle" icon="sap-icon://navigation-right-arrow" iconFirst="false" type="Transparent" press=".onVerDetalle" class="mdDetailButton">
                            <customData>
                                <core:CustomData key="section" value="no_ejecutadas" />
                            </customData>
                        </Button>
                        <VBox class="mdDetailBody" alignItems="Center" justifyContent="SpaceAround">
                            <VBox class="mdRoundIcon mdBlueSoft" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://task" />
                            </VBox>
                            <Text text="{dash>/summary/nonExecuted}" class="mdDetailNumber" />
                            <Text text="OT" class="mdDetailLabel" />
                            <VBox class="mdDivider" />
                            <Text text="Total" class="mdDetailLabel" />
                            <Text text="{dash>/summary/nonExecutedPercent}" class="mdDetailPercent" />
                        </VBox>
                    </VBox>
                </HBox>
                <!-- Ejecución y matriz por zonas -->
                <HBox class="mdGridRow mdMiddleRow" renderType="Bare" wrap="NoWrap">
                    <VBox class="mdCard mdExecutionCard">
                        <HBox class="mdCardHeader" alignItems="Start" justifyContent="SpaceBetween">
                            <VBox>
                                <Title text="Ejecución del plan del periodo" level="H3" class="mdCardTitle" />
                                <Text text="Planeado vs real y equipo por semana" class="mdCardSubtitle" />
                            </VBox>
                            <HBox class="mdChartLegend" alignItems="Center">
                                <HBox alignItems="Center">
                                    <VBox class="mdLegendLine mdLineBlueKey" />
                                    <Text text="OT Ejecutadas" />
                                </HBox>
                                <HBox alignItems="Center">
                                    <VBox class="mdLegendLine mdLineGrayKey" />
                                    <Text text="Plan" />
                                </HBox>
                                <HBox alignItems="Center">
                                    <VBox class="mdLegendLine mdLineGreenKey" />
                                    <Text text="% Cumplimiento" />
                                </HBox>
                            </HBox>
                        </HBox>
                        <HBox class="mdExecutionBody" renderType="Bare">
                            <VBox class="mdLineChart">
                                <core:HTML sanitizeContent="false" content='&lt;svg viewBox=&quot;0 0 620 175&quot; preserveAspectRatio=&quot;none&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;&gt;&lt;g class=&quot;mdChartGrid&quot;&gt;&lt;line x1=&quot;48&quot; y1=&quot;18&quot; x2=&quot;588&quot; y2=&quot;18&quot;/&gt;&lt;line x1=&quot;48&quot; y1=&quot;52&quot; x2=&quot;588&quot; y2=&quot;52&quot;/&gt;&lt;line x1=&quot;48&quot; y1=&quot;86&quot; x2=&quot;588&quot; y2=&quot;86&quot;/&gt;&lt;line x1=&quot;48&quot; y1=&quot;120&quot; x2=&quot;588&quot; y2=&quot;120&quot;/&gt;&lt;line x1=&quot;48&quot; y1=&quot;150&quot; x2=&quot;588&quot; y2=&quot;150&quot;/&gt;&lt;/g&gt;&lt;g class=&quot;mdAxisText&quot;&gt;&lt;text x=&quot;8&quot; y=&quot;22&quot;&gt;300&lt;/text&gt;&lt;text x=&quot;8&quot; y=&quot;56&quot;&gt;225&lt;/text&gt;&lt;text x=&quot;8&quot; y=&quot;90&quot;&gt;150&lt;/text&gt;&lt;text x=&quot;16&quot; y=&quot;124&quot;&gt;75&lt;/text&gt;&lt;text x=&quot;24&quot; y=&quot;154&quot;&gt;0&lt;/text&gt;&lt;/g&gt;&lt;polyline points=&quot;70,100 190,86 310,66 430,45 550,92&quot; class=&quot;mdChartPlan&quot;/&gt;&lt;polyline points=&quot;70,122 190,108 310,88 430,69 550,116&quot; class=&quot;mdChartReal&quot;/&gt;&lt;polyline points=&quot;70,72 190,70 310,39 430,37 550,78&quot; class=&quot;mdChartRate&quot;/&gt;&lt;g class=&quot;mdDotsPlan&quot;&gt;&lt;circle cx=&quot;70&quot; cy=&quot;100&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;190&quot; cy=&quot;86&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;310&quot; cy=&quot;66&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;430&quot; cy=&quot;45&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;550&quot; cy=&quot;92&quot; r=&quot;4&quot;/&gt;&lt;/g&gt;&lt;g class=&quot;mdDotsReal&quot;&gt;&lt;circle cx=&quot;70&quot; cy=&quot;122&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;190&quot; cy=&quot;108&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;310&quot; cy=&quot;88&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;430&quot; cy=&quot;69&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;550&quot; cy=&quot;116&quot; r=&quot;4&quot;/&gt;&lt;/g&gt;&lt;g class=&quot;mdDotsRate&quot;&gt;&lt;circle cx=&quot;70&quot; cy=&quot;72&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;190&quot; cy=&quot;70&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;310&quot; cy=&quot;39&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;430&quot; cy=&quot;37&quot; r=&quot;4&quot;/&gt;&lt;circle cx=&quot;550&quot; cy=&quot;78&quot; r=&quot;4&quot;/&gt;&lt;/g&gt;&lt;g class=&quot;mdXAxisText&quot;&gt;&lt;text x=&quot;70&quot; y=&quot;169&quot;&gt;Sem 18&lt;/text&gt;&lt;text x=&quot;190&quot; y=&quot;169&quot;&gt;Sem 19&lt;/text&gt;&lt;text x=&quot;310&quot; y=&quot;169&quot;&gt;Sem 20&lt;/text&gt;&lt;text x=&quot;430&quot; y=&quot;169&quot;&gt;Sem 21&lt;/text&gt;&lt;text x=&quot;550&quot; y=&quot;169&quot;&gt;Sem 22&lt;/text&gt;&lt;/g&gt;&lt;/svg&gt;' />
                                <HBox class="mdWeekDates" renderType="Bare">
                                    <Text text="(28 Abr - 4 May)" />
                                    <Text text="(5 - 11 May)" />
                                    <Text text="(12 - 18 May)" />
                                    <Text text="(19 - 25 May)" />
                                    <Text text="(26 May - 1 Jun)" />
                                </HBox>
                            </VBox>
                            <VBox class="mdExecutionKpi" alignItems="Center" justifyContent="SpaceAround">
                                <Text text="Progreso órdenes del periodo" class="mdCardSubtitle" />
                                <Text text="{dash>/summary/forecast}" class="mdForecastValue" />
                                <Text text="Cumplimiento estimado" class="mdCardSubtitle" />
                                <VBox class="mdDivider" />
                                <Text text="{dash>/summary/forecastExecuted}" wrapping="false" class="mdForecastOrders" />
                                <Text text="Órdenes" wrapping="false" class="mdCardSubtitle" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdHeatmapCard">
                        <Title text="Cumplimiento del plan por zona y periodo" level="H3" class="mdCardTitle" />
                        <VBox class="mdHeatmapTable">
                            <HBox class="mdHeatRow mdHeatHead" renderType="Bare">
                                <Text text="" />
                                <Text text="28 Abr - 4 May" />
                                <Text text="5 - 11 May" />
                                <Text text="12 - 18 May" />
                                <Text text="19 - 25 May" />
                                <Text text="26 May - 1 Jun" />
                                <Text text="Cumplimiento general" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="Norte" class="mdZone" />
                                <Text text="74%" class="mdHeatYellow" />
                                <Text text="67%" class="mdHeatOrange" />
                                <Text text="87%" class="mdHeatGreen" />
                                <Text text="87%" class="mdHeatGreen" />
                                <Text text="80%" class="mdHeatGreen" />
                                <Text text="82%" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="Centro" class="mdZone" />
                                <Text text="64%" class="mdHeatYellow" />
                                <Text text="70%" class="mdHeatYellow" />
                                <Text text="85%" class="mdHeatGreen" />
                                <Text text="91%" class="mdHeatGreen" />
                                <Text text="84%" class="mdHeatGreen" />
                                <Text text="77%" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="Sur" class="mdZone" />
                                <Text text="61%" class="mdHeatYellow" />
                                <Text text="61%" class="mdHeatYellow" />
                                <Text text="72%" class="mdHeatOrange" />
                                <Text text="78%" class="mdHeatYellow" />
                                <Text text="84%" class="mdHeatGreen" />
                                <Text text="71%" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="Este" class="mdZone" />
                                <Text text="54%" class="mdHeatOrange" />
                                <Text text="62%" class="mdHeatYellow" />
                                <Text text="71%" class="mdHeatYellow" />
                                <Text text="66%" class="mdHeatOrange" />
                                <Text text="72%" class="mdHeatYellow" />
                                <Text text="66%" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="Oeste" class="mdZone" />
                                <Text text="46%" class="mdHeatRed" />
                                <Text text="53%" class="mdHeatOrange" />
                                <Text text="61%" class="mdHeatYellow" />
                                <Text text="71%" class="mdHeatYellow" />
                                <Text text="70%" class="mdHeatYellow" />
                                <Text text="60%" class="mdHeatTotal" />
                            </HBox>
                        </VBox>
                        <HBox class="mdHeatLegend" alignItems="Center" justifyContent="Center">
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotRed" />
                                <Text text="&lt; 70%" />
                            </HBox>
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotYellow" />
                                <Text text="70% - 84%" />
                            </HBox>
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotGreen" />
                                <Text text="85% - 94%" />
                            </HBox>
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotBlue" />
                                <Text text="≥ 95%" />
                            </HBox>
                        </HBox>
                    </VBox>
                </HBox>
                <!-- Capacidad y materiales -->
                <HBox class="mdGridRow mdLowerRow" renderType="Bare" wrap="NoWrap">
                    <VBox class="mdCard mdStaffCard">
                        <Title text="Capacidad de plantillas vs horas programadas" level="H3" class="mdCardTitle" />
                        <HBox class="mdStaffTop" renderType="Bare">
                            <VBox class="mdStaffFacts" justifyContent="SpaceBetween">
                                <HBox class="mdStaffFact" alignItems="Center">
                                    <core:Icon src="sap-icon://employee" />
                                    <VBox>
                                        <Text text="Turnos activos" />
                                        <Text text="76" class="mdFactValue" />
                                    </VBox>
                                </HBox>
                                <HBox class="mdStaffFact" alignItems="Center">
                                    <core:Icon src="sap-icon://calendar" />
                                    <VBox>
                                        <Text text="Total técnicos" />
                                        <Text text="21" class="mdFactValue" />
                                    </VBox>
                                </HBox>
                                <HBox class="mdStaffFact" alignItems="Center">
                                    <core:Icon src="sap-icon://history" />
                                    <VBox>
                                        <Text text="Turnos actuales" />
                                        <Text text="Diurno, Nocturno y" />
                                        <Text text="fin de semana" />
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox class="mdStaffBars" justifyContent="SpaceAround">
                                <VBox class="mdStaffBarRow">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Capacidad disponible de plantillas" />
                                        <Text text="6,400 h" />
                                    </HBox>
                                    <HBox class="mdStaffTrack">
                                        <HBox class="mdStaffFill mdStaffBlue" width="100%" />
                                    </HBox>
                                </VBox>
                                <VBox class="mdStaffBarRow">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Horas programadas en órdenes" />
                                        <Text text="5,800 h" />
                                    </HBox>
                                    <HBox class="mdStaffTrack">
                                        <HBox class="mdStaffFill mdStaffBlue" width="91%" />
                                    </HBox>
                                </VBox>
                                <VBox class="mdStaffBarRow">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Horas reales utilizadas" />
                                        <Text text="5,842 h" />
                                    </HBox>
                                    <HBox class="mdStaffTrack">
                                        <HBox class="mdStaffFill mdStaffGreen" width="92%" />
                                    </HBox>
                                </VBox>
                                <HBox class="mdStaffScale" justifyContent="SpaceBetween">
                                    <Text text="0" />
                                    <Text text="2,000" />
                                    <Text text="4,000" />
                                    <Text text="6,000" />
                                </HBox>
                            </VBox>
                            <VBox class="mdStaffKpis" justifyContent="SpaceBetween">
                                <VBox class="mdStaffKpi mdStaffKpiRed">
                                    <Text text="Capacidad comprometida" />
                                    <Text text="92.1%" class="mdStaffRedValue" />
                                    <Text text="(5,800 / 6,400 h)" class="mdStaffKpiDetail" />
                                    <core:Icon src="sap-icon://performance" class="mdStaffKpiIcon" />
                                </VBox>
                                <VBox class="mdStaffKpi mdStaffKpiGreen">
                                    <Text text="Margen disponible" />
                                    <Text text="500 h" class="mdStaffGreenValue" />
                                    <Text text="(8% disponible - Programado)" class="mdStaffKpiDetail" />
                                    <core:Icon src="sap-icon://performance" class="mdStaffKpiIcon" />
                                </VBox>
                            </VBox>
                        </HBox>
                        <HBox class="mdShiftCards" renderType="Bare" wrap="NoWrap">
                            <VBox class="mdShiftCard mdShiftNormal">
                                <HBox class="mdShiftHeader" justifyContent="SpaceBetween" alignItems="Center">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://lightbulb" />
                                        <Text text="Diurno" class="mdShiftTitle" />
                                    </HBox>
                                    <Text text="94.6%" class="mdShiftPercent" />
                                </HBox>
                                <HBox class="mdShiftData" justifyContent="SpaceBetween">
                                    <Text text="Técnicos" />
                                    <Text text="21" />
                                </HBox>
                                <HBox class="mdShiftData" justifyContent="SpaceBetween">
                                    <Text text="Capacidad" />
                                    <Text text="4,200 h" />
                                </HBox>
                                <HBox class="mdShiftData" justifyContent="SpaceBetween">
                                    <Text text="Programado" />
                                    <Text text="4,155 h" />
                                </HBox>
                                <Text text="Normal" class="mdState mdStateGreen" />
                            </VBox>
                            <VBox class="mdShiftCard mdShiftWarning">
                                <HBox class="mdShiftHeader" justifyContent="SpaceBetween" alignItems="Center">
