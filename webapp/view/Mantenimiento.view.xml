<mvc:View controllerName="mantenimiento.controller.Mantenimiento" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page id="pageMantenimientoDashboard" showHeader="false" enableScrolling="false" class="MantenimientoDashboard">
        <content>
            <VBox id="dashboardPage" class="mdPageContainer sapUiSizeCompact">
                <!-- Encabezado -->
                <VBox class="mdHeader" justifyContent="Center">
                    <Title text="Dashboard Ejecutivo de Mantenimiento" level="H1" class="mdMainTitle" />
                </VBox>
                <!-- Filtros -->
                <HBox class="mdFiltersBar" renderType="Bare" wrap="NoWrap" alignItems="Stretch">
                    <VBox class="mdFilterBox mdFilterPeriod">
                        <Label text="Periodo" class="mdFilterLabel" />
                        <Select id="slPeriodo" selectedKey="{dash>/filtros/periodo}" change=".onPeriodoChange" width="100%" items="{dash>/filterOptions/periodos}">
                            <core:Item key="{dash>key}" text="{dash>text}" />
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Fecha desde" class="mdFilterLabel" />
                        <DatePicker id="dpInicio" value="{dash>/filtros/fechaInicio}" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" change=".onFilterChange" width="100%" />
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Fecha hasta" class="mdFilterLabel" />
                        <DatePicker id="dpFin" value="{dash>/filtros/fechaFin}" displayFormat="dd/MM/yyyy" valueFormat="dd/MM/yyyy" change=".onFilterChange" width="100%" />
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Zona" class="mdFilterLabel" />
                        <Select id="slZona" selectedKey="{dash>/filtros/zona}" change=".onFilterChange" width="100%" items="{dash>/filterOptions/zonas}">
                            <core:Item key="{dash>key}" text="{dash>text}" />
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Supervisor" class="mdFilterLabel" />
                        <Select id="slSupervisor" selectedKey="{dash>/filtros/supervisor}" change=".onFilterChange" width="100%" items="{dash>/filterOptions/supervisores}">
                            <core:Item key="{dash>key}" text="{dash>text}" />
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Tipo de orden" class="mdFilterLabel" />
                        <Select id="slTipoOrden" selectedKey="{dash>/filtros/tipoOrden}" change=".onFilterChange" width="100%" items="{dash>/filterOptions/tiposOrden}">
                            <core:Item key="{dash>key}" text="{dash>text}" />
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Turno" class="mdFilterLabel" />
                        <Select id="slTurno" selectedKey="{dash>/filtros/turno}" change=".onFilterChange" width="100%" items="{dash>/filterOptions/turnos}">
                            <core:Item key="{dash>key}" text="{dash>text}" />
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox">
                        <Label text="Mecánico" class="mdFilterLabel" />
                        <Select id="slMecanico" selectedKey="{dash>/filtros/mecanico}" change=".onFilterChange" width="100%" items="{dash>/filterOptions/mecanicos}">
                            <core:Item key="{dash>key}" text="{dash>text}" />
                        </Select>
                    </VBox>
                    <VBox class="mdFilterBox mdFilterStatus">
                        <Label text="Estado de orden" class="mdFilterLabel" />
                        <Select id="slEstadoOrden" selectedKey="{dash>/filtros/estadoOrden}" change=".onFilterChange" width="100%" items="{dash>/filterOptions/estadosOrden}">
                            <core:Item key="{dash>key}" text="{dash>text}" />
                        </Select>
                    </VBox>
                    <VBox class="mdApplyWrap" justifyContent="Center" alignItems="Stretch">
                        <Button text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" press=".onAplicarFiltros" class="mdApplyButton" />
                    </VBox>
                </HBox>
                <!-- Indicadores superiores -->
                <HBox class="mdGridRow mdTopRow" renderType="Bare" wrap="NoWrap">
                    <VBox class="mdCard mdComplianceCard">
                        <HBox class="mdComplianceTitleRow" alignItems="Center" justifyContent="Center">
                            <Text text="Cumplimiento general del plan" textDirection="LTR" textAlign="Center" wrapping="false" class="mdComplianceTitle" />
                        </HBox>
                        <VBox class="mdSemiGauge" alignItems="Center" renderType="Bare">
                            <VBox class="mdGaugeVisual" renderType="Bare">
                                <core:HTML sanitizeContent="false" content="{dash>/summary/gaugeSvg}" />
                                <VBox class="mdGaugeOverlay" alignItems="Center">
                                    <Text text="{dash>/summary/compliance}" class="mdMetricValue mdBlueText" />
                                    <Text text="{= ${dash>/summary/executed} + ' órdenes'}" class="mdGaugeOrdersInside" />
                                </VBox>
                            </VBox>
                            <HBox class="mdGaugeLabels" justifyContent="SpaceBetween">
                                <Text text="0%" />
                                <Text text="100%" />
                            </HBox>
                        </VBox>
                        <HBox class="mdTargetBand mdTargetBlue" alignItems="Center" justifyContent="Center">
                            <Text text="{dash>/summary/complianceTargetText}" />
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdDeviationCard">
                        <HBox class="mdDeviationTitleRow" alignItems="Center" justifyContent="Center">
                            <Text text="Desviación general del periodo" textAlign="Center" wrapping="false" class="mdDeviationTitle" />
                        </HBox>
                        <Text text="{dash>/summary/deviation}" class="mdMetricValue mdRedText" />
                        <Text text="{dash>/summary/deviationCaption}" class="mdMetricCaption" />
                        <VBox class="mdDeviationGauge">
                            <HBox class="mdDeviationBar" renderType="Bare">
                                <VBox class="mdDevGood" />
                                <VBox class="mdDevWarn" />
                                <VBox class="mdDevBad" />
                                <core:HTML sanitizeContent="false" content="{dash>/summary/deviationMarkerHtml}" />
                            </HBox>
                            <HBox class="mdScaleLabels" justifyContent="SpaceBetween">
                                <Text text="0%" />
                                <Text text="{dash>/summary/deviationScaleMiddle}" />
                                <Text text="15%" />
                            </HBox>
                        </VBox>
                        <HBox class="mdTargetBand mdTargetRed" alignItems="Center" justifyContent="Center">
                            <Text text="{dash>/summary/deviationTargetText}" />
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdCausesCard">
                        <Title text="Causas de no ejecución" level="H3" class="mdCardTitle" />
                        <List items="{dash>/causes}" showSeparators="None" class="mdCauseList">
                            <CustomListItem>
                                <HBox class="mdCauseRow" alignItems="Center" renderType="Bare">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>tone}" writeToDom="true" />
                                    </customData>
                                    <HBox class="mdCauseName" alignItems="Center">
                                        <VBox class="mdCauseDot" />
                                        <Text text="{dash>label}" />
                                    </HBox>
                                    <HBox class="mdCauseTrack" alignItems="Center">
                                        <HBox class="mdCauseFill" width="{dash>width}" />
                                    </HBox>
                                    <Text text="{dash>value}" class="mdCauseValue" />
                                </HBox>
                            </CustomListItem>
                        </List>
                        <HBox class="mdInfoBand" alignItems="Center">
                            <core:Icon src="sap-icon://message-information" />
                            <Text text="{dash>/summary/nonExecutedInfo}" />
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdDetailCard">
                        <Button text="Ver detalle" icon="sap-icon://navigation-right-arrow" iconFirst="false" type="Transparent" press=".onVerDetalle" class="mdDetailButton">
                            <customData>
                                <core:CustomData key="section" value="no_ejecutadas" />
                            </customData>
                        </Button>
                        <VBox class="mdDetailBody" alignItems="Center" justifyContent="SpaceAround">
                            <VBox class="mdRoundIcon mdBlueSoft" alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://task" />
                            </VBox>
                            <Text text="{dash>/summary/nonExecuted}" class="mdDetailNumber" />
                            <Text text="OT" class="mdDetailLabel" />
                            <VBox class="mdDivider" />
                            <Text text="Total" class="mdDetailLabel" />
                            <Text text="{dash>/summary/nonExecutedPercent}" class="mdDetailPercent" />
                        </VBox>
                    </VBox>
                </HBox>
                <!-- Ejecución y matriz por zonas -->
                <HBox class="mdGridRow mdMiddleRow" renderType="Bare" wrap="NoWrap">
                    <VBox class="mdCard mdExecutionCard">
                        <HBox class="mdCardHeader" alignItems="Start" justifyContent="SpaceBetween">
                            <VBox>
                                <Title text="Ejecución del plan del periodo" level="H3" class="mdCardTitle" />
                                <Text text="Planeado vs real y equipo por semana" class="mdCardSubtitle" />
                            </VBox>
                            <HBox class="mdChartLegend" alignItems="Center">
                                <HBox alignItems="Center">
                                    <VBox class="mdLegendLine mdLineBlueKey" />
                                    <Text text="OT Ejecutadas" />
                                </HBox>
                                <HBox alignItems="Center">
                                    <VBox class="mdLegendLine mdLineGrayKey" />
                                    <Text text="Plan" />
                                </HBox>
                                <HBox alignItems="Center">
                                    <VBox class="mdLegendLine mdLineGreenKey" />
                                    <Text text="% Cumplimiento" />
                                </HBox>
                            </HBox>
                        </HBox>
                        <HBox class="mdExecutionBody" renderType="Bare">
                            <VBox class="mdLineChart">
                                <core:HTML sanitizeContent="false" content="{dash>/execution/chartSvg}" />
                                <HBox class="mdWeekDates" renderType="Bare">
                                    <Text text="{dash>/execution/weeks/0/dateLabel}" />
                                    <Text text="{dash>/execution/weeks/1/dateLabel}" />
                                    <Text text="{dash>/execution/weeks/2/dateLabel}" />
                                    <Text text="{dash>/execution/weeks/3/dateLabel}" />
                                    <Text text="{dash>/execution/weeks/4/dateLabel}" />
                                </HBox>
                            </VBox>
                            <VBox class="mdExecutionKpi" alignItems="Center" justifyContent="SpaceAround">
                                <Text text="Progreso órdenes del periodo" class="mdCardSubtitle" />
                                <Text text="{dash>/summary/forecast}" class="mdForecastValue" />
                                <Text text="Cumplimiento estimado" class="mdCardSubtitle" />
                                <VBox class="mdDivider" />
                                <Text text="{dash>/summary/forecastExecuted}" wrapping="false" class="mdForecastOrders" />
                                <Text text="Órdenes" wrapping="false" class="mdCardSubtitle" />
                            </VBox>
                        </HBox>
                    </VBox>
                    <VBox class="mdCard mdHeatmapCard">
                        <Title text="Cumplimiento del plan por zona y periodo" level="H3" class="mdCardTitle" />
                        <VBox class="mdHeatmapTable">
                            <HBox class="mdHeatRow mdHeatHead" renderType="Bare">
                                <Text text="" />
                                <Text text="{dash>/zonePeriods/headers/0}" />
                                <Text text="{dash>/zonePeriods/headers/1}" />
                                <Text text="{dash>/zonePeriods/headers/2}" />
                                <Text text="{dash>/zonePeriods/headers/3}" />
                                <Text text="{dash>/zonePeriods/headers/4}" />
                                <Text text="Cumplimiento general" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="{dash>/zonePeriods/rows/0/zone}" class="mdZone" />
                                <Text text="{dash>/zonePeriods/rows/0/periods/0/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/0/periods/0/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/0/periods/1/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/0/periods/1/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/0/periods/2/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/0/periods/2/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/0/periods/3/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/0/periods/3/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/0/periods/4/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/0/periods/4/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/0/total}" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="{dash>/zonePeriods/rows/1/zone}" class="mdZone" />
                                <Text text="{dash>/zonePeriods/rows/1/periods/0/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/1/periods/0/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/1/periods/1/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/1/periods/1/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/1/periods/2/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/1/periods/2/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/1/periods/3/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/1/periods/3/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/1/periods/4/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/1/periods/4/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/1/total}" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="{dash>/zonePeriods/rows/2/zone}" class="mdZone" />
                                <Text text="{dash>/zonePeriods/rows/2/periods/0/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/2/periods/0/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/2/periods/1/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/2/periods/1/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/2/periods/2/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/2/periods/2/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/2/periods/3/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/2/periods/3/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/2/periods/4/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/2/periods/4/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/2/total}" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="{dash>/zonePeriods/rows/3/zone}" class="mdZone" />
                                <Text text="{dash>/zonePeriods/rows/3/periods/0/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/3/periods/0/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/3/periods/1/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/3/periods/1/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/3/periods/2/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/3/periods/2/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/3/periods/3/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/3/periods/3/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/3/periods/4/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/3/periods/4/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/3/total}" class="mdHeatTotal" />
                            </HBox>
                            <HBox class="mdHeatRow" renderType="Bare">
                                <Text text="{dash>/zonePeriods/rows/4/zone}" class="mdZone" />
                                <Text text="{dash>/zonePeriods/rows/4/periods/0/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/4/periods/0/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/4/periods/1/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/4/periods/1/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/4/periods/2/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/4/periods/2/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/4/periods/3/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/4/periods/3/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/4/periods/4/value}" class="mdHeatCell">
                                    <customData>
                                        <core:CustomData key="tone" value="{dash>/zonePeriods/rows/4/periods/4/tone}" writeToDom="true" />
                                    </customData>
                                </Text>
                                <Text text="{dash>/zonePeriods/rows/4/total}" class="mdHeatTotal" />
                            </HBox>
                        </VBox>
                        <HBox class="mdHeatLegend" alignItems="Center" justifyContent="Center">
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotRed" />
                                <Text text="&lt; 70%" />
                            </HBox>
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotYellow" />
                                <Text text="70% - 84%" />
                            </HBox>
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotGreen" />
                                <Text text="85% - 94%" />
                            </HBox>
                            <HBox alignItems="Center">
                                <VBox class="mdLegendDot mdDotBlue" />
                                <Text text="≥ 95%" />
                            </HBox>
                        </HBox>
                    </VBox>
                </HBox>
                <!-- Capacidad y materiales -->
                <HBox class="mdGridRow mdLowerRow" renderType="Bare" wrap="NoWrap">
                    <VBox class="mdCard mdStaffCard">
                        <Title text="Capacidad de plantillas vs horas programadas" level="H3" class="mdCardTitle" />
                        <HBox class="mdStaffTop" renderType="Bare">
                            <VBox class="mdStaffFacts" justifyContent="SpaceBetween">
                                <HBox class="mdStaffFact" alignItems="Center">
                                    <core:Icon src="sap-icon://employee" />
                                    <VBox>
                                        <Text text="Turnos activos" />
                                        <Text text="{dash>/staff/activeTurns}" class="mdFactValue" />
                                    </VBox>
                                </HBox>
                                <HBox class="mdStaffFact" alignItems="Center">
                                    <core:Icon src="sap-icon://calendar" />
                                    <VBox>
                                        <Text text="Total técnicos" />
                                        <Text text="{dash>/staff/technicians}" class="mdFactValue" />
                                    </VBox>
                                </HBox>
                                <HBox class="mdStaffFact" alignItems="Center">
                                    <core:Icon src="sap-icon://history" />
                                    <VBox>
                                        <Text text="Turnos actuales" />
                                        <Text text="{dash>/staff/currentShiftLine1}" />
                                        <Text text="{dash>/staff/currentShiftLine2}" />
                                    </VBox>
                                </HBox>
                            </VBox>
                            <VBox class="mdStaffBars" justifyContent="SpaceAround">
                                <VBox class="mdStaffBarRow">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Capacidad disponible de plantillas" />
                                        <Text text="{dash>/staff/capacity}" />
                                    </HBox>
                                    <HBox class="mdStaffTrack">
                                        <HBox class="mdStaffFill mdStaffBlue" width="{dash>/staff/capacityWidth}" />
                                    </HBox>
                                </VBox>
                                <VBox class="mdStaffBarRow">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Horas programadas en órdenes" />
                                        <Text text="{dash>/staff/planned}" />
                                    </HBox>
                                    <HBox class="mdStaffTrack">
                                        <HBox class="mdStaffFill mdStaffBlue" width="{dash>/staff/plannedWidth}" />
                                    </HBox>
                                </VBox>
                                <VBox class="mdStaffBarRow">
                                    <HBox justifyContent="SpaceBetween">
                                        <Text text="Horas reales utilizadas" />
                                        <Text text="{dash>/staff/actual}" />
                                    </HBox>
                                    <HBox class="mdStaffTrack">
                                        <HBox class="mdStaffFill mdStaffGreen" width="{dash>/staff/actualWidth}" />
                                    </HBox>
                                </VBox>
                                <HBox class="mdStaffScale" justifyContent="SpaceBetween">
                                    <Text text="{dash>/staff/scale0}" />
                                    <Text text="{dash>/staff/scale1}" />
                                    <Text text="{dash>/staff/scale2}" />
                                    <Text text="{dash>/staff/scale3}" />
                                </HBox>
                            </VBox>
                            <VBox class="mdStaffKpis" justifyContent="SpaceBetween">
                                <VBox class="mdStaffKpi mdStaffKpiRed">
                                    <Text text="Capacidad comprometida" />
                                    <Text text="{dash>/staff/committed}" class="mdStaffRedValue" />
                                    <Text text="{dash>/staff/committedDetail}" class="mdStaffKpiDetail" />
                                    <core:Icon src="sap-icon://performance" class="mdStaffKpiIcon" />
                                </VBox>
                                <VBox class="mdStaffKpi mdStaffKpiGreen">
                                    <Text text="Margen disponible" />
                                    <Text text="{dash>/staff/margin}" class="mdStaffGreenValue" />
                                    <Text text="{dash>/staff/marginDetail}" class="mdStaffKpiDetail" />
                                    <core:Icon src="sap-icon://performance" class="mdStaffKpiIcon" />
                                </VBox>
                            </VBox>
                        </HBox>
                        <HBox class="mdShiftCards" renderType="Bare" wrap="NoWrap">
                            <VBox class="mdShiftCard mdShiftNormal">
                                <customData>
                                    <core:CustomData key="tone" value="{dash>/staff/shifts/0/tone}" writeToDom="true" />
                                </customData>
                                <HBox class="mdShiftHeader" justifyContent="SpaceBetween" alignItems="Center">
                                    <HBox alignItems="Center">
                                        <core:Icon src="sap-icon://lightbulb" />
                                        <Text text="{dash>/staff/shifts/0/title}" class="mdShiftTitle" />
                                    </HBox>
                                    <Text text="{dash>/staff/shifts/0/percent}" class="mdShiftPercent" />
                                </HBox>
                                <HBox class="mdShiftData" justifyContent="SpaceBetween">
                                    <Text text="Técnicos" />
                                    <Text text="{dash>/staff/shifts/0/technicians}" />
                                </HBox>
                                <HBox class="mdShiftData" justifyContent="SpaceBetween">
                                    <Text text="Capacidad" />
                                    <Text text="{dash>/staff/shifts/0/capacity}" />
                                </HBox>
                                <HBox class="mdShiftData" justifyContent="SpaceBetween">
                                    <Text text="Programado" />
