<mvc:View
    controllerName="mantenimiento.controller.DetalleOperativoJefaturas"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="detalleOperativoJefaturasPage"
        showHeader="false"
        enableScrolling="true"
        busy="{/busy}"
        busyIndicatorDelay="0"
        class="dojPage sapUiSizeCompact">

        <content>

            <VBox
                width="100%"
                class="dojDashboard">

                <!-- ENCABEZADO -->

                <VBox class="dojHeaderBlock">

                    <Title
                        text="Detalle operativo de jefaturas"
                        level="H1"
                        class="dojMainTitle"/>

                    <Text
                        text="Análisis operativo de las jefaturas bajo la gerencia seleccionada"
                        class="dojSubtitle"/>

                </VBox>

                <!-- FILTROS -->

                <VBox
                    width="100%"
                    class="dojFiltersBar">

                    <!-- PERIODO -->

                    <VBox class="dojFilter dojFilterPeriod">

                        <Label
                            text="Periodo"
                            class="dojFilterLabel"/>

                        <Select
                            id="periodSelect"
                            width="100%"
                            selectedKey="{/filters/period}"
                            change=".onPeriodChange"
                            items="{/catalogs/periods}">

                            <core:Item
                                key="{key}"
                                text="{text}"/>

                        </Select>

                    </VBox>

                    <!-- FECHA DESDE -->

                    <VBox class="dojFilter dojFilterDate">

                        <Label
                            text="Fecha desde"
                            class="dojFilterLabel"/>

                        <DatePicker
                            id="dateFromPicker"
                            width="100%"
                            value="{/filters/dateFrom}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onDateChange"
                            placeholder="dd/mm/aaaa"/>

                    </VBox>

                    <!-- FECHA HASTA -->

                    <VBox class="dojFilter dojFilterDate">

                        <Label
                            text="Fecha hasta"
                            class="dojFilterLabel"/>

                        <DatePicker
                            id="dateToPicker"
                            width="100%"
                            value="{/filters/dateTo}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onDateChange"
                            placeholder="dd/mm/aaaa"/>

                    </VBox>

                    <!-- GERENCIA -->

                    <VBox class="dojFilter dojFilterManagement">

                        <Label
                            text="Gerencia"
                            class="dojFilterLabel"/>

                        <Select
                            id="managementSelect"
                            width="100%"
                            selectedKey="{/filters/management}"
                            change=".onManagementChange"
                            items="{/catalogs/managements}">

                            <core:Item
                                key="{key}"
                                text="{text}"/>

                        </Select>

                    </VBox>

                    <!-- JEFATURA -->

                    <VBox class="dojFilter dojFilterMedium">

                        <Label
                            text="Jefatura"
                            class="dojFilterLabel"/>

                        <Select
                            id="managementHeadSelect"
                            width="100%"
                            selectedKey="{/filters/headship}"
                            change=".onFilterChange"
                            items="{/catalogs/headships}">

                            <core:Item
                                key="{key}"
                                text="{text}"/>

                        </Select>

                    </VBox>

                    <!-- ZONA -->

                    <VBox class="dojFilter dojFilterSmall">

                        <Label
                            text="Zona"
                            class="dojFilterLabel"/>

                        <Select
                            id="zoneSelect"
                            width="100%"
                            selectedKey="{/filters/zone}"
                            change=".onFilterChange"
                            items="{/catalogs/zones}">

                            <core:Item
                                key="{key}"
                                text="{text}"/>

                        </Select>

                    </VBox>

                    <!-- TURNO -->

                    <VBox class="dojFilter dojFilterSmall">

                        <Label
                            text="Turno"
                            class="dojFilterLabel"/>

                        <Select
                            id="shiftSelect"
                            width="100%"
                            selectedKey="{/filters/shift}"
                            change=".onFilterChange"
                            items="{/catalogs/shifts}">

                            <core:Item
                                key="{key}"
                                text="{text}"/>

                        </Select>

                    </VBox>

                    <!-- TIPO SERVICIO -->

                    <VBox class="dojFilter dojFilterService">

                        <Label
                            text="Tipo de servicio"
                            class="dojFilterLabel"/>

                        <Select
                            id="serviceTypeSelect"
                            width="100%"
                            selectedKey="{/filters/serviceType}"
                            change=".onFilterChange"
                            items="{/catalogs/serviceTypes}">

                            <core:Item
                                key="{key}"
                                text="{text}"/>

                        </Select>

                    </VBox>

                    <!-- TIPO RECURSO -->

                    <VBox class="dojFilter dojFilterResource">

                        <Label
                            text="Tipo de recurso"
                            class="dojFilterLabel"/>

                        <Select
                            id="resourceTypeSelect"
                            width="100%"
                            selectedKey="{/filters/resourceType}"
                            change=".onFilterChange"
                            items="{/catalogs/resourceTypes}">

                            <core:Item
                                key="{key}"
                                text="{text}"/>

                        </Select>

                    </VBox>

                    <!-- ACCIONES -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="End"
                        class="dojFilterActions">

                        <Link
                            text="Adaptar filtros"
                            press=".onAdaptFilters"
                            class="dojAdaptFiltersLink"/>

                        <Button
                            text="Ir"
                            tooltip="Aplicar filtros"
                            type="Emphasized"
                            press=".onApplyFilters"
                            class="dojApplyFiltersButton"/>

                    </HBox>

                </VBox>

                <!-- KPIS -->

                <FlexBox
                    width="100%"
                    wrap="Wrap"
                    alignItems="Stretch"
                    renderType="Div"
                    class="dojKpiGrid">

                    <!-- JEFATURAS -->

                    <HBox
                        alignItems="Center"
                        class="dojKpiCard dojKpiBlue">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dojKpiIconWrap">

                            <core:Icon
                                src="sap-icon://group"
                                class="dojKpiIcon"/>

                        </VBox>

                        <VBox class="dojKpiContent">

                            <Text
                                text="Jefaturas activas"
                                class="dojKpiLabel"/>

                            <Text
                                text="{/kpis/activeHeadships/value}"
                                class="dojKpiValue"/>

                            <Text
                                text="{/kpis/activeHeadships/description}"
                                class="dojKpiDescription"/>

                        </VBox>

                    </HBox>

                    <!-- RECURSOS -->

                    <HBox
                        alignItems="Center"
                        class="dojKpiCard dojKpiPurple">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dojKpiIconWrap">

                            <core:Icon
                                src="sap-icon://employee"
                                class="dojKpiIcon"/>

                        </VBox>

                        <VBox class="dojKpiContent">

                            <Text
                                text="Recursos totales"
                                class="dojKpiLabel"/>

                            <Text
                                text="{/kpis/totalResources/value}"
                                class="dojKpiValue"/>

                            <Text
                                text="{/kpis/totalResources/description}"
                                class="dojKpiDescription"/>

                        </VBox>

                    </HBox>

                    <!-- CAPACIDAD -->

                    <HBox
                        alignItems="Center"
                        class="dojKpiCard dojKpiGreen">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dojKpiIconWrap">

                            <core:Icon
                                src="sap-icon://history"
                                class="dojKpiIcon"/>

                        </VBox>

                        <VBox class="dojKpiContent">

                            <Text
                                text="Capacidad disponible"
                                class="dojKpiLabel"/>

                            <Text
                                text="{/kpis/availableCapacity/value}"
                                class="dojKpiValue"/>

                            <Text
                                text="{/kpis/availableCapacity/description}"
                                class="dojKpiDescription"/>

                        </VBox>

                    </HBox>

                    <!-- CARGA -->

                    <HBox
                        busy="{/operationalBusy}"
                        busyIndicatorDelay="0"
                        alignItems="Center"
                        class="dojKpiCard dojKpiOrange">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dojKpiIconWrap">

                            <core:Icon
                                src="sap-icon://activity-items"
                                class="dojKpiIcon"/>

                        </VBox>

                        <VBox class="dojKpiContent">

                            <Text
                                text="Carga programada"
                                class="dojKpiLabel"/>

                            <Text
                                text="{/kpis/scheduledLoad/value}"
                                class="dojKpiValue"/>

                            <Text
                                text="{/kpis/scheduledLoad/description}"
                                class="dojKpiDescription"/>

                        </VBox>

                    </HBox>

                    <!-- UTILIZACIÓN -->

                    <HBox
                        alignItems="Center"
                        class="dojKpiCard dojKpiRed">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dojKpiIconWrap">

                            <core:Icon
                                src="sap-icon://trend-up"
                                class="dojKpiIcon"/>

                        </VBox>

                        <VBox class="dojKpiContent">

                            <Text
                                text="Utilización promedio"
                                class="dojKpiLabel"/>

                            <Text
                                text="{/kpis/averageUtilization/value}"
                                class="dojKpiValue"/>

                            <Text
                                text="{/kpis/averageUtilization/description}"
                                class="dojKpiDescription"/>

                        </VBox>

                    </HBox>

                    <!-- CUMPLIMIENTO -->

                    <HBox
                        alignItems="Center"
                        class="dojKpiCard dojKpiTurquoise">

                        <VBox
                            alignItems="Center"
                            justifyContent="Center"
                            class="dojKpiIconWrap">

                            <core:Icon
                                src="sap-icon://target-group"
                                class="dojKpiIcon"/>

                        </VBox>

                        <VBox class="dojKpiContent">

                            <Text
                                text="Cumplimiento operativo"
                                class="dojKpiLabel"/>

                            <Text
                                text="{/kpis/operationalCompliance/value}"
                                class="dojKpiValue"/>

                            <Text
                                text="{/kpis/operationalCompliance/description}"
                                class="dojKpiDescription"/>

                        </VBox>

                    </HBox>

                </FlexBox>

                <!-- TABLA -->

                <VBox
                    busy="{/operationalBusy}"
                    busyIndicatorDelay="0"
                    width="100%"
                    class="dojTableCard">

                    <Toolbar
                        design="Transparent"
                        class="dojTableToolbar">

                        <HBox
                            alignItems="Center"
                            class="dojTableTitleBox">

                            <VBox
                                alignItems="Center"
                                justifyContent="Center"
                                class="dojTableIconWrap">

                                <core:Icon
                                    src="sap-icon://table-view"
                                    class="dojTableIcon"/>

                            </VBox>

                            <Title
                                text="Desempeño operativo por jefatura"
                                level="H3"
                                class="dojTableTitle"/>

                        </HBox>

                        <ToolbarSpacer/>

                        <HBox
                            alignItems="Center"
                            class="dojLegend">

                            <HBox class="dojLegendItem">

                                <Text
                                    text="●"
                                    class="dojLegendDot dojLegendBlue"/>

                                <Text
                                    text="Bajo (0 - 70%)"
                                    class="dojLegendText"/>

                            </HBox>

                            <HBox class="dojLegendItem">

                                <Text
                                    text="●"
                                    class="dojLegendDot dojLegendGreen"/>

                                <Text
                                    text="Normal (71 - 100%)"
                                    class="dojLegendText"/>

                            </HBox>

                            <HBox class="dojLegendItem">

                                <Text
                                    text="●"
                                    class="dojLegendDot dojLegendOrange"/>

                                <Text
                                    text="Alto (101 - 120%)"
                                    class="dojLegendText"/>

                            </HBox>

                            <HBox class="dojLegendItem">

                                <Text
                                    text="●"
                                    class="dojLegendDot dojLegendRed"/>

                                <Text
                                    text="Crítico (&gt;120%)"
                                    class="dojLegendText"/>

                            </HBox>

                        </HBox>

                    </Toolbar>

                    <Table
                        id="jefaturasTable"
                        width="100%"
                        fixedLayout="true"
                        inset="false"
                        mode="None"
                        showSeparators="Inner"
                        items="{/rows}"
                        noDataText="No se encontraron jefaturas para los filtros seleccionados"
                        updateFinished=".onTableUpdateFinished"
                        class="dojOperationsTable">

                        <columns>

                            <Column width="14%">

                                <Text
                                    text="Jefatura"
                                    class="dojColumnHeader dojColumnHeaderLeft"/>

                            </Column>

                            <Column width="11%">

                                <Text
                                    text="Jefe responsable"
                                    class="dojColumnHeader dojColumnHeaderLeft"/>

                            </Column>

                            <Column
                                width="6%"
                                hAlign="Center">

                                <Text
                                    text="Supervisores activos"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="6%"
                                hAlign="Center">

                                <Text
                                    text="Recursos totales"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="8%"
                                hAlign="Center">

                                <Text
                                    text="Capacidad disponible (h)"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="8%"
                                hAlign="Center">

                                <Text
                                    text="Carga programada (h)"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="6%"
                                hAlign="Center">

                                <Text
                                    text="Utilización (%)"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="7%"
                                hAlign="Center">

                                <Text
                                    text="Estatus utilización"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="7%"
                                hAlign="Center">

                                <Text
                                    text="Recursos sobre capacidad"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="8%"
                                hAlign="Center">

                                <Text
                                    text="Cumplimiento operativo (%)"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="5%"
                                hAlign="Center">

                                <Text
                                    text="Meta (%)"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="7%"
                                hAlign="Center">

                                <Text
                                    text="Diferencia vs meta (pp)"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                            <Column
                                width="7%"
                                hAlign="Center">

                                <Text
                                    text="Acción"
                                    textAlign="Center"
                                    class="dojColumnHeader"/>

                            </Column>

                        </columns>

                        <items>

                            <ColumnListItem
                                type="Inactive"
                                vAlign="Middle">

                                <cells>

                                    <VBox>

                                        <Link
                                            text="{jefatura}"
                                            visible="{= !${isTotal} }"
                                            press=".onViewJefatura"
                                            class="dojManagementLink"/>

                                        <Text
                                            text="{jefatura}"
                                            visible="{isTotal}"
                                            class="dojCellText dojTotalLabel"/>

                                    </VBox>

                                    <Text
                                        text="{manager}"
                                        class="dojCellText"/>

                                    <Text
                                        text="{supervisors}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell"/>

                                    <Text
                                        text="{resources}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell"/>

                                    <Text
                                        text="{capacity}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell"/>

                                    <Text
                                        text="{scheduledLoad}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell"/>

                                    <Text
                                        text="{utilization}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell dojUtilizationValue"/>

                                    <VBox
                                        width="100%"
                                        alignItems="Center">

                                        <ObjectStatus
                                            text="{status}"
                                            state="{statusState}"
                                            visible="{= !${isTotal} }"
                                            class="dojUtilStatus"/>

                                        <Text
                                            text="{status}"
                                            visible="{isTotal}"
                                            class="dojCellText"/>

                                    </VBox>

                                    <Text
                                        text="{overCapacity}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell"/>

                                    <Text
                                        text="{compliance}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell"/>

                                    <Text
                                        text="{target}"
                                        textAlign="Center"
                                        class="dojCellText dojNumericCell"/>

                                    <ObjectStatus
                                        text="{difference}"
                                        state="{differenceState}"
                                        class="dojDifferenceStatus"/>

                                    <VBox
                                        width="100%"
                                        alignItems="Center">

                                        <Button
                                            text="Ver jefatura"
                                            icon="sap-icon://slim-arrow-right"
                                            iconFirst="false"
                                            type="Transparent"
                                            visible="{= !${isTotal} }"
                                            press=".onViewJefatura"
                                            class="dojViewManagementButton"/>

                                        <Text
                                            text="—"
                                            visible="{isTotal}"
                                            class="dojCellText"/>

                                    </VBox>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>

                    <!-- FOOTER -->

                    <HBox
                        width="100%"
                        alignItems="Center"
                        justifyContent="SpaceBetween"
                        class="dojTableFooter">

                        <HBox
                            alignItems="Center"
                            class="dojUpdateInformation">

                            <core:Icon
                                src="sap-icon://message-information"
                                class="dojInformationIcon"/>

                            <Text
                                text="Los datos se actualizan cada 15 minutos"
                                class="dojInformationText"/>

                        </HBox>

                        <HBox
                            alignItems="Center"
                            class="dojPagination">

                            <Text
                                text="{/pagination/summary}"
                                class="dojPaginationSummary"/>

                            <Button
                                icon="sap-icon://media-rewind"
                                type="Transparent"
                                enabled="{/pagination/hasPrev}"
                                press=".onFirstPage"
                                tooltip="Primera página"
                                class="dojPaginationArrow"/>

                            <Button
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                enabled="{/pagination/hasPrev}"
                                press=".onPreviousPage"
                                tooltip="Página anterior"
                                class="dojPaginationArrow"/>

                            <Button
                                text="{/pagination/currentPage}"
                                type="Emphasized"
                                class="dojCurrentPageButton"/>

                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                type="Transparent"
                                enabled="{/pagination/hasNext}"
                                press=".onNextPage"
                                tooltip="Página siguiente"
                                class="dojPaginationArrow"/>

                            <Button
                                icon="sap-icon://media-forward"
                                type="Transparent"
                                enabled="{/pagination/hasNext}"
                                press=".onLastPage"
                                tooltip="Última página"
                                class="dojPaginationArrow"/>

                        </HBox>

                    </HBox>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>