<mvc:View
    controllerName="mantenimiento.controller.Mecanicos"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    displayBlock="true"
    height="100%">

    <Page
        id="mecanicosPage"
        showHeader="false"
        enableScrolling="false"
        busy="{dashboard>/loading}"
        busyIndicatorDelay="0"
        class="mecPage sapUiSizeCompact">

        <content>

            <VBox class="mecDashboard">

                <!-- ENCABEZADO -->
                <HBox
                    class="mecHeader"
                    alignItems="Center"
                    justifyContent="SpaceBetween">

                    <VBox class="mecHeaderCopy">
                        <HBox
                            alignItems="Center"
                            class="mecTitleRow">

                            <Title
                                text="Mecánicos"
                                level="H1"
                                class="mecTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="mecInfoIcon"/>
                        </HBox>

                        <Text
                            text="Panorama general de la plantilla de mecánicos y su capacidad para cubrir la operación del período."
                            class="mecSubtitle"/>
                    </VBox>

                    <HBox
                        class="mecPeriodBadge"
                        alignItems="Center">

                        <core:Icon
                            src="sap-icon://calendar"
                            class="mecPeriodIcon"/>

                        <VBox>
                            <Text
                                text="Periodo actual"
                                class="mecPeriodLabel"/>

                            <Text
                                text="{dashboard>/header/periodoActual}"
                                class="mecPeriodValue"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- FILTROS -->
                <HBox class="mecFilters">

                    <VBox class="mecFilterBox">
                        <Label
                            text="Periodo"
                            class="mecFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dashboard>/filters/periodo}"
                            change=".onPeriodChange"
                            items="{dashboard>/catalogos/periodos}"
                            class="mecFilterControl">

                            <core:Item
                                key="{dashboard>key}"
                                text="{dashboard>text}"/>
                        </Select>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Fecha desde"
                            class="mecFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{dashboard>/filters/fechaDesde}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onDateChange"
                            class="mecFilterControl"/>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Fecha hasta"
                            class="mecFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{dashboard>/filters/fechaHasta}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            change=".onDateChange"
                            class="mecFilterControl"/>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Zona"
                            class="mecFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dashboard>/filters/zona}"
                            change=".onFilterChange"
                            items="{dashboard>/catalogos/zonas}"
                            class="mecFilterControl">

                            <core:Item
                                key="{dashboard>key}"
                                text="{dashboard>text}"/>
                        </Select>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Supervisor"
                            class="mecFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dashboard>/filters/supervisor}"
                            change=".onFilterChange"
                            items="{dashboard>/catalogos/supervisores}"
                            class="mecFilterControl">

                            <core:Item
                                key="{dashboard>key}"
                                text="{dashboard>text}"/>
                        </Select>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Turno"
                            class="mecFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dashboard>/filters/turno}"
                            change=".onFilterChange"
                            items="{dashboard>/catalogos/turnos}"
                            class="mecFilterControl">

                            <core:Item
                                key="{dashboard>key}"
                                text="{dashboard>text}"/>
                        </Select>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Tipo de servicio"
                            class="mecFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dashboard>/filters/tipoServicio}"
                            change=".onFilterChange"
                            items="{dashboard>/catalogos/tiposServicio}"
                            class="mecFilterControl">

                            <core:Item
                                key="{dashboard>key}"
                                text="{dashboard>text}"/>
                        </Select>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Especialidad"
                            class="mecFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dashboard>/filters/especialidad}"
                            change=".onFilterChange"
                            items="{dashboard>/catalogos/especialidades}"
                            class="mecFilterControl">

                            <core:Item
                                key="{dashboard>key}"
                                text="{dashboard>text}"/>
                        </Select>
                    </VBox>

                    <VBox class="mecFilterBox">
                        <Label
                            text="Estado"
                            class="mecFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{dashboard>/filters/estado}"
                            change=".onFilterChange"
                            items="{dashboard>/catalogos/estados}"
                            class="mecFilterControl">

                            <core:Item
                                key="{dashboard>key}"
                                text="{dashboard>text}"/>
                        </Select>
                    </VBox>

                    <VBox
                        class="mecApplyWrap"
                        justifyContent="Center">

                        <Button
                            width="100%"
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            press=".onApplyFilters"
                            class="mecApplyButton"/>
                    </VBox>
                </HBox>

                <!-- KPIs -->
                <HBox class="mecKpiGrid">

                    <HBox
                        class="mecKpiCard mecKpiBlue"
                        alignItems="Center">

                        <HBox
                            class="mecKpiIconCircle"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://group"
                                class="mecKpiIcon"/>
                        </HBox>

                        <VBox class="mecKpiText">
                            <Text
                                text="{dashboard>/kpis/activos}"
                                class="mecKpiValue"/>

                            <Text
                                text="Mecánicos activos"
                                class="mecKpiLabel"/>

                            <Text
                                text="Plantilla activa en el periodo"
                                class="mecKpiSub"/>
                        </VBox>
                    </HBox>

                    <HBox
                        class="mecKpiCard mecKpiGreen"
                        alignItems="Center">

                        <HBox
                            class="mecKpiIconCircle"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://employee-approvals"
                                class="mecKpiIcon"/>
                        </HBox>

                        <VBox class="mecKpiText">
                            <Text
                                text="{dashboard>/kpis/disponibles}"
                                class="mecKpiValue"/>

                            <Text
                                text="Mecánicos disponibles"
                                class="mecKpiLabel"/>

                            <Text
                                text="{dashboard>/kpis/disponiblesPct}"
                                class="mecKpiSub"/>
                        </VBox>
                    </HBox>

                    <HBox
                        busy="{dashboard>/operationalLoading}"
                        busyIndicatorDelay="0"
                        class="mecKpiCard mecKpiOrange"
                        alignItems="Center">

                        <HBox
                            class="mecKpiIconCircle"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://warning"
                                class="mecKpiIcon"/>
                        </HBox>

                        <VBox class="mecKpiText">
                            <Text
                                text="{dashboard>/kpis/sobrecapacidad}"
                                class="mecKpiValue"/>

                            <Text
                                text="Recursos sobre capacidad"
                                class="mecKpiLabel"/>

                            <Text
                                text="{dashboard>/kpis/sobrecapacidadPct}"
                                class="mecKpiSub"/>
                        </VBox>
                    </HBox>

                    <HBox
                        busy="{dashboard>/operationalLoading}"
                        busyIndicatorDelay="0"
                        class="mecKpiCard mecKpiPurple"
                        alignItems="Center">

                        <HBox
                            class="mecKpiIconCircle"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://shield"
                                class="mecKpiIcon"/>
                        </HBox>

                        <VBox class="mecKpiText">
                            <Text
                                text="{dashboard>/kpis/cobertura}"
                                class="mecKpiValue"/>

                            <Text
                                text="Cobertura de demanda programada"
                                class="mecKpiLabel"/>

                            <Text
                                text="{dashboard>/kpis/coberturaSub}"
                                class="mecKpiSub"/>
                        </VBox>
                    </HBox>
                </HBox>

                <!-- FILA MEDIA -->
                <HBox class="mecMiddleGrid">

                    <!-- BALANCE GENERAL -->
                    <VBox
                        busy="{dashboard>/operationalLoading}"
                        busyIndicatorDelay="0"
                        class="mecCard mecBalanceCard">

                        <HBox
                            alignItems="Center"
                            class="mecCardTitleRow">

                            <Title
                                text="Balance general de plantilla"
                                level="H3"
                                class="mecCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="mecSmallInfo"/>
                        </HBox>

                        <Text
                            text="Comparativo de capacidad, carga y brecha del periodo"
                            class="mecCardSubtitle"/>

                        <HBox
                            class="mecBalanceStats"
                            justifyContent="SpaceAround">

                            <VBox
                                alignItems="Center"
                                class="mecBalanceMetric mecGreenMetric">

                                <core:Icon
                                    src="sap-icon://employee"
                                    class="mecBalanceMetricIcon"/>

                                <Text
                                    text="Capacidad disponible"
                                    class="mecMiniLabel"/>

                                <Text
                                    text="{dashboard>/balance/capacidad}"
                                    class="mecBalanceValue"/>

                                <Text
                                    text="{dashboard>/balance/capacidadPct}"
                                    class="mecMiniPct"/>
                            </VBox>

                            <VBox
                                alignItems="Center"
                                class="mecBalanceMetric mecBlueMetric">

                                <core:Icon
                                    src="sap-icon://calendar"
                                    class="mecBalanceMetricIcon"/>

                                <Text
                                    text="Carga programada"
                                    class="mecMiniLabel"/>

                                <Text
                                    text="{dashboard>/balance/carga}"
                                    class="mecBalanceValue"/>

                                <Text
                                    text="{dashboard>/balance/cargaPct}"
                                    class="mecMiniPct"/>
                            </VBox>

                            <VBox
                                alignItems="Center"
                                class="mecBalanceMetric mecPurpleMetric">

                                <core:Icon
                                    src="sap-icon://trend-up"
                                    class="mecBalanceMetricIcon"/>

                                <Text
                                    text="Brecha"
                                    class="mecMiniLabel"/>

                                <Text
                                    text="{dashboard>/balance/brecha}"
                                    class="mecBalanceValue"/>

                                <Text
                                    text="{dashboard>/balance/brechaPct}"
                                    class="mecMiniPct"/>
                            </VBox>
                        </HBox>

                        <VBox class="mecBalanceProgressArea">
                            <ProgressIndicator
                                percentValue="{dashboard>/balance/utilizacionRaw}"
                                displayValue=""
                                showValue="false"
                                class="mecBalanceProgress"/>

                            <HBox
                                class="mecBalanceScale"
                                justifyContent="SpaceBetween">

                                <Text text="0"/>
                                <Text text="Carga"/>
                                <Text text="Capacidad"/>
                            </HBox>
                        </VBox>

                        <HBox
                            class="mecBalanceMessage"
                            alignItems="Center">

                            <core:Icon
                                src="sap-icon://sys-enter-2"
                                class="mecBalanceMessageIcon"/>

                            <Text
                                text="{dashboard>/balance/mensaje}"
                                wrapping="true"
                                class="mecBalanceMessageText"/>
                        </HBox>
                    </VBox>

                    <!-- DISTRIBUCIÓN -->
                    <VBox class="mecCard mecDistributionCard">

                        <HBox
                            alignItems="Center"
                            class="mecCardTitleRow">

                            <Title
                                text="Distribución de plantilla"
                                level="H3"
                                class="mecCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="mecSmallInfo"/>
                        </HBox>

                        <Text
                            text="Cómo está distribuida la plantilla"
                            class="mecCardSubtitle"/>

                        <HBox class="mecDistributionColumns">

                            <!-- POR TURNO -->
                            <VBox class="mecDistributionColumn">
                                <HBox
                                    alignItems="Center"
                                    class="mecMiniSectionHeader">

                                    <HBox
                                        class="mecMiniSectionIcon mecBlueSectionIcon"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <core:Icon
                                            src="sap-icon://employee"/>
                                    </HBox>

                                    <Text
                                        text="Distribución de mecánicos"
                                        class="mecSectionTitle"/>
                                </HBox>

                                <VBox
                                    class="mecDistList"
                                    items="{dashboard>/distribucionTurnos}">

                                    <items>
                                        <HBox
                                            class="mecDistRow"
                                            alignItems="Center">

                                            <VBox class="mecDistMain">
                                                <Text
                                                    text="{dashboard>label}"
                                                    class="mecDistLabel"/>

                                                <ProgressIndicator
                                                    percentValue="{dashboard>pct}"
                                                    displayValue=""
                                                    showValue="false"
                                                    class="mecDistProgress"/>
                                            </VBox>

                                            <Text
                                                text="{dashboard>value}"
                                                class="mecDistValue"/>

                                            <Text
                                                text="{dashboard>pctText}"
                                                class="mecDistPct"/>
                                        </HBox>
                                    </items>
                                </VBox>

                                <HBox
                                    class="mecDistTotal"
                                    justifyContent="SpaceBetween">

                                    <Text text="Total mecánicos"/>

                                    <Text
                                        text="{dashboard>/kpis/activos}"
                                        class="mecStrong"/>
                                </HBox>
                            </VBox>

                            <!-- POR ESPECIALIDAD -->
                            <VBox class="mecDistributionColumn">
                                <HBox
                                    alignItems="Center"
                                    class="mecMiniSectionHeader">

                                    <VBox class="mecSectionAccent mecSectionAccentGreen"/>

                                    <Text
                                        text="Por especialidad"
                                        class="mecSectionTitle"/>

                                    <core:Icon
                                        src="sap-icon://hint"
                                        class="mecSectionHint"/>
                                </HBox>

                                <VBox
                                    class="mecSpecialtyList mecSpecialtyOnlyList"
                                    items="{dashboard>/distribucionEspecialidad}">

                                    <items>
                                        <HBox
                                            class="mecSpecialtyRow mecSpecialtyTargetRow"
                                            alignItems="Center">

                                            <VBox class="mecSpecialtyBullet"/>

                                            <VBox class="mecSpecialtyMain">
                                                <Text
                                                    text="{dashboard>label}"
                                                    class="mecDistLabel"/>

                                                <ProgressIndicator
                                                    percentValue="{dashboard>pct}"
                                                    displayValue=""
                                                    showValue="false"
                                                    class="mecDistProgress mecSpecialtyProgress"/>
                                            </VBox>

                                            <Text
                                                text="{dashboard>value}"
                                                class="mecDistValue"/>

                                            <Text
                                                text="{dashboard>pctText}"
                                                class="mecDistPct"/>
                                        </HBox>
                                    </items>
                                </VBox>
                            </VBox>

                            <!-- POR ZONA -->
                            <VBox class="mecDistributionColumn mecZoneColumn">
                                <HBox
                                    alignItems="Center"
                                    class="mecMiniSectionHeader">

                                    <HBox
                                        class="mecMiniSectionIcon mecBlueSectionIcon mecZoneHeaderIcon"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <core:Icon
                                            src="sap-icon://map-2"/>
                                    </HBox>

                                    <Text
                                        text="Por zona"
                                        class="mecSectionTitle"/>

                                    <core:Icon
                                        src="sap-icon://hint"
                                        class="mecSectionHint"/>
                                </HBox>

                                <HBox
                                    class="mecZoneTargetBody"
                                    alignItems="Center"
                                    justifyContent="SpaceAround">

                                    <HBox
                                        id="zoneDonut"
                                        class="mecZoneDonut mecZoneDonutLarge"
                                        alignItems="Center"
                                        justifyContent="Center">

                                        <VBox
                                            class="mecDonutCenter"
                                            alignItems="Center">

                                            <Text
                                                text="{dashboard>/zonaTotal}"
                                                class="mecDonutValue mecDonutValueLarge"/>

                                            <Text
                                                text="Total"
                                                class="mecDonutLabel"/>
                                        </VBox>
                                    </HBox>

                                    <VBox
                                        class="mecZoneLegend mecZoneLegendTarget"
                                        items="{dashboard>/distribucionZona}">

                                        <items>
                                            <HBox
                                                class="mecZoneLegendRow mecZoneLegendTargetRow"
                                                alignItems="Center">

                                                <VBox class="mecZoneLegendDot"/>

                                                <Text
                                                    text="{dashboard>label}"
                                                    class="mecZoneLegendName"/>

                                                <Text
                                                    text="{dashboard>value}"
                                                    class="mecZoneLegendValue"/>

                                                <Text
                                                    text="{dashboard>pctText}"
                                                    class="mecZoneLegendPct"/>
                                            </HBox>
                                        </items>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- FILA INFERIOR -->
                <HBox class="mecLowerGrid">

                    <!-- SATURACIÓN -->
                    <VBox
                        busy="{dashboard>/operationalLoading}"
                        busyIndicatorDelay="0"
                        class="mecCard mecHeatCard">

                        <HBox
                            alignItems="Center"
                            class="mecCardTitleRow">

                            <Title
                                text="Saturación por turno y zona"
                                level="H3"
                                class="mecCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="mecSmallInfo"/>
                        </HBox>

                        <Text
                            text="Utilización de la plantilla; identifica zonas con sobrecarga."
                            class="mecCardSubtitle"/>

                        <VBox class="mecHeatTable">

                            <HBox class="mecHeatHeader">
                                <Text
                                    text="Turno"
                                    class="mecHeatRowLabel"/>

                                <HBox
                                    class="mecHeatCells"
                                    items="{dashboard>/heatmapZones}">

                                    <items>
                                        <Text
                                            text="{dashboard>label}"
                                            class="mecHeatHeaderCell"/>
                                    </items>
                                </HBox>
                            </HBox>

                            <VBox
                                class="mecHeatRows"
                                items="{dashboard>/heatmapRows}">

                                <items>
                                    <HBox class="mecHeatRow">
                                        <Text
                                            text="{dashboard>shift}"
                                            class="mecHeatRowLabel"/>

                                        <HBox
                                            class="mecHeatCells"
                                            items="{dashboard>cells}">

                                            <items>
                                                <VBox
                                                    class="mecHeatCell"
                                                    alignItems="Center"
                                                    justifyContent="Center">

                                                    <customData>
                                                        <core:CustomData
                                                            key="state"
                                                            value="{dashboard>stateCode}"
                                                            writeToDom="true"/>
                                                    </customData>

                                                    <Text
                                                        text="{dashboard>value}"
                                                        class="mecHeatValue"/>
                                                </VBox>
                                            </items>
                                        </HBox>
                                    </HBox>
                                </items>
                            </VBox>
                        </VBox>

                        <HBox
                            class="mecHeatLegend"
                            justifyContent="SpaceBetween">

                            <HBox alignItems="Center">
                                <VBox class="mecLegendDot mecLegendGreen"/>
                                <Text text="&lt; 90% Balanceado"/>
                            </HBox>

                            <HBox alignItems="Center">
                                <VBox class="mecLegendDot mecLegendYellow"/>
                                <Text text="90% - 100% Cerca"/>
                            </HBox>

                            <HBox alignItems="Center">
                                <VBox class="mecLegendDot mecLegendOrange"/>
                                <Text text="100% - 120% Alto"/>
                            </HBox>

                            <HBox alignItems="Center">
                                <VBox class="mecLegendDot mecLegendRed"/>
                                <Text text="&gt; 120% Crítico"/>
                            </HBox>
                        </HBox>
                    </VBox>

                    <!-- CAPACIDAD ESPECIALIDAD -->
                    <VBox
                        busy="{dashboard>/operationalLoading}"
                        busyIndicatorDelay="0"
                        class="mecCard mecCapacityCard">

                        <HBox
                            alignItems="Center"
                            class="mecCardTitleRow">

                            <Title
                                text="Capacidad por especialidad"
                                level="H3"
                                class="mecCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="mecSmallInfo"/>
                        </HBox>

                        <Text
                            text="Comparativo de capacidad disponible, carga programada y utilización"
                            class="mecCardSubtitle"/>

                        <HBox class="mecMiniTableHeader">
                            <Text
                                text="Especialidad"
                                class="mecColName"/>

                            <Text
                                text="Cap. disp. (h)"
                                class="mecColMetric"/>

                            <Text
                                text="Carga prog. (h)"
                                class="mecColMetric"/>

                            <Text
                                text="Utilización"
                                class="mecColUtil"/>
                        </HBox>

                        <VBox
                            class="mecMiniTableRows"
                            items="{dashboard>/capacidadEspecialidad}">

                            <items>
                                <HBox
                                    class="mecMiniTableRow"
                                    alignItems="Center">

                                    <Text
                                        text="{dashboard>label}"
                                        class="mecColName mecRowName"/>

                                    <HBox
                                        class="mecColMetric"
                                        alignItems="Center">

                                        <ProgressIndicator
                                            percentValue="{dashboard>capPct}"
                                            displayValue=""
                                            showValue="false"
                                            class="mecInlineProgress"/>

                                        <Text
                                            text="{dashboard>capacidad}"
                                            class="mecTableNumber"/>
                                    </HBox>

                                    <HBox
                                        class="mecColMetric"
                                        alignItems="Center">

                                        <ProgressIndicator
                                            percentValue="{dashboard>cargaPct}"
                                            displayValue=""
                                            showValue="false"
                                            class="mecInlineProgress mecBlueProgress"/>

                                        <Text
                                            text="{dashboard>carga}"
                                            class="mecTableNumber"/>
                                    </HBox>

                                    <ObjectStatus
                                        text="{dashboard>utilizacion}"
                                        state="{dashboard>state}"
                                        class="mecColUtil mecUtilStatus"/>
                                </HBox>
                            </items>
                        </VBox>

                        <HBox class="mecMiniTableTotal">
                            <Text
                                text="Total"
                                class="mecColName"/>

                            <Text
                                text="{dashboard>/balance/capacidad}"
                                class="mecColMetric mecTotalGreen"/>

                            <Text
                                text="{dashboard>/balance/carga}"
                                class="mecColMetric mecTotalBlue"/>

                            <Text
                                text="{dashboard>/capacidadTotal}"
                                class="mecColUtil mecTotalGreen"/>
                        </HBox>
                    </VBox>

                    <!-- PRESIÓN SERVICIO -->
                    <VBox
                        busy="{dashboard>/operationalLoading}"
                        busyIndicatorDelay="0"
                        class="mecCard mecPressureCard">

                        <HBox
                            alignItems="Center"
                            class="mecCardTitleRow">

                            <Title
                                text="Presión operativa por tipo de servicio"
                                level="H3"
                                class="mecCardTitle"/>

                            <core:Icon
                                src="sap-icon://hint"
                                class="mecSmallInfo"/>
                        </HBox>

                        <Text
                            text="Demanda de mecánicos por tipo de servicio"
                            class="mecCardSubtitle"/>

                        <HBox class="mecPressureHeader">
                            <Text
                                text="Servicio"
                                class="mecPressureName"/>

                            <Text
                                text="Req. (h)"
                                class="mecPressureMetric"/>

                            <Text
                                text="Disp. (h)"
                                class="mecPressureMetric"/>

                            <Text
                                text="Utilización"
                                class="mecPressureUtil"/>
                        </HBox>

                        <VBox
                            class="mecPressureRows"
                            items="{dashboard>/presionServicios}">

                            <items>
                                <HBox
                                    class="mecPressureRow"
                                    alignItems="Center">

                                    <Text
                                        text="{dashboard>label}"
                                        class="mecPressureName mecRowName"/>

                                    <VBox class="mecPressureMetric">
                                        <Text
                                            text="{dashboard>req}"
                                            class="mecPressureNumber mecBlueText"/>

                                        <ProgressIndicator
                                            percentValue="{dashboard>reqPct}"
                                            displayValue=""
                                            showValue="false"
                                            class="mecPressureProgress mecBlueProgress"/>
                                    </VBox>

                                    <VBox class="mecPressureMetric">
                                        <Text
                                            text="{dashboard>disp}"
                                            class="mecPressureNumber mecGreenText"/>

                                        <ProgressIndicator
                                            percentValue="{dashboard>dispPct}"
                                            displayValue=""
                                            showValue="false"
                                            class="mecPressureProgress"/>
                                    </VBox>

                                    <VBox
                                        class="mecPressureUtil"
                                        alignItems="Center">

                                        <ObjectStatus
                                            text="{dashboard>utilizacion}"
                                            state="{dashboard>state}"
                                            class="mecPressureUtilValue"/>

                                        <Text
                                            text="{dashboard>stateText}"
                                            class="mecPressureStateText"/>
                                    </VBox>
                                </HBox>
                            </items>
                        </VBox>

                        <HBox class="mecPressureTotal">
                            <Text
                                text="Total"
                                class="mecPressureName"/>

                            <Text
                                text="{dashboard>/presionTotal/req}"
                                class="mecPressureMetric mecTotalBlue"/>

                            <Text
                                text="{dashboard>/presionTotal/disp}"
                                class="mecPressureMetric mecTotalGreen"/>

                            <Text
                                text="{dashboard>/presionTotal/utilizacion}"
                                class="mecPressureUtil mecTotalOrange"/>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
