<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">

    <Popover
        id="responsablePopover"
        showHeader="false"
        placement="Right"
        contentWidth="270px"
        class="coResponsiblePopover">
        <VBox class="coPopoverContent">

            <!-- HEADER RESPONSABLE -->
            <HBox
                alignItems="Center"
                class="coPopoverHeader">

                <f:Avatar
                    displaySize="XS"
                    initials="{popover>/initials}"
                    backgroundColor="Accent6"
                    class="coPopoverAvatar" />

                <VBox>
                    <Text
                        text="{popover>/responsable}"
                        class="coPopoverName" />

                    <Text
                        text="{popover>/otDesviadasText}"
                        class="coPopoverDeviation" />
                </VBox>
            </HBox>


            <!-- EQUIPOS AFECTADOS -->
            <VBox class="coPopoverSection">

                <HBox
                    alignItems="Center"
                    class="coPopoverSectionHeader">

                    <core:Icon
                        src="sap-icon://technical-object"
                        class="coPopoverSectionIcon" />

                    <Text
                        text="{popover>/equiposTitulo}"
                        class="coPopoverSectionTitle" />
                </HBox>

                <VBox
                    class="coPopoverList"
                    items="{popover>/equipos}">

                    <items>
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="coPopoverListItem">

                            <Text
                                text="{popover>nombre}"
                                wrapping="false"
                                class="coPopoverItemText" />

                            <Text
                                text="{popover>ots}"
                                wrapping="false"
                                class="coPopoverItemCount" />
                        </HBox>
                    </items>
                </VBox>
            </VBox>


            <!-- CLIENTES AFECTADOS -->
            <VBox class="coPopoverSection">

                <HBox
                    alignItems="Center"
                    class="coPopoverSectionHeader">

                    <core:Icon
                        src="sap-icon://customer"
                        class="coPopoverSectionIcon" />

                    <Text
                        text="{popover>/clientesTitulo}"
                        class="coPopoverSectionTitle" />
                </HBox>

                <VBox
                    class="coPopoverList"
                    items="{popover>/clientes}">

                    <items>
                        <HBox
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="coPopoverListItem">

                            <Text
                                text="{popover>nombre}"
                                wrapping="false"
                                class="coPopoverItemText" />

                            <Text
                                text="{popover>ots}"
                                wrapping="false"
                                class="coPopoverItemCount" />
                        </HBox>
                    </items>
                </VBox>
            </VBox>


            <!-- FOOTER -->
            <Button
                text="Ver detalle del responsable"
                icon="sap-icon://navigation-right-arrow"
                iconFirst="false"
                type="Transparent"
                press=".onVerDetalleResponsable"
                class="coPopoverDetailButton" />

        </VBox>
    </Popover>

</core:FragmentDefinition>