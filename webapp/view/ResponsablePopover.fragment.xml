<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <Popover id="responsablePopover" showHeader="false" placement="Auto" class="coResponsiblePopover">
        <VBox class="coPopoverContent">
            <HBox class="coPopoverHeader" alignItems="Center"><Avatar displaySize="XS" initials="{popover>initials}" class="coPopoverAvatar"/><VBox><Text text="{popover>responsable}" class="coPopoverName"/><Text text="{= ${popover>otDesviadas} + ' OT desviadas de ' + ${popover>otAsignadas} + ' planeadas'}" class="coPopoverDeviation"/></VBox></HBox>
            <VBox class="coPopoverSection"><Text text="Equipos afectados" class="coPopoverSectionTitle"/><List showSeparators="None" items="{popover>equipos}" class="coPopoverList"><items><CustomListItem><HBox justifyContent="SpaceBetween" class="coPopoverListItem"><Text text="{popover>nombre}" class="coPopoverItemText"/><Text text="{popover>ots}" class="coPopoverItemCount"/></HBox></CustomListItem></items></List></VBox>
            <VBox class="coPopoverSection"><Text text="Clientes afectados" class="coPopoverSectionTitle"/><List showSeparators="None" items="{popover>clientes}" class="coPopoverList"><items><CustomListItem><HBox justifyContent="SpaceBetween" class="coPopoverListItem"><Text text="{popover>nombre}" class="coPopoverItemText"/><Text text="{popover>ots}" class="coPopoverItemCount"/></HBox></CustomListItem></items></List></VBox>
            <Button text="Ver detalle" icon="sap-icon://navigation-right-arrow" type="Emphasized" press=".onVerDetalleResponsable" class="coPopoverDetailButton"/>
        </VBox>
    </Popover>
</core:FragmentDefinition>
