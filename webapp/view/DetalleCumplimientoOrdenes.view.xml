<mvc:View
    controllerName="mantenimiento.controller.DetalleCumplimientoOrdenes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="pageDetalleCumplimientoOrdenes"
        showHeader="false"
        enableScrolling="true"
        class="DetalleCumplimientoOrdenes">

        <content>

            <VBox
                id="dashboardViewport"
                fitContainer="false"
                class="dcgoDashboard sapUiSizeCompact">

                <!-- =====================================================
                     TÍTULO DE LA PANTALLA
                ====================================================== -->

                <VBox class="dcgoHeaderBlock">

                    <Title
                        text="Detalle de cumplimiento general de las órdenes"
                        level="H1"
                        class="dcgoPageTitle"/>

                </VBox>

                <!-- =====================================================
                     FILTROS
                ====================================================== -->

                <HBox
                    width="100%"
                    wrap="NoWrap"
                    alignItems="End"
                    class="dcgoFilterRow">

                    <!-- PERIODO -->

                    <VBox class="dcgoFilterCard">

                        <Label
                            text="Periodo"
                            class="dcgoFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{cumplimientoModel>/filtros/periodo}"
                            class="dcgoFilterControl">

                            <items>
                                <core:Item
                                    key="mayo2024"
                                    text="Mayo 2024"/>

                                <core:Item
                                    key="abril2024"
                                    text="Abril 2024"/>

                                <core:Item
                                    key="marzo2024"
                                    text="Marzo 2024"/>
                            </items>

                        </Select>

                    </VBox>

                    <!-- FECHA DESDE -->

                    <VBox class="dcgoFilterCard">

                        <Label
                            text="Fecha desde"
                            class="dcgoFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{cumplimientoModel>/filtros/fechaDesde}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            class="dcgoFilterControl"/>

                    </VBox>

                    <!-- FECHA HASTA -->

                    <VBox class="dcgoFilterCard">

                        <Label
                            text="Fecha hasta"
                            class="dcgoFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{cumplimientoModel>/filtros/fechaHasta}"
                            valueFormat="dd/MM/yyyy"
                            displayFormat="dd/MM/yyyy"
                            class="dcgoFilterControl"/>

                    </VBox>

                    <!-- ZONA -->

                    <VBox class="dcgoFilterCard">

                        <Label
                            text="Zona"
                            class="dcgoFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{cumplimientoModel>/filtros/zona}"
                            class="dcgoFilterControl">

                            <items>
                                <core:Item
                                    key="todas"
                                    text="Todas"/>

                                <core:Item
                                    key="norte"
                                    text="Norte"/>

                                <core:Item
                                    key="centro"
                                    text="Centro"/>

                                <core:Item
                                    key="sur"
                                    text="Sur"/>

                                <core:Item
                                    key="este"
                                    text="Este"/>

                                <core:Item
                                    key="oeste"
                                    text="Oeste"/>
                            </items>

                        </Select>

                    </VBox>

                    <!-- SUPERVISOR -->

                    <VBox class="dcgoFilterCard">

                        <Label
                            text="Supervisor"
                            class="dcgoFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{cumplimientoModel>/filtros/supervisor}"
                            class="dcgoFilterControl">

                            <items>
                                <core:Item
                                    key="todos"
                                    text="Todos"/>

                                <core:Item
                                    key="luis"
                                    text="Luis Pérez"/>

                                <core:Item
                                    key="maria"
                                    text="María García"/>

                                <core:Item
                                    key="carlos"
                                    text="Carlos Herrera"/>
                            </items>

                        </Select>

                    </VBox>

                    <!-- TIPO DE SERVICIO -->

                    <VBox class="dcgoFilterCard">

                        <Label
                            text="Tipo de servicio"
                            class="dcgoFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{cumplimientoModel>/filtros/tipoServicio}"
                            class="dcgoFilterControl">

                            <items>
                                <core:Item
                                    key="todos"
                                    text="Todos"/>

                                <core:Item
                                    key="mantenimiento"
                                    text="Mantenimiento"/>

                                <core:Item
                                    key="correctivo"
                                    text="Correctivo"/>

                                <core:Item
                                    key="revision"
                                    text="Revisión"/>
                            </items>

                        </Select>

                    </VBox>

                    <!-- BOTÓN -->

                    <VBox class="dcgoApplyButtonBox">

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            press=".onAplicarFiltros"
                            class="dcgoApplyButton"/>

                    </VBox>

                </HBox>

                <!-- =====================================================
                     KPI
                ====================================================== -->

                <HBox
                    width="100%"
                    wrap="NoWrap"
                    alignItems="Stretch"
                    class="dcgoKpiRow">

                    <!-- ÓRDENES PLANEADAS -->

                    <VBox class="dcgoKpiCard dcgoKpiPurple">

                        <HBox
                            width="100%"
                            alignItems="Center"
                            class="dcgoKpiContent">

                            <VBox
                                alignItems="Center"
                                justifyContent="Center"
                                class="dcgoKpiIconCircle">

                                <core:Icon
                                    src="sap-icon://calendar"
                                    class="dcgoKpiIcon"/>

                            </VBox>

                            <VBox class="dcgoKpiTextBlock">

                                <Text
                                    text="Órdenes planeadas"
                                    class="dcgoKpiLabel"/>

                                <HBox alignItems="End">

                                    <Text
                                        text="{cumplimientoModel>/kpis/ordenesPlaneadas}"
                                        class="dcgoKpiValue"/>

                                    <Text
                                        text="OT"
                                        class="dcgoKpiUnit"/>

                                </HBox>

                                <Text
                                    text="Planificadas en el periodo"
                                    class="dcgoKpiHelper"/>

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- ÓRDENES EJECUTADAS -->

                    <VBox class="dcgoKpiCard dcgoKpiGreen">

                        <HBox
                            width="100%"
                            alignItems="Center"
                            class="dcgoKpiContent">

                            <VBox
                                alignItems="Center"
                                justifyContent="Center"
                                class="dcgoKpiIconCircle">

                                <core:Icon
                                    src="sap-icon://complete"
                                    class="dcgoKpiIcon"/>

                            </VBox>

                            <VBox class="dcgoKpiTextBlock">

                                <Text
                                    text="Órdenes ejecutadas"
                                    class="dcgoKpiLabel"/>

                                <HBox alignItems="End">

                                    <Text
                                        text="{cumplimientoModel>/kpis/ordenesEjecutadas}"
                                        class="dcgoKpiValue"/>

                                    <Text
                                        text="OT"
                                        class="dcgoKpiUnit"/>

                                </HBox>

                                <Text
                                    text="↑ 92.9% del total planeado"
                                    class="dcgoKpiHelper dcgoPositiveText"/>

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- BRECHA -->

                    <VBox class="dcgoKpiCard dcgoKpiRed">

                        <HBox
                            width="100%"
                            alignItems="Center"
                            class="dcgoKpiContent">

                            <VBox
                                alignItems="Center"
                                justifyContent="Center"
                                class="dcgoKpiIconCircle">

                                <core:Icon
                                    src="sap-icon://message-error"
                                    class="dcgoKpiIcon"/>

                            </VBox>

                            <VBox class="dcgoKpiTextBlock">

                                <Text
                                    text="Brecha"
                                    class="dcgoKpiLabel"/>

                                <HBox alignItems="End">

                                    <Text
                                        text="{cumplimientoModel>/kpis/brecha}"
                                        class="dcgoKpiValue"/>

                                    <Text
                                        text="OT"
                                        class="dcgoKpiUnit"/>

                                </HBox>

                                <Text
                                    text="No ejecutadas en el periodo"
                                    class="dcgoKpiHelper"/>

                            </VBox>

                        </HBox>

                    </VBox>

                    <!-- CUMPLIMIENTO -->

                    <VBox class="dcgoKpiCard dcgoKpiGreen">

                        <HBox
                            width="100%"
                            alignItems="Center"
                            class="dcgoKpiContent">

                            <VBox
                                alignItems="Center"
                                justifyContent="Center"
                                class="dcgoKpiIconCircle">

                                <core:Icon
                                    src="sap-icon://target-group"
                                    class="dcgoKpiIcon"/>

                            </VBox>

                            <VBox class="dcgoKpiTextBlock">

                                <Text
                                    text="Cumplimiento general"
                                    class="dcgoKpiLabel"/>

                                <Text
                                    text="{cumplimientoModel>/kpis/cumplimientoGeneral}"
                                    class="dcgoKpiValue"/>

                                <Text
                                    text="↑ 18.6% vs. mismo periodo 2023"
                                    class="dcgoKpiHelper dcgoPositiveText"/>

                            </VBox>

                        </HBox>

                    </VBox>

                </HBox>

                <!-- =====================================================
                     GRID PRINCIPAL
                ====================================================== -->

                <VBox class="dcgoDashboardGrid">

                    <!-- =================================================
                         DESCOMPOSICIÓN DE LA BRECHA
                    ================================================== -->

                    <VBox class="dcgoCard dcgoBrechaCard">

                        <!-- TÍTULO Y LEYENDA -->

                        <HBox
                            width="100%"
                            justifyContent="SpaceBetween"
                            alignItems="Center"
                            class="dcgoWfHeaderRow">

                            <HBox
                                alignItems="Center"
                                class="dcgoWfTitleGroup">

                                <Title
                                    text="Descomposición de la brecha"
                                    level="H3"
                                    class="dcgoWfTitle"/>

                                <core:Icon
                                    src="sap-icon://hint"
                                    tooltip="Información de la descomposición de la brecha"
                                    class="dcgoWfTitleIcon"/>

                            </HBox>

                            <HBox
                                alignItems="Center"
                                class="dcgoWfLegendRow">

                                <HBox
                                    alignItems="Center"
                                    class="dcgoWfLegendItem">

                                    <VBox
                                        class="dcgoWfLegendSwatch dcgoWfLegendPlan"/>

                                    <Text
                                        text="Plan"
                                        class="dcgoWfLegendText"/>

                                </HBox>

                                <HBox
                                    alignItems="Center"
                                    class="dcgoWfLegendItem">

                                    <VBox
                                        class="dcgoWfLegendSwatch dcgoWfLegendGap"/>

                                    <Text
                                        text="Brecha"
                                        class="dcgoWfLegendText"/>

                                </HBox>

                                <HBox
                                    alignItems="Center"
                                    class="dcgoWfLegendItem">

                                    <VBox
                                        class="dcgoWfLegendSwatch dcgoWfLegendResult"/>

                                    <Text
                                        text="Resultado real"
                                        class="dcgoWfLegendText"/>

                                </HBox>

                            </HBox>

                        </HBox>

                        <!-- CUERPO DE LA GRÁFICA -->

                        <HBox
                            width="100%"
                            class="dcgoWfChartBody">

                            <!-- EJE Y -->

                            <VBox
                                justifyContent="SpaceBetween"
                                class="dcgoWfAxis">

                                <Text text="600"/>
                                <Text text="500"/>
                                <Text text="400"/>
                                <Text text="300"/>
                                <Text text="200"/>
                                <Text text="100"/>
                                <Text text="0"/>

                            </VBox>

                            <!-- GRÁFICA Y ETIQUETAS -->

                            <VBox class="dcgoWfChartContent">

                                <!-- ÁREA DE TRAZADO -->

                                <HBox
                                    width="100%"
                                    class="dcgoWfPlot">

                                    <!-- PLAN INICIAL -->

                                    <VBox class="dcgoWfPoint dcgoWfPlan">

                                        <Text
                                            text="{cumplimientoModel>/graficas/descomposicionBrecha/0/valor}"
                                            class="dcgoWfValue"/>

                                    </VBox>

                                    <!-- FALTA DE MANTENIMIENTO -->

                                    <VBox class="dcgoWfPoint dcgoWfGap1">

                                        <Text
                                            text="{cumplimientoModel>/graficas/descomposicionBrecha/1/valor}"
                                            class="dcgoWfValue"/>

                                    </VBox>

                                    <!-- FALTA DE REFACCIONES -->

                                    <VBox class="dcgoWfPoint dcgoWfGap2">

                                        <Text
                                            text="{cumplimientoModel>/graficas/descomposicionBrecha/2/valor}"
                                            class="dcgoWfValue"/>

                                    </VBox>

                                    <!-- CLIENTE NO DISPONIBLE -->

                                    <VBox class="dcgoWfPoint dcgoWfGap3">

                                        <Text
                                            text="{cumplimientoModel>/graficas/descomposicionBrecha/3/valor}"
                                            class="dcgoWfValue"/>

                                    </VBox>

                                    <!-- REPROGRAMACIÓN -->

                                    <VBox class="dcgoWfPoint dcgoWfGap4">

                                        <Text
                                            text="{cumplimientoModel>/graficas/descomposicionBrecha/4/valor}"
                                            class="dcgoWfValue"/>

                                    </VBox>

                                    <!-- MECÁNICO NO DISPONIBLE -->

                                    <VBox class="dcgoWfPoint dcgoWfGap5">

                                        <Text
                                            text="{cumplimientoModel>/graficas/descomposicionBrecha/5/valor}"
                                            class="dcgoWfValue"/>

                                    </VBox>

                                    <!-- RESULTADO REAL -->

                                    <VBox class="dcgoWfPoint dcgoWfResult">

                                        <Text
                                            text="{cumplimientoModel>/graficas/descomposicionBrecha/6/valor}"
                                            class="dcgoWfValue"/>

                                    </VBox>

                                </HBox>

                                <!-- ETIQUETAS DEL EJE X -->

                                <HBox
                                    width="100%"
                                    alignItems="Start"
                                    class="dcgoWfLabels">

                                    <Text
                                        text="Plan inicial"
                                        wrapping="true"
                                        maxLines="2"
                                        textAlign="Center"/>

                                    <Text
                                        text="Falta de mantenimiento"
                                        wrapping="true"
                                        maxLines="2"
                                        textAlign="Center"/>

                                    <Text
                                        text="Falta de refacciones"
                                        wrapping="true"
                                        maxLines="2"
                                        textAlign="Center"/>

                                    <Text
                                        text="Cliente no disponible"
                                        wrapping="true"
                                        maxLines="2"
                                        textAlign="Center"/>

                                    <Text
                                        text="Reprogramación"
                                        wrapping="true"
                                        maxLines="2"
                                        textAlign="Center"/>

                                    <Text
                                        text="Mecánico no disponible"
                                        wrapping="true"
                                        maxLines="2"
                                        textAlign="Center"/>

                                    <Text
                                        text="Resultado real"
                                        wrapping="true"
                                        maxLines="2"
                                        textAlign="Center"/>

                                </HBox>

                            </VBox>

                        </HBox>

                        <!-- TEXTO INFERIOR SIN ICONO -->

                        <HBox
                            width="100%"
                            alignItems="Center"
                            class="dcgoWfFooter">

                            <Text
                                text="Principal causa: falta de mantenimiento, con 12 OT no ejecutadas (32% del total de la brecha)."
                                wrapping="false"
                                class="dcgoWfFooterText"/>

                        </HBox>

                    </VBox>
        <!-- =================================================
     ELEVADORES CON MAYOR DESVIACIÓN
================================================== -->

<VBox class="dcgoCard dcgoElevadoresCard">

    <!-- TÍTULO -->

    <HBox
        width="100%"
        alignItems="Center"
        class="dcgoElevadoresTitleRow">

        <Title
            text="Elevadores con mayor desviación"
            level="H3"
            class="dcgoElevadoresTitle"/>

        <core:Icon
            src="sap-icon://hint"
            tooltip="Equipos con mayor cantidad de órdenes no ejecutadas"
            class="dcgoElevadoresInfoIcon"/>

    </HBox>

    <!-- CABECERA -->

    <HBox
        width="100%"
        alignItems="Center"
        class="dcgoElevadoresHeader">

        <Text
            text="Elevador / Equipo"
            wrapping="false"
            class="dcgoElevadoresHeaderText"/>

        <Text
            text="Cliente / Sitio"
            wrapping="false"
            class="dcgoElevadoresHeaderText"/>

        <Text
            text="OT no ejecutadas"
            wrapping="false"
            class="dcgoElevadoresHeaderText dcgoElevadoresHeaderMetric"/>

    </HBox>

    <!-- LISTA DE ELEVADORES -->

    <List
        width="100%"
        inset="false"
        showSeparators="None"
        class="dcgoElevadoresList"
        items="{
            path: 'cumplimientoModel>/graficas/elevadoresDesviacion',
            templateShareable: false
        }">

        <CustomListItem>

            <HBox
                width="100%"
                alignItems="Center"
                class="dcgoElevadorRow">

                <Text
                    text="{cumplimientoModel>elevador}"
                    wrapping="false"
                    class="dcgoElevadorCode"/>

                <Text
                    text="{cumplimientoModel>cliente}"
                    wrapping="false"
                    class="dcgoElevadorClient"/>

                   <HBox
    width="100%"
    alignItems="Center"
    class="dcgoElevadorBarTrack">

    <VBox
        width="100%"
        class="dcgoElevadorBarFill">

        <layoutData>
            <FlexItemData
                growFactor="0"
                shrinkFactor="0"
                baseSize="{
                    path: 'cumplimientoModel>otNoEjecutadas',
                    formatter: '.formatBarWidth'
                }"/>
        </layoutData>

    </VBox>

</HBox>

                <Text
                    text="{cumplimientoModel>otNoEjecutadas}"
                    wrapping="false"
                    class="dcgoElevadorValue"/>

            </HBox>

        </CustomListItem>

    </List>

    <!-- ENLACE -->

    <HBox
        width="100%"
        justifyContent="End"
        alignItems="Center"
        class="dcgoElevadoresFooter">

        <Link
            text="Ver todos los elevadores"
            press=".onVerElevadores"
            class="dcgoElevadoresLink"/>

        <core:Icon
            src="sap-icon://slim-arrow-right"
            class="dcgoElevadoresLinkIcon"/>

    </HBox>

</VBox>
<!-- =================================================
     CAUSAS POR ZONA
================================================== -->

<VBox class="dcgoCard dcgoCausasZonaCard">

    <!-- TÍTULO -->

    <HBox
        width="100%"
        alignItems="Center"
        class="dcgoCausasTitleRow">

        <Title
            text="Causas por zona"
            level="H3"
            class="dcgoCausasTitle"/>

        <core:Icon
            src="sap-icon://hint"
            tooltip="Distribución de causas por zona operativa"
            class="dcgoCausasInfoIcon"/>

    </HBox>

    <!-- CABECERA -->

    <HBox
        width="100%"
        alignItems="Center"
        class="dcgoCausasGridHeader">

        <Text
            text="Causa"
            wrapping="false"
            class="dcgoCausasHeaderCause"/>

        <Text
            text="Norte"
            wrapping="false"
            class="dcgoCausasHeaderZone"/>

        <Text
            text="Centro"
            wrapping="false"
            class="dcgoCausasHeaderZone"/>

        <Text
            text="Sur"
            wrapping="false"
            class="dcgoCausasHeaderZone"/>

        <Text
            text="Este"
            wrapping="false"
            class="dcgoCausasHeaderZone"/>

        <Text
            text="Oeste"
            wrapping="false"
            class="dcgoCausasHeaderZone"/>

        <Text
            text="Total"
            wrapping="false"
            class="dcgoCausasHeaderTotal"/>

    </HBox>

    <!-- MATRIZ:
         Se utiliza VBox en lugar de List para evitar alturas,
         paddings y recortes internos de sap.m.List.
    -->

    <VBox
        width="100%"
        class="dcgoCausasMatrix"
        items="{
            path: 'cumplimientoModel>/graficas/causasZona',
            templateShareable: false
        }">

        <HBox
            width="100%"
            alignItems="Stretch"
            class="dcgoCausasGridRow">

            <!-- CAUSA -->

            <Text
                text="{cumplimientoModel>causa}"
                wrapping="false"
                class="dcgoCausaName"/>

            <!-- NORTE -->

            <Text
                text="{cumplimientoModel>norte}"
                class="dcgoHeatCell">

                <customData>
                    <core:CustomData
                        key="level"
                        value="{
                            path: 'cumplimientoModel>norte',
                            formatter: '.formatHeatLevel'
                        }"
                        writeToDom="true"/>
                </customData>

            </Text>

            <!-- CENTRO -->

            <Text
                text="{cumplimientoModel>centro}"
                class="dcgoHeatCell">

                <customData>
                    <core:CustomData
                        key="level"
                        value="{
                            path: 'cumplimientoModel>centro',
                            formatter: '.formatHeatLevel'
                        }"
                        writeToDom="true"/>
                </customData>

            </Text>

            <!-- SUR -->

            <Text
                text="{cumplimientoModel>sur}"
                class="dcgoHeatCell">

                <customData>
                    <core:CustomData
                        key="level"
                        value="{
                            path: 'cumplimientoModel>sur',
                            formatter: '.formatHeatLevel'
                        }"
                        writeToDom="true"/>
                </customData>

            </Text>

            <!-- ESTE -->

            <Text
                text="{cumplimientoModel>este}"
                class="dcgoHeatCell">

                <customData>
                    <core:CustomData
                        key="level"
                        value="{
                            path: 'cumplimientoModel>este',
                            formatter: '.formatHeatLevel'
                        }"
                        writeToDom="true"/>
                </customData>

            </Text>

            <!-- OESTE -->

            <Text
                text="{cumplimientoModel>oeste}"
                class="dcgoHeatCell">

                <customData>
                    <core:CustomData
                        key="level"
                        value="{
                            path: 'cumplimientoModel>oeste',
                            formatter: '.formatHeatLevel'
                        }"
                        writeToDom="true"/>
                </customData>

            </Text>

            <!-- TOTAL -->

            <Text
                text="{cumplimientoModel>total}"
                class="dcgoHeatTotal"/>

        </HBox>

    </VBox>

    <!-- LEYENDA -->

    <HBox
        width="100%"
        alignItems="Center"
        justifyContent="Center"
        class="dcgoCausasLegendRow">

        <Text
            text="Menor impacto"
            wrapping="false"
            class="dcgoCausasLegendText"/>

        <VBox class="dcgoCausasLegendGradient"/>

        <Text
            text="Mayor impacto"
            wrapping="false"
            class="dcgoCausasLegendText"/>

    </HBox>

</VBox>
<!-- =================================================
     SEGUIMIENTO OPERATIVO POR RESPONSABLE
================================================== -->

<VBox class="dcgoCard dcgoRespCard">

    <VBox class="dcgoRespHeader">

        <HBox
            width="100%"
            alignItems="Center"
            class="dcgoRespTitleRow">

            <Title
                text="Seguimiento operativo por responsable"
                level="H3"
                class="dcgoRespTitle"/>

            <core:Icon
                src="sap-icon://hint"
                tooltip="OT desviadas por categoría de causa"
                class="dcgoRespInfoIcon"/>

        </HBox>

        <Text
            text="OT desviadas por categoría de causa"
            wrapping="false"
            class="dcgoRespSubtitle"/>

    </VBox>

    <core:HTML
        id="htmlResponsables"
        sanitizeContent="false"
        class="dcgoRespHtml"/>

</VBox>
                    <!-- =================================================
                         TENDENCIA DE EJECUCIÓN
                    ================================================== -->

                    <VBox class="dcgoCard dcgoTendenciaCard">

                        <VBox class="dcgoCardHeader">

                            <HBox
                                alignItems="Center"
                                class="dcgoCardTitleLine">

                                <Title
                                    text="Tendencia de ejecución"
                                    level="H3"
                                    class="dcgoCardTitle"/>

                                <core:Icon
                                    src="sap-icon://hint"
                                    class="dcgoTitleInfoIcon"/>

                            </HBox>

                            <Text
                                text="Comportamiento mensual de órdenes planeadas, ejecutadas y cumplimiento"
                                class="dcgoCardSubtitle"/>

                        </VBox>

                        <HBox
                            alignItems="Center"
                            class="dcgoLegendRow">

                            <HBox
                                alignItems="Center"
                                class="dcgoLegendItem">

                                <VBox
                                    class="dcgoLegendLine dcgoLegendGray"/>

                                <Text text="OT planeadas"/>

                            </HBox>

                            <HBox
                                alignItems="Center"
                                class="dcgoLegendItem">

                                <VBox
                                    class="dcgoLegendLine dcgoLegendBlue"/>

                                <Text text="OT ejecutadas"/>

                            </HBox>

                            <HBox
                                alignItems="Center"
                                class="dcgoLegendItem">

                                <VBox
                                    class="dcgoLegendLine dcgoLegendGreen"/>

                                <Text text="% cumplimiento"/>

                            </HBox>

                        </HBox>

                        <VBox class="dcgoChartArea dcgoTrendChartArea">

                            <core:HTML
                                id="htmlTendenciaEjecucion"
                                sanitizeContent="false"
                                class="dcgoTrendHtml"/>

                        </VBox>

