<mvc:View controllerName="mantenimiento.controller.DetalleCumplimientoOrdenes"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Page showHeader="false" enableScrolling="true" class="DetalleCumplimientoOrdenes">
        <content>
            <VBox class="dcgoDashboard sapUiSizeCompact">
                <Title text="Detalle de cumplimiento general de las órdenes" level="H1" class="dcgoPageTitle"/>
                <HBox width="100%" wrap="Wrap" alignItems="End" class="dcgoFilterRow">
                    <VBox class="dcgoFilterCard">
                        <Label text="Periodo" class="dcgoFilterLabel"/>
                        <Select width="100%" selectedKey="{cumplimientoModel>/filters/periodo}" change=".onPeriodoChange" items="{path: 'cumplimientoModel>/catalogos/periodos'}">
                            <core:Item key="{cumplimientoModel>key}" text="{cumplimientoModel>text}"/>
                        </Select>
                    </VBox>
                    <VBox class="dcgoFilterCard">
                        <Label text="Fecha desde" class="dcgoFilterLabel"/>
                        <DatePicker width="100%" value="{cumplimientoModel>/filters/fechaDesde}" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy"/>
                    </VBox>
                    <VBox class="dcgoFilterCard">
                        <Label text="Fecha hasta" class="dcgoFilterLabel"/>
                        <DatePicker width="100%" value="{cumplimientoModel>/filters/fechaHasta}" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy"/>
                    </VBox>
                    <VBox class="dcgoFilterCard">
                        <Label text="Zona" class="dcgoFilterLabel"/>
                        <Select width="100%" selectedKey="{cumplimientoModel>/filters/zona}" items="{path: 'cumplimientoModel>/catalogos/zonas'}">
                            <core:Item key="{cumplimientoModel>key}" text="{cumplimientoModel>text}"/>
                        </Select>
                    </VBox>
                    <VBox class="dcgoFilterCard">
                        <Label text="Supervisor" class="dcgoFilterLabel"/>
                        <Select width="100%" selectedKey="{cumplimientoModel>/filters/supervisor}" items="{path: 'cumplimientoModel>/catalogos/supervisores'}">
                            <core:Item key="{cumplimientoModel>key}" text="{cumplimientoModel>text}"/>
                        </Select>
                    </VBox>
                    <VBox class="dcgoFilterCard">
                        <Label text="Tipo de servicio" class="dcgoFilterLabel"/>
                        <Select width="100%" selectedKey="{cumplimientoModel>/filters/tipoServicio}" items="{path: 'cumplimientoModel>/catalogos/tiposServicio'}">
                            <core:Item key="{cumplimientoModel>key}" text="{cumplimientoModel>text}"/>
                        </Select>
                    </VBox>
                    <Button text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" press=".onAplicarFiltros" class="dcgoApplyButton"/>
                </HBox>
                <HBox width="100%" wrap="Wrap" class="dcgoKpiRow">
                    <VBox class="dcgoKpiCard dcgoKpiPurple">
                        <core:Icon src="sap-icon://calendar" class="dcgoKpiIcon"/>
                        <VBox>
                            <Text text="Órdenes planeadas" class="dcgoKpiTitle"/>
                            <ObjectNumber number="{cumplimientoModel>/kpis/ordenesPlaneadas}" unit="OT" class="dcgoKpiValue"/>
                            <Text text="Planificadas en el periodo" class="dcgoKpiHelper"/>
                        </VBox>
                    </VBox>
                    <VBox class="dcgoKpiCard dcgoKpiGreen">
                        <core:Icon src="sap-icon://complete" class="dcgoKpiIcon"/>
                        <VBox>
                            <Text text="Órdenes ejecutadas" class="dcgoKpiTitle"/>
                            <ObjectNumber number="{cumplimientoModel>/kpis/ordenesEjecutadas}" unit="OT" class="dcgoKpiValue"/>
                            <Text text="{cumplimientoModel>/kpis/ejecucionDescripcion}" class="dcgoKpiHelper"/>
                        </VBox>
                    </VBox>
                    <VBox class="dcgoKpiCard dcgoKpiRed">
                        <core:Icon src="sap-icon://message-error" class="dcgoKpiIcon"/>
                        <VBox>
                            <Text text="Brecha" class="dcgoKpiTitle"/>
                            <ObjectNumber number="{cumplimientoModel>/kpis/brecha}" unit="OT" class="dcgoKpiValue"/>
                            <Text text="{cumplimientoModel>/kpis/brechaDescripcion}" class="dcgoKpiHelper"/>
                        </VBox>
                    </VBox>
                    <VBox class="dcgoKpiCard dcgoKpiLime">
                        <core:Icon src="sap-icon://target-group" class="dcgoKpiIcon"/>
                        <VBox>
                            <Text text="Cumplimiento general" class="dcgoKpiTitle"/>
                            <Text text="{cumplimientoModel>/kpis/cumplimientoGeneral}" class="dcgoKpiValue"/>
                            <Text text="Ejecutadas / planeadas" class="dcgoKpiHelper"/>
                        </VBox>
                    </VBox>
                </HBox>
                <HBox width="100%" wrap="Wrap" class="dcgoDashboardGrid">
                    <VBox class="dcgoCard dcgoWideCard">
                        <Title text="Descomposición de la brecha" level="H3" class="dcgoCardTitle"/>
                        <Text text="Plan inicial menos las OT no ejecutadas, agrupadas por causa principal." class="dcgoCardSubtitle"/>
                        <List inset="false" showSeparators="Inner" class="dcgoWaterfallList" items="{path: 'cumplimientoModel>/graficas/descomposicionBrecha'}">
                            <CustomListItem>
                                <HBox width="100%" justifyContent="SpaceBetween" class="dcgoWaterfallRow">
                                    <Text text="{cumplimientoModel>concepto}"/>
                                    <ObjectNumber number="{cumplimientoModel>valor}" state="{= ${cumplimientoModel>tipo} === 'brecha' ? 'Error' : 'None' }"/>
                                </HBox>
                            </CustomListItem>
                        </List>
                        <Text text="{cumplimientoModel>/graficas/descomposicionBrechaPie}" class="dcgoCardFooter"/>
                    </VBox>
                    <VBox class="dcgoCard dcgoWideCard">
                        <HBox alignItems="Center">
                            <Title text="Elevadores con mayor desviación" level="H3" class="dcgoCardTitle"/>
                            <core:Icon src="sap-icon://hint" tooltip="OT no ejecutadas por equipo" class="dcgoInfoIcon"/>
                        </HBox>
                        <List inset="false" showSeparators="Inner" items="{path: 'cumplimientoModel>/graficas/elevadoresDesviacion'}">
                            <CustomListItem>
                                <HBox width="100%" alignItems="Center" class="dcgoEquipmentRow">
                                    <VBox class="dcgoEquipmentName">
                                        <Text text="{cumplimientoModel>elevador}"/>
                                        <Text text="{cumplimientoModel>cliente}" class="dcgoMutedText"/>
                                    </VBox>
                                    <ProgressIndicator percentValue="{cumplimientoModel>barWidth}" displayValue="" showValue="false" state="Information" class="dcgoEquipmentBar"/>
                                    <ObjectNumber number="{cumplimientoModel>otNoEjecutadas}" unit="OT" state="Error"/>
                                </HBox>
                            </CustomListItem>
                        </List>
                    </VBox>
                    <VBox class="dcgoCard dcgoWideCard">
                        <Title text="Causas por zona" level="H3" class="dcgoCardTitle"/>
                        <Table inset="false" fixedLayout="true" items="{path: 'cumplimientoModel>/graficas/causasZona'}" class="dcgoCompactTable">
                            <columns>
                                <Column>
                                    <Text text="Causa"/>
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Norte"/>
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Centro"/>
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Sur"/>
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Este"/>
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Oeste"/>
                                </Column>
                                <Column hAlign="Center">
                                    <Text text="Total"/>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{cumplimientoModel>causa}"/>
                                        <Text text="{cumplimientoModel>norte}" textAlign="Center"/>
                                        <Text text="{cumplimientoModel>centro}" textAlign="Center"/>
                                        <Text text="{cumplimientoModel>sur}" textAlign="Center"/>
                                        <Text text="{cumplimientoModel>este}" textAlign="Center"/>
                                        <Text text="{cumplimientoModel>oeste}" textAlign="Center"/>
                                        <ObjectNumber number="{cumplimientoModel>total}"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                    <VBox class="dcgoCard dcgoWideCard">
                        <Title text="Seguimiento operativo por responsable" level="H3" class="dcgoCardTitle"/>
                        <Text text="OT desviadas por origen de la causa" class="dcgoCardSubtitle"/>
                        <core:HTML id="htmlResponsables" sanitizeContent="false" class="dcgoRespHtml"/>
                    </VBox>
                    <VBox class="dcgoCard dcgoTrendCard">
                        <Title text="Tendencia de ejecución" level="H3" class="dcgoCardTitle"/>
                        <Text text="Órdenes planeadas, ejecutadas y cumplimiento por mes" class="dcgoCardSubtitle"/>
                        <core:HTML id="htmlTendenciaEjecucion" sanitizeContent="false" class="dcgoTrendHtml"/>
                        <Table inset="false" fixedLayout="true" items="{path: 'cumplimientoModel>/graficas/tendenciaEjecucion'}" class="dcgoCompactTable">
                            <columns>
                                <Column>
                                    <Text text="Mes"/>
                                </Column>
                                <Column hAlign="End">
                                    <Text text="Plan"/>
                                </Column>
                                <Column hAlign="End">
                                    <Text text="Ejecutadas"/>
                                </Column>
                                <Column hAlign="End">
                                    <Text text="Brecha"/>
                                </Column>
                                <Column hAlign="End">
                                    <Text text="Cumplimiento"/>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{cumplimientoModel>mes}"/>
                                        <Text text="{cumplimientoModel>otPlaneadas}" textAlign="End"/>
                                        <Text text="{cumplimientoModel>otEjecutadas}" textAlign="End"/>
                                        <ObjectNumber number="{cumplimientoModel>brecha}" state="Error"/>
                                        <Text text="{= ${cumplimientoModel>cumplimiento} + '%' }" textAlign="End"/>
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </VBox>
                    <VBox class="dcgoCard dcgoWideCard">
                        <Title text="Clasificación de fallas / servicios afectados" level="H3" class="dcgoCardTitle"/>
                        <HBox alignItems="Center" class="dcgoFailuresBody">
                            <core:HTML id="htmlFallasDonut" sanitizeContent="false" class="dcgoDonutHtml"/>
                            <List inset="false" showSeparators="Inner" class="dcgoFailuresList" items="{path: 'cumplimientoModel>/graficas/fallasServicios'}">
                                <CustomListItem>
                                    <HBox width="100%" justifyContent="SpaceBetween">
                                        <Text text="{cumplimientoModel>falla}"/>
                                        <Text text="{= ${cumplimientoModel>total} + ' (' + ${cumplimientoModel>porcentaje} + '%)' }"/>
                                    </HBox>
                                </CustomListItem>
                            </List>
                        </HBox>
                    </VBox>
                </HBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
