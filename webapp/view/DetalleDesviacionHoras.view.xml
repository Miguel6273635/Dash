<mvc:View
    controllerName="mantenimiento.controller.DetalleDesviacionHoras"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        id="detalleDesviacionHorasPage"
        showHeader="false"
        enableScrolling="false"
        busy="{ddh>/isBusy}"
        busyIndicatorDelay="0"
        class="DetalleDesviacionHoras">

        <content>

            <VBox
                width="100%"
                height="100%"
                class="ddhPage sapUiSizeCompact">

                <!-- =================================================
                     HEADER
                     ================================================= -->

                <VBox
                    class="ddhHeader">

                    <Title
                        text="Detalle de desviación de horas"
                        level="H1"
                        class="ddhTitle"/>

                    <Text
                        text="Análisis de órdenes con desviación entre las horas planificadas y las horas reales."
                        wrapping="false"
                        class="ddhSubtitle"/>

                </VBox>


                <!-- =================================================
                     FILTROS
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="ddhFiltersBar">

                    <!-- AÑO -->

                    <VBox
                        class="ddhFilterBox ddhFilterYear">

                        <Label
                            text="Año"
                            class="ddhFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{ddh>/filters/periodo}"
                            change=".onPeriodoChange"
                            items="{ddh>/catalogos/periodos}"
                            class="ddhFilterControl">

                            <core:Item
                                key="{ddh>key}"
                                text="{ddh>text}"/>

                        </Select>

                    </VBox>


                    <!-- FECHA DESDE -->

                    <VBox
                        class="ddhFilterBox ddhFilterDate">

                        <Label
                            text="Fecha desde"
                            class="ddhFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{ddh>/filters/fechaDesde}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            change=".onFechaChange"
                            class="ddhFilterControl"/>

                    </VBox>


                    <!-- FECHA HASTA -->

                    <VBox
                        class="ddhFilterBox ddhFilterDate">

                        <Label
                            text="Fecha hasta"
                            class="ddhFilterLabel"/>

                        <DatePicker
                            width="100%"
                            value="{ddh>/filters/fechaHasta}"
                            displayFormat="dd/MM/yyyy"
                            valueFormat="dd/MM/yyyy"
                            change=".onFechaChange"
                            class="ddhFilterControl"/>

                    </VBox>


                    <!-- ZONA -->

                    <VBox
                        class="ddhFilterBox ddhFilterNormal">

                        <Label
                            text="Zona"
                            class="ddhFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{ddh>/filters/zona}"
                            items="{ddh>/catalogos/zonas}"
                            class="ddhFilterControl">

                            <core:Item
                                key="{ddh>key}"
                                text="{ddh>text}"/>

                        </Select>

                    </VBox>


                    <!-- SUPERVISOR -->

                    <VBox
                        class="ddhFilterBox ddhFilterSupervisor">

                        <Label
                            text="Supervisor"
                            class="ddhFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{ddh>/filters/supervisor}"
                            items="{ddh>/catalogos/supervisores}"
                            class="ddhFilterControl">

                            <core:Item
                                key="{ddh>key}"
                                text="{ddh>text}"/>

                        </Select>

                    </VBox>


                    <!-- TURNO -->

                    <VBox
                        class="ddhFilterBox ddhFilterNormal">

                        <Label
                            text="Turno"
                            class="ddhFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{ddh>/filters/turno}"
                            items="{ddh>/catalogos/turnos}"
                            class="ddhFilterControl">

                            <core:Item
                                key="{ddh>key}"
                                text="{ddh>text}"/>

                        </Select>

                    </VBox>


                    <!-- TIPO ORDEN -->

                    <VBox
                        class="ddhFilterBox ddhFilterOrder">

                        <Label
                            text="Tipo de orden"
                            class="ddhFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{ddh>/filters/tipoOrden}"
                            items="{ddh>/catalogos/tiposOrden}"
                            class="ddhFilterControl">

                            <core:Item
                                key="{ddh>key}"
                                text="{ddh>text}"/>

                        </Select>

                    </VBox>


                    <!-- ESTADO -->

                    <VBox
                        class="ddhFilterBox ddhFilterState">

                        <Label
                            text="Estado de orden"
                            class="ddhFilterLabel"/>

                        <Select
                            width="100%"
                            selectedKey="{ddh>/filters/estado}"
                            items="{ddh>/catalogos/estadosOrden}"
                            class="ddhFilterControl">

                            <core:Item
                                key="{ddh>key}"
                                text="{ddh>text}"/>

                        </Select>

                    </VBox>


                    <!-- APLICAR -->

                    <VBox
                        justifyContent="Center"
                        class="ddhApplyButtonBox">

                        <Button
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            width="100%"
                            class="ddhApplyButton"
                            press=".onAplicarFiltros"/>

                    </VBox>

                </HBox>


                <!-- =================================================
                     KPIS
                     ================================================= -->

                <HBox
                    width="100%"
                    wrap="NoWrap"
                    alignItems="Stretch"
                    class="ddhKpiRow">

                    <!-- OT DESVIACIÓN -->

                    <HBox
                        class="ddhKpiCard ddhKpiBlue"
                        alignItems="Center">

                        <HBox
                            class="ddhKpiIcon ddhKpiIconBlue"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://appointment-2"/>

                        </HBox>

                        <VBox
                            class="ddhKpiContent"
                            justifyContent="Center">

                            <Text
                                text="OT con desviación"
                                wrapping="false"
                                class="ddhKpiLabel"/>

                            <Text
                                text="{ddh>/kpis/otDesviacion}"
                                wrapping="false"
                                class="ddhKpiNumber"/>

                            <Text
                                text="órdenes"
                                wrapping="false"
                                class="ddhKpiSub"/>

                        </VBox>

                    </HBox>


                    <!-- PLAN -->

                    <HBox
                        class="ddhKpiCard ddhKpiGreen"
                        alignItems="Center">

                        <HBox
                            class="ddhKpiIcon ddhKpiIconGreen"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://time-account"/>

                        </HBox>

                        <VBox
                            class="ddhKpiContent"
                            justifyContent="Center">

                            <Text
                                text="Horas planificadas"
                                wrapping="false"
                                class="ddhKpiLabel"/>

                            <Text
                                text="{ddh>/kpis/horasPlanificadas}"
                                wrapping="false"
                                class="ddhKpiNumber"/>

                            <Text
                                text="Horas previstas"
                                wrapping="false"
                                class="ddhKpiSub"/>

                        </VBox>

                    </HBox>


                    <!-- REAL -->

                    <HBox
                        class="ddhKpiCard ddhKpiSky"
                        alignItems="Center">

                        <HBox
                            class="ddhKpiIcon ddhKpiIconSky"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://lateness"/>

                        </HBox>

                        <VBox
                            class="ddhKpiContent"
                            justifyContent="Center">

                            <Text
                                text="Horas reales"
                                wrapping="false"
                                class="ddhKpiLabel"/>

                            <Text
                                text="{ddh>/kpis/horasReales}"
                                wrapping="false"
                                class="ddhKpiNumber"/>

                            <Text
                                text="Horas registradas"
                                wrapping="false"
                                class="ddhKpiSub"/>

                        </VBox>

                    </HBox>


                    <!-- DESVIACIÓN -->

                    <HBox
                        class="ddhKpiCard ddhKpiRed"
                        alignItems="Center">

                        <HBox
                            class="ddhKpiIcon ddhKpiIconRed"
                            alignItems="Center"
                            justifyContent="Center">

                            <core:Icon
                                src="sap-icon://sort"/>

                        </HBox>

                        <VBox
                            class="ddhKpiContent"
                            justifyContent="Center">

                            <Text
                                text="Desviación total"
                                wrapping="false"
                                class="ddhKpiLabel"/>

                            <Text
                                text="{ddh>/kpis/desviacionTotal}"
                                wrapping="false"
                                class="ddhKpiNumber"/>

                            <Text
                                text="sobre lo planeado"
                                wrapping="false"
                                class="ddhKpiSub"/>

                        </VBox>

                    </HBox>


                    <!-- PROMEDIO -->

                    <HBox
                        class="ddhKpiCard ddhKpiPurple"
                        alignItems="Center">

                        <HBox
                            class="ddhKpiIcon ddhKpiIconPurple"
                            alignItems="Center"
                            justifyContent="Center">

                            <Text
                                text="%"
                                class="ddhPercentIcon"/>

                        </HBox>

                        <VBox
                            class="ddhKpiContent"
                            justifyContent="Center">

                            <Text
                                text="Desviación % promedio"
                                wrapping="false"
                                class="ddhKpiLabel"/>

                            <Text
                                text="{ddh>/kpis/desviacionPromedio}"
                                wrapping="false"
                                class="ddhKpiNumber"/>

                            <Text
                                text="promedio de variación"
                                wrapping="false"
                                class="ddhKpiSub"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- =================================================
                     TABLA PRINCIPAL
                     ================================================= -->

                <VBox
                    width="100%"
                    height="100%"
                    class="ddhCard ddhMainTableCard">

                    <layoutData>

                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>

                    </layoutData>


                    <!-- HEADER -->

                    <HBox
                        width="100%"
                        class="ddhCardHeader"
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <HBox
                            alignItems="Center"
                            class="ddhCardTitleGroup">

                            <HBox
                                class="ddhHeaderIcon ddhHeaderIconBlue"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://appointment-2"/>

                            </HBox>

                            <Title
                                text="Órdenes con desviación de horas"
                                level="H3"
                                class="ddhCardTitle"/>

                        </HBox>

                        <Button
                            text="Columnas"
                            icon="sap-icon://table-view"
                            type="Transparent"
                            class="ddhColumnsButton"
                            press=".onColumnas"/>

                    </HBox>


                    <!-- TABLA -->

                    <VBox
                        width="100%"
                        class="ddhOrdersGrid">

                        <layoutData>

                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>

                        </layoutData>


                        <!-- CABECERA -->

                        <HBox
                            class="ddhOrdersGridHeader">

                            <Text
                                text="OT"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Cliente"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Elevador / Equipo"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Zona"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Tipo de orden"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Responsable"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Turno"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Horas plan (h)"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Horas reales (h)"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Variación (h)"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Variación (%)"
                                class="ddhGridHeadText"/>

                            <Text
                                text="Estado"
                                class="ddhGridHeadText"/>

                        </HBox>


                        <!-- FILAS -->

                        <VBox
                            width="100%"
                            items="{ddh>/ordenesPaginadas}"
                            class="ddhOrdersRows">

                            <HBox
                                class="ddhOrdersGridRow">

                                <Text
                                    text="{ddh>ot}"
                                    tooltip="{ddh>ot}"
                                    wrapping="false"
                                    class="ddhBlueStrong ddhCellText"/>

                                <Text
                                    text="{ddh>cliente}"
                                    tooltip="{ddh>cliente}"
                                    wrapping="false"
                                    class="ddhCellText"/>

                                <Text
                                    text="{ddh>elevador}"
                                    tooltip="{ddh>elevador}"
                                    wrapping="false"
                                    class="ddhCellText"/>

                                <Text
                                    text="{ddh>zona}"
                                    tooltip="{ddh>zona}"
                                    wrapping="false"
                                    class="ddhCellText"/>

                                <Text
                                    text="{ddh>tipoOrden}"
                                    tooltip="{ddh>tipoOrden}"
                                    wrapping="false"
                                    class="ddhCellText"/>

                                <Text
                                    text="{ddh>responsable}"
                                    tooltip="{ddh>responsable}"
                                    wrapping="false"
                                    class="ddhCellText"/>

                                <Text
                                    text="{ddh>turno}"
                                    tooltip="{ddh>turno}"
                                    wrapping="false"
                                    class="ddhCellText"/>

                                <Text
                                    text="{ddh>horasPlan}"
                                    wrapping="false"
                                    class="ddhCellText"/>

                                <Text
                                    text="{ddh>horasReales}"
                                    wrapping="false"
                                    class="ddhCellText"/>


                                <!-- VARIACIÓN H -->

                                <VBox
                                    class="ddhCenterCell">

                                    <Text
                                        text="{ddh>variacionH}"
                                        class="ddhVarText ddhRedStrong"
                                        visible="{= ${ddh>variacionH}.charAt(0) === '+' }"/>

                                    <Text
                                        text="{ddh>variacionH}"
                                        class="ddhVarText ddhGreenStrong"
                                        visible="{= ${ddh>variacionH}.charAt(0) === '-' }"/>

                                    <Text
                                        text="{ddh>variacionH}"
                                        class="ddhVarText ddhDarkStrong"
                                        visible="{= ${ddh>variacionH}.charAt(0) !== '+' &amp;&amp; ${ddh>variacionH}.charAt(0) !== '-' }"/>

                                </VBox>


                                <!-- VARIACIÓN % -->

                                <VBox
                                    class="ddhCenterCell">

                                    <Text
                                        text="{ddh>variacionPct}"
                                        class="ddhVarText ddhRedStrong"
                                        visible="{= ${ddh>variacionPct}.charAt(0) === '+' }"/>

                                    <Text
                                        text="{ddh>variacionPct}"
                                        class="ddhVarText ddhGreenStrong"
                                        visible="{= ${ddh>variacionPct}.charAt(0) === '-' }"/>

                                    <Text
                                        text="{ddh>variacionPct}"
                                        class="ddhVarText ddhDarkStrong"
                                        visible="{= ${ddh>variacionPct}.charAt(0) !== '+' &amp;&amp; ${ddh>variacionPct}.charAt(0) !== '-' }"/>

                                </VBox>


                                <!-- ESTADO -->

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="ddhSummaryStatusCell">

                                    <VBox
                                        class="ddhDotRed"
                                        visible="{= ${ddh>estado} === 'Sobrecargado' }"/>

                                    <VBox
                                        class="ddhDotOrange"
                                        visible="{= ${ddh>estado} === 'Cerca de plan' }"/>

                                    <VBox
                                        class="ddhDotGreen"
                                        visible="{= ${ddh>estado} === 'Dentro de plan' }"/>

                                    <Text
                                        text="{ddh>estado}"
                                        tooltip="{ddh>estado}"
                                        wrapping="false"
                                        class="ddhSummaryStatusText"/>

                                </HBox>

                            </HBox>

                        </VBox>


                        <!-- NO DATA -->

                        <HBox
                            visible="{= ${ddh>/pagination/totalResults} === 0 }"
                            alignItems="Center"
                            justifyContent="Center"
                            class="ddhNoDataRow">

                            <Text
                                text="No se encontraron órdenes con desviación para los filtros seleccionados."
                                class="ddhNoDataText"/>

                        </HBox>

                    </VBox>


                    <!-- FOOTER -->

                    <HBox
                        width="100%"
                        class="ddhTableFooter"
                        justifyContent="SpaceBetween"
                        alignItems="Center">

                        <Text
                            text="{ddh>/pagination/resultText}"
                            class="ddhFooterText"/>

                        <HBox
                            alignItems="Center"
                            class="ddhPager">

                            <Button
                                icon="sap-icon://navigation-left-arrow"
                                type="Transparent"
                                enabled="{ddh>/pagination/hasPrevious}"
                                press=".onPaginaAnterior"
                                class="ddhPagerButton"/>

                            <Text
                                text="{= 'Página ' + ${ddh>/pagination/currentPage} + ' de ' + ${ddh>/pagination/totalPages} }"
                                class="ddhPaginationText"/>

                            <Button
                                icon="sap-icon://navigation-right-arrow"
                                type="Transparent"
                                enabled="{ddh>/pagination/hasNext}"
                                press=".onPaginaSiguiente"
                                class="ddhPagerButton"/>

                        </HBox>

                    </HBox>

                </VBox>


                <!-- =================================================
                     RESÚMENES
                     ================================================= -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    wrap="NoWrap"
                    class="ddhBottomGrid">

                    <!-- =================================================
                         ZONA
                         ================================================= -->

                    <VBox
                        width="100%"
                        height="100%"
                        class="ddhCard ddhSummaryCard ddhSummaryBlue">

                        <HBox
                            class="ddhSummaryTitleRow"
                            alignItems="Center">

                            <HBox
                                class="ddhSummaryIcon ddhSummaryIconBlue"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://map-2"/>

                            </HBox>

                            <Title
                                text="Resumen por zona"
                                level="H3"
                                class="ddhCardTitle"/>

                        </HBox>


                        <VBox
                            class="ddhSummaryGrid ddhZonaSummaryGrid">

                            <HBox
                                class="ddhSummaryHeader">

                                <Text text="Zona"/>
                                <Text text="OT con desv."/>
                                <Text text="Horas plan (h)"/>
                                <Text text="Horas reales (h)"/>
                                <Text text="Variación (h)"/>
                                <Text text="Variación (%)"/>
                                <Text text="Estado"/>

                            </HBox>


                            <VBox
                                items="{ddh>/resumenZona}"
                                class="ddhSummaryRows">

                                <HBox
                                    class="ddhSummaryRow">

                                    <Text
                                        text="{ddh>zona}"
                                        tooltip="{ddh>zona}"/>

                                    <Text
                                        text="{ddh>ot}"/>

                                    <Text
                                        text="{ddh>horasPlan}"/>

                                    <Text
                                        text="{ddh>horasReales}"/>

                                    <Text
                                        text="{ddh>variacionH}"
                                        class="{ddh>colorClass}"/>

                                    <Text
                                        text="{ddh>variacionPct}"
                                        class="{ddh>colorClass}"/>

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="Center"
                                        class="ddhSummaryStatusCell">

                                        <VBox
                                            class="ddhDotRed"
                                            visible="{= ${ddh>estado} === 'Sobrecargado' }"/>

                                        <VBox
                                            class="ddhDotOrange"
                                            visible="{= ${ddh>estado} === 'Cerca de plan' }"/>

                                        <VBox
                                            class="ddhDotGreen"
                                            visible="{= ${ddh>estado} === 'Dentro de plan' }"/>

                                        <Text
                                            text="{ddh>estado}"
                                            class="ddhSummaryStatusText"/>

                                    </HBox>

                                </HBox>

                            </VBox>


                            <!-- TOTAL -->

                            <HBox
                                class="ddhSummaryRow ddhSummaryTotal">

                                <Text text="Total"/>

                                <Text
                                    text="{ddh>/totales/ot}"/>

                                <Text
                                    text="{ddh>/totales/horasPlan}"/>

                                <Text
                                    text="{ddh>/totales/horasReales}"/>

                                <Text
                                    text="{ddh>/totales/variacionH}"
                                    class="ddhRedStrong"/>

                                <Text
                                    text="{ddh>/totales/variacionPct}"
                                    class="ddhRedStrong"/>

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="ddhSummaryStatusCell">

                                    <VBox
                                        class="ddhDotRed"
                                        visible="{= ${ddh>/totales/estado} === 'Sobrecargado' }"/>

                                    <VBox
                                        class="ddhDotOrange"
                                        visible="{= ${ddh>/totales/estado} === 'Cerca de plan' }"/>

                                    <VBox
                                        class="ddhDotGreen"
                                        visible="{= ${ddh>/totales/estado} === 'Dentro de plan' }"/>

                                    <Text
                                        text="{ddh>/totales/estado}"
                                        class="ddhSummaryStatusText"/>

                                </HBox>

                            </HBox>

                        </VBox>

                    </VBox>


                    <!-- =================================================
                         TURNO
                         ================================================= -->

                    <VBox
                        width="100%"
                        height="100%"
                        class="ddhCard ddhSummaryCard ddhSummaryGreen">

                        <HBox
                            class="ddhSummaryTitleRow"
                            alignItems="Center">

                            <HBox
                                class="ddhSummaryIcon ddhSummaryIconGreen"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://time-entry-request"/>

                            </HBox>

                            <Title
                                text="Resumen por turno"
                                level="H3"
                                class="ddhCardTitle"/>

                        </HBox>


                        <VBox
                            class="ddhSummaryGrid ddhTurnoSummaryGrid">

                            <HBox
                                class="ddhSummaryHeader">

                                <Text text="Turno"/>
                                <Text text="OT con desv."/>
                                <Text text="Horas plan (h)"/>
                                <Text text="Horas reales (h)"/>
                                <Text text="Variación (h)"/>
                                <Text text="Variación (%)"/>
                                <Text text="Estado"/>

                            </HBox>


                            <VBox
                                items="{ddh>/resumenTurno}"
                                class="ddhSummaryRows">

                                <HBox
                                    class="ddhSummaryRow">

                                    <Text
                                        text="{ddh>turno}"
                                        tooltip="{ddh>turno}"/>

                                    <Text text="{ddh>ot}"/>

                                    <Text text="{ddh>horasPlan}"/>

                                    <Text text="{ddh>horasReales}"/>

                                    <Text
                                        text="{ddh>variacionH}"
                                        class="{ddh>colorClass}"/>

                                    <Text
                                        text="{ddh>variacionPct}"
                                        class="{ddh>colorClass}"/>

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="Center"
                                        class="ddhSummaryStatusCell">

                                        <VBox
                                            class="ddhDotRed"
                                            visible="{= ${ddh>estado} === 'Sobrecargado' }"/>

                                        <VBox
                                            class="ddhDotOrange"
                                            visible="{= ${ddh>estado} === 'Cerca de plan' }"/>

                                        <VBox
                                            class="ddhDotGreen"
                                            visible="{= ${ddh>estado} === 'Dentro de plan' }"/>

                                        <Text
                                            text="{ddh>estado}"
                                            class="ddhSummaryStatusText"/>

                                    </HBox>

                                </HBox>

                            </VBox>


                            <HBox
                                class="ddhSummaryRow ddhSummaryTotal">

                                <Text text="Total"/>

                                <Text
                                    text="{ddh>/totales/ot}"/>

                                <Text
                                    text="{ddh>/totales/horasPlan}"/>

                                <Text
                                    text="{ddh>/totales/horasReales}"/>

                                <Text
                                    text="{ddh>/totales/variacionH}"
                                    class="ddhRedStrong"/>

                                <Text
                                    text="{ddh>/totales/variacionPct}"
                                    class="ddhRedStrong"/>

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="ddhSummaryStatusCell">

                                    <VBox
                                        class="ddhDotRed"
                                        visible="{= ${ddh>/totales/estado} === 'Sobrecargado' }"/>

                                    <VBox
                                        class="ddhDotOrange"
                                        visible="{= ${ddh>/totales/estado} === 'Cerca de plan' }"/>

                                    <VBox
                                        class="ddhDotGreen"
                                        visible="{= ${ddh>/totales/estado} === 'Dentro de plan' }"/>

                                    <Text
                                        text="{ddh>/totales/estado}"
                                        class="ddhSummaryStatusText"/>

                                </HBox>

                            </HBox>

                        </VBox>

                    </VBox>


                    <!-- =================================================
                         TIPO ORDEN
                         ================================================= -->

                    <VBox
                        width="100%"
                        height="100%"
                        class="ddhCard ddhSummaryCard ddhSummaryPurple">

                        <HBox
                            class="ddhSummaryTitleRow"
                            alignItems="Center">

                            <HBox
                                class="ddhSummaryIcon ddhSummaryIconPurple"
                                alignItems="Center"
                                justifyContent="Center">

                                <core:Icon
                                    src="sap-icon://wrench"/>

                            </HBox>

                            <Title
                                text="Resumen por tipo de orden"
                                level="H3"
                                class="ddhCardTitle"/>

                        </HBox>


                        <VBox
                            class="ddhSummaryGrid ddhTipoSummaryGrid">

                            <HBox
                                class="ddhSummaryHeader">

                                <Text text="Tipo de orden"/>
                                <Text text="OT con desv."/>
                                <Text text="Horas plan (h)"/>
                                <Text text="Horas reales (h)"/>
                                <Text text="Variación (h)"/>
                                <Text text="Variación (%)"/>
                                <Text text="Estado"/>

                            </HBox>


                            <VBox
                                items="{ddh>/resumenTipoOrden}"
                                class="ddhSummaryRows">

                                <HBox
                                    class="ddhSummaryRow">

                                    <Text
                                        text="{ddh>tipoOrden}"
                                        tooltip="{ddh>tipoOrden}"/>

                                    <Text text="{ddh>ot}"/>

                                    <Text text="{ddh>horasPlan}"/>

                                    <Text text="{ddh>horasReales}"/>

                                    <Text
                                        text="{ddh>variacionH}"
                                        class="{ddh>colorClass}"/>

                                    <Text
                                        text="{ddh>variacionPct}"
                                        class="{ddh>colorClass}"/>

                                    <HBox
                                        alignItems="Center"
                                        justifyContent="Center"
                                        class="ddhSummaryStatusCell">

                                        <VBox
                                            class="ddhDotRed"
                                            visible="{= ${ddh>estado} === 'Sobrecargado' }"/>

                                        <VBox
                                            class="ddhDotOrange"
                                            visible="{= ${ddh>estado} === 'Cerca de plan' }"/>

                                        <VBox
                                            class="ddhDotGreen"
                                            visible="{= ${ddh>estado} === 'Dentro de plan' }"/>

                                        <Text
                                            text="{ddh>estado}"
                                            class="ddhSummaryStatusText"/>

                                    </HBox>

                                </HBox>

                            </VBox>


                            <HBox
                                class="ddhSummaryRow ddhSummaryTotal">

                                <Text text="Total"/>

                                <Text
                                    text="{ddh>/totales/ot}"/>

                                <Text
                                    text="{ddh>/totales/horasPlan}"/>

                                <Text
                                    text="{ddh>/totales/horasReales}"/>

                                <Text
                                    text="{ddh>/totales/variacionH}"
                                    class="ddhRedStrong"/>

                                <Text
                                    text="{ddh>/totales/variacionPct}"
                                    class="ddhRedStrong"/>

                                <HBox
                                    alignItems="Center"
                                    justifyContent="Center"
                                    class="ddhSummaryStatusCell">

                                    <VBox
                                        class="ddhDotRed"
                                        visible="{= ${ddh>/totales/estado} === 'Sobrecargado' }"/>

                                    <VBox
                                        class="ddhDotOrange"
                                        visible="{= ${ddh>/totales/estado} === 'Cerca de plan' }"/>

                                    <VBox
                                        class="ddhDotGreen"
                                        visible="{= ${ddh>/totales/estado} === 'Dentro de plan' }"/>

                                    <Text
                                        text="{ddh>/totales/estado}"
                                        class="ddhSummaryStatusText"/>

                                </HBox>

                            </HBox>

                        </VBox>

                    </VBox>

                </HBox>

            </VBox>

        </content>

    </Page>

</mvc:View>