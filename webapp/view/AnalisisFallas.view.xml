<mvc:View
    controllerName="mantenimiento.controller.AnalisisFallas"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:microchart="sap.suite.ui.microchart"
    displayBlock="true">

    <Page
        id="analisisFallasPage"
        showHeader="false"
        enableScrolling="true"
        class="AnalisisFallas">

        <content>

            <VBox
                width="100%"
                height="100%"
                class="cmPageContainer">

                <!-- =====================================================
                     TÍTULO + FILTROS
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Center"
                    justifyContent="SpaceBetween"
                    class="afTopBar">

                    <VBox class="afTitleBlock">
                        <Title
                            text="Análisis de fallas y servicios afectados"
                            level="H1"
                            class="cmMainTitle"/>

                        <Text
                            text="Identifique qué tipos de fallas están impactando más el cumplimiento y dónde se concentran."
                            class="cmSubtitle"/>
                    </VBox>


                    <HBox
                        alignItems="Stretch"
                        justifyContent="End"
                        class="afFilters">

                        <!-- PERIODO -->
                        <HBox
                            alignItems="Center"
                            class="afFilterCard afWeekFilter">

                            <core:Icon
                                src="sap-icon://calendar"
                                class="afFilterIcon"/>

                            <VBox class="afFilterContent">

                                <Text
                                    text="Periodo"
                                    class="afFilterLabel"/>

                                <Select
                                    id="analisisFallasPeriodSelect"
                                    selectedKey="{fallasModel>/filtros/periodo}"
                                    change=".onPeriodoChange"
                                    items="{fallasModel>/opcionesPeriodo}"
                                    class="afFilterSelect">

                                    <items>
                                        <core:Item
                                            key="{fallasModel>key}"
                                            text="{fallasModel>text}"/>
                                    </items>

                                </Select>

                            </VBox>

                        </HBox>


                        <!-- ZONA -->
                        <HBox
                            alignItems="Center"
                            class="afFilterCard afZoneFilter">

                            <core:Icon
                                src="sap-icon://map"
                                class="afFilterIcon"/>

                            <VBox class="afFilterContent">

                                <Text
                                    text="Zona"
                                    class="afFilterLabel"/>

                                <Select
                                    id="analisisFallasZoneSelect"
                                    selectedKey="{fallasModel>/filtros/zona}"
                                    items="{fallasModel>/opcionesZona}"
                                    class="afFilterSelect">

                                    <items>
                                        <core:Item
                                            key="{fallasModel>key}"
                                            text="{fallasModel>text}"/>
                                    </items>

                                </Select>

                            </VBox>

                        </HBox>


                        <!-- APLICAR -->
                        <Button
                            id="analisisFallasApplyButton"
                            text="Aplicar filtros"
                            icon="sap-icon://filter"
                            type="Emphasized"
                            press=".onApplyFilters"
                            class="afApplyButton"/>

                    </HBox>

                </HBox>


                <!-- =====================================================
                     KPIs
                     ===================================================== -->

                <HBox
                    width="100%"
                    alignItems="Stretch"
                    class="cmKpiRow">

                    <!-- OT -->
                    <HBox
                        alignItems="Center"
                        class="cmKpiCard cmKpiPurple">

                        <VBox class="cmKpiIcon cmKpiIconPurple">
                            <core:Icon src="sap-icon://form"/>
                        </VBox>

                        <VBox class="cmKpiContent">

                            <Text
                                text="OT afectadas"
                                class="cmKpiLabel"/>

                            <Text
                                text="{fallasModel>/resumen/TotalOTAfectadas}"
                                class="cmKpiNumber cmPurpleText"/>

                            <Text
                                text="Del total de desviaciones"
                                class="cmKpiDescription"/>

                        </VBox>

                    </HBox>


                    <!-- CLASIFICACIÓN -->
                    <HBox
                        alignItems="Center"
                        class="cmKpiCard cmKpiGreen">

                        <VBox class="cmKpiIcon cmKpiIconGreen">
                            <core:Icon src="sap-icon://wrench"/>
                        </VBox>

                        <VBox class="cmKpiContent">

                            <Text
                                text="Clasificación principal"
                                class="cmKpiLabel"/>

                            <Text
                                text="{fallasModel>/resumen/ClasificacionPrincipalTexto}"
                                class="cmKpiTextValue cmGreenText"/>

                            <Text
                                text="{fallasModel>/resumen/ClasificacionPrincipalPorcentaje}"
                                class="cmKpiDescription"/>

                        </VBox>

                    </HBox>


                    <!-- EQUIPOS -->
                    <HBox
                        alignItems="Center"
                        class="cmKpiCard cmKpiOrange">

                        <VBox class="cmKpiIcon cmKpiIconOrange">
                            <core:Icon src="sap-icon://product"/>
                        </VBox>

                        <VBox class="cmKpiContent">

                            <Text
                                text="Equipos afectados"
                                class="cmKpiLabel"/>

                            <Text
                                text="{fallasModel>/resumen/TotalEquiposAfectados}"
                                class="cmKpiNumber cmOrangeText"/>

                            <Text
                                text="Equipos únicos"
                                class="cmKpiDescription"/>

                        </VBox>

                    </HBox>


                    <!-- CLIENTES -->
                    <HBox
                        alignItems="Center"
                        class="cmKpiCard cmKpiBlue">

                        <VBox class="cmKpiIcon cmKpiIconBlue">
                            <core:Icon src="sap-icon://business-objects-mobile"/>
                        </VBox>

                        <VBox class="cmKpiContent">

                            <Text
                                text="Clientes afectados"
                                class="cmKpiLabel"/>

                            <Text
                                text="{fallasModel>/resumen/TotalClientesAfectados}"
                                class="cmKpiNumber cmBlueText"/>

                            <Text
                                text="Clientes únicos"
                                class="cmKpiDescription"/>

                        </VBox>

                    </HBox>

                </HBox>


                <!-- =====================================================
                     CARD TABLA
                     ===================================================== -->

                <VBox
                    width="100%"
                    class="afTableCard">

                    <layoutData>
                        <FlexItemData
                            growFactor="1"
                            shrinkFactor="1"
                            baseSize="0%"/>
                    </layoutData>


                    <!-- HEADER CARD -->
                    <HBox
                        alignItems="Center"
                        class="afTableTitleBar">

                        <VBox class="afTableTitleIcon">
                            <core:Icon src="sap-icon://shield"/>
                        </VBox>

                        <Title
                            level="H4"
                            text="CLASIFICACIÓN DE FALLAS"
                            class="afTableTitle"/>

                        <core:Icon
                            src="sap-icon://information"
                            class="afInfoIcon"/>

                    </HBox>


                    <!-- TABLA -->
                    <Table
                        id="fallasTable"
                        items="{path: 'fallasModel>/clasificaciones'}"
                        fixedLayout="true"
                        inset="false"
                        showSeparators="Inner"
                        class="afTable">

                        <layoutData>
                            <FlexItemData
                                growFactor="1"
                                shrinkFactor="1"
                                baseSize="0%"/>
                        </layoutData>

                        <columns>

                            <Column
                                width="5%"
                                hAlign="Center">
                                <Text text="#"/>
                            </Column>

                            <Column
                                width="24%"
                                hAlign="Begin">
                                <Text text="Clasificación de falla"/>
                            </Column>

                            <Column
                                width="13%"
                                hAlign="Center">
                                <Text text="OT afectadas"/>
                            </Column>

                            <Column
                                width="15%"
                                hAlign="Center">
                                <Text text="Equipos afectados"/>
                            </Column>

                            <Column
                                width="15%"
                                hAlign="Center">
                                <Text text="Clientes afectados"/>
                            </Column>

                            <Column
                                width="14%"
                                hAlign="Center">
                                <Text text="% del impacto"/>
                            </Column>

                            <Column
                                width="14%"
                                hAlign="Center">
                                <Text text="Tendencia"/>
                            </Column>

                        </columns>


                        <items>

                            <ColumnListItem
                                type="Inactive"
                                vAlign="Middle"
                                class="afDataRow">

                                <cells>

                                    <!-- # -->
                                    <Text
                                        text="{fallasModel>id}"
                                        class="afIndexText"/>


                                    <!-- CLASIFICACIÓN -->
                                    <HBox
                                        alignItems="Center"
                                        class="afClassificationCell">

                                        <VBox class="icon-falla">
                                            <core:Icon
                                                src="{fallasModel>icon}"/>
                                        </VBox>

                                        <Text
                                            text="{fallasModel>nombre}"
                                            class="afClassificationText"
                                            wrapping="false"/>

                                    </HBox>


                                    <!-- OT -->
                                    <Text
                                        text="{fallasModel>otAfectadas}"
                                        class="afMetric afOtMetric"/>


                                    <!-- EQUIPOS -->
                                    <Text
                                        text="{fallasModel>equiposAfectados}"
                                        class="afMetric"/>


                                    <!-- CLIENTES -->
                                    <Text
                                        text="{fallasModel>clientesAfectados}"
                                        class="afMetric"/>


                                    <!-- ==========================================
                                         % IMPACTO
                                         SOLO GRÁFICA.
                                         SIN TEXTO.
                                         SIN PUNTO.
                                         SIN ICONO.
                                         ========================================== -->

                                    <VBox
                                        justifyContent="Center"
                                        class="afImpactCell">

                                        <HBox class="afImpactTrack">

                                            <VBox
                                                width="{= ${fallasModel>impacto} + '%' }"
                                                class="afImpactFill">

                                                <customData>
                                                    <core:CustomData
                                                        key="state"
                                                        value="{fallasModel>impactoState}"
                                                        writeToDom="true"/>
                                                </customData>

                                            </VBox>

                                        </HBox>

                                    </VBox>


                                    <!-- ==========================================
                                         TENDENCIA MODERNA
                                         ========================================== -->

                                    <VBox
                                        alignItems="Stretch"
                                        justifyContent="Center"
                                        class="afTrendCell">

                                        <HBox
                                            alignItems="Center"
                                            justifyContent="Center"
                                            class="afTrendChart">

                                            <customData>
                                                <core:CustomData
                                                    key="trend"
                                                    value="{fallasModel>tendenciaColor}"
                                                    writeToDom="true"/>
                                            </customData>

                                            <microchart:LineMicroChart
                                                points="{path: 'fallasModel>tendenciaData'}"
                                                showPoints="true"
                                                size="Responsive"
                                                color="{fallasModel>tendenciaColor}"
                                                class="afTrendMicroChart">

                                                <microchart:points>

                                                    <microchart:LineMicroChartPoint
                                                        x="{fallasModel>x}"
                                                        y="{fallasModel>y}"/>

                                                </microchart:points>

                                            </microchart:LineMicroChart>

                                        </HBox>

                                        <Text
                                            text="{fallasModel>tendenciaTexto}"
                                            class="afTrendLabel"/>

                                    </VBox>

                                </cells>

                            </ColumnListItem>

                        </items>

                    </Table>


                    <!-- FOOTER -->
                    <Toolbar class="afTableFooter">

                        <Text
                            text="{= 'Mostrando ' + ${fallasModel>/totalClasificaciones} + ' clasificaciones calculadas'}"
                            class="afFooterText"/>

                        <ToolbarSpacer/>

                        <Text
                            text="{fallasModel>/filtros/periodoTexto}"
                            class="afFooterText"/>

                    </Toolbar>

                </VBox>

            </VBox>

        </content>

    </Page>

</mvc:View>