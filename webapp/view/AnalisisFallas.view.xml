<mvc:View controllerName="mantenimiento.controller.AnalisisFallas"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:core="sap.ui.core"
    xmlns:microchart="sap.suite.ui.microchart" displayBlock="true">
    <Page id="analisisFallasPage" showHeader="false" class="AnalisisFallas">
        <content>
            <VBox class="cmPageContainer">
                <HBox class="afTopBar" alignItems="Center" justifyContent="SpaceBetween" wrap="Wrap">
                    <VBox class="afTitleBlock">
                        <Title text="Análisis de fallas y servicios afectados" level="H1" class="cmMainTitle"/>
                        <Text text="Identifique qué tipos de fallas están impactando más el cumplimiento y dónde se concentran." class="cmSubtitle"/>
                    </VBox>
                    <HBox class="afFilters" alignItems="Stretch" justifyContent="End" wrap="Wrap">
                        <HBox class="afFilterCard afWeekFilter" alignItems="Center">
                            <core:Icon src="sap-icon://calendar" class="afFilterIcon"/>
                            <VBox class="afFilterContent">
                                <Text text="Periodo" class="afFilterLabel"/>
                                <Select id="analisisFallasPeriodSelect" selectedKey="{fallasModel>/filtros/periodo}" change=".onPeriodoChange" class="afFilterSelect" items="{fallasModel>/opcionesPeriodo}">
                                    <items>
                                        <core:Item key="{fallasModel>key}" text="{fallasModel>text}"/>
                                    </items>
                                </Select>
                            </VBox>
                        </HBox>
                        <HBox class="afFilterCard afZoneFilter" alignItems="Center">
                            <core:Icon src="sap-icon://map" class="afFilterIcon"/>
                            <VBox class="afFilterContent">
                                <Text text="Zona" class="afFilterLabel"/>
                                <Select id="analisisFallasZoneSelect" selectedKey="{fallasModel>/filtros/zona}" class="afFilterSelect" items="{fallasModel>/opcionesZona}">
                                    <items>
                                        <core:Item key="{fallasModel>key}" text="{fallasModel>text}"/>
                                    </items>
                                </Select>
                            </VBox>
                        </HBox>
                        <Button id="analisisFallasApplyButton" text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" press=".onApplyFilters" class="afApplyButton"/>
                    </HBox>
                </HBox>
                <HBox class="cmKpiRow" wrap="Wrap">
                    <HBox class="cmKpiCard cmKpiPurple" alignItems="Center">
                        <VBox class="cmKpiIcon cmKpiIconPurple">
                            <core:Icon src="sap-icon://form"/>
                        </VBox>
                        <VBox class="cmKpiContent">
                            <Text text="OT afectadas" class="cmKpiLabel"/>
                            <Text text="{fallasModel>/resumen/TotalOTAfectadas}" class="cmKpiNumber cmPurpleText"/>
                            <Text text="Del total de desviaciones" class="cmKpiDescription"/>
                        </VBox>
                    </HBox>
                    <HBox class="cmKpiCard cmKpiGreen" alignItems="Center">
                        <VBox class="cmKpiIcon cmKpiIconGreen">
                            <core:Icon src="sap-icon://wrench"/>
                        </VBox>
                        <VBox class="cmKpiContent">
                            <Text text="Clasificación principal" class="cmKpiLabel"/>
                            <Text text="{fallasModel>/resumen/ClasificacionPrincipalTexto}" class="cmKpiTextValue cmGreenText"/>
                            <Text text="{fallasModel>/resumen/ClasificacionPrincipalPorcentaje}" class="cmKpiDescription"/>
                        </VBox>
                    </HBox>
                    <HBox class="cmKpiCard cmKpiOrange" alignItems="Center">
                        <VBox class="cmKpiIcon cmKpiIconOrange">
                            <core:Icon src="sap-icon://product"/>
                        </VBox>
                        <VBox class="cmKpiContent">
                            <Text text="Equipos afectados" class="cmKpiLabel"/>
                            <Text text="{fallasModel>/resumen/TotalEquiposAfectados}" class="cmKpiNumber cmOrangeText"/>
                            <Text text="Equipos únicos" class="cmKpiDescription"/>
                        </VBox>
                    </HBox>
                    <HBox class="cmKpiCard cmKpiBlue" alignItems="Center">
                        <VBox class="cmKpiIcon cmKpiIconBlue">
                            <core:Icon src="sap-icon://business-objects-mobile"/>
                        </VBox>
                        <VBox class="cmKpiContent">
                            <Text text="Clientes afectados" class="cmKpiLabel"/>
                            <Text text="{fallasModel>/resumen/TotalClientesAfectados}" class="cmKpiNumber cmBlueText"/>
                            <Text text="Clientes únicos" class="cmKpiDescription"/>
                        </VBox>
                    </HBox>
                </HBox>
                <f:Card class="afTableCard">
                    <f:content>
                        <VBox>
                            <HBox alignItems="Center" class="afTableTitleBar">
                                <VBox class="afTableTitleIcon">
                                    <core:Icon src="sap-icon://shield"/>
                                </VBox>
                                <Title level="H4" text="CLASIFICACIÓN DE FALLAS" class="afTableTitle"/>
                                <core:Icon src="sap-icon://information" class="afInfoIcon"/>
                            </HBox>
                            <Table id="fallasTable" items="{path: 'fallasModel>/clasificaciones'}" fixedLayout="true" inset="false" class="afTable">
                                <columns>
                                    <Column width="5%" hAlign="Center">
                                        <Text text="#"/>
                                    </Column>
                                    <Column width="24%" hAlign="Begin">
                                        <Text text="Clasificación de falla"/>
                                    </Column>
                                    <Column width="13%" hAlign="Center">
                                        <Text text="OT afectadas"/>
                                    </Column>
                                    <Column width="15%" hAlign="Center">
                                        <Text text="Equipos afectados"/>
                                    </Column>
                                    <Column width="15%" hAlign="Center">
                                        <Text text="Clientes afectados"/>
                                    </Column>
                                    <Column width="14%" hAlign="Center">
                                        <Text text="% del impacto"/>
                                    </Column>
                                    <Column width="14%" hAlign="Center">
                                        <Text text="Tendencia"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem type="Inactive" vAlign="Middle">
                                        <cells>
                                            <Text text="{fallasModel>id}" class="afIndexText"/>
                                            <HBox alignItems="Center" class="afClassificationCell">
                                                <VBox class="icon-falla">
                                                    <core:Icon src="{fallasModel>icon}"/>
                                                </VBox>
                                                <Text text="{fallasModel>nombre}" class="afClassificationText" wrapping="false"/>
                                            </HBox>
                                            <Text text="{fallasModel>otAfectadas}" class="afMetric afOtMetric"/>
                                            <Text text="{fallasModel>equiposAfectados}" class="afMetric"/>
                                            <Text text="{fallasModel>clientesAfectados}" class="afMetric"/>
                                            <VBox class="afImpactCell">
                                                <Text text="{fallasModel>impactoTexto}" class="impactoText"/>
                                                <ProgressIndicator percentValue="{fallasModel>impacto}" displayValue="" state="{fallasModel>impactoState}" class="impactoProgress"/>
                                            </VBox>
                                            <VBox alignItems="Center" class="tendenciaCell">
                                                <microchart:LineMicroChart points="{path: 'fallasModel>tendenciaData'}" showPoints="false" size="Responsive" color="{fallasModel>tendenciaColor}">
                                                    <microchart:points>
                                                        <microchart:LineMicroChartPoint x="{fallasModel>x}" y="{fallasModel>y}"/>
                                                    </microchart:points>
                                                </microchart:LineMicroChart>
                                                <Text text="{fallasModel>tendenciaTexto}" class="tendenciaTexto"/>
                                            </VBox>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                            <Toolbar class="afTableFooter">
                                <Text text="{= 'Mostrando ' + ${fallasModel>/totalClasificaciones} + ' clasificaciones calculadas'}" class="afFooterText"/>
                                <ToolbarSpacer/>
                                <Text text="{fallasModel>/filtros/periodoTexto}" class="afFooterText"/>
                            </Toolbar>
                        </VBox>
                    </f:content>
                </f:Card>
            </VBox>
        </content>
    </Page>
</mvc:View>
