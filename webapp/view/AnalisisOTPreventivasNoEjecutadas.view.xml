<mvc:View controllerName="mantenimiento.controller.AnalisisOTPreventivasNoEjecutadas"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core" displayBlock="true" height="100%" class="otneView">
    <Page id="analisisOTPreventivasNoEjecutadasPage" showHeader="false" enableScrolling="true" class="otnePage sapUiSizeCompact">
        <content>
            <VBox width="100%" height="100%" fitContainer="true" class="otneContainer">
                <!-- =====================================================
                     HEADER
                     ===================================================== -->
                <HBox width="100%" alignItems="Start" justifyContent="SpaceBetween" class="otneHeader">
                    <VBox width="100%" class="otneHeaderLeft">
                        <HBox width="100%" alignItems="Center" wrap="Wrap" class="otneTitleRow">
                            <Title text="{otne>/header/titlePrefix}" level="H1" class="otneTitle" />
                            <Title text="{otne>/header/titleStatus}" level="H1" class="otneTitleRed" />
                        </HBox>
                        <HBox alignItems="Center" wrap="Wrap" class="otneBreadcrumb">
                            <Link text="Órdenes" class="otneBreadLink" />
                            <core:Icon src="sap-icon://navigation-right-arrow" class="otneBreadIcon" />
                            <Link text="Composición de órdenes del periodo" class="otneBreadLink" />
                            <core:Icon src="sap-icon://navigation-right-arrow" class="otneBreadIcon" />
                            <Text text="Preventivas" class="otneBreadText" />
                        </HBox>
                    </VBox>
                    <Text text="{otne>/header/dateNote}" class="otneDateNote" />
                </HBox>
                <!-- =====================================================
                     FILTROS
                     ===================================================== -->
                <HBox width="100%" alignItems="Stretch" class="otneFilters">
                    <!-- Periodo -->
                    <VBox class="otneFilterItem">
                        <Label text="Periodo" class="otneFilterLabel" />
                        <Select width="100%" selectedKey="{otne>/filters/periodo}" change=".onPeriodoChange" items="{otne>/catalogos/periodos}" class="otneFilterControl">
                            <core:Item key="{otne>key}" text="{otne>text}" />
                        </Select>
                    </VBox>
                    <!-- Fecha desde -->
                    <VBox class="otneFilterItem">
                        <Label text="Fecha desde" class="otneFilterLabel" />
                        <DatePicker width="100%" value="{otne>/filters/fechaDesde}" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy" class="otneFilterControl" />
                    </VBox>
                    <!-- Fecha hasta -->
                    <VBox class="otneFilterItem">
                        <Label text="Fecha hasta" class="otneFilterLabel" />
                        <DatePicker width="100%" value="{otne>/filters/fechaHasta}" valueFormat="dd/MM/yyyy" displayFormat="dd/MM/yyyy" class="otneFilterControl" />
                    </VBox>
                    <!-- Zona -->
                    <VBox class="otneFilterItem">
                        <Label text="Zona" class="otneFilterLabel" />
                        <Select width="100%" selectedKey="{otne>/filters/zona}" items="{otne>/catalogos/zonas}" class="otneFilterControl">
                            <core:Item key="{otne>key}" text="{otne>text}" />
                        </Select>
                    </VBox>
                    <!-- Cliente -->
                    <VBox class="otneFilterItem">
                        <Label text="Cliente" class="otneFilterLabel" />
                        <Select width="100%" selectedKey="{otne>/filters/cliente}" items="{otne>/catalogos/clientes}" class="otneFilterControl">
                            <core:Item key="{otne>key}" text="{otne>text}" />
                        </Select>
                    </VBox>
                    <!-- Responsable -->
                    <VBox class="otneFilterItem">
                        <Label text="Responsable" class="otneFilterLabel" />
                        <Select width="100%" selectedKey="{otne>/filters/responsable}" items="{otne>/catalogos/responsables}" class="otneFilterControl">
                            <core:Item key="{otne>key}" text="{otne>text}" />
                        </Select>
                    </VBox>
                    <!-- Aplicar filtros -->
                    <Button text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" press=".onApplyFilters" class="otneApplyBtn" />
                </HBox>
                <!-- =====================================================
                     KPIS - ESTILO VISTA JEFATURA
                     ===================================================== -->
                <HBox width="100%" alignItems="Stretch" class="otneKpiGrid">
                    <!-- PLANEADAS -->
                    <HBox alignItems="Center" class="otneKpiCard otneKpiBlue">
                        <HBox alignItems="Center" justifyContent="Center" class="otneKpiIconCircle">
                            <core:Icon src="sap-icon://appointment-2" class="otneKpiIcon" />
                        </HBox>
                        <VBox justifyContent="Center" class="otneKpiContent">
                            <Text text="{otne>/kpis/planeadas}" class="otneKpiNumber" />
                            <Text text="{otne>/kpis/planeadasLabel}" class="otneKpiLabel" />
                            <Text text="{otne>/kpis/planeadasDescription}" class="otneKpiSubLabel" />
                        </VBox>
                    </HBox>
                    <!-- EJECUTADAS -->
                    <HBox alignItems="Center" class="otneKpiCard otneKpiGreen">
                        <HBox alignItems="Center" justifyContent="Center" class="otneKpiIconCircle">
                            <core:Icon src="sap-icon://sys-enter-2" class="otneKpiIcon" />
                        </HBox>
                        <VBox justifyContent="Center" class="otneKpiContent">
                            <Text text="{otne>/kpis/ejecutadas}" class="otneKpiNumber" />
                            <Text text="{otne>/kpis/ejecutadasLabel}" class="otneKpiLabel" />
                            <Text text="{otne>/kpis/ejecutadasDescription}" class="otneKpiSubLabel" />
                        </VBox>
                    </HBox>
                    <!-- NO EJECUTADAS -->
                    <HBox alignItems="Center" class="otneKpiCard otneKpiRed">
                        <HBox alignItems="Center" justifyContent="Center" class="otneKpiIconCircle">
                            <core:Icon src="sap-icon://decline" class="otneKpiIcon" />
                        </HBox>
                        <VBox justifyContent="Center" class="otneKpiContent">
                            <Text text="{otne>/kpis/noEjecutadas}" class="otneKpiNumber" />
                            <Text text="{otne>/kpis/noEjecutadasLabel}" class="otneKpiLabel" />
                            <Text text="{otne>/kpis/noEjecutadasDescription}" class="otneKpiSubLabel otneKpiSubLabelRed" />
                        </VBox>
                    </HBox>
                    <!-- CUMPLIMIENTO -->
                    <HBox alignItems="Center" class="otneKpiCard otneKpiPurple">
                        <HBox alignItems="Center" justifyContent="Center" class="otneKpiIconCircle">
                            <core:Icon src="sap-icon://target-group" class="otneKpiIcon" />
                        </HBox>
                        <VBox justifyContent="Center" class="otneKpiContent">
                            <Text text="{otne>/kpis/cumplimiento}" class="otneKpiNumber" />
                            <Text text="{otne>/kpis/cumplimientoLabel}" class="otneKpiLabel" />
                            <Text text="{otne>/kpis/cumplimientoDescription}" class="otneKpiSubLabel" />
                        </VBox>
                    </HBox>
                </HBox>
                <!-- =====================================================
                     SELECTOR DE ANÁLISIS
                     ===================================================== -->
                <HBox width="100%" alignItems="Center" justifyContent="SpaceBetween" class="otneToolbar">
                    <HBox alignItems="Center" wrap="Wrap" class="otneTabs">
                        <Text text="Ver análisis por:" class="otneTabsLabel" />
                        <Button text="{otne>/analysisTabs/noEjecutadas}" type="{= ${otne>/ui/selectedAnalysis} === 'NO_EJECUTADAS' ? 'Emphasized' : 'Default'}" press=".onSelectNoEjecutadas" class="otneTabBtn" />
                        <Button text="{otne>/analysisTabs/ejecutadas}" type="{= ${otne>/ui/selectedAnalysis} === 'EJECUTADAS' ? 'Emphasized' : 'Default'}" press=".onSelectEjecutadas" class="otneTabBtn" />
                        <Button text="{otne>/analysisTabs/todas}" type="{= ${otne>/ui/selectedAnalysis} === 'TODAS' ? 'Emphasized' : 'Default'}" press=".onSelectTodas" class="otneTabBtn" />
                    </HBox>
                    <HBox alignItems="Center" class="otneInfoBox">
                        <core:Icon src="sap-icon://hint" class="otneInfoIcon" />
                        <Text text="{otne>/ui/analysisInfo}" class="otneInfoText" />
                    </HBox>
                </HBox>
                <!-- =====================================================
                     CARD TABLA
                     ===================================================== -->
                <VBox width="100%" class="otneTableCard">
                    <!-- CABECERA -->
                    <HBox width="100%" alignItems="Center" justifyContent="SpaceBetween" class="otneTableTop">
                        <Title text="Causas de no ejecución de OT Preventivas" level="H2" class="otneTableTitle" />
                        <SearchField width="100%" placeholder="Buscar causa..." liveChange=".onSearchCause" search=".onSearchCause" class="otneSearch" />
                    </HBox>
                    <!-- TABLA -->
                    <VBox width="100%" class="otneTableViewport">
                        <!-- HEADER -->
                        <HBox width="100%" class="otneCauseHeader">
                            <Text text="" />
                            <Text text="Causa de no ejecución" wrapping="true" />
                            <Text text="OT no ejecutadas" wrapping="true" />
                            <Text text="% del total no ejecutadas" wrapping="true" />
                            <Text text="Clientes afectados" wrapping="true" />
                            <Text text="Elevadores afectados" wrapping="true" />
                            <Text text="Días detenidas (promedio)" wrapping="true" />
                            <Text text="" />
                        </HBox>
                        <!-- LISTA -->
                        <List items="{otne>/causes}" showSeparators="None" noDataText="No se encontraron causas" class="otneCauseList">
                            <CustomListItem class="otneCauseListItem">
                                <VBox width="100%">
                                    <!-- FILA PRINCIPAL -->
                                    <HBox width="100%" alignItems="Center" class="otneCauseRow">
                                        <HBox alignItems="Center" justifyContent="Center" class="otneCauseLead">
                                            <Button icon="{= ${otne>expanded} ? 'sap-icon://slim-arrow-down' : 'sap-icon://slim-arrow-right'}" type="Transparent" press=".onToggleCause" class="otneExpandBtn" />
                                            <core:Icon src="{otne>icon}" class="otneCauseIcon" />
                                        </HBox>
                                        <Text text="{otne>name}" tooltip="{otne>name}" class="otneCauseName" />
                                        <Text text="{otne>ot}" class="otneRedStrong" />
                                        <Text text="{otne>pct}" class="otneBlueStrong" />
                                        <Text text="{otne>clientes}" class="otneStrong" />
                                        <Text text="{otne>elevadores}" class="otneStrong" />
                                        <Text text="{otne>dias}" class="otneDaysText" />
                                        <core:Icon src="{= ${otne>expanded} ? 'sap-icon://slim-arrow-up' : 'sap-icon://slim-arrow-right'}" class="otneRowEndIcon" />
                                    </HBox>
                                    <!-- DETALLE EXPANDIDO -->
                                    <VBox width="100%" visible="{otne>expanded}" class="otneSubTable">
                                        <HBox width="100%" class="otneSubHeader">
                                            <Text text="OT" />
                                            <Text text="Cliente" />
                                            <Text text="Elevador" />
                                            <Text text="Responsable" />
                                            <Text text="Fecha programada" />
                                            <Text text="Días detenida desde hace" />
                                        </HBox>
                                        <VBox width="100%" items="{
                                                path: 'otne>details',
                                                templateShareable: false
                                            }" class="otneSubRows">
                                            <items>
                                                <HBox width="100%" class="otneSubRow">
                                                    <Text text="{otne>ot}" class="otneOrderText" />
                                                    <Text text="{otne>cliente}" tooltip="{otne>cliente}" />
                                                    <Text text="{otne>elevador}" />
                                                    <Text text="{otne>responsable}" tooltip="{otne>responsable}" />
                                                    <Text text="{otne>fechaProgramada}" />
                                                    <Text text="{otne>diasDetenida}" class="otneSubDaysText" />
                                                </HBox>
                                            </items>
                                        </VBox>
                                    </VBox>
                                </VBox>
                            </CustomListItem>
                        </List>
                        <!-- TOTAL -->
                        <HBox width="100%" alignItems="Center" class="otneCauseRow otneTotalRow">
                            <HBox alignItems="Center" justifyContent="Center">
                                <core:Icon src="sap-icon://bar-chart" class="otneTotalIcon" />
                            </HBox>
                            <Text text="{otne>/totals/name}" class="otneCauseName" />
                            <Text text="{otne>/totals/ot}" class="otneRedStrong" />
                            <Text text="{otne>/totals/pct}" class="otneBlueStrong" />
                            <Text text="{otne>/totals/clientes}" class="otneStrong" />
                            <Text text="{otne>/totals/elevadores}" class="otneStrong" />
                            <Text text="{otne>/totals/dias}" class="otneDaysText" />
                            <Text text="" />
                        </HBox>
                    </VBox>
                    <!-- FOOTER -->
                    <HBox width="100%" alignItems="Center" class="otneTableFooter">
                        <core:Icon src="sap-icon://hint" class="otneFooterIcon" />
                        <Text text="{otne>/footerText}" wrapping="true" />
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>