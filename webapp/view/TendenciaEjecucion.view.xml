<mvc:View controllerName="mantenimiento.controller.TendenciaEjecucion"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:layout="sap.ui.layout"
    xmlns:viz="sap.viz.ui5.controls" height="100%">
    <Page id="pageTendencia" showHeader="false" class="tprPage">
        <content>
            <VBox class="tprDashboard">
                <HBox class="tprHeader" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">
                    <VBox class="tprHeaderTextBox">
                        <Title text="Tendencia de ejecución" level="H1" class="tprMainTitle"/>
                        <Text text="Evolución semanal de OT planeadas vs ejecutadas y análisis de causas de desviación." class="tprMainSubtitle"/>
                    </VBox>
                    <HBox class="tprFilterActions" alignItems="Center" wrap="Wrap">
                        <HBox class="tprFilterCard tprPeriodCard" alignItems="Center">
                            <core:Icon src="sap-icon://calendar" class="tprFilterIcon"/>
                            <VBox class="tprFilterTexts">
                                <Text text="Periodo" class="tprFilterLabel"/>
                                <Select id="tendenciaSelPeriodo" selectedKey="{trend>/filtros/periodo}" items="{trend>/opcionesPeriodo}" class="tprFilterSelect">
                                    <items>
                                        <core:Item key="{trend>key}" text="{trend>text}"/>
                                    </items>
                                </Select>
                            </VBox>
                        </HBox>
                        <HBox class="tprFilterCard tprZoneCard" alignItems="Center">
                            <core:Icon src="sap-icon://map" class="tprFilterIcon"/>
                            <VBox class="tprFilterTexts">
                                <Text text="Zona" class="tprFilterLabel"/>
                                <Select id="tendenciaSelZona" selectedKey="{trend>/filtros/zona}" items="{trend>/opcionesZona}" class="tprFilterSelect">
                                    <items>
                                        <core:Item key="{trend>key}" text="{trend>text}"/>
                                    </items>
                                </Select>
                            </VBox>
                        </HBox>
                        <Button text="Aplicar filtros" icon="sap-icon://filter" type="Emphasized" press=".onApplyFilters" class="tprApplyButton"/>
                    </HBox>
                </HBox>
                <VBox class="tprSectionCard">
                    <Title text="CONTEXTO DEL PERIODO" level="H4" class="tprSectionTitle"/>
                    <layout:Grid defaultSpan="XL4 L4 M12 S12" hSpacing="1" vSpacing="1">
                        <HBox class="tprInsightCard tprInsightRed" alignItems="Center">
                            <HBox class="tprInsightIconBox">
                                <core:Icon src="sap-icon://trend-down" class="tprInsightIcon"/>
                            </HBox>
                            <VBox>
                                <Text text="Peor semana" class="tprInsightLabel"/>
                                <Text text="{trend>/contexto/peorSemana}" class="tprInsightMain"/>
                                <Text text="{trend>/contexto/peorSemanaDetalle}" class="tprInsightDetail"/>
                            </VBox>
                        </HBox>
                        <HBox class="tprInsightCard tprInsightOrange" alignItems="Center">
                            <HBox class="tprInsightIconBox">
                                <core:Icon src="sap-icon://alert" class="tprInsightIcon"/>
                            </HBox>
                            <VBox>
                                <Text text="Mayor brecha" class="tprInsightLabel"/>
                                <Text text="{trend>/contexto/mayorBrecha}" class="tprInsightMain"/>
                                <Text text="{trend>/contexto/mayorBrechaDetalle}" class="tprInsightDetail"/>
                            </VBox>
                        </HBox>
                        <HBox class="tprInsightCard tprInsightGreen" alignItems="Center">
                            <HBox class="tprInsightIconBox">
                                <core:Icon src="sap-icon://document-text" class="tprInsightIcon"/>
                            </HBox>
                            <VBox>
                                <Text text="Principal impulsor de la caída" class="tprInsightLabel"/>
                                <Text text="{trend>/contexto/principalImpulsor}" class="tprInsightMain tprLongText" wrapping="false"/>
                                <Text text="{= ${trend>/contexto/impulsorOT} + ' · ' + ${trend>/contexto/impulsorPorcentaje} + ' del deterioro'}" class="tprInsightDetail"/>
                            </VBox>
                        </HBox>
                    </layout:Grid>
                </VBox>
                <layout:Grid hSpacing="1" vSpacing="1" class="tprMiddleGrid">
                    <VBox class="tprCard tprChartCard">
                        <layoutData>
                            <layout:GridData span="XL7 L7 M12 S12"/>
                        </layoutData>
                        <Title text="EVOLUCIÓN SEMANAL" level="H4" class="tprCardTitle"/>
                        <Text text="OT planeadas, ejecutadas y porcentaje de cumplimiento por semana." class="tprCardSubtitle"/>
                        <viz:VizFrame id="vfEvolucionSemanal" width="100%" height="285px" vizType="dual_line" uiConfig="{applicationSet:'fiori'}" class="tprVizFrame"/>
                    </VBox>
                    <VBox class="tprCard tprDropCard">
                        <layoutData>
                            <layout:GridData span="XL5 L5 M12 S12"/>
                        </layoutData>
                        <Title text="¿POR QUÉ CAYÓ EL CUMPLIMIENTO?" level="H4" class="tprCardTitle"/>
                        <Text text="Diferencia entre la mejor y la peor semana del periodo." class="tprCardSubtitle"/>
                        <List items="{trend>/caidaCumplimiento}" showSeparators="None" class="tprCauseList">
                            <items>
                                <CustomListItem>
                                    <HBox class="tprCauseRow" alignItems="Center">
                                        <VBox class="tprCauseDot">
                                            <customData>
                                                <core:CustomData key="tone" value="{trend>tono}" writeToDom="true"/>
                                            </customData>
                                        </VBox>
                                        <Text text="{trend>causa}" class="tprCauseName"/>
                                        <ObjectNumber number="{trend>incremento}" state="{trend>estado}" class="tprCauseIncrement"/>
                                        <ProgressIndicator percentValue="{trend>porcentajeValor}" displayValue="" showValue="false" state="{trend>estado}" class="tprCauseBar"/>
                                        <Text text="{trend>porcentajeTexto}" class="tprCausePercent"/>
                                    </HBox>
                                </CustomListItem>
                            </items>
                        </List>
                        <HBox class="tprTotalRow" justifyContent="SpaceBetween">
                            <Text text="Total de incremento"/>
                            <Text text="{trend>/totalCaida/incremento}"/>
                        </HBox>
                    </VBox>
                </layout:Grid>
                <VBox class="tprCard tprHeatmapCard">
                    <Title text="EVOLUCIÓN DE LAS CAUSAS (OT NO EJECUTADAS)" level="H4" class="tprCardTitle"/>
                    <Text text="Conteo distinto de órdenes no ejecutadas con causa principal por semana." class="tprCardSubtitle"/>
                    <Table items="{trend>/evolucionCausas}" fixedLayout="true" class="tprHeatmapTable">
                        <columns>
                            <Column width="27%">
                                <Text text="Causa"/>
                            </Column>
                            <Column hAlign="Center">
                                <Text text="{trend>/cabecerasSemana/0/semana}"/>
                            </Column>
                            <Column hAlign="Center">
                                <Text text="{trend>/cabecerasSemana/1/semana}"/>
                            </Column>
                            <Column hAlign="Center">
                                <Text text="{trend>/cabecerasSemana/2/semana}"/>
                            </Column>
                            <Column hAlign="Center">
                                <Text text="{trend>/cabecerasSemana/3/semana}"/>
                            </Column>
                            <Column hAlign="Center">
                                <Text text="{trend>/cabecerasSemana/4/semana}"/>
                            </Column>
                            <Column hAlign="Center" width="12%">
                                <Text text="Variación"/>
                            </Column>
                        </columns>
                        <items>
                            <ColumnListItem>
                                <customData>
                                    <core:CustomData key="rowtype" value="{trend>rowtype}" writeToDom="true"/>
                                </customData>
                                <cells>
                                    <Text text="{trend>causa}" class="tprHeatCauseName"/>
                                    <HBox justifyContent="Center" class="tprHeatCell">
                                        <customData>
                                            <core:CustomData key="heat" value="{trend>heat1}" writeToDom="true"/>
                                        </customData>
                                        <Text text="{trend>week1}"/>
                                    </HBox>
                                    <HBox justifyContent="Center" class="tprHeatCell">
                                        <customData>
                                            <core:CustomData key="heat" value="{trend>heat2}" writeToDom="true"/>
                                        </customData>
                                        <Text text="{trend>week2}"/>
                                    </HBox>
                                    <HBox justifyContent="Center" class="tprHeatCell">
                                        <customData>
                                            <core:CustomData key="heat" value="{trend>heat3}" writeToDom="true"/>
                                        </customData>
                                        <Text text="{trend>week3}"/>
                                    </HBox>
                                    <HBox justifyContent="Center" class="tprHeatCell">
                                        <customData>
                                            <core:CustomData key="heat" value="{trend>heat4}" writeToDom="true"/>
                                        </customData>
                                        <Text text="{trend>week4}"/>
                                    </HBox>
                                    <HBox justifyContent="Center" class="tprHeatCell">
                                        <customData>
                                            <core:CustomData key="heat" value="{trend>heat5}" writeToDom="true"/>
                                        </customData>
                                        <Text text="{trend>week5}"/>
                                    </HBox>
                                    <ObjectNumber number="{trend>variacion}" state="{trend>estadoVariacion}"/>
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                    <HBox class="tprHeatLegend" justifyContent="Center">
                        <Text text="Menor impacto"/>
                        <VBox class="tprLegendGradient"/>
                        <Text text="Mayor impacto"/>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </Page>
</mvc:View>
