<mvc:View
  controllerName="mantenimiento.controller.AnalisisReparacionesPlaneadasEjecutadas"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Page
    id="pageAnalisisReparacionesEjecutadas"
    showHeader="false"
    class="repaEjecutadasPage">

    <content>
      <ScrollContainer height="100%" vertical="true">
        <VBox class="repaContainer">

          <!-- HEADER -->
          <HBox class="repaHeader" justifyContent="SpaceBetween" alignItems="Center">
            <VBox>
              <Title level="H1" class="repaTitle">
                <Text text="Análisis de Reparaciones Planeadas "/>
                <Text text="Ejecutadas" class="repaTitleGreen"/>
              </Title>

              <HBox class="repaBreadcrumb" alignItems="Center">
                <Text text="Órdenes"/>
                <core:Icon src="sap-icon://navigation-right-arrow"/>
                <Text text="Composición de órdenes del periodo"/>
                <core:Icon src="sap-icon://navigation-right-arrow"/>
                <Text text="Reparaciones"/>
              </HBox>
            </VBox>
          </HBox>

          <!-- FILTROS -->
          <HBox class="repaFilterCard" alignItems="End" wrap="Wrap">

            <VBox class="repaFilterItem">
              <Label text="Periodo"/>
              <Select id="selPeriodo" selectedKey="mayo" width="170px">
                <items>
                  <core:Item key="mayo" text="Mayo 2024"/>
                  <core:Item key="junio" text="Junio 2024"/>
                </items>
              </Select>
            </VBox>

            <VBox class="repaFilterItem">
              <Label text="Fecha desde"/>
              <DatePicker id="dpDesde" value="01/05/2024" width="170px"/>
            </VBox>

            <VBox class="repaFilterItem">
              <Label text="Fecha hasta"/>
              <DatePicker id="dpHasta" value="31/05/2024" width="170px"/>
            </VBox>

            <VBox class="repaFilterItem">
              <Label text="Zona"/>
              <Select id="selZona" selectedKey="todas" width="145px">
                <items>
                  <core:Item key="todas" text="Todas"/>
                  <core:Item key="norte" text="Norte"/>
                  <core:Item key="centro" text="Centro"/>
                  <core:Item key="sur" text="Sur"/>
                </items>
              </Select>
            </VBox>

            <VBox class="repaFilterItem">
              <Label text="Cliente"/>
              <Select id="selCliente" selectedKey="todos" width="145px">
                <items>
                  <core:Item key="todos" text="Todos"/>
                  <core:Item key="torre" text="Torre Reforma"/>
                  <core:Item key="plaza" text="Plaza Satélite"/>
                </items>
              </Select>
            </VBox>

            <VBox class="repaFilterItem">
              <Label text="Responsable"/>
              <Select id="selResponsable" selectedKey="todos" width="165px">
                <items>
                  <core:Item key="todos" text="Todos"/>
                  <core:Item key="juan" text="Juan Pérez"/>
                  <core:Item key="maria" text="María González"/>
                  <core:Item key="carlos" text="Carlos Herrera"/>
                </items>
              </Select>
            </VBox>

            <Button
              text="Aplicar filtros"
              icon="sap-icon://filter"
              type="Emphasized"
              press=".onAplicarFiltros"
              class="repaFilterButton"/>

          </HBox>

          <!-- KPI CARDS -->
          <HBox class="repaKpiRow" wrap="Wrap">

            <VBox class="repaKpiCard repaKpiBlue">
              <HBox alignItems="Center">
                <VBox class="repaKpiIconBox repaBlueSoft">
                  <core:Icon src="sap-icon://appointment-2"/>
                </VBox>
                <VBox class="repaKpiText">
                  <Text text="{repa>/kpis/planeadas}" class="repaKpiNumber repaBlueText"/>
                  <Text text="Planeadas" class="repaKpiLabel"/>
                  <Text text="Órdenes del periodo" class="repaKpiSub"/>
                </VBox>
              </HBox>
            </VBox>

            <VBox class="repaKpiCard repaKpiGreen">
              <HBox alignItems="Center">
                <VBox class="repaKpiIconBox repaGreenSoft">
                  <core:Icon src="sap-icon://accept"/>
                </VBox>
                <VBox class="repaKpiText">
                  <Text text="{repa>/kpis/ejecutadas}" class="repaKpiNumber repaGreenText"/>
                  <Text text="Ejecutadas" class="repaKpiLabel"/>
                  <Text text="92.6% del total" class="repaKpiSub"/>
                </VBox>
              </HBox>
            </VBox>

            <VBox class="repaKpiCard repaKpiRed">
              <HBox alignItems="Center">
                <VBox class="repaKpiIconBox repaRedSoft">
                  <core:Icon src="sap-icon://decline"/>
                </VBox>
                <VBox class="repaKpiText">
                  <Text text="{repa>/kpis/noEjecutadas}" class="repaKpiNumber repaRedText"/>
                  <Text text="No ejecutadas" class="repaKpiLabel"/>
                  <Text text="7.4% del total planeado" class="repaKpiSub"/>
                </VBox>
              </HBox>
            </VBox>

            <VBox class="repaKpiCard repaKpiPurple">
              <HBox alignItems="Center">
                <VBox class="repaKpiIconBox repaPurpleSoft">
                  <core:Icon src="sap-icon://target-group"/>
                </VBox>
                <VBox class="repaKpiText">
                  <Text text="{repa>/kpis/cumplimiento}" class="repaKpiNumber repaPurpleText"/>
                  <Text text="Cumplimiento" class="repaKpiLabel"/>
                  <Text text="{repa>/kpis/resumen}" class="repaKpiSub"/>
                </VBox>
              </HBox>
            </VBox>

          </HBox>

          <!-- TABS + INFO -->
          <HBox class="repaAnalysisBar" justifyContent="SpaceBetween" alignItems="Center" wrap="Wrap">

            <HBox class="repaTabs" alignItems="Center">
              <Text text="Ver análisis por:" class="repaTabsLabel"/>

              <Button
                text="No ejecutadas (7)"
                type="Transparent"
                press=".onVerNoEjecutadas"
                class="repaTabButton"/>

              <Button
                text="Ejecutadas (88)"
                type="Emphasized"
                class="repaTabButton repaTabButtonActive"/>

              <Button
                text="Todas (95)"
                type="Transparent"
                press=".onVerTodas"
                class="repaTabButton"/>
            </HBox>

            <HBox class="repaInfoMessage" alignItems="Center">
              <core:Icon src="sap-icon://information"/>
              <Text text="Análisis basado en 88 OT ejecutadas en el periodo seleccionado."/>
            </HBox>

          </HBox>

          <!-- TABLA PRINCIPAL -->
          <VBox class="repaTableCard">

            <HBox class="repaTableTop" justifyContent="SpaceBetween" alignItems="Center">
              <Title text="Ejecución de Reparaciones Planeadas" level="H2" class="repaSectionTitle"/>

              <SearchField
                width="320px"
                placeholder="Buscar material..."
                liveChange=".onBuscarMaterial"
                class="repaSearch"/>
            </HBox>

            <!-- HEADER TABLA -->
            <HBox class="repaTableHeader">
              <Text text="Material utilizado" class="repaColMaterial"/>
              <Text text="OT ejecutadas" class="repaColSmall"/>
              <Text text="% de las ejecutadas" class="repaColSmall"/>
              <Text text="Equipos atendidos" class="repaColSmall"/>
              <Text text="Clientes atendidos" class="repaColSmall"/>
              <Text text="Días promedio de ejecución" class="repaColSmall"/>
              <Text text="" class="repaColArrow"/>
            </HBox>

            <!-- BODY TABLA -->
            <VBox
              class="repaTableBody"
              items="{repa>/materiales}">

              <items>
                <VBox class="repaMaterialBlock">

                  <HBox class="repaMaterialRow" alignItems="Center">
                    <Button
                      icon="{repa>chevronIcon}"
                      type="Transparent"
                      press=".onToggleMaterial"
                      class="repaExpandButton"/>

                    <HBox class="repaColMaterial" alignItems="Center">
                      <core:Icon src="{repa>icon}" class="repaMaterialIcon"/>
                      <Text text="{repa>material}" class="repaMaterialName"/>
                    </HBox>

                    <Text text="{repa>ejecutadas}" class="repaColSmall repaGreenNumber"/>
                    <Text text="{repa>porcentaje}" class="repaColSmall repaBlueNumber"/>
                    <Text text="{repa>equipos}" class="repaColSmall"/>
                    <Text text="{repa>clientes}" class="repaColSmall"/>
                    <Text text="{repa>dias}" class="repaColSmall repaGreenNumber"/>

                    <Button
                      icon="{repa>chevronIcon}"
                      type="Transparent"
                      press=".onToggleMaterial"
                      class="repaArrowButton"/>
                  </HBox>

                  <Table
                    visible="{repa>expanded}"
                    items="{repa>ordenes}"
                    class="repaInnerTable"
                    showSeparators="Inner">

                    <columns>
                      <Column>
                        <Text text="OT"/>
                      </Column>
                      <Column>
                        <Text text="Equipo"/>
                      </Column>
                      <Column>
                        <Text text="Cliente"/>
                      </Column>
                      <Column>
                        <Text text="Fecha ejecución"/>
                      </Column>
                      <Column>
                        <Text text="Técnico responsable"/>
                      </Column>
                      <Column>
                        <Text text="Días de ejecución"/>
                      </Column>
                    </columns>

                    <items>
                      <ColumnListItem>
                        <cells>
                          <Text text="{repa>ot}" class="repaOtText"/>
                          <Text text="{repa>equipo}"/>
                          <Text text="{repa>cliente}"/>
                          <Text text="{repa>fecha}"/>
                          <Text text="{repa>tecnico}"/>
                          <Text text="{repa>dias}"/>
                        </cells>
                      </ColumnListItem>
                    </items>

                  </Table>

                </VBox>
              </items>

            </VBox>

            <HBox class="repaFooterInfo" alignItems="Center">
              <core:Icon src="sap-icon://information"/>
              <Text text="Los días de ejecución corresponden al tiempo desde la fecha de inicio hasta la fecha de cierre de la OT."/>
            </HBox>

          </VBox>

        </VBox>
      </ScrollContainer>
    </content>
  </Page>
</mvc:View>